        )
    query = query.order_by(MovimientoInventario.creado_en.desc())
    return jsonify(
        paginar(
            query,
            parse_int(request.args.get("page"), 1) or 1,
            parse_int(request.args.get("perPage"), 30) or 30,
            lambda m: m.to_dict(),
        )
    )
