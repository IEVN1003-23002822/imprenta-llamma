                  <div><span>Subtotal</span><strong>{{ monedaExacta(totalesFormulario().subtotal) }}</strong></div>
                  <div><span>IVA (16%)</span><strong>{{ monedaExacta(totalesFormulario().impuestos) }}</strong></div>
                  <div class="order-totals-final"><span>Total</span><strong>{{ monedaExacta(totalesFormulario().total) }}</strong></div>
                </div>
