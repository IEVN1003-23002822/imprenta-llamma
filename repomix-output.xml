    busqueda = (request.args.get("q") or "").strip()
    if busqueda:
        patron = f"%{busqueda}%"
        query = query.join(Cliente).filter(
            or_(Cotizacion.folio.ilike(patron), Cliente.nombre.ilike(patron))
        )
    query = query.order_by(Cotizacion.creado_en.desc())
    return jsonify(
