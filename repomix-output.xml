    query = query.order_by(Pedido.creado_en.desc())
    return jsonify(
        paginar(
            query,
            parse_int(request.args.get("page"), 1) or 1,
            parse_int(request.args.get("perPage"), 20) or 20,
            lambda p: p.to_dict(incluir_detalle=False),
        )
    )


