<file path="src/app/llamma/produccion/produccion.component.html">
<div class="module-page produccion-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Taller y calidad</span>
        <h1>Producción en tiempo real.</h1>
        <p class="page-lead">
          Tablero de etapas, responsables y control de calidad. Visualiza qué está en el taller y
          qué necesita atención antes de la entrega.
        </p>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="date-chip">
          <i class="bi bi-calendar3"></i>
          Hoy · {{ hoy | date: 'dd MMM yyyy' }}
        </span>
        <button class="btn btn-outline-ink" type="button" (click)="exportar()">
          <i class="bi bi-file-earmark-bar-graph"></i> Reporte de turno
        </button>
      </div>
    </header>

    @if (error()) {
      <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="flex-grow-1">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar()">Reintentar</button>
      </div>
    }

    <div class="row g-3 mb-4">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-sm-6 col-xl-3">
          <div class="prod-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div><strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span></div>
          </div>
        </div>
      }
    </div>

    <div class="kanban-head-bar">
      <div>
        <span class="panel-kicker">Flujo del taller</span>
        <h2>Tablero de producción</h2>
      </div>
      <div class="d-flex align-items-center gap-2">
        @if (cargando()) {
          <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
        }
        <span class="kanban-hint d-none d-xl-inline-flex">
          <i class="bi bi-arrows-expand"></i> Desplázate para ver las 8 etapas
        </span>
        <span class="badge badge-soft-muted">{{ ordenes().length }} órdenes en piso</span>
      </div>
    </div>

    <div class="kanban-scroll mb-4">
      <div class="kanban-board">
        @for (columna of columnas(); track columna.valor) {
          <section class="kanban-col">
            <header class="kanban-col-head">
              <span [class]="dotEtapa(columna.valor)"></span>
              <strong>{{ columna.etiqueta }}</strong>
              <span class="kanban-count">{{ columna.ordenes.length }}</span>
            </header>

            @for (orden of columna.ordenes; track orden.id) {
              <article class="task-card" [class.is-featured]="orden.estado === 'pausada' || orden.estado === 'rechazada'">
                <div class="task-top">
                  <span class="order-id">#{{ orden.pedidoFolio ?? orden.pedidoId }}</span>
                  <span class="badge" [class]="claseEstado(orden.estado)">{{ etiquetaEstado(orden.estado) }}</span>
                </div>
                <strong class="task-title">{{ titulo(orden) }}</strong>
                <span class="task-client"><i class="bi bi-person"></i> {{ cliente(orden) }}</span>
                <div class="task-meta">
                  <span><i class="bi bi-clock"></i> Entrega {{ fechaEntrega(orden) }}</span>
                  <span><i class="bi bi-person-badge"></i> {{ orden.responsable || 'Sin asignar' }}</span>
                </div>
                @if (orden.estado === 'pausada' && orden.observaciones) {
                  <p class="task-note"><i class="bi bi-exclamation-triangle"></i> {{ orden.observaciones }}</p>
                }
                <div class="task-foot">
                  <span class="task-progress-track"><span [style.width]="progreso(orden) + '%'"></span></span>
                  <span>{{ progreso(orden) }}%</span>
                </div>

                @if (puedeGestionar()) {
                  <div class="task-actions">
                    <button
                      class="btn btn-icon btn-icon-xs"
                      type="button"
                      aria-label="Regresar etapa"
                      title="Regresar etapa"
                      [disabled]="!puedeRetroceder(orden) || moviendoId() === orden.id"
                      (click)="mover(orden, -1)"
                    >
                      <i class="bi bi-chevron-left"></i>
                    </button>
                    <button
                      class="btn btn-icon btn-icon-xs"
                      type="button"
                      aria-label="Avanzar etapa"
                      title="Avanzar etapa"
                      [disabled]="!puedeAvanzar(orden) || moviendoId() === orden.id"
                      (click)="mover(orden, 1)"
                    >
                      <i class="bi bi-chevron-right"></i>
                    </button>
                    <button
                      class="btn btn-icon btn-icon-xs ms-auto"
                      type="button"
                      aria-label="Abrir orden"
                      title="Abrir orden"
                      (click)="abrirDetalle(orden)"
                    >
                      <i class="bi bi-arrows-angle-expand"></i>
                    </button>
                  </div>
                } @else {
                  <div class="task-actions">
                    <button
                      class="btn btn-icon btn-icon-xs ms-auto"
                      type="button"
                      aria-label="Abrir orden"
                      title="Abrir orden"
                      (click)="abrirDetalle(orden)"
                    >
                      <i class="bi bi-arrows-angle-expand"></i>
                    </button>
                  </div>
                }
              </article>
            } @empty {
              <p class="kanban-empty">
                <i class="bi bi-inbox"></i> Sin órdenes en esta etapa
              </p>
            }
          </section>
        }
      </div>
    </div>

    <div class="row g-4">
      <div class="col-xl-7">
        <section class="panel-card h-100">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Capacidad del taller</span>
              <h2>Carga por etapa</h2>
            </div>
            <span class="badge badge-soft-success">
              {{ ordenes().length ? 'Operación en curso' : 'Sin paros' }}
            </span>
          </div>

          <div class="stage-load">
            @for (columna of resumenEtapas(); track columna.valor) {
              <div class="stage-load-row">
                <span class="stage-load-name">
                  <i class="bi" [class]="'bi ' + columna.icono"></i> {{ columna.etiqueta }}
                </span>
                <div class="stage-meter">
                  <span [style.width]="columna.porcentaje + '%'"></span>
                </div>
                <strong>{{ columna.total }}</strong>
              </div>
            }
          </div>
        </section>
      </div>

      <div class="col-xl-5">
        <section class="panel-card h-100 d-flex flex-column">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Calidad</span>
              <h2>Últimos controles</h2>
            </div>
            <span class="badge" [class]="controlesPendientes() ? 'badge-soft-warning' : 'badge-soft-success'">
              {{ controlesPendientes() ? controlesPendientes() + ' por atender' : 'Todo en orden' }}
            </span>
          </div>

          <div class="quality-list">
            @for (fila of calidadReciente(); track fila.control.id) {
              <div class="quality-row" [class.is-done]="fila.control.aprobado">
                <span class="quality-check">
                  <i class="bi" [class]="fila.control.aprobado ? 'bi-check-lg' : 'bi-hourglass-split'"></i>
                </span>
                <div>
                  <strong>{{ fila.control.criterio }}</strong>
                  <small>
                    #{{ fila.folio }} · {{ fila.control.revisadoPor || 'Sin revisor' }} ·
                    {{ fechaHora(fila.control.fecha) }}
                  </small>
                </div>
                <span class="badge" [class]="fila.control.aprobado ? 'badge-soft-success' : 'badge-soft-warning'">
                  {{ fila.control.aprobado ? 'OK' : 'Pendiente' }}
                </span>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">
                Aún no hay controles de calidad registrados. Abre una orden para capturar el primero.
              </p>
            }
          </div>

          <div class="quote-note">
            <i class="bi bi-shield-check"></i>
            <span>Ninguna orden sale del taller sin el checklist de calidad completo y firmado.</span>
          </div>

          <a class="btn btn-outline-ink w-100 mt-auto" routerLink="/detalle">
            <i class="bi bi-receipt"></i> Ver detalle de la orden
          </a>
        </section>
      </div>
    </div>
  </div>
</div>

@if (seleccionada(); as orden) {
  <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="z-index: 1055">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <span class="panel-kicker">Orden de producción</span>
            <div class="d-flex flex-wrap align-items-center gap-2">
              <h2 class="modal-title h5 mb-0">#{{ orden.pedidoFolio ?? orden.pedidoId }}</h2>
              <span class="badge" [class]="claseEstado(orden.estado)">{{ etiquetaEstado(orden.estado) }}</span>
              <span class="badge badge-soft-muted">
                <i class="bi" [class]="'bi ' + iconoEtapa(orden.etapa)"></i>
                {{ etiquetaEtapa(orden.etapa) }}
              </span>
            </div>
          </div>
          <button class="btn btn-icon" type="button" aria-label="Cerrar" (click)="cerrarDetalle()">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>

        <div class="modal-body">
          <div class="row g-4">
            <div class="col-lg-5">
              <div class="order-brief mb-3">
                <span class="order-brief-icon"><i class="bi bi-printer"></i></span>
                <div>
                  <strong>{{ titulo(orden) }}</strong>
                  <span>{{ cliente(orden) }}</span>
                </div>
              </div>

              <div class="row g-3">
                <div class="col-6">
                  <span class="panel-kicker">Entrega</span>
                  <strong class="d-block">{{ fechaEntrega(orden) }}</strong>
                </div>
                <div class="col-6">
                  <span class="panel-kicker">Prioridad</span>
                  <span class="badge" [class]="clasePrioridad(orden)">{{ prioridad(orden) }}</span>
                </div>
                <div class="col-6">
                  <span class="panel-kicker">Responsable</span>
                  <strong class="d-block">{{ orden.responsable || 'Sin asignar' }}</strong>
                </div>
                <div class="col-6">
                  <span class="panel-kicker">Inicio</span>
                  <strong class="d-block">{{ fechaHora(orden.fechaInicio) }}</strong>
                </div>
              </div>

              <div class="stage-list mt-3">
                @for (etapa of orden.historialEtapas; track etapa.id) {
                  <div class="stage-list-item" [class.is-done]="etapa.estado === 'completada'" [class.is-active]="etapa.estado === 'en-proceso'">
                    <span class="stage-list-dot"><i class="bi" [class]="'bi ' + iconoEtapa(etapa.etapa)"></i></span>
                    <div class="flex-grow-1 min-w-0">
                      <strong>{{ etiquetaEtapa(etapa.etapa) }}</strong>
                      <small>
                        {{ etapa.responsable || 'Sin responsable' }} ·
                        {{ etapa.fin ? fechaHora(etapa.fin) : etapa.inicio ? fechaHora(etapa.inicio) : 'Programado' }}
                      </small>
                    </div>
                    <span class="badge" [class]="etapa.estado === 'completada' ? 'badge-soft-success' : etapa.estado === 'en-proceso' ? 'badge-soft-cyan' : 'badge-soft-muted'">
                      {{ etapa.estado }}
                    </span>
                  </div>
                } @empty {
                  <p class="text-muted mb-0 small">Sin historial de etapas.</p>
                }
              </div>

              <p class="table-note mt-3 mb-0">
                <i class="bi bi-journal-text"></i>
                {{ orden.observaciones || 'Sin observaciones registradas.' }}
              </p>
            </div>

            <div class="col-lg-7">
              @if (puedeGestionar()) {
                <form [formGroup]="ordenForm" (ngSubmit)="guardarCambios()">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label" for="prodEtapa">Etapa actual</label>
                      <select id="prodEtapa" class="form-select" formControlName="etapa">
                        @for (etapa of etapas; track etapa.valor) {
                          <option [value]="etapa.valor">{{ etapa.etiqueta }}</option>
                        }
                      </select>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label" for="prodEstado">Estado</label>
                      <select id="prodEstado" class="form-select" formControlName="estado">
                        @for (estado of estados; track estado.valor) {
                          <option [value]="estado.valor">{{ estado.etiqueta }}</option>
                        }
                      </select>
                    </div>
                    <div class="col-12">
                      <label class="form-label" for="prodObs">Observaciones</label>
                      <textarea id="prodObs" class="form-control" rows="2" formControlName="observaciones"></textarea>
                    </div>
                  </div>
                  <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-brand" type="submit" [disabled]="guardando()">
                      <i class="bi" [class]="guardando() ? 'bi-arrow-repeat spin' : 'bi-check2'"></i>
                      {{ guardando() ? 'Guardando…' : 'Guardar cambios' }}
                    </button>
                    @if (orden.estado !== 'completada') {
                      <button class="btn btn-outline-ink" type="button" [disabled]="guardando()" (click)="completar(orden)">
                        <i class="bi bi-flag"></i> Completar orden
                      </button>
                    }
                  </div>
                </form>
              }

              <div class="panel-head mt-4">
                <div>
                  <span class="panel-kicker">Checklist de calidad</span>
                  <h2>Controles de la orden</h2>
                </div>
                <span class="badge badge-soft-muted">{{ controlesDe(orden).length }} registros</span>
              </div>

              <div class="table-responsive">
                <table class="table table-llamma align-middle">
                  <thead>
                    <tr>
                      <th>Criterio</th>
                      <th>Resultado</th>
                      <th>Revisó</th>
                      <th class="text-end">Fecha</th>
                    </tr>
                  </thead>
                  <tbody>
                    @for (control of controlesDe(orden); track control.id) {
                      <tr>
                        <td>
                          <div class="cell-main">{{ control.criterio }}</div>
                          <div class="cell-muted">{{ control.observaciones || 'Sin observaciones' }}</div>
                        </td>
                        <td>
                          <span class="badge" [class]="control.aprobado ? 'badge-soft-success' : 'badge-soft-danger'">
                            {{ control.aprobado ? 'Aprobado' : 'Rechazado' }}
                          </span>
                        </td>
                        <td>{{ control.revisadoPor || '—' }}</td>
                        <td class="text-end cell-muted">{{ fechaHora(control.fecha) }}</td>
                      </tr>
                    } @empty {
                      <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                          Aún no hay controles registrados para esta orden.
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>

              @if (puedeGestionar()) {
                <form class="quality-form" [formGroup]="calidadForm" (ngSubmit)="registrarCalidad()">
                  <span class="panel-kicker">Nuevo control</span>
                  <div class="row g-2 mt-1">
                    <div class="col-md-6">
                      <input
                        class="form-control form-control-sm"
                        placeholder="Criterio: color, medidas, empaque…"
                        aria-label="Criterio de calidad"
                        formControlName="criterio"
                      />
                      @if (calidadForm.controls.criterio.invalid && calidadForm.controls.criterio.touched) {
                        <small class="text-danger">Describe el criterio a revisar.</small>
                      }
                    </div>
                    <div class="col-md-6">
                      <input
                        class="form-control form-control-sm"
                        placeholder="Observaciones"
                        aria-label="Observaciones de calidad"
                        formControlName="observaciones"
                      />
                    </div>
                    <div class="col-12 d-flex flex-wrap align-items-center gap-3">
                      <div class="form-check form-switch mb-0">
                        <input id="calidadAprobado" class="form-check-input" type="checkbox" formControlName="aprobado" />
                        <label class="form-check-label small" for="calidadAprobado">Aprobado</label>
                      </div>
                      <button class="btn btn-ink btn-sm ms-auto" type="submit" [disabled]="registrandoCalidad()">
                        <i class="bi" [class]="registrandoCalidad() ? 'bi-arrow-repeat spin' : 'bi-clipboard-check'"></i>
                        {{ registrandoCalidad() ? 'Registrando…' : 'Registrar control' }}
                      </button>
                    </div>
                  </div>
                </form>
              }
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-ink" type="button" (click)="cerrarDetalle()">Cerrar</button>
          <a class="btn btn-brand" routerLink="/detalle" [queryParams]="{ pedido: orden.pedidoId }">
            <i class="bi bi-receipt"></i> Ver pedido
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}
</file>

<file path="src/app/llamma/produccion/produccion.component.ts">
import { DatePipe } from '@angular/common';
import {
  ChangeDetectionStrategy,
  Component,
  OnInit,
  computed,
  inject,
  signal,
} from '@angular/core';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { finalize } from 'rxjs';

import { AuthService } from '../auth.service';
import {
  ControlCalidadApi,
  EtapaProduccion,
  EstadoProduccion,
  OrdenProduccionApi,
  PedidoApi,
  TableroProduccion,
} from '../llamma.models';
import { LlammaService } from '../llamma.service';
import { UiService } from '../ui.service';

const ETAPAS: Array<{
  valor: EtapaProduccion;
  etiqueta: string;
  icono: string;
  dot: string;
}> = [
  { valor: 'diseno', etiqueta: 'Preprensa', icono: 'bi-vector-pen', dot: 'dot-cyan' },
  { valor: 'impresion', etiqueta: 'Impresión', icono: 'bi-printer', dot: 'dot-magenta' },
  { valor: 'laminado', etiqueta: 'Laminado', icono: 'bi-layers', dot: 'dot-cyan' },
  { valor: 'corte', etiqueta: 'Corte', icono: 'bi-scissors', dot: 'dot-yellow' },
  { valor: 'confeccion', etiqueta: 'Confección', icono: 'bi-bag', dot: 'dot-magenta' },
  { valor: 'armado', etiqueta: 'Armado', icono: 'bi-tools', dot: 'dot-yellow' },
  { valor: 'acabado', etiqueta: 'Acabado', icono: 'bi-stars', dot: 'dot-ink' },
  { valor: 'entrega', etiqueta: 'Entrega', icono: 'bi-box-seam', dot: 'dot-ink' },
];

const ESTADOS: Array<{ valor: EstadoProduccion; etiqueta: string; badge: string }> = [
  { valor: 'pendiente', etiqueta: 'Pendiente', badge: 'badge-soft-muted' },
  { valor: 'en-proceso', etiqueta: 'En proceso', badge: 'badge-soft-cyan' },
  { valor: 'pausada', etiqueta: 'Pausada', badge: 'badge-soft-warning' },
  { valor: 'completada', etiqueta: 'Completada', badge: 'badge-soft-success' },
  { valor: 'rechazada', etiqueta: 'Rechazada', badge: 'badge-soft-danger' },
];

@Component({
  selector: 'app-produccion',
  imports: [DatePipe, ReactiveFormsModule, RouterLink],
  templateUrl: './produccion.component.html',
  styleUrl: './produccion.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class ProduccionComponent implements OnInit {
  private readonly service = inject(LlammaService);
  private readonly ui = inject(UiService);
  private readonly fb = inject(FormBuilder);
  readonly auth = inject(AuthService);

  readonly etapas = ETAPAS;
  readonly estados = ESTADOS;

  readonly tablero = signal<TableroProduccion | null>(null);
  readonly pedidos = signal<PedidoApi[]>([]);
  readonly cargando = signal(true);
  readonly error = signal<string | null>(null);
  readonly seleccionada = signal<OrdenProduccionApi | null>(null);
  readonly guardando = signal(false);
  readonly registrandoCalidad = signal(false);
  readonly moviendoId = signal<number | null>(null);

  readonly puedeGestionar = computed(() => this.auth.tieneRol('admin', 'produccion'));

  readonly ordenForm = this.fb.nonNullable.group({
    etapa: ['diseno' as EtapaProduccion, [Validators.required]],
    estado: ['pendiente' as EstadoProduccion, [Validators.required]],
    observaciones: [''],
  });

  readonly calidadForm = this.fb.nonNullable.group({
    criterio: ['', [Validators.required, Validators.minLength(3)]],
    aprobado: [true],
    observaciones: [''],
  });

  readonly pedidosPorId = computed(() => {
    const mapa = new Map<number, PedidoApi>();
    for (const pedido of this.pedidos()) mapa.set(pedido.id, pedido);
    return mapa;
  });

  readonly columnas = computed(() => {
    const tablero = this.tablero();
    const porEtapa = new Map<EtapaProduccion, OrdenProduccionApi[]>();
    for (const columna of tablero?.columnas ?? []) porEtapa.set(columna.etapa, columna.ordenes);
    return ETAPAS.map((etapa) => ({
      ...etapa,
      ordenes: porEtapa.get(etapa.valor) ?? [],
    }));
  });

  readonly ordenes = computed(() =>
    (this.tablero()?.columnas ?? []).flatMap((columna) => columna.ordenes),
  );

  readonly estadisticas = computed(() => {
    const columnas = this.columnas();
    const total = this.tablero()?.total ?? 0;
    const enImpresion = columnas.find((columna) => columna.valor === 'impresion')?.ordenes.length ?? 0;
    const enEntrega = columnas.find((columna) => columna.valor === 'entrega')?.ordenes.length ?? 0;
    const atencion = this.ordenes().filter(
      (orden) => orden.estado === 'pausada' || orden.estado === 'rechazada',
    ).length;
    return [
      {
        icono: 'bi-gear-wide-connected',
        tono: 'icon-tile-cyan',
        valor: this.dosDigitos(total),
        etiqueta: 'Órdenes activas',
      },
      {
        icono: 'bi-printer',
        tono: 'icon-tile-magenta',
        valor: this.dosDigitos(enImpresion),
        etiqueta: 'En etapa de impresión',
      },
      {
        icono: 'bi-exclamation-triangle',
        tono: atencion ? 'icon-tile-warning' : 'icon-tile-success',
        valor: this.dosDigitos(atencion),
        etiqueta: 'Órdenes que requieren atención',
      },
      {
        icono: 'bi-box-seam',
        tono: 'icon-tile-success',
        valor: this.dosDigitos(enEntrega),
        etiqueta: 'Listas para entrega',
      },
    ];
  });

  readonly resumenEtapas = computed(() => {
    const columnas = this.columnas();
    const maximo = Math.max(1, ...columnas.map((columna) => columna.ordenes.length));
    return columnas.map((columna) => {
      const total = columna.ordenes.length;
      return {
        ...columna,
        total,
        porcentaje: total === 0 ? 0 : Math.max(6, Math.round((total / maximo) * 100)),
      };
    });
  });

  readonly calidadReciente = computed(() => {
    const filas = this.ordenes().flatMap((orden) =>
      (orden.controlesCalidad ?? []).map((control) => ({
        control,
        folio: orden.pedidoFolio ?? `Orden ${orden.id}`,
        ordenId: orden.id,
      })),
    );
    return filas.sort((a, b) => String(b.control.fecha).localeCompare(String(a.control.fecha))).slice(0, 6);
  });

  readonly controlesPendientes = computed(
    () => this.calidadReciente().filter((fila) => !fila.control.aprobado).length,
  );

  readonly hoy = new Date();

  ngOnInit(): void {
    this.cargar();
    this.cargarPedidos();
  }

  cargar(seleccionarId?: number): void {
    this.cargando.set(true);
    this.error.set(null);
    this.service
      .tableroProduccion()
      .pipe(finalize(() => this.cargando.set(false)))
      .subscribe({
        next: (tablero) => {
          this.tablero.set(tablero);
          this.cargarDetalles(
            tablero.columnas.flatMap((columna) => columna.ordenes.map((orden) => orden.pedidoId)),
          );
          const objetivo =
            seleccionarId ?? this.seleccionada()?.id;
          if (objetivo) {
            const actual = tablero.columnas
              .flatMap((columna) => columna.ordenes)
              .find((orden) => orden.id === objetivo);
            this.seleccionada.set(actual ?? null);
            if (actual) this.sincronizarFormulario(actual);
          }
        },
        error: (error) => {
          this.error.set(this.ui.mensajeDeError(error, 'No pudimos cargar el tablero de producción.'));
        },
      });
  }

  private cargarPedidos(): void {
    this.service.listarPedidos({ page: 1, perPage: 100 }).subscribe({
      next: (respuesta) =>
        this.pedidos.update((actuales) =>
          respuesta.items.map((pedido) => {
            const previo = actuales.find((fila) => fila.id === pedido.id);
            return previo?.items?.length
              ? { ...pedido, items: previo.items, pagos: previo.pagos ?? pedido.pagos }
              : pedido;
          }),
        ),
      error: () => this.pedidos.set([]),
    });
  }

  private cargarDetalles(ids: number[]): void {
    const unicos = [...new Set(ids)];
    for (const id of unicos) {
      const conocido = this.pedidos().find((pedido) => pedido.id === id);
      if (conocido?.items?.length) continue;
      this.service.detallePedido(id).subscribe({
        next: (pedido) => {
          this.pedidos.update((lista) => [
            ...lista.filter((fila) => fila.id !== pedido.id),
            pedido,
          ]);
        },
        error: () => undefined,
      });
    }
  }

  pedidoDe(orden: OrdenProduccionApi): PedidoApi | undefined {
    return this.pedidosPorId().get(orden.pedidoId);
  }

  titulo(orden: OrdenProduccionApi): string {
    const pedido = this.pedidoDe(orden);
    const primero = pedido?.items?.[0];
    if (primero) {
      const extra = (pedido?.items?.length ?? 0) - 1;
      return extra > 0 ? `${primero.descripcion} +${extra} más` : primero.descripcion;
    }
    return `Orden ${orden.pedidoFolio ?? orden.id}`;
  }

  cliente(orden: OrdenProduccionApi): string {
    return this.pedidoDe(orden)?.cliente ?? 'Cliente sin asignar';
  }

  fechaEntrega(orden: OrdenProduccionApi): string {
    return this.fechaCorta(this.pedidoDe(orden)?.fechaEntrega);
  }

  prioridad(orden: OrdenProduccionApi): string {
    return this.pedidoDe(orden)?.prioridad ?? 'media';
  }

  clasePrioridad(orden: OrdenProduccionApi): string {
    const mapa: Record<string, string> = {
      baja: 'badge-soft-muted',
      media: 'badge-soft-cyan',
      alta: 'badge-soft-magenta',
      urgente: 'badge-soft-danger',
    };
    return mapa[this.prioridad(orden)] ?? 'badge-soft-muted';
  }

  progreso(orden: OrdenProduccionApi): number {
    const indice = ETAPAS.findIndex((etapa) => etapa.valor === orden.etapa);
    return Math.round(((indice + 1) / ETAPAS.length) * 100);
  }

  indiceEtapa(etapa: string): number {
    return ETAPAS.findIndex((fila) => fila.valor === etapa);
  }

  etiquetaEtapa(etapa: string): string {
    return ETAPAS.find((fila) => fila.valor === etapa)?.etiqueta ?? etapa;
  }

  iconoEtapa(etapa: string): string {
    return ETAPAS.find((fila) => fila.valor === etapa)?.icono ?? 'bi-circle';
  }

  dotEtapa(etapa: string): string {
    return `kanban-dot ${ETAPAS.find((fila) => fila.valor === etapa)?.dot ?? 'dot-ink'}`;
  }

  etiquetaEstado(estado: string): string {
    return ESTADOS.find((fila) => fila.valor === estado)?.etiqueta ?? estado;
  }

  claseEstado(estado: string): string {
    return ESTADOS.find((fila) => fila.valor === estado)?.badge ?? 'badge-soft-muted';
  }

  puedeAvanzar(orden: OrdenProduccionApi): boolean {
    return this.indiceEtapa(orden.etapa) < ETAPAS.length - 1;
  }

  puedeRetroceder(orden: OrdenProduccionApi): boolean {
    return this.indiceEtapa(orden.etapa) > 0;
  }

  mover(orden: OrdenProduccionApi, delta: number): void {
    const indice = this.indiceEtapa(orden.etapa);
    const destino = ETAPAS[indice + delta];
    if (!destino) return;
    this.moviendoId.set(orden.id);
    this.service
      .actualizarOrdenProduccion(orden.id, {
        etapa: destino.valor,
        estado: orden.estado === 'pendiente' ? 'en-proceso' : orden.estado,
      })
      .pipe(finalize(() => this.moviendoId.set(null)))
      .subscribe({
        next: (actualizada) => {
          this.ui.exito(`${actualizada.pedidoFolio}: ${this.etiquetaEtapa(actualizada.etapa)}.`);
          this.cargar();
        },
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos mover la orden de etapa.')),
      });
  }

  abrirDetalle(orden: OrdenProduccionApi): void {
    this.seleccionada.set(orden);
    this.sincronizarFormulario(orden);
    this.calidadForm.reset({ criterio: '', aprobado: true, observaciones: '' });
  }

  cerrarDetalle(): void {
    this.seleccionada.set(null);
  }

  private sincronizarFormulario(orden: OrdenProduccionApi): void {
    this.ordenForm.reset({
      etapa: orden.etapa,
      estado: orden.estado,
      observaciones: orden.observaciones ?? '',
    });
  }

  guardarCambios(): void {
    const orden = this.seleccionada();
    if (!orden || this.ordenForm.invalid) {
      this.ordenForm.markAllAsTouched();
      return;
    }
    const valores = this.ordenForm.getRawValue();
    this.guardando.set(true);
    this.service
      .actualizarOrdenProduccion(orden.id, {
        etapa: valores.etapa,
        estado: valores.estado,
        observaciones: valores.observaciones.trim() || undefined,
      })
      .pipe(finalize(() => this.guardando.set(false)))
      .subscribe({
        next: () => {
          this.ui.exito('Orden de producción actualizada.');
          this.cargar(orden.id);
        },
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos actualizar la orden.')),
      });
  }

  completar(orden: OrdenProduccionApi): void {
    if (
      !window.confirm(
        `¿Marcar ${orden.pedidoFolio ?? 'la orden'} como completada? El pedido se moverá a Listo.`,
      )
    )
      return;
    this.guardando.set(true);
    this.service
      .actualizarOrdenProduccion(orden.id, { estado: 'completada' })
      .pipe(finalize(() => this.guardando.set(false)))
      .subscribe({
        next: () => {
          this.ui.exito('Orden completada. El pedido está listo para entrega.');
          this.cargar(orden.id);
        },
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos completar la orden.')),
      });
  }

  registrarCalidad(): void {
    const orden = this.seleccionada();
    if (!orden) return;
    if (this.calidadForm.invalid) {
      this.calidadForm.markAllAsTouched();
      return;
    }
    const valores = this.calidadForm.getRawValue();
    this.registrandoCalidad.set(true);
    this.service
      .registrarCalidad(orden.id, {
        criterio: valores.criterio.trim(),
        aprobado: valores.aprobado,
        observaciones: valores.observaciones.trim() || undefined,
      })
      .pipe(finalize(() => this.registrandoCalidad.set(false)))
      .subscribe({
        next: (control) => {
          this.ui.exito(
            control.aprobado ? 'Control de calidad aprobado.' : 'Control de calidad registrado como rechazado.',
          );
          this.calidadForm.reset({ criterio: '', aprobado: true, observaciones: '' });
          this.cargar(orden.id);
        },
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos registrar el control de calidad.')),
      });
  }

  exportar(): void {
    const filas = [
      ['Pedido', 'Cliente', 'Etapa', 'Estado', 'Responsable', 'Entrega', 'Observaciones'],
      ...this.ordenes().map((orden) => [
        orden.pedidoFolio ?? String(orden.pedidoId),
        this.cliente(orden),
        this.etiquetaEtapa(orden.etapa),
        this.etiquetaEstado(orden.estado),
        orden.responsable ?? '',
        this.fechaEntrega(orden),
        orden.observaciones ?? '',
      ]),
    ];
    const csv = filas.map((fila) => fila.map((celda) => `"${celda}"`).join(',')).join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    const enlace = document.createElement('a');
    enlace.href = url;
    enlace.download = 'produccion-llamma.csv';
    enlace.click();
    URL.revokeObjectURL(url);
    this.ui.exito('Reporte de turno exportado en CSV.');
  }

  iniciales(nombre: string | null | undefined): string {
    return (nombre || 'LL')
      .split(' ')
      .filter(Boolean)
      .slice(0, 2)
      .map((parte) => parte[0])
      .join('')
      .toUpperCase();
  }

  fechaCorta(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    if (!fecha) return 'Sin fecha';
    return fecha.toLocaleDateString('es-MX', { day: '2-digit', month: 'short' });
  }

  fechaHora(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    if (!fecha) return 'Pendiente';
    return fecha.toLocaleString('es-MX', {
      day: '2-digit',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  controlesDe(orden: OrdenProduccionApi): ControlCalidadApi[] {
    return orden.controlesCalidad ?? [];
  }

  private aFecha(valor: string | null | undefined): Date | null {
    if (!valor) return null;
    const fecha = new Date(valor.length > 10 ? valor : `${valor}T00:00:00`);
    return Number.isNaN(fecha.getTime()) ? null : fecha;
  }

  private dosDigitos(valor: number): string {
    return String(valor).padStart(2, '0');
  }
}
</file>

<file path="src/app/llamma/productos/productos.component.css">
/* Catálogo público de productos. */

.catalog-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.catalog-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.filter-chip {
  padding: 0.4rem 0.85rem;
  border: 1px solid var(--llamma-line);
  border-radius: 999px;
  background: #fff;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  font-weight: 600;
}

.filter-chip.is-active {
  border-color: var(--llamma-cyan);
  background: rgba(var(--llamma-cyan-rgb), 0.1);
  color: var(--llamma-cyan-deep);
}

.catalog-search {
  display: flex;
  align-items: center;
  min-width: 15rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  overflow: hidden;
}

.catalog-search .input-group-text {
  border: 0;
  background: transparent;
  color: var(--llamma-muted);
}

.catalog-search .form-control {
  border: 0;
  box-shadow: none;
}

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  gap: 1rem;
}

.product-card {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  padding: 1.25rem;
  border: 1px solid var(--llamma-line);
  border-top: 4px solid var(--llamma-cyan);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.product-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.product-card h2 {
  margin: 0.2rem 0 0;
  font-size: 1rem;
  line-height: 1.3;
}

.product-card p {
  margin: 0;
  color: var(--llamma-muted);
  font-size: 0.74rem;
  line-height: 1.55;
}

.product-card-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 0.75rem;
  padding-top: 0.85rem;
  margin-top: auto;
  border-top: 1px solid var(--llamma-line);
}

.product-price span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.product-price strong {
  display: block;
  font-family: var(--llamma-font-display);
  font-size: 1.05rem;
  line-height: 1.2;
}

.product-price small {
  color: var(--llamma-muted);
  font-size: 0.64rem;
}

.catalog-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  padding: 3rem 1.5rem;
  text-align: center;
}

.catalog-empty i {
  font-size: 1.8rem;
  color: var(--llamma-cyan-deep);
}

.catalog-empty p {
  margin: 0;
  color: var(--llamma-muted);
  font-size: 0.8rem;
}

.catalog-error {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.8rem 1rem;
  border: 1px solid rgba(180, 35, 24, 0.2);
  border-radius: var(--llamma-radius-sm);
  background: rgba(180, 35, 24, 0.06);
  color: #b42318;
  font-size: 0.76rem;
}

.catalog-help {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
  padding: 1.6rem 1.8rem;
  margin-top: 2.5rem;
  border-radius: var(--llamma-radius);
  background: var(--llamma-carbon);
  color: #fff;
}

.catalog-help h2 {
  margin: 0.3rem 0 0.4rem;
  color: #fff;
  font-size: 1.35rem;
}

.catalog-help p {
  max-width: 40rem;
  margin: 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.78rem;
  line-height: 1.6;
}

.catalog-help .eyebrow {
  color: var(--llamma-yellow);
}

@media (max-width: 575.98px) {
  .catalog-search {
    width: 100%;
    min-width: 0;
  }

  .catalog-grid {
    grid-template-columns: 1fr;
  }
}

.campaign-cell {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  min-width: 14rem;
}

.campaign-cell strong {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
}

.campaign-cell small {
  display: block;
  margin-top: 0.12rem;
  color: var(--llamma-muted);
  font-size: 0.67rem;
}

.table-inactive {
  opacity: 0.6;
}

.productos-page .modal-body .table-llamma {
  font-size: 0.78rem;
}

.campaign-cell small {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
