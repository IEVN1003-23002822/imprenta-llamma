}

.payment-state small {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.66rem;
}

.payment-state-alerta {
  background: #fdf2f4;
}

.delivery-list {
  display: grid;
  gap: 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.delivery-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
}

.delivery-list i {
  margin-top: 0.12rem;
  color: var(--llamma-cyan-deep);
  font-size: 1rem;
}

.delivery-list strong {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
}

.delivery-list span {
  display: block;
  margin-top: 0.12rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
}

.file-list {
  display: grid;
  gap: 0.85rem;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.file-row strong {
  display: block;
  overflow: hidden;
  font-size: 0.76rem;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-row small {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.66rem;
}

@media (max-width: 575.98px) {
  .order-head {
    align-items: flex-start;
  }

  .order-emblem {
    width: 2.9rem;
    height: 2.9rem;
    font-size: 1.2rem;
  }

  .order-switcher-list {
    width: 100%;
  }

  .order-pill {
    flex: 1 1 auto;
  }
}

.pago-list {
  display: grid;
  gap: 0.55rem;
  margin-top: 0.9rem;
}

@media (max-width: 575.98px) {
  .seccion-detalle {
    display: none;
  }
}
