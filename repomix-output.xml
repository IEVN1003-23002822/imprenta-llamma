<file path="src/app/llamma/productos/productos.component.html">
<div class="module-page productos-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div class="page-brand">
        <img
          class="page-brand-logo"
          src="assets/images/logo-llamma.png"
          alt="Imprenta Llamma Logo"
          width="38"
          height="54"
        >
        <div>
          <span class="eyebrow">Catálogo público</span>
          <h1>Productos que podemos transformar.</h1>
          <p class="page-lead">
            Gran formato, textil, promocionales y papelería creativa. Explora el catálogo, elige tus
            piezas y solicita una cotización a tu medida. Los precios son referenciales y se confirman
            al revisar medidas, materiales y archivo de diseño.
          </p>
        </div>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-brand" routerLink="/cotizar">
          <i class="bi bi-send"></i> Solicitar cotización
        </a>
        @if (puedeGestionar()) {
          <button class="btn btn-outline-ink" type="button" (click)="abrirGestion()">
            <i class="bi bi-sliders"></i> Gestionar catálogo
          </button>
        } @else {
          <a class="btn btn-soft" routerLink="/login">
            <i class="bi bi-shield-lock"></i> Acceso equipo
          </a>
        }
      </div>
    </header>

    <section class="panel-card mb-4">
      <div class="catalog-toolbar">
        <div class="catalog-tabs" role="tablist" aria-label="Filtrar por línea de producción">
          @for (opcion of lineas; track opcion.clave) {
            <button
              class="filter-chip"
              type="button"
              [class.is-active]="linea() === opcion.clave"
              (click)="filtrarPor(opcion.clave)"
            >
              {{ opcion.etiqueta }}
            </button>
          }
        </div>

        <div class="catalog-search">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input
            type="search"
            class="form-control"
            placeholder="Buscar producto..."
            [value]="busqueda()"
            (input)="actualizarBusqueda($event)"
          >
        </div>
      </div>
    </section>

    @if (error()) {
      <div class="catalog-error mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>{{ error() }}</span>
      </div>
    }

    @if (cargando()) {
      <div class="panel-card catalog-empty">
        <i class="bi bi-arrow-repeat"></i>
        <p>Cargando catálogo...</p>
      </div>
    } @else if (!filtrados().length) {
      <div class="panel-card catalog-empty">
        <i class="bi bi-search"></i>
        <p>No encontramos productos con ese filtro. Prueba con otra línea o palabra.</p>
      </div>
    } @else {
      <div class="catalog-grid">
        @for (producto of filtrados(); track producto.id) {
          <article class="product-card">
            <div class="product-card-head">
              <span class="icon-tile icon-tile-cyan">
                <i class="bi {{ producto.icono || 'bi-box-seam' }}"></i>
              </span>
              <span class="badge badge-soft-muted">{{ etiquetaLinea(producto.lineaProduccion) }}</span>
            </div>

            <h2>{{ producto.nombre }}</h2>
            <p>{{ producto.descripcion || 'Producto personalizable según tu proyecto.' }}</p>

            <div class="product-card-footer">
              <div class="product-price">
                <span>Desde</span>
                <strong>{{ moneda(producto.precioBase) }}</strong>
                <small>por {{ unidad(producto.unidadVenta) }}</small>
              </div>
              <a
                class="btn btn-sm btn-brand"
                routerLink="/cotizar"
                [queryParams]="{ producto: producto.id }"
              >
                <i class="bi bi-plus-lg"></i> Cotizar
              </a>
            </div>
          </article>
        }
      </div>
    }

    <section class="catalog-help">
      <div class="catalog-help-text">
        <span class="eyebrow">¿No encuentras tu producto?</span>
        <h2>Lo desarrollamos contigo.</h2>
        <p>
          Cuéntanos qué necesitas y armamos una propuesta con materiales, acabados y tiempos de
          producción para tu proyecto.
        </p>
      </div>
      <a class="btn btn-yellow" routerLink="/cotizar">
        <i class="bi bi-chat-square-text"></i> Describir mi proyecto
      </a>
    </section>
  </div>
</div>

@if (gestionAbierta()) {
  <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="z-index: 1055">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <span class="panel-kicker">Catálogo interno</span>
            <div class="d-flex flex-wrap align-items-center gap-2">
              <h2 class="modal-title h5 mb-0">
                {{ vista() === 'formulario' ? (editando() ? 'Editar producto' : 'Nuevo producto') : 'Gestión de productos' }}
              </h2>
              <span class="badge badge-soft-muted">{{ resumenAdmin().total }} productos</span>
            </div>
          </div>
          <button class="btn btn-icon" type="button" aria-label="Cerrar" (click)="cerrarGestion()">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>

        <div class="modal-body">
          @if (vista() === 'lista') {
            <div class="row g-2 align-items-center mb-3">
              <div class="col-lg-6">
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-search"></i></span>
                  <input
                    type="search"
                    class="form-control"
                    placeholder="Buscar producto interno…"
                    aria-label="Buscar producto interno"
                    [value]="busquedaAdmin()"
                    (input)="actualizarBusquedaAdmin($event)"
                  />
                </div>
              </div>
              <div class="col-lg-6 d-flex flex-wrap align-items-center justify-content-lg-end gap-2">
                <span class="badge badge-soft-success">{{ resumenAdmin().publicados }} publicados</span>
                <span class="badge badge-soft-warning">{{ resumenAdmin().borradores }} borradores</span>
                <span class="badge badge-soft-danger">{{ resumenAdmin().inactivos }} inactivos</span>
                <button class="btn btn-brand btn-sm" type="button" (click)="abrirNuevo()">
                  <i class="bi bi-plus-lg"></i> Nuevo producto
                </button>
              </div>
            </div>

            <div class="table-responsive">
              <table class="table table-llamma align-middle">
                <thead>
                  <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Línea</th>
                    <th class="text-end">Precio base</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  @for (producto of filtradosAdmin(); track producto.id) {
                    <tr [class.table-inactive]="!producto.activo">
                      <td>
                        <div class="campaign-cell">
                          <span class="icon-tile icon-tile-sm icon-tile-cyan">
                            <i class="bi {{ producto.icono || 'bi-box-seam' }}"></i>
                          </span>
                          <div>
                            <strong>{{ producto.nombre }}</strong>
                            <small>{{ producto.descripcion || 'Sin descripción' }}</small>
                          </div>
                        </div>
                      </td>
                      <td>{{ etiquetaCategoria(producto.categoria) }}</td>
                      <td>{{ etiquetaLinea(producto.lineaProduccion) }}</td>
                      <td class="text-end cell-main">
                        {{ moneda(producto.precioBase) }}
                        <small class="cell-muted"> / {{ unidad(producto.unidadVenta) }}</small>
                      </td>
                      <td>
                        <div class="d-flex flex-wrap gap-1">
                          <span class="badge" [class]="producto.activo ? 'badge-soft-success' : 'badge-soft-danger'">
                            {{ producto.activo ? 'Activo' : 'Inactivo' }}
                          </span>
                          <span class="badge" [class]="producto.publicado ? 'badge-soft-cyan' : 'badge-soft-muted'">
                            {{ producto.publicado ? 'Publicado' : 'Borrador' }}
                          </span>
                          @if (producto.tieneReceta) {
                            <span class="badge badge-soft-warning">Receta</span>
                          }
                        </div>
                      </td>
                      <td class="text-end">
                        <div class="d-inline-flex gap-1">
                          <button
                            class="btn btn-icon"
                            type="button"
                            aria-label="Editar producto"
                            title="Editar producto"
                            (click)="abrirEditar(producto)"
                          >
                            <i class="bi bi-pencil"></i>
                          </button>
                          <button
                            class="btn btn-icon"
                            type="button"
                            [attr.aria-label]="producto.publicado ? 'Ocultar del catálogo' : 'Publicar en catálogo'"
                            [title]="producto.publicado ? 'Ocultar del catálogo' : 'Publicar en catálogo'"
                            [disabled]="cambiandoId() === producto.id || !producto.activo"
                            (click)="alternarPublicado(producto)"
                          >
                            <i class="bi" [class]="producto.publicado ? 'bi-eye-slash' : 'bi-eye'"></i>
                          </button>
                          <button
                            class="btn btn-icon"
                            type="button"
                            [attr.aria-label]="producto.activo ? 'Dar de baja' : 'Reactivar'"
                            [title]="producto.activo ? 'Dar de baja' : 'Reactivar'"
                            [disabled]="cambiandoId() === producto.id"
                            (click)="alternarActivo(producto)"
                          >
                            <i class="bi" [class]="producto.activo ? 'bi-trash3' : 'bi-arrow-counterclockwise'"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  } @empty {
                    <tr>
                      <td colspan="6" class="text-center text-muted py-5">
                        <i class="bi bi-box-seam d-block fs-4 mb-2"></i>
                        {{ cargandoAdmin() ? 'Cargando productos…' : 'No hay productos con esa búsqueda.' }}
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          } @else {
            <form [formGroup]="formulario" (ngSubmit)="guardar()" id="productoForm">
              <div class="row g-3">
                <div class="col-md-7">
                  <label class="form-label" for="prodNombre">Nombre *</label>
                  <input id="prodNombre" class="form-control" formControlName="nombre" />
                  @if (formulario.controls.nombre.invalid && formulario.controls.nombre.touched) {
                    <small class="text-danger">Indica al menos dos caracteres.</small>
                  }
                </div>
                <div class="col-md-5">
                  <label class="form-label" for="prodCategoria">Categoría</label>
                  <select id="prodCategoria" class="form-select" formControlName="categoria">
                    @for (categoria of categorias; track categoria.valor) {
                      <option [value]="categoria.valor">{{ categoria.etiqueta }}</option>
                    }
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label" for="prodDescripcion">Descripción</label>
                  <textarea id="prodDescripcion" class="form-control" rows="2" formControlName="descripcion"></textarea>
                </div>
                <div class="col-md-4">
                  <label class="form-label" for="prodLinea">Línea de producción</label>
                  <select id="prodLinea" class="form-select" formControlName="lineaProduccion">
                    @for (linea of lineas; track linea.clave) {
                      @if (linea.clave) {
                        <option [value]="linea.clave">{{ linea.etiqueta }}</option>
                      }
                    }
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label" for="prodPrecio">Precio base</label>
                  <input id="prodPrecio" type="number" min="0" step="0.01" class="form-control" formControlName="precioBase" />
                </div>
                <div class="col-md-4">
                  <label class="form-label" for="prodUnidad">Unidad de venta</label>
                  <select id="prodUnidad" class="form-select" formControlName="unidadVenta">
                    @for (unidad of unidadesForm; track unidad.valor) {
                      <option [value]="unidad.valor">{{ unidad.etiqueta }}</option>
                    }
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="prodIcono">Icono (Bootstrap Icons)</label>
                  <input id="prodIcono" class="form-control" formControlName="icono" placeholder="bi-box-seam" />
                </div>
                <div class="col-md-6 d-flex flex-wrap align-items-center gap-3 pt-md-4">
                  <div class="form-check form-switch mb-0">
                    <input id="prodPublicado" class="form-check-input" type="checkbox" formControlName="publicado" />
                    <label class="form-check-label small" for="prodPublicado">Visible en catálogo</label>
                  </div>
                  <div class="form-check form-switch mb-0">
                    <input id="prodActivo" class="form-check-input" type="checkbox" formControlName="activo" />
                    <label class="form-check-label small" for="prodActivo">Activo</label>
                  </div>
                </div>
              </div>

              <div class="quote-note mt-3 mb-0">
                <i class="bi bi-info-circle"></i>
                <span>
                  Los productos activos y publicados aparecen en el catálogo público. Las recetas e
                  insumos se administran desde producción para descontar stock.
                </span>
              </div>
            </form>
          }
        </div>

        <div class="modal-footer">
          @if (vista() === 'formulario') {
            <button class="btn btn-outline-ink" type="button" (click)="volverLista()">Volver</button>
            <button class="btn btn-brand" type="button" [disabled]="guardando()" (click)="guardar()">
              <i class="bi" [class]="guardando() ? 'bi-arrow-repeat spin' : 'bi-check2'"></i>
              {{ guardando() ? 'Guardando…' : 'Guardar producto' }}
            </button>
          } @else {
            <button class="btn btn-outline-ink" type="button" (click)="cerrarGestion()">Cerrar</button>
          }
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}
</file>

<file path="src/app/llamma/productos/productos.component.ts">
import {
  ChangeDetectionStrategy,
  Component,
  OnInit,
  computed,
  inject,
  signal,
} from '@angular/core';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { finalize } from 'rxjs';

import { AuthService } from '../auth.service';
import {
  CategoriaProducto,
  LineaProduccion,
  ProductoApi,
  ProductoPublico,
  UnidadMedida,
} from '../llamma.models';
import { LlammaService } from '../llamma.service';
import { UiService } from '../ui.service';

const LINEAS: { clave: LineaProduccion | ''; etiqueta: string }[] = [
  { clave: '', etiqueta: 'Todas las líneas' },
  { clave: 'gran-formato', etiqueta: 'Gran formato' },
  { clave: 'textil', etiqueta: 'Textil' },
  { clave: 'promocionales', etiqueta: 'Promocionales' },
  { clave: 'papeleria', etiqueta: 'Papelería' },
];

const CATEGORIAS: { valor: CategoriaProducto; etiqueta: string }[] = [
  { valor: 'display', etiqueta: 'Display' },
  { valor: 'senaletica', etiqueta: 'Señalética' },
  { valor: 'rotulacion', etiqueta: 'Rotulación' },
  { valor: 'bastidor', etiqueta: 'Bastidor' },
  { valor: 'textil', etiqueta: 'Textil' },
  { valor: 'promocional', etiqueta: 'Promocional' },
  { valor: 'papeleria', etiqueta: 'Papelería' },
  { valor: 'otro', etiqueta: 'Otro' },
];

const UNIDADES: Record<UnidadMedida, string> = {
  m2: 'm²',
  ml: 'ml',
  pieza: 'pieza',
  hoja: 'hoja',
  kg: 'kg',
  litro: 'litro',
};

const UNIDADES_FORM: Array<{ valor: UnidadMedida; etiqueta: string }> = [
  { valor: 'pieza', etiqueta: 'Pieza' },
  { valor: 'm2', etiqueta: 'Metro cuadrado (m²)' },
  { valor: 'ml', etiqueta: 'Metro lineal (ml)' },
  { valor: 'hoja', etiqueta: 'Hoja' },
  { valor: 'kg', etiqueta: 'Kilogramo' },
  { valor: 'litro', etiqueta: 'Litro' },
];

/** Catálogo público con gestión interna para admin y ventas. */
@Component({
  selector: 'app-productos',
  imports: [ReactiveFormsModule, RouterLink],
  templateUrl: './productos.component.html',
  styleUrl: './productos.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class ProductosComponent implements OnInit {
  private readonly service = inject(LlammaService);
  private readonly ui = inject(UiService);
  private readonly fb = inject(FormBuilder);
  readonly auth = inject(AuthService);

  readonly productos = signal<ProductoPublico[]>([]);
  readonly cargando = signal(true);
  readonly error = signal<string | null>(null);

  readonly linea = signal<LineaProduccion | ''>('');
  readonly busqueda = signal('');

  readonly lineas = LINEAS;
  readonly categorias = CATEGORIAS;
  readonly unidadesForm = UNIDADES_FORM;

  readonly puedeGestionar = computed(() => this.auth.tieneRol('admin', 'ventas'));

  readonly gestionAbierta = signal(false);
  readonly vista = signal<'lista' | 'formulario'>('lista');
  readonly admin = signal<ProductoApi[]>([]);
  readonly cargandoAdmin = signal(false);
  readonly busquedaAdmin = signal('');
  readonly editando = signal<ProductoApi | null>(null);
  readonly guardando = signal(false);
  readonly cambiandoId = signal<number | null>(null);

  readonly formulario = this.fb.nonNullable.group({
    nombre: ['', [Validators.required, Validators.minLength(2)]],
    descripcion: [''],
    categoria: ['otro' as CategoriaProducto, [Validators.required]],
    lineaProduccion: ['gran-formato' as LineaProduccion, [Validators.required]],
    precioBase: [0, [Validators.required, Validators.min(0)]],
    unidadVenta: ['pieza' as UnidadMedida, [Validators.required]],
    icono: ['bi-box-seam'],
    publicado: [true],
    activo: [true],
  });

  readonly filtrados = computed(() => {
    const texto = this.busqueda().trim().toLowerCase();
    return this.productos().filter((producto) => {
      const coincideLinea = !this.linea() || producto.lineaProduccion === this.linea();
      const coincideTexto =
        !texto ||
        producto.nombre.toLowerCase().includes(texto) ||
        (producto.descripcion ?? '').toLowerCase().includes(texto);
      return coincideLinea && coincideTexto;
    });
  });

  readonly filtradosAdmin = computed(() => {
    const texto = this.busquedaAdmin().trim().toLowerCase();
    if (!texto) return this.admin();
    return this.admin().filter((producto) =>
      [producto.nombre, producto.descripcion ?? '', producto.categoria, producto.lineaProduccion]
        .join(' ')
        .toLowerCase()
        .includes(texto),
    );
  });

  readonly resumenAdmin = computed(() => {
    const lista = this.admin();
    return {
      total: lista.length,
      publicados: lista.filter((producto) => producto.publicado && producto.activo).length,
      borradores: lista.filter((producto) => !producto.publicado && producto.activo).length,
      inactivos: lista.filter((producto) => !producto.activo).length,
    };
  });

  ngOnInit(): void {
    this.cargarPublico();
  }

  cargarPublico(): void {
    this.cargando.set(true);
    this.error.set(null);
    this.service.listarProductosPublicos().subscribe({
      next: (respuesta) => {
        this.productos.set(respuesta.items);
        this.cargando.set(false);
      },
      error: () => {
        this.error.set('No pudimos cargar el catálogo. Intenta de nuevo en un momento.');
        this.cargando.set(false);
      },
    });
  }

  filtrarPor(linea: LineaProduccion | ''): void {
    this.linea.set(linea);
  }

  actualizarBusqueda(evento: Event): void {
    this.busqueda.set((evento.target as HTMLInputElement).value);
  }

  abrirGestion(): void {
    this.gestionAbierta.set(true);
    this.vista.set('lista');
    this.busquedaAdmin.set('');
    this.editando.set(null);
    this.cargarAdmin();
  }

  cerrarGestion(): void {
    this.gestionAbierta.set(false);
    this.vista.set('lista');
    this.editando.set(null);
  }

  cargarAdmin(): void {
    this.cargandoAdmin.set(true);
    this.service
      .listarProductos()
      .pipe(finalize(() => this.cargandoAdmin.set(false)))
      .subscribe({
        next: (respuesta) => this.admin.set(respuesta.items),
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos cargar los productos internos.')),
      });
  }

  actualizarBusquedaAdmin(evento: Event): void {
    this.busquedaAdmin.set((evento.target as HTMLInputElement).value);
  }

  abrirNuevo(): void {
    this.editando.set(null);
    this.formulario.reset({
      nombre: '',
      descripcion: '',
      categoria: 'otro',
      lineaProduccion: 'gran-formato',
      precioBase: 0,
      unidadVenta: 'pieza',
      icono: 'bi-box-seam',
      publicado: true,
      activo: true,
    });
    this.vista.set('formulario');
  }

  abrirEditar(producto: ProductoApi): void {
    this.editando.set(producto);
    this.formulario.reset({
      nombre: producto.nombre,
      descripcion: producto.descripcion ?? '',
      categoria: producto.categoria,
      lineaProduccion: producto.lineaProduccion,
      precioBase: Number(producto.precioBase ?? 0),
      unidadVenta: producto.unidadVenta,
      icono: producto.icono ?? 'bi-box-seam',
      publicado: producto.publicado,
      activo: producto.activo,
    });
    this.vista.set('formulario');
  }

  volverLista(): void {
    this.vista.set('lista');
    this.editando.set(null);
  }

  guardar(): void {
    if (this.formulario.invalid) {
      this.formulario.markAllAsTouched();
      return;
    }
    const valores = this.formulario.getRawValue();
    const body: Record<string, unknown> = {
      nombre: valores.nombre.trim(),
      descripcion: valores.descripcion.trim() || null,
      categoria: valores.categoria,
      lineaProduccion: valores.lineaProduccion,
      precioBase: Number(valores.precioBase),
      unidadVenta: valores.unidadVenta,
      icono: valores.icono.trim() || 'bi-box-seam',
      publicado: valores.publicado,
      activo: valores.activo,
    };
    const edicion = this.editando();
    this.guardando.set(true);
    const peticion = edicion
      ? this.service.actualizarProducto(edicion.id, body)
      : this.service.crearProducto(body);
    peticion.pipe(finalize(() => this.guardando.set(false))).subscribe({
      next: () => {
        this.ui.exito(edicion ? 'Producto actualizado.' : 'Producto creado.');
        this.volverLista();
        this.cargarAdmin();
        this.cargarPublico();
      },
      error: (error) =>
        this.ui.error(this.ui.mensajeDeError(error, 'No pudimos guardar el producto.')),
    });
  }

  alternarPublicado(producto: ProductoApi): void {
    this.cambiandoId.set(producto.id);
    this.service
      .actualizarProducto(producto.id, { publicado: !producto.publicado })
      .pipe(finalize(() => this.cambiandoId.set(null)))
      .subscribe({
        next: (actualizado) => {
          this.actualizarEnLista(actualizado);
          this.ui.exito(
            actualizado.publicado
              ? `${actualizado.nombre} ya aparece en el catálogo.`
              : `${actualizado.nombre} se ocultó del catálogo.`,
          );
          this.cargarPublico();
        },
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos cambiar la publicación.')),
      });
  }

  alternarActivo(producto: ProductoApi): void {
    if (producto.activo) {
      if (
        !window.confirm(
          `¿Dar de baja ${producto.nombre}? Se ocultará del catálogo pero conservará su historial.`,
        )
      )
        return;
      this.cambiandoId.set(producto.id);
      this.service
        .desactivarProducto(producto.id)
        .pipe(finalize(() => this.cambiandoId.set(null)))
        .subscribe({
          next: () => {
            this.ui.exito('Producto dado de baja.');
            this.cargarAdmin();
            this.cargarPublico();
          },
          error: (error) =>
            this.ui.error(this.ui.mensajeDeError(error, 'No pudimos dar de baja el producto.')),
        });
      return;
    }

    this.cambiandoId.set(producto.id);
    this.service
      .actualizarProducto(producto.id, { activo: true })
      .pipe(finalize(() => this.cambiandoId.set(null)))
      .subscribe({
        next: (actualizado) => {
          this.actualizarEnLista(actualizado);
          this.ui.exito('Producto reactivado.');
          this.cargarPublico();
        },
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos reactivar el producto.')),
      });
  }

  private actualizarEnLista(producto: ProductoApi): void {
    this.admin.update((lista) =>
      lista.map((fila) => (fila.id === producto.id ? producto : fila)),
    );
  }

  moneda(valor: number): string {
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0,
    }).format(valor);
  }

  unidad(unidad: UnidadMedida): string {
    return UNIDADES[unidad] ?? unidad;
  }

  etiquetaLinea(linea: LineaProduccion | string): string {
    return LINEAS.find((opcion) => opcion.clave === linea)?.etiqueta ?? linea;
  }

  etiquetaCategoria(categoria: string): string {
    return CATEGORIAS.find((opcion) => opcion.valor === categoria)?.etiqueta ?? categoria;
  }
}
