<file path="src/app/llamma/solicitudes/solicitudes.component.html">
<div class="module-page solicitudes-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Bandeja comercial</span>
        <h1>Solicitudes entrantes.</h1>
        <p class="page-lead">
          Cada solicitud del portal llega aquí con su folio, partidas y archivos. Atiéndela,
          conviértela en cotización y da seguimiento al cliente sin salir del panel.
        </p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-ink" type="button" (click)="cargar()" [disabled]="cargando()">
          <i class="bi bi-arrow-clockwise"></i> Actualizar
        </button>
        <a class="btn btn-brand" routerLink="/captura">
          <i class="bi bi-plus-lg"></i> Nueva cotización
        </a>
      </div>
    </header>

    <div class="row g-3 mb-4">
      <div class="col-6 col-xl-3">
        <div class="inbox-stat inbox-stat-cyan">
          <span class="icon-tile icon-tile-cyan"><i class="bi bi-inbox"></i></span>
          <div>
            <strong>{{ nuevoConteo() }}</strong>
            <span>Solicitudes nuevas</span>
          </div>
        </div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="inbox-stat">
          <span class="icon-tile icon-tile-warning"><i class="bi bi-hourglass-split"></i></span>
          <div>
            <strong>{{ store.resumen().enRevision }}</strong>
            <span>En revisión</span>
          </div>
        </div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="inbox-stat">
          <span class="icon-tile icon-tile-magenta"><i class="bi bi-file-earmark-text"></i></span>
          <div>
            <strong>{{ store.resumen().porEstado.cotizada }}</strong>
            <span>Cotizadas</span>
          </div>
        </div>
      </div>
      <div class="col-6 col-xl-3">
        <div class="inbox-stat">
          <span class="icon-tile icon-tile-ink"><i class="bi bi-collection"></i></span>
          <div>
            <strong>{{ store.resumen().total }}</strong>
            <span>Total histórico</span>
          </div>
        </div>
      </div>
    </div>

    <section class="panel-card mb-4">
      <div class="filter-row">
        <div class="inbox-tabs" role="tablist" aria-label="Filtrar solicitudes por estado">
          @for (opcion of opciones; track opcion.clave) {
            <button
              class="filter-chip"
              type="button"
              [class.is-active]="estadoFiltro() === opcion.clave"
              (click)="filtrarPor(opcion.clave)"
            >
              {{ opcion.etiqueta }}
            </button>
          }
        </div>

        <div class="inbox-search">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input
              type="search"
              class="form-control"
              placeholder="Folio, cliente o correo..."
              [value]="texto()"
              (input)="actualizarTexto($event)"
              (keyup.enter)="buscar()"
            >
          </div>
          <button class="btn btn-ink" type="button" (click)="buscar()">
            <i class="bi bi-funnel-fill"></i> Buscar
          </button>
          @if (hayFiltros()) {
            <button class="btn btn-soft" type="button" aria-label="Limpiar filtros" (click)="limpiar()">
              <i class="bi bi-arrow-counterclockwise"></i>
            </button>
          }
        </div>
      </div>
    </section>

    @if (error()) {
      <div class="inbox-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>{{ error() }}</span>
      </div>
    }

    <div class="row g-4">
      <div class="col-xl-7">
        <section class="panel-card inbox-panel">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Bandeja</span>
              <h2>Solicitudes recibidas</h2>
            </div>
            <span class="badge badge-soft-muted">{{ total() }} resultados</span>
          </div>

          @if (cargando()) {
            <div class="inbox-loading">
              <i class="bi bi-arrow-repeat"></i>
              <span>Cargando solicitudes...</span>
            </div>
          } @else if (!solicitudes().length) {
            <div class="inbox-empty">
              <i class="bi bi-inbox"></i>
              <strong>Sin solicitudes para este filtro</strong>
              <p>Prueba con otro estado o limpia la búsqueda para ver toda la bandeja.</p>
            </div>
          } @else {
            <div class="request-list">
              @for (solicitud of solicitudes(); track solicitud.id) {
                <button
                  class="request-row"
                  type="button"
                  [class.is-active]="seleccionada()?.id === solicitud.id"
                  (click)="abrir(solicitud.id)"
                >
                  <span class="avatar avatar-magenta">{{ iniciales(solicitud.nombreCliente) }}</span>

                  <span class="request-main">
                    <span class="request-top">
                      <strong>{{ solicitud.nombreCliente }}</strong>
                      <span class="badge" [class]="claseEstado(solicitud.estado)">
                        {{ etiquetaEstado(solicitud.estado) }}
                      </span>
                    </span>
                    <span class="request-company">
                      {{ solicitud.empresa || 'Cliente particular' }} · {{ solicitud.folio }}
                    </span>
                    @if (solicitud.mensaje) {
                      <span class="request-preview">{{ solicitud.mensaje }}</span>
                    }
                    <span class="request-meta">
                      <span><i class="bi bi-box-seam"></i> {{ solicitud.totalItems ?? 0 }} partidas</span>
                      <span><i class="bi bi-paperclip"></i> {{ solicitud.totalArchivos ?? 0 }} archivos</span>
                      <span><i class="bi bi-calendar3"></i> {{ fechaHora(solicitud.fechaCreacion) }}</span>
                    </span>
                  </span>

                  <i class="bi bi-chevron-right request-chevron"></i>
                </button>
              }
            </div>

            @if (paginas() > 1) {
              <div class="inbox-pager">
                <button
                  class="btn btn-soft btn-sm"
                  type="button"
                  [disabled]="pagina() <= 1"
                  (click)="cambiarPagina(-1)"
                >
                  <i class="bi bi-arrow-left"></i> Anterior
                </button>
                <span>Página {{ pagina() }} de {{ paginas() }}</span>
                <button
                  class="btn btn-soft btn-sm"
                  type="button"
                  [disabled]="pagina() >= paginas()"
                  (click)="cambiarPagina(1)"
                >
                  Siguiente <i class="bi bi-arrow-right"></i>
                </button>
              </div>
            }
          }
        </section>
      </div>

      <div class="col-xl-5">
        @if (detalleCargando() || seleccionada()) {
          <button
            class="detail-backdrop"
            type="button"
            aria-label="Cerrar detalle de la solicitud"
            (click)="cerrarDetalle()"
          ></button>
        }

        @if (detalleCargando()) {
          <aside class="panel-card detail-panel detail-panel-open" role="region" aria-label="Detalle de la solicitud">
            <div class="inbox-loading">
              <i class="bi bi-arrow-repeat"></i>
              <span>Abriendo solicitud...</span>
            </div>
          </aside>
        } @else if (seleccionada(); as solicitud) {
          <aside class="panel-card detail-panel detail-panel-open" role="region" aria-label="Detalle de la solicitud">
            <div class="detail-head">
              <div>
                <span class="panel-kicker">Solicitud {{ solicitud.folio }}</span>
                <h2>{{ solicitud.nombreCliente }}</h2>
              </div>
              <button class="btn btn-icon" type="button" aria-label="Cerrar detalle" (click)="cerrarDetalle()">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>

            <div class="detail-state">
              <span class="badge" [class]="claseEstado(solicitud.estado)">
                {{ etiquetaEstado(solicitud.estado) }}
              </span>
              <select
                class="form-select form-select-sm"
                aria-label="Cambiar estado de la solicitud"
                [value]="solicitud.estado"
                [disabled]="accion() === 'estado'"
                (change)="cambiarEstado($any($event.target).value)"
              >
                <option value="nueva">Nueva</option>
                <option value="en-revision">En revisión</option>
                <option value="cotizada">Cotizada</option>
                <option value="convertida">Convertida</option>
                <option value="descartada">Descartada</option>
              </select>
            </div>

            <div class="detail-contact">
              <div><i class="bi bi-envelope"></i> <a [href]="'mailto:' + solicitud.correo">{{ solicitud.correo }}</a></div>
              @if (solicitud.telefono) {
                <div><i class="bi bi-telephone"></i> {{ solicitud.telefono }}</div>
              }
              <div><i class="bi bi-tag"></i> {{ solicitud.segmento }} · {{ solicitud.origen }}</div>
            </div>

            <div class="detail-actions">
              @if (solicitud.telefono) {
                <a
                  class="btn btn-sm btn-outline-ink"
                  [href]="whatsapp(solicitud.telefono)"
                  target="_blank"
                  rel="noopener"
                >
                  <i class="bi bi-whatsapp"></i> WhatsApp
                </a>
              }
              <a class="btn btn-sm btn-outline-ink" [href]="'mailto:' + solicitud.correo">
                <i class="bi bi-envelope"></i> Correo
              </a>
              <button class="btn btn-sm btn-outline-ink" type="button" (click)="copiarCorreo(solicitud.correo)">
                <i class="bi" [class.bi-clipboard]="!correoCopiado()" [class.bi-clipboard-check]="correoCopiado()"></i>
                {{ correoCopiado() ? 'Copiado' : 'Copiar correo' }}
              </button>
            </div>

            <div class="detail-grid">
              <div>
                <span>Recibida</span>
                <strong>{{ fechaHora(solicitud.fechaCreacion) }}</strong>
              </div>
              <div>
                <span>Entrega deseada</span>
                <strong>{{ fecha(solicitud.fechaDeseada) }}</strong>
              </div>
              <div>
                <span>Método</span>
                <strong>{{ solicitud.metodoEntrega }}</strong>
              </div>
              <div>
                <span>Partidas</span>
                <strong>{{ solicitud.itemsSolicitados?.length ?? 0 }}</strong>
              </div>
            </div>

            @if (solicitud.mensaje) {
              <div class="detail-message">
                <span class="panel-kicker">Mensaje del cliente</span>
                <p>{{ solicitud.mensaje }}</p>
              </div>
            }

            <div class="detail-items">
              <span class="panel-kicker">Partidas solicitadas</span>
              @for (item of solicitud.itemsSolicitados ?? []; track $index) {
                <div class="detail-item">
                  <div class="flex-grow-1 min-w-0">
                    <strong>{{ item.nombreProducto }}</strong>
                    <small>{{ item.especificaciones || 'Sin especificaciones' }}</small>
                  </div>
                  <span class="detail-qty">×{{ item.cantidad }}</span>
                  @if (item.precioEstimado) {
                    <strong class="detail-amount">{{ moneda(item.precioEstimado) }}</strong>
                  }
                </div>
              } @empty {
                <p class="detail-empty">El cliente no agregó productos; revisa su mensaje.</p>
              }
            </div>

            @if (solicitud.archivosAdjuntos?.length) {
              <div class="detail-files">
                <span class="panel-kicker">Archivos adjuntos</span>
                @for (archivo of solicitud.archivosAdjuntos; track archivo.id) {
                  <button class="file-row" type="button" (click)="descargar(archivo)">
                    <i class="bi bi-paperclip"></i>
                    <span class="file-row-name">{{ archivo.nombreOriginal }}</span>
                    <small>{{ tamano(archivo.tamanoBytes) }}</small>
                    <i class="bi bi-download"></i>
                  </button>
                }
              </div>
            }

            @if (aviso()) {
              <div class="inbox-success" role="status">
                <i class="bi bi-check2-circle"></i>
                <span>{{ aviso() }}</span>
              </div>
            }

            @if (errorAccion()) {
              <div class="inbox-alert" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>{{ errorAccion() }}</span>
              </div>
            }

            @if (cotizacionCreada(); as cotizacion) {
              <div class="conversion-result">
                <div class="conversion-head">
                  <i class="bi bi-file-earmark-check"></i>
                  <div>
                    <span class="panel-kicker">Cotización generada</span>
                    <strong>{{ cotizacion.folio }}</strong>
                  </div>
                  <span class="badge badge-soft-success">{{ moneda(cotizacion.total) }}</span>
                </div>
                <div class="conversion-totals">
                  <div><span>Subtotal</span><strong>{{ moneda(cotizacion.subtotal) }}</strong></div>
                  <div><span>IVA</span><strong>{{ moneda(cotizacion.impuestos) }}</strong></div>
                  <div><span>Anticipo 50%</span><strong>{{ moneda(cotizacion.anticipo) }}</strong></div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                  <button class="btn btn-sm btn-brand" type="button" (click)="abrirCotizacion(cotizacion)">
                    <i class="bi bi-pencil-square"></i> Abrir en cotizador
                  </button>
                  <a class="btn btn-sm btn-outline-ink" routerLink="/detalle">
                    <i class="bi bi-receipt"></i> Ver órdenes
                  </a>
                </div>
              </div>
            } @else if (solicitud.cotizacionId) {
              <div class="conversion-locked">
                <i class="bi bi-file-earmark-check"></i>
                <div>
                  <strong>Esta solicitud ya está cotizada</strong>
                  <span>Abre la cotización para revisar partidas o convertirla en pedido.</span>
                </div>
                <button class="btn btn-sm btn-ink" type="button" (click)="abrirCotizacion({ id: solicitud.cotizacionId })">
                  Abrir
                </button>
              </div>
            } @else {
              <div class="detail-cta">
                <button
                  class="btn btn-brand w-100"
                  type="button"
                  [disabled]="accion() === 'convertir'"
                  (click)="convertir()"
                >
                  @if (accion() === 'convertir') {
                    <i class="bi bi-hourglass-split"></i> Generando cotización...
                  } @else {
                    <i class="bi bi-lightning-charge"></i> Convertir en cotización
                  }
                </button>
                <button class="btn btn-outline-ink w-100" type="button" (click)="cotizarConDetalle()">
                  <i class="bi bi-sliders"></i> Revisar partidas y precios
                </button>
                <p class="detail-note">
                  <i class="bi bi-info-circle"></i>
