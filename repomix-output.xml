    @property
    def roi(self) -> float:
        inversion = float(self.inversion_real or 0)
        if inversion <= 0:
            return 0.0
        return round(float(self.ingresos_atribuidos or 0) / inversion, 2)

    def to_dict(self) -> dict:
        return {
            "id": self.id,
            "nombre": self.nombre,
            "canal": self.canal,
            "fechaInicio": self.fecha_inicio.isoformat() if self.fecha_inicio else None,
