.upload-box-compact strong {
  font-size: 0.72rem;
}

.file-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  margin-top: 1rem;
}

.file-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  max-width: 100%;
  padding: 0.35rem 0.55rem;
  border: 1px solid var(--llamma-line);
  border-radius: 999px;
  background: #fff;
  font-size: 0.66rem;
}

.file-chip > i {
  color: var(--llamma-cyan-deep);
}

.file-chip-name {
  max-width: 13rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-chip small {
  color: var(--llamma-muted);
}

.file-chip button {
  display: grid;
  place-items: center;
  width: 1.15rem;
  height: 1.15rem;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(26, 26, 26, 0.06);
  color: var(--llamma-carbon);
  font-size: 0.6rem;
}

/* --------------------------------- Resumen --------------------------------- */

.request-summary .summary-empty {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.8rem;
  border-radius: 0.7rem;
  background: rgba(26, 26, 26, 0.03);
  color: var(--llamma-muted);
}

.request-summary .summary-empty i {
  font-size: 1.1rem;
  color: var(--llamma-cyan-deep);
}

.request-summary .summary-empty p {
  margin: 0;
  font-size: 0.68rem;
  line-height: 1.45;
}

.request-note {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin: 0.9rem 0 1rem;
  padding: 0.7rem 0.8rem;
  border-left: 3px solid var(--llamma-yellow);
  background: rgba(var(--llamma-yellow-rgb), 0.12);
  color: #4a4a4a;
  font-size: 0.66rem;
  line-height: 1.5;
}

.request-note i {
  margin-top: 0.1rem;
}

.request-error {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-bottom: 0.9rem;
  padding: 0.65rem 0.75rem;
  border: 1px solid rgba(180, 35, 24, 0.26);
  border-radius: 0.7rem;
  background: #fdecec;
  color: #a01212;
  font-size: 0.7rem;
  line-height: 1.45;
}

.request-error i {
  margin-top: 0.1rem;
}

/* -------------------------------- Seguimiento ------------------------------ */

.tracking-card {
  margin-top: 2rem;
}

.tracking-result {
  margin-top: 1.2rem;
  padding-top: 1.2rem;
  border-top: 1px solid var(--llamma-line);
}

.tracking-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.tracking-head h3 {
  margin: 0.2rem 0 0;
  font-size: 1.05rem;
}

.tracking-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.75rem;
  margin-top: 1rem;
}

.tracking-grid > div {
  padding: 0.65rem 0.8rem;
  border-radius: 0.7rem;
  background: rgba(26, 26, 26, 0.03);
}

.tracking-grid span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.tracking-grid strong {
  display: block;
  margin-top: 0.2rem;
  font-size: 0.76rem;
}

.tracking-message {
  margin: 1rem 0 0;
  padding: 0.8rem 1rem;
  border-left: 3px solid var(--llamma-cyan);
  background: rgba(var(--llamma-cyan-rgb), 0.05);
  font-size: 0.76rem;
  line-height: 1.6;
}

.tracking-quote {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  margin-top: 1rem;
  padding: 0.8rem 1rem;
  border: 1px solid rgba(0, 174, 239, 0.25);
  border-radius: 0.75rem;
  background: rgba(var(--llamma-cyan-rgb), 0.07);
}

.tracking-quote > i {
  font-size: 1.3rem;
  color: var(--llamma-cyan-deep);
}

.tracking-quote strong {
  display: block;
  font-size: 0.8rem;
}

.tracking-quote span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.68rem;
}

/* --------------------------------- Responsive ------------------------------ */

@media (max-width: 991.98px) {
  .request-success-grid,
  .tracking-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 575.98px) {
  .request-success {
    padding: 1.4rem;
  }

  .request-success-grid,
  .tracking-grid {
    grid-template-columns: 1fr;
  }

  .upload-box {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .upload-box .btn {
    margin-left: 0 !important;
  }

  .picked-product {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .picked-price {
    text-align: left;
  }

  .cart-row {
    flex-wrap: wrap;
  }
}
