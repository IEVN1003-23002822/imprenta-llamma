.line-link i {
  color: var(--llamma-magenta);
}

.line-link:hover {
  color: var(--llamma-magenta);
}

/* CTA final */
.cta-section {
  padding: 0 0 5.5rem;
}

.cta-panel {
  position: relative;
  padding: clamp(2rem, 5vw, 4rem);
  overflow: hidden;
  border-radius: 2rem;
  background:
