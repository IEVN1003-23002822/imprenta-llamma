<div class="module-page detalle-page">
  <div class="llamma-container">
    <header class="page-header flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Órdenes y seguimiento</span>
        <h1>Detalle de órdenes.</h1>
        <p class="page-lead">Partidas, producción, pagos y entrega de la orden seleccionada.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button
          class="btn btn-outline-ink"
          type="button"
          (click)="imprimir()"
          [disabled]="!pedido()"
        >
          <i class="bi bi-printer"></i> Imprimir
        </button>
        @if (puedeGestionar()) {
          <a class="btn btn-brand" routerLink="/captura">
            <i class="bi bi-plus-lg"></i> Nuevo pedido
          </a>
        }
      </div>
    </header>

    <div class="order-switcher">
      <span class="order-switcher-label"
        ><i class="bi bi-clock-history"></i> Órdenes recientes</span
      >
      <div class="order-switcher-list">
        @if (cargandoLista()) {
          <span class="text-llamma-muted small inline-flex items-center gap-2">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Cargando…
          </span>
        } @else {
          @for (fila of pedidos(); track fila.id) {
            <button
              class="order-pill"
              type="button"
              [class.is-current]="fila.id === pedido()?.id"
              (click)="seleccionar(fila.id)"
            >
              #{{ fila.folio }} <span>{{ etiquetaEstado(fila.estado) }}</span>
            </button>
          } @empty {
            <span class="text-llamma-muted small">No hay órdenes registradas todavía.</span>
          }
        }
      </div>
    </div>

    @if (error()) {
      <div class="alert alert-danger flex items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="grow">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargarLista()">
          Reintentar
        </button>
      </div>
    }

    @if (cargandoDetalle() && !pedido()) {
      <div class="panel-card text-center py-12">
        <span class="spinner-border text-llamma-cyan-deep" role="status" aria-hidden="true"></span>
        <p class="mt-4 mb-0 text-llamma-muted">Cargando la orden…</p>
      </div>
    }

    @if (pedido(); as orden) {
      <section class="panel-card mb-6">
        <div class="order-head">
          <span class="order-emblem" aria-hidden="true"><i class="bi bi-receipt"></i></span>
          <div class="grow min-w-0">
            <span class="panel-kicker">Orden de producción</span>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="order-title">#{{ orden.folio }}</h2>
              <span class="badge" [class]="claseEstado(orden.estado)">{{
                etiquetaEstado(orden.estado)
              }}</span>
              <span class="badge" [class]="clasePrioridad(orden.prioridad)">{{
                etiquetaPrioridad(orden.prioridad)
              }}</span>
            </div>
          </div>
          @if (puedeGestionar()) {
            <div class="w-full sm:w-56">
              <label class="sr-only" for="estado-pedido">Estado del pedido</label>
              <select
                id="estado-pedido"
                class="form-select form-select-sm"
                [disabled]="guardandoEstado()"
                (change)="cambiarEstado($event)"
              >
                @for (estado of estados; track estado.valor) {
                  <option [value]="estado.valor" [selected]="estado.valor === orden.estado">
                    {{ estado.etiqueta }}
                  </option>
                }
              </select>
            </div>
          }
        </div>

        <div class="grid grid-cols-12 gap-4 order-meta">
          <div class="col-span-6 lg:col-span-3">
            <div class="order-meta-item">
              <span>Cliente</span>
              <strong>{{ cliente()?.nombre ?? orden.cliente ?? 'Mostrador' }}</strong>
              <small>
                {{ cliente()?.empresa || (cliente()?.segmento ?? 'particular') }}
                @if (cliente()?.rfc) {
                  · {{ cliente()!.rfc }}
                }
              </small>
            </div>
          </div>
          <div class="col-span-6 lg:col-span-3">
            <div class="order-meta-item">
              <span>Fecha de alta</span>
              <strong>{{ fechaCorta(orden.fechaPedido) }}</strong>
              <small>
                @if (orden.cotizacionId) {
                  Cotización #{{ orden.cotizacionId }}
                } @else {
                  Pedido directo
                }
              </small>
            </div>
          </div>
          <div class="col-span-6 lg:col-span-3">
            <div class="order-meta-item">
              <span>Entrega comprometida</span>
              <strong>{{ fechaCorta(orden.fechaEntrega) }}</strong>
              <small>{{ textoEntrega() }}</small>
            </div>
          </div>
          <div class="col-span-6 lg:col-span-3">
            <div class="order-meta-item">
              <span>Responsable</span>
              <strong>{{ orden.ordenProduccion?.responsable || 'Sin asignar' }}</strong>
              <small>
                {{
                  orden.ordenProduccion
                    ? 'Etapa: ' + (etapas()[etapaActual() - 1]?.etiqueta ?? 'Diseño')
                    : 'Sin orden de producción'
                }}
              </small>
            </div>
          </div>
        </div>
      </section>

      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 xl:col-span-8 order-2 xl:order-1 flex flex-col gap-6">
          <section class="panel-card">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Partidas del pedido</span>
                <h2>Productos y especificaciones</h2>
              </div>
              <span class="badge badge-soft-cyan">
                {{ partidas().length }} partidas · {{ totalPiezas() }} piezas
              </span>
            </div>

            <div class="table-responsive">
              <table class="table table-llamma align-middle">
                <caption class="sr-only">
                  Partidas del pedido
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Producto</th>
                    <th scope="col">Especificación</th>
                    <th scope="col" class="text-center">Cant.</th>
                    <th scope="col" class="text-right">P. unitario</th>
                    <th scope="col" class="text-right">Importe</th>
                  </tr>
                </thead>
                <tbody>
                  @for (item of partidas(); track item.id) {
                    <tr>
                      <td>
                        <div class="product-cell">
                          <span class="icon-tile icon-tile-sm icon-tile-cyan"
                            ><i class="bi bi-box"></i
                          ></span>
                          <div>
                            <strong>{{ item.descripcion }}</strong>
                            @if (item.archivoDiseno) {
                              <small><i class="bi bi-paperclip"></i> Con archivo de diseño</small>
                            }
                          </div>
                        </div>
                      </td>
                      <td>
                        <div class="cell-main">
                          {{ item.especificaciones || 'Sin especificaciones' }}
                        </div>
                      </td>
                      <td class="text-center">{{ item.cantidad }}</td>
                      <td class="text-right">{{ moneda(item.precioUnitario) }}</td>
                      <td class="text-right cell-main">{{ moneda(item.importe) }}</td>
                    </tr>
                  } @empty {
                    <tr>
                      <td colspan="5" class="text-center text-llamma-muted py-6">
                        Esta orden no tiene partidas registradas.
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>

            <p
              class="table-hint mt-3 flex items-center gap-2 text-[0.68rem] text-llamma-muted sm:hidden"
            >
              <i class="bi bi-arrow-left-right"></i> Desliza para ver cantidades e importes.
            </p>

            <p class="table-note">
              <i class="bi bi-palette"></i>
              Los acabados especiales se confirman al aprobar el archivo final de preprensa.
            </p>
          </section>

          <section class="panel-card">
            <h2 class="seccion-cabecera">
              <button
                class="seccion-toggle"
                type="button"
                aria-controls="detalle-produccion"
                [attr.aria-expanded]="estaAbierta('produccion')"
                (click)="alternarSeccion('produccion')"
              >
                <span class="seccion-identidad">
                  <span class="panel-kicker">Trazabilidad</span>
                  <span class="seccion-titulo">Seguimiento de producción</span>
                </span>
                <span class="seccion-resumen">
                  <span class="badge badge-soft-warning">
                    Etapa {{ etapaActual() }} de {{ etapas().length || 0 }}
                  </span>
                  <span class="seccion-detalle">{{
                    etapaEnProceso() ?? 'Sin etapa en proceso'
                  }}</span>
                  <i
                    class="bi bi-chevron-down seccion-chevron"
                    [class.is-open]="estaAbierta('produccion')"
                    aria-hidden="true"
                  ></i>
                </span>
              </button>
            </h2>

            @if (estaAbierta('produccion')) {
              <div id="detalle-produccion" class="seccion-cuerpo">
                <ol class="timeline">
                  @for (etapa of etapas(); track etapa.id) {
                    <li class="timeline-item" [class]="etapa.clase">
                      <span class="timeline-dot"
                        ><i class="bi" [class]="'bi ' + etapa.icono"></i
                      ></span>
                      <div class="timeline-body">
                        <div class="timeline-top">
                          <strong>{{ etapa.etiqueta }}</strong>
                          <span>
                            {{
                              etapa.clase === 'is-pending'
                                ? 'Programado'
                                : fechaHora(etapa.fin || etapa.inicio)
                            }}
                          </span>
                        </div>
                        <p>
                          {{ etapa.responsable || 'Sin responsable' }} ·
                          {{ etapa.estado.replace('-', ' ') }}
                          @if (etapa.notas) {
                            · {{ etapa.notas }}
                          }
                        </p>
                      </div>
                    </li>
                  } @empty {
                    <li class="text-llamma-muted">
                      Aún no hay etapas registradas para esta orden.
                    </li>
                  }
                </ol>
              </div>
            }
          </section>

          @if (controles().length) {
            <section class="panel-card">
              <h2 class="seccion-cabecera">
                <button
                  class="seccion-toggle"
                  type="button"
                  aria-controls="detalle-calidad"
                  [attr.aria-expanded]="estaAbierta('calidad')"
                  (click)="alternarSeccion('calidad')"
                >
                  <span class="seccion-identidad">
                    <span class="panel-kicker">Control de calidad</span>
                    <span class="seccion-titulo">Revisiones de la orden</span>
                  </span>
                  <span class="seccion-resumen">
                    <span class="badge badge-soft-muted">
                      {{ controles().length }}
                      {{ controles().length === 1 ? 'revisión' : 'revisiones' }}
                    </span>
                    @if (controlesRechazados()) {
                      <span class="seccion-detalle">
                        {{
                          controlesRechazados() === 1
                            ? '1 rechazada'
                            : controlesRechazados() + ' rechazadas'
                        }}
                      </span>
                    }
                    <i
                      class="bi bi-chevron-down seccion-chevron"
                      [class.is-open]="estaAbierta('calidad')"
                      aria-hidden="true"
                    ></i>
                  </span>
                </button>
              </h2>

              @if (estaAbierta('calidad')) {
                <div id="detalle-calidad" class="seccion-cuerpo table-responsive">
                  <table class="table table-llamma align-middle mb-0">
                    <caption class="sr-only">
                      Controles de calidad del pedido
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Criterio</th>
                        <th scope="col">Resultado</th>
                        <th scope="col">Revisó</th>
                        <th scope="col" class="text-right">Fecha</th>
                      </tr>
                    </thead>
                    <tbody>
                      @for (control of controles(); track control.id) {
                        <tr>
                          <td>
                            <div class="cell-main">{{ control.criterio }}</div>
                            <div class="cell-muted">
                              {{ control.observaciones || 'Sin observaciones' }}
                            </div>
                          </td>
                          <td>
                            <span
                              class="badge"
                              [class]="
                                control.aprobado ? 'badge-soft-success' : 'badge-soft-danger'
                              "
                            >
                              {{ control.aprobado ? 'Aprobado' : 'Rechazado' }}
                            </span>
                          </td>
                          <td>{{ control.revisadoPor || '—' }}</td>
                          <td class="text-right cell-muted">{{ fechaHora(control.fecha) }}</td>
                        </tr>
                      }
                    </tbody>
                  </table>
                </div>
              }
            </section>
          }
          <div class="grid grid-cols-12 gap-6">
            <section class="col-span-12 md:col-span-6 panel-card">
              <h2 class="seccion-cabecera">
                <button
                  class="seccion-toggle"
                  type="button"
                  aria-controls="detalle-entrega"
                  [attr.aria-expanded]="estaAbierta('entrega')"
                  (click)="alternarSeccion('entrega')"
                >
                  <span class="seccion-identidad">
                    <span class="panel-kicker">Logística</span>
                    <span class="seccion-titulo">Datos de entrega</span>
                  </span>
                  <span class="seccion-resumen">
                    <span class="seccion-detalle">{{ textoEntrega() }}</span>
                    <i
                      class="bi bi-chevron-down seccion-chevron"
                      [class.is-open]="estaAbierta('entrega')"
                      aria-hidden="true"
                    ></i>
                  </span>
                </button>
              </h2>

              @if (estaAbierta('entrega')) {
                <ul id="detalle-entrega" class="delivery-list seccion-cuerpo">
                  <li>
                    <i class="bi bi-geo-alt"></i>
                    <div>
                      <strong>{{ cliente()?.direccion || 'Dirección por confirmar' }}</strong>
                      <span>{{ cliente()?.empresa || cliente()?.nombre || 'Cliente' }}</span>
                    </div>
                  </li>
                  <li>
                    <i class="bi bi-truck"></i>
                    <div>
                      <strong>Entrega: {{ fechaCorta(orden.fechaEntrega) }}</strong>
                      <span>Recepción de 9:00 a 18:00 h</span>
                    </div>
                  </li>
                </ul>
              }
            </section>

            <section class="col-span-12 md:col-span-6 panel-card">
              <h2 class="seccion-cabecera">
                <button
                  class="seccion-toggle"
                  type="button"
                  aria-controls="detalle-archivos"
                  [attr.aria-expanded]="estaAbierta('archivos')"
                  (click)="alternarSeccion('archivos')"
                >
                  <span class="seccion-identidad">
                    <span class="panel-kicker">Documentos</span>
                    <span class="seccion-titulo">Archivos del pedido</span>
                  </span>
                  <span class="seccion-resumen">
                    <span class="badge badge-soft-muted">{{ archivos().length }}</span>
                    <i
                      class="bi bi-chevron-down seccion-chevron"
                      [class.is-open]="estaAbierta('archivos')"
                      aria-hidden="true"
                    ></i>
                  </span>
                </button>
              </h2>

              @if (estaAbierta('archivos')) {
                <div id="detalle-archivos" class="file-list seccion-cuerpo">
                  @for (archivo of archivos(); track archivo.nombre + archivo.descripcion) {
                    <div class="file-row">
                      <span class="icon-tile icon-tile-sm icon-tile-magenta"
                        ><i class="bi bi-file-earmark-image"></i
                      ></span>
                      <div class="grow min-w-0">
                        <strong>{{ archivo.nombre }}</strong>
                        <small>{{ archivo.descripcion }}</small>
                      </div>
                      <a
                        class="btn btn-icon"
                        [href]="archivo.ruta"
                        target="_blank"
                        rel="noopener"
                        aria-label="Abrir archivo"
                      >
                        <i class="bi bi-box-arrow-up-right"></i>
                      </a>
                    </div>
                  } @empty {
                    <p class="text-llamma-muted mb-0 small">
                      Esta orden no tiene archivos adjuntos. Los diseños se cargan desde la
                      solicitud.
                    </p>
                  }
                </div>
              }
            </section>
          </div>
        </div>

        <div
          class="col-span-12 xl:col-span-4 order-1 xl:order-2 flex flex-col gap-6 summary-sidebar"
        >
          <aside class="order-summary">
            <div class="quote-summary-head">
              <span>Resumen del pedido</span>
              <span class="badge" [class]="claseEstado(orden.estado)">{{
                etiquetaEstado(orden.estado)
              }}</span>
            </div>

            <div class="summary-client">
              <span class="avatar avatar-magenta">{{
                iniciales(cliente()?.nombre ?? orden.cliente)
              }}</span>
              <div>
                <strong>{{ cliente()?.nombre ?? orden.cliente ?? 'Mostrador' }}</strong>
                <small>
                  {{ cliente()?.telefono || 'Sin teléfono' }} ·
                  {{ cliente()?.correo || 'Sin correo' }}
                </small>
              </div>
            </div>

            <div class="summary-totals">
              <div>
                <span>Subtotal</span><strong>{{ moneda(orden.subtotal) }}</strong>
              </div>
              <div>
                <span>IVA (16%)</span><strong>{{ moneda(orden.impuestos) }}</strong>
              </div>
              <div class="summary-total">
                <span>Total</span><strong>{{ moneda(orden.total) }}</strong>
              </div>
              <div>
                <span>Anticipo recibido</span><strong>{{ moneda(orden.anticipo) }}</strong>
              </div>
              <div>
                <span>Saldo pendiente</span><strong>{{ moneda(orden.saldo) }}</strong>
              </div>
            </div>

            <div class="payment-state" [class.payment-state-alerta]="!estadoPago().ok">
              <span
                class="icon-tile icon-tile-sm"
                [class]="
                  estadoPago().ok
                    ? 'icon-tile icon-tile-sm icon-tile-success'
                    : 'icon-tile icon-tile-sm icon-tile-danger'
                "
              >
                <i
                  class="bi"
                  [class]="estadoPago().ok ? 'bi bi-shield-check' : 'bi bi-exclamation-circle'"
                ></i>
              </span>
              <div>
                <strong>{{ estadoPago().titulo }}</strong>
                <small>{{ estadoPago().detalle }}</small>
              </div>
            </div>

            @if (puedeGestionar() && orden.saldo > 0.01) {
              @if (!mostrarPago()) {
                <button class="btn btn-brand w-full" type="button" (click)="abrirPago()">
                  <i class="bi bi-cash-coin"></i> Registrar pago
                </button>
              } @else {
                <form class="mt-2" [formGroup]="pagoForm" (ngSubmit)="registrarPago()">
                  <div class="grid grid-cols-12 gap-2">
                    <div class="col-span-6">
                      <label class="form-label small font-semibold" for="pago-tipo">Tipo</label>
                      <select
                        id="pago-tipo"
                        class="form-select form-select-sm"
                        formControlName="tipo"
                      >
                        <option value="anticipo">Anticipo</option>
                        <option value="abono">Abono</option>
                        <option value="saldo">Liquidación</option>
                      </select>
                    </div>
                    <div class="col-span-6">
                      <label class="form-label small font-semibold" for="pago-metodo">Método</label>
                      <select
                        id="pago-metodo"
                        class="form-select form-select-sm"
                        formControlName="metodo"
                      >
                        <option value="transferencia">Transferencia</option>
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="cheque">Cheque</option>
                      </select>
                    </div>
                    <div class="col-span-6">
                      <label class="form-label small font-semibold" for="pago-monto">Monto</label>
                      <input
                        id="pago-monto"
                        class="form-control form-control-sm"
                        type="number"
                        min="1"
                        step="0.01"
                        formControlName="monto"
                      />
                      @if (pagoForm.controls.monto.invalid && pagoForm.controls.monto.touched) {
                        <small class="text-red-600">Indica un monto mayor a cero.</small>
                      }
                    </div>
                    <div class="col-span-6">
                      <label class="form-label small font-semibold" for="pago-referencia"
                        >Referencia</label
                      >
                      <input
                        id="pago-referencia"
                        class="form-control form-control-sm"
                        type="text"
                        formControlName="referencia"
                        placeholder="SPEI, folio…"
                      />
                    </div>
                  </div>
                  <div class="flex gap-2 mt-2">
                    <button
                      class="btn btn-brand btn-sm grow"
                      type="submit"
                      [disabled]="registrandoPago()"
                    >
                      <i
                        class="bi"
                        [class]="registrandoPago() ? 'bi-arrow-repeat spin' : 'bi-check2'"
                      ></i>
                      {{ registrandoPago() ? 'Guardando…' : 'Confirmar pago' }}
                    </button>
                    <button
                      class="btn btn-outline-ink btn-sm"
                      type="button"
                      (click)="mostrarPago.set(false)"
                    >
                      Cancelar
                    </button>
                  </div>
                </form>
              }
            }

            @if (pagos().length) {
              <div class="seccion-bloque">
                <h2 class="seccion-cabecera">
                  <button
                    class="seccion-toggle seccion-toggle-compacta"
                    type="button"
                    aria-controls="detalle-pagos"
                    [attr.aria-expanded]="estaAbierta('pagos')"
                    (click)="alternarSeccion('pagos')"
                  >
                    <span class="seccion-identidad">
                      <span class="seccion-titulo">Pagos registrados</span>
                    </span>
                    <span class="seccion-resumen">
                      <span class="seccion-detalle">{{ moneda(pagado()) }}</span>
                      <i
                        class="bi bi-chevron-down seccion-chevron"
                        [class.is-open]="estaAbierta('pagos')"
                        aria-hidden="true"
                      ></i>
                    </span>
                  </button>
                </h2>

                @if (estaAbierta('pagos')) {
                  <div id="detalle-pagos" class="pago-list">
                    @for (pago of pagos(); track pago.id) {
                      <div class="flex items-start justify-between gap-2">
                        <div>
                          <strong class="small capitalize"
                            >{{ pago.tipo }} · {{ pago.metodo }}</strong
                          >
                          <small class="block text-llamma-muted">
                            {{ fechaHora(pago.fechaPago) }}
                            @if (pago.referencia) {
                              · {{ pago.referencia }}
                            }
                          </small>
                        </div>
                        <span class="font-semibold small">{{ moneda(pago.monto) }}</span>
                      </div>
                    }
                  </div>
                }
              </div>
            }
          </aside>
        </div>
      </div>
    }
  </div>
</div>
</file>

<file path="src/styles.css">
/* ==========================================================================
   LLAMMA · Sistema visual institucional
   Cian + Magenta + Amarillo proceso + Negro carbón
   ========================================================================== */

/* Tailwind CSS v4 + Flowbite.
   La base visual son las capas de Tailwind: `base` (preflight + tipografía),
   `components` (contenedor, navegación, formularios, tablas, modales) y
   `utilities`. Los componentes conservan los nombres de clase que usan las
   plantillas, pero ya no dependen de Bootstrap. */
@layer theme, base, components, utilities;
@import 'tailwindcss/theme.css' layer(theme);
@import 'tailwindcss/preflight.css' layer(base);
@import 'tailwindcss/utilities.css' layer(utilities);
@plugin 'flowbite/plugin' {
  forms: false;
}

@theme {
  --color-llamma-cyan: #00aeef;
  --color-llamma-cyan-deep: #008fca;
  --color-llamma-magenta: #ec008c;
  --color-llamma-yellow: #fff200;
  --color-llamma-carbon: #1a1a1a;
  --color-llamma-carbon-soft: #252525;
  --color-llamma-ink: #101010;
  --color-llamma-paper: #f5f4f0;
  --color-llamma-paper-deep: #edece6;
  --color-llamma-surface: #ffffff;
  --color-llamma-muted: #6d6e74;
  --color-llamma-line: #e4e2dc;

  --radius-llamma-sm: 0.85rem;
  --radius-llamma: 1.25rem;
  --radius-llamma-lg: 1.75rem;

  --font-sans: 'Inter', 'Segoe UI', sans-serif;
  --font-display: 'Space Grotesk', 'Segoe UI', sans-serif;

  --shadow-llamma-sm: 0 8px 24px rgba(26, 26, 26, 0.06);
  --shadow-llamma: 0 22px 60px rgba(26, 26, 26, 0.14);
}

:root {
  --llamma-cyan: #00aeef;
  --llamma-cyan-rgb: 0, 174, 239;
  --llamma-cyan-deep: #008fca;
  --llamma-magenta: #ec008c;
  --llamma-magenta-rgb: 236, 0, 140;
  --llamma-yellow: #fff200;
  --llamma-yellow-rgb: 255, 242, 0;
  --llamma-carbon: #1a1a1a;
  --llamma-carbon-soft: #252525;
  --llamma-ink: #101010;
  --llamma-paper: #f5f4f0;
  --llamma-paper-deep: #edece6;
  --llamma-surface: #ffffff;
  --llamma-muted: #6d6e74;
  --llamma-line: #e4e2dc;

  --llamma-radius-sm: 0.85rem;
  --llamma-radius: 1.25rem;
  --llamma-radius-lg: 1.75rem;
  --llamma-shadow-sm: 0 8px 24px rgba(26, 26, 26, 0.06);
  --llamma-shadow: 0 22px 60px rgba(26, 26, 26, 0.14);

  --llamma-font-display: 'Space Grotesk', 'Segoe UI', sans-serif;
  --llamma-font-body: 'Inter', 'Segoe UI', sans-serif;
}

/* --------------------------------------------------------------------------
   Base tipográfica
   Tailwind aplica su preflight; aquí se conservan los valores por defecto de
   Bootstrap que el diseño ya usaba (márgenes de títulos, párrafos y listas).
   -------------------------------------------------------------------------- */

@layer base {
  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  .h1,
  .h2,
  .h3,
  .h4,
  .h5,
  .h6 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-weight: 500;
    line-height: 1.2;
  }

  h1,
  .h1 {
    font-size: calc(1.375rem + 1.5vw);
  }

  h2,
  .h2 {
    font-size: calc(1.325rem + 0.9vw);
  }

  h3,
  .h3 {
    font-size: calc(1.3rem + 0.6vw);
  }

  h4,
  .h4 {
    font-size: calc(1.275rem + 0.3vw);
  }

  h5,
  .h5 {
    font-size: 1.25rem;
  }

  h6,
  .h6 {
    font-size: 1rem;
  }

  p {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  ul,
  ol {
    margin-top: 0;
    margin-bottom: 1rem;
    padding-left: 2rem;
  }

  ul {
    list-style: disc;
  }

  ol {
    list-style: decimal;
  }

  ul ul {
    list-style: circle;
  }

  dl,
  dd {
    margin-bottom: 0.5rem;
  }

  dd {
    margin-left: 0;
  }

  hr {
    margin: 1rem 0;
    color: inherit;
    border: 0;
    border-top: 1px solid;
    opacity: 0.25;
  }

  small,
  .small {
    font-size: 0.875em;
  }

  label {
    display: inline-block;
  }

  legend {
    float: left;
    width: 100%;
    padding: 0;
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
    line-height: inherit;
  }

  legend + * {
    clear: left;
  }

  table {
    caption-side: bottom;
    border-collapse: collapse;
  }

  th {
    text-align: inherit;
    text-align: -webkit-match-parent;
  }

  textarea {
    resize: vertical;
  }

  img,
  svg {
    display: inline-block;
    vertical-align: middle;
  }

  [role='button'] {
    cursor: pointer;
  }

  @media (min-width: 1200px) {
    h1,
    .h1 {
      font-size: 2.5rem;
    }

    h2,
    .h2 {
      font-size: 2rem;
    }

    h3,
    .h3 {
      font-size: 1.75rem;
    }

    h4,
    .h4 {
      font-size: 1.5rem;
    }
  }
}

/* --------------------------------------------------------------------------
   Componentes base
   Nombres de clase que conservan las plantillas, reescritos con los tokens de
   Llamma sobre la capa de componentes de Tailwind. Las utilidades y los estilos
   propios de cada componente pueden sobrescribirlos.
   -------------------------------------------------------------------------- */

@layer components {
  /* Contenedor y estructura */
  .llamma-container {
    width: 100%;
    padding-inline: 0.75rem;
    margin-inline: auto;
  }

  @media (min-width: 576px) {
    .llamma-container {
      max-width: 540px;
    }
  }

  @media (min-width: 768px) {
    .llamma-container {
      max-width: 720px;
    }
  }

  @media (min-width: 992px) {
    .llamma-container {
      max-width: 960px;
    }
  }

  @media (min-width: 1200px) {
    .llamma-container {
      max-width: 1140px;
    }
  }

  @media (min-width: 1400px) {
    .llamma-container {
      max-width: 1320px;
    }
  }

  .fade {
    transition: opacity 0.15s linear;
  }

  .fade:not(.show) {
    opacity: 0;
  }

  /* Navegación */
  .navbar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.5rem;
  }

  .navbar > .llamma-container {
    display: flex;
    flex-wrap: inherit;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-brand {
    padding-block: 0.3125rem;
    margin-right: 1rem;
    font-size: 1.25rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .navbar-nav {
    display: flex;
    flex-direction: column;
    padding-left: 0;
    margin-block: 0;
    list-style: none;
  }

  .navbar-collapse {
    flex-basis: 100%;
    flex-grow: 1;
    align-items: center;
  }

  .nav-link {
    display: block;
    padding: 0.5rem;
    color: inherit;
    text-decoration: none;
    background: none;
    border: 0;
    transition:
      color 0.15s ease-in-out,
      background-color 0.15s ease-in-out;
  }

  .navbar-toggler {
    padding: 0.25rem 0.75rem;
    font-family: inherit;
    font-size: 1.25rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.65);
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.375rem;
    transition: box-shadow 0.15s ease-in-out;
  }

  .navbar-toggler-icon {
    display: inline-block;
    width: 1.5em;
    height: 1.5em;
    vertical-align: middle;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.75%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100%;
  }

  @media (min-width: 992px) {
    .navbar-expand-lg {
      flex-wrap: nowrap;
      justify-content: flex-start;
    }

    .navbar-expand-lg .navbar-nav {
      flex-direction: row;
    }

    .navbar-expand-lg .navbar-collapse {
      display: flex !important;
      flex-basis: auto;
    }

    .navbar-expand-lg .navbar-toggler {
      display: none;
    }
  }

  @media (max-width: 991.98px) {
    .navbar-collapse:not(.show) {
      display: none;
    }

    .navbar-collapse.show {
      display: block;
    }

    .navbar-nav .dropdown-menu {
      position: static;
    }
  }

  /* Menús desplegables */
  .dropdown {
    position: relative;
  }

  .dropdown-toggle {
    white-space: nowrap;
  }

  .dropdown-toggle::after {
    display: inline-block;
    margin-left: 0.255em;
    vertical-align: 0.255em;
    content: '';
    border-top: 0.3em solid;
    border-right: 0.3em solid transparent;
    border-bottom: 0;
    border-left: 0.3em solid transparent;
  }

  .dropdown-menu {
    position: absolute;
    z-index: 1000;
    display: none;
    min-width: 10rem;
    padding: 0.5rem 0;
    margin: 0;
    font-size: 1rem;
    color: var(--llamma-carbon);
    text-align: left;
    list-style: none;
    background-color: #fff;
    background-clip: padding-box;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 0.375rem;
  }

  @media (min-width: 992px) {
    .navbar-expand-lg .navbar-nav .dropdown-menu {
      position: absolute;
      top: 100%;
      left: 0;
    }
  }

  .dropdown-menu.show {
    display: block;
  }

  .dropdown-menu-end {
    right: 0;
    left: auto;
  }

  .dropdown-item {
    display: block;
    width: 100%;
    padding: 0.25rem 1rem;
    clear: both;
    font-weight: 400;
    color: var(--llamma-carbon);
    text-align: inherit;
    text-decoration: none;
    white-space: nowrap;
    background-color: transparent;
    border: 0;
  }

  .dropdown-item:hover,
  .dropdown-item:focus {
    background-color: var(--llamma-paper-deep);
  }

  .dropdown-divider {
    height: 0;
    margin: 0.5rem 0;
    overflow: hidden;
    border-top: 1px solid var(--llamma-line);
    opacity: 0.25;
  }

  /* Botones */
  .btn {
    --llamma-btn-padding-y: 0.62rem;
    --llamma-btn-padding-x: 1.05rem;
    --llamma-btn-font-size: 1rem;
    --llamma-btn-font-weight: 600;
    --llamma-btn-border-radius: 0.72rem;
    display: inline-block;
    padding: var(--llamma-btn-padding-y) var(--llamma-btn-padding-x);
    font-family: inherit;
    font-size: var(--llamma-btn-font-size);
    font-weight: var(--llamma-btn-font-weight);
    line-height: 1.5;
    color: var(--llamma-btn-color, var(--llamma-carbon));
    text-align: center;
    text-decoration: none;
    vertical-align: middle;
    cursor: pointer;
    user-select: none;
    border: 1px solid var(--llamma-btn-border-color, transparent);
    border-radius: var(--llamma-btn-border-radius);
    background-color: var(--llamma-btn-bg, transparent);
    transition:
      color 0.15s ease-in-out,
      background-color 0.15s ease-in-out,
      border-color 0.15s ease-in-out,
      box-shadow 0.15s ease-in-out;
  }

  .btn:hover {
    color: var(--llamma-btn-hover-color, var(--llamma-btn-color, var(--llamma-carbon)));
    background-color: var(--llamma-btn-hover-bg, var(--llamma-btn-bg, transparent));
    border-color: var(--llamma-btn-hover-border-color, var(--llamma-btn-border-color, transparent));
  }

  .btn:disabled,
  .btn.disabled {
    pointer-events: none;
    opacity: 0.65;
  }

  .btn-sm {
    --llamma-btn-padding-y: 0.25rem;
    --llamma-btn-padding-x: 0.5rem;
    --llamma-btn-font-size: 0.875rem;
    --llamma-btn-border-radius: 0.25rem;
  }

  .btn-lg {
    --llamma-btn-padding-y: 0.5rem;
    --llamma-btn-padding-x: 1rem;
    --llamma-btn-font-size: 1.25rem;
    --llamma-btn-border-radius: 0.5rem;
  }

  .btn-outline-dark {
    --llamma-btn-color: #212529;
    --llamma-btn-border-color: #212529;
    --llamma-btn-hover-color: #fff;
    --llamma-btn-hover-bg: #212529;
    --llamma-btn-hover-border-color: #212529;
  }

  /* Formularios */
  .form-label {
    margin-bottom: 0.5rem;
  }

  .form-control {
    display: block;
    width: 100%;
    padding: 0.375rem 0.75rem;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--llamma-carbon);
    appearance: none;
    background-color: #fff;
    background-clip: padding-box;
    border: 1px solid var(--llamma-line);
    border-radius: 0.375rem;
    transition:
      border-color 0.15s ease-in-out,
      box-shadow 0.15s ease-in-out;
  }

  .form-control:focus {
    color: var(--llamma-carbon);
    background-color: #fff;
    border-color: #86b7fe;
    outline: 0;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
  }

  .form-control:disabled,
  .form-control[readonly] {
    background-color: #e9ecef;
    opacity: 1;
  }

  .form-control[type='file'] {
    overflow: hidden;
  }

  .form-select {
    display: block;
    width: 100%;
    padding: 0.375rem 2.25rem 0.375rem 0.75rem;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--llamma-carbon);
    appearance: none;
    background-color: #fff;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.75rem center;
    background-size: 16px 12px;
    border: 1px solid var(--llamma-line);
    border-radius: 0.375rem;
    transition:
      border-color 0.15s ease-in-out,
      box-shadow 0.15s ease-in-out;
  }

  .form-select:focus {
    border-color: #86b7fe;
    outline: 0;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
  }

  .form-select:disabled {
    background-color: #e9ecef;
  }

  .form-check {
    display: block;
    min-height: 1.5rem;
    padding-left: 1.5em;
    margin-bottom: 0.125rem;
  }

  .form-check .form-check-input {
    float: left;
    margin-left: -1.5em;
  }

  .form-check-input {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    margin-top: 0.25em;
    vertical-align: top;
    appearance: none;
    background-color: #fff;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    border: 1px solid var(--llamma-line);
    border-radius: 0.25em;
    print-color-adjust: exact;
  }

  .form-check-input[type='radio'] {
    border-radius: 50%;
  }

  .form-check-input:checked {
    background-color: var(--llamma-magenta);
    border-color: var(--llamma-magenta);
  }

  .form-check-input:checked[type='checkbox'] {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='none' stroke='%23fff' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='m6 10 3 3 6-6'/%3e%3c/svg%3e");
  }

  .form-check-input:checked[type='radio'] {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='2' fill='%23fff'/%3e%3c/svg%3e");
  }

  .form-check-input:disabled {
    pointer-events: none;
    filter: none;
    opacity: 0.5;
  }

  .form-check-label {
    display: inline-block;
  }

  .form-switch {
    padding-left: 2.5em;
  }

  .form-switch .form-check-input {
    width: 2em;
    margin-left: -2.5em;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='rgba%280, 0, 0, 0.25%29'/%3e%3c/svg%3e");
    background-position: left center;
    border-radius: 2em;
    transition: background-position 0.15s ease-in-out;
  }

  .form-switch .form-check-input:checked {
    background-position: right center;
  }

  .input-group {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    width: 100%;
  }

  .input-group > .form-control,
  .input-group > .form-select {
    position: relative;
    flex: 1 1 auto;
    width: 1%;
    min-width: 0;
  }

  .input-group > .form-control:focus,
  .input-group > .form-select:focus {
    z-index: 5;
  }

  .input-group .btn {
    position: relative;
    z-index: 2;
  }

  .input-group-text {
    display: flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--llamma-muted);
    text-align: center;
    white-space: nowrap;
    background-color: #f2f1ec;
    border: 1px solid var(--llamma-line);
    border-radius: 0.375rem;
  }

  .input-group > :not(:first-child) {
    margin-left: -1px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }

  .input-group > :not(:last-child) {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }

  /* Tablas */
  .table {
    width: 100%;
    margin-bottom: 1rem;
    color: var(--llamma-carbon);
    vertical-align: top;
    border-color: var(--llamma-line);
  }

  .table > :not(caption) > * > * {
    padding: 0.5rem;
    background-color: transparent;
    border-bottom: 1px solid var(--llamma-line);
  }

  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Paginación */
  .pagination {
    display: flex;
    padding-left: 0;
    margin-bottom: 1rem;
    font-size: 0.76rem;
    list-style: none;
  }

  .page-link {
    position: relative;
    display: block;
    padding: 0.375rem 0.75rem;
    color: var(--llamma-carbon);
    text-decoration: none;
    background-color: transparent;
    border: 1px solid var(--llamma-line);
    transition:
      color 0.15s ease-in-out,
      background-color 0.15s ease-in-out,
      border-color 0.15s ease-in-out,
      box-shadow 0.15s ease-in-out;
  }

  .page-link:hover {
    color: var(--llamma-magenta);
    background-color: rgba(var(--llamma-magenta-rgb), 0.06);
    border-color: var(--llamma-line);
  }

  .page-link:focus-visible {
    color: var(--llamma-magenta);
    background-color: rgba(var(--llamma-magenta-rgb), 0.06);
    outline: 0;
    box-shadow: 0 0 0 0.2rem rgba(var(--llamma-cyan-rgb), 0.15);
  }

  .page-item:not(:first-child) .page-link {
    margin-left: -1px;
  }

  .page-item.active .page-link {
    z-index: 3;
    color: #fff;
    background-color: var(--llamma-carbon);
    border-color: var(--llamma-carbon);
  }

  .page-item.disabled .page-link {
    color: #b8b6af;
    pointer-events: none;
    background-color: transparent;
    border-color: var(--llamma-line);
  }

  .pagination-sm .page-link {
    padding: 0.25rem 0.5rem;
  }

  /* Alertas y badges */
  .alert {
    position: relative;
    padding: 1rem;
    margin-bottom: 1rem;
    color: inherit;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 0.375rem;
  }

  .alert-danger {
    color: #58151c;
    background-color: #f8d7da;
    border-color: #f1aeb5;
  }

  .badge {
    display: inline-block;
    padding: 0.42rem 0.65rem;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    text-align: center;
    white-space: nowrap;
    vertical-align: baseline;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  /* Spinner */
  .spinner-border {
    display: inline-block;
    width: 2rem;
    height: 2rem;
    vertical-align: -0.125em;
    border: 0.25em solid currentcolor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spinner-border 0.75s linear infinite;
  }

  .spinner-border-sm {
    width: 1rem;
    height: 1rem;
    border-width: 0.2em;
  }

  @keyframes spinner-border {
    to {
      transform: rotate(360deg);
    }
  }

  /* Modales */
  .modal {
    --llamma-modal-margin: 0.5rem;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1055;
    display: none;
    width: 100%;
    height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    outline: 0;
  }

  .modal-dialog {
    position: relative;
    width: auto;
    margin: var(--llamma-modal-margin);
    pointer-events: none;
  }

  .modal.fade .modal-dialog {
    transition: transform 0.3s ease-out;
    transform: translate(0, -50px);
  }

  .modal.show .modal-dialog {
    transform: none;
  }

  .modal-dialog-centered {
    display: flex;
    align-items: center;
    min-height: calc(100% - var(--llamma-modal-margin) * 2);
  }

  .modal-dialog-scrollable {
    height: calc(100% - var(--llamma-modal-margin) * 2);
  }

  .modal-dialog-scrollable .modal-content {
    max-height: 100%;
    overflow: hidden;
  }

  .modal-dialog-scrollable .modal-body {
    overflow-y: auto;
  }

  .modal-content {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    pointer-events: auto;
    background-color: #fff;
    background-clip: padding-box;
    border: 1px solid rgba(0, 0, 0, 0.175);
    border-radius: 0.5rem;
    outline: 0;
  }

  .modal-header {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    border-bottom: 1px solid var(--llamma-line);
    border-top-left-radius: 0.5rem;
    border-top-right-radius: 0.5rem;
  }

  .modal-title {
    margin-bottom: 0;
    line-height: 1.5;
  }

  .modal-body {
    position: relative;
    flex: 1 1 auto;
    padding: 1rem;
  }

  .modal-footer {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.75rem;
    background-color: transparent;
    border-top: 1px solid var(--llamma-line);
    border-bottom-right-radius: 0.5rem;
    border-bottom-left-radius: 0.5rem;
  }

  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1050;
    width: 100vw;
    height: 100vh;
    background-color: #000;
  }

  .modal-backdrop.fade {
    opacity: 0;
  }

  .modal-backdrop.show {
    opacity: 0.5;
  }

  @media (min-width: 576px) {
    .modal {
      --llamma-modal-margin: 1.75rem;
    }

    .modal-dialog {
      max-width: 500px;
      margin: var(--llamma-modal-margin) auto;
    }
  }

  @media (min-width: 992px) {
    .modal-lg {
      max-width: 800px;
    }
  }

  @media (min-width: 1200px) {
    .modal-xl {
      max-width: 1140px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade,
    .form-control,
    .form-select,
    .form-switch .form-check-input,
    .btn,
    .page-link,
    .modal.fade .modal-dialog {
      transition: none;
    }
  }
}

body {
  min-height: 100vh;
  max-width: 100%;
  overflow-x: clip;
  background-color: var(--llamma-paper);
  color: var(--llamma-carbon);
  font-family: var(--llamma-font-body);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

h1,
h2,
h3,
h4,
h5,
h6,
.display-font {
  font-family: var(--llamma-font-display);
  font-weight: 700;
  letter-spacing: -0.035em;
}

p {
  line-height: 1.7;
}

::selection {
  background: var(--llamma-yellow);
  color: var(--llamma-carbon);
}

a {
  text-decoration: none;
}

a:focus-visible,
button:focus-visible,
.btn:focus-visible,
.form-control:focus-visible,
.form-select:focus-visible {
  outline: 0;
  box-shadow: 0 0 0 0.25rem rgba(var(--llamma-cyan-rgb), 0.28);
}

/* --------------------------------------------------------------------------
   Shell, navegación y pie de página
   -------------------------------------------------------------------------- */

.ink-strip {
  height: 5px;
  background: linear-gradient(
    90deg,
    var(--llamma-cyan) 0 25%,
    var(--llamma-magenta) 25% 50%,
    var(--llamma-yellow) 50% 75%,
    var(--llamma-carbon) 75% 100%
  );
}

.app-shell {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.app-main {
  flex: 1;
}

/* Pie de página del portal público */

.site-footer {
  position: relative;
  margin-top: 3rem;
  padding: 3rem 0 1.4rem;
  background: var(--llamma-carbon);
  color: rgba(255, 255, 255, 0.72);
}

.site-footer::before {
  content: '';
  position: absolute;
  inset: 0 0 auto;
  height: 4px;
  background: linear-gradient(
    90deg,
    var(--llamma-cyan) 0%,
    var(--llamma-magenta) 55%,
    var(--llamma-yellow) 100%
  );
}

.site-footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
  gap: 2rem;
}

.site-footer-brand .brand-lockup {
  margin-bottom: 1rem;
}

.site-footer-brand p {
  max-width: 23rem;
  margin-bottom: 1.2rem;
  color: rgba(255, 255, 255, 0.64);
  font-size: 0.85rem;
  line-height: 1.65;
}

.site-footer-title {
  margin-bottom: 0.7rem;
  color: #fff;
  font-family: var(--llamma-font-display);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.site-footer-col a,
.site-footer-text {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.22rem 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.83rem;
  line-height: 1.5;
}

.site-footer-col a:hover {
  color: var(--llamma-cyan);
}

.site-footer-col a i,
.site-footer-text i {
  color: var(--llamma-cyan);
  font-size: 0.9rem;
}

.site-footer-bottom {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.5rem;
  margin-top: 2.4rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.72rem;
}

@media (max-width: 991.98px) {
  .site-footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .site-footer-brand {
    grid-column: 1 / -1;
  }
}

@media (max-width: 575.98px) {
