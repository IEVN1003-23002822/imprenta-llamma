                    >
                  }
                </div>
                <div class="col-span-12 md:col-span-6">
                  <label class="form-label" for="clienteEmpresa">Empresa o marca</label>
                  <input
                    id="clienteEmpresa"
                    type="text"
                    class="form-control"
                    formControlName="empresa"
                    placeholder="Ej. Estudio Nómada"
                  />
                </div>
                <div class="col-span-12 md:col-span-6">
                  <label class="form-label" for="clienteCorreo">Correo electrónico</label>
                  <input
                    id="clienteCorreo"
                    type="email"
                    class="form-control"
                    formControlName="correo"
                    placeholder="nombre&#64;empresa.mx"
                    [attr.aria-invalid]="
                      form.controls.correo.touched && form.controls.correo.invalid
                    "
                    [attr.aria-describedby]="
                      form.controls.correo.touched && form.controls.correo.invalid
                        ? 'clienteCorreoError'
                        : null
                    "
                    [class.is-invalid]="
                      form.controls.correo.touched && form.controls.correo.invalid
                    "
                  />
                  @if (form.controls.correo.touched && form.controls.correo.invalid) {
                    <span class="field-error" id="clienteCorreoError"
                      >Ingresa un correo válido.</span
                    >
                  }
                </div>
                <div class="col-span-12 md:col-span-6">
                  <label class="form-label" for="clienteTelefono">Teléfono</label>
                  <input
                    id="clienteTelefono"
                    type="tel"
                    class="form-control"
                    formControlName="telefono"
                    placeholder="55 0000 0000"
                    [attr.aria-invalid]="
                      form.controls.telefono.touched && form.controls.telefono.invalid
                    "
                    [attr.aria-describedby]="
                      form.controls.telefono.touched && form.controls.telefono.invalid
                        ? 'clienteTelefonoError'
                        : null
                    "
                    [class.is-invalid]="
                      form.controls.telefono.touched && form.controls.telefono.invalid
                    "
                  />
                  @if (form.controls.telefono.touched && form.controls.telefono.invalid) {
                    <span class="field-error" id="clienteTelefonoError"
                      >Escribe un teléfono de contacto.</span
                    >
                  }
                </div>
                <div class="col-span-12 md:col-span-6">
                  <label class="form-label" for="clienteRfc">RFC / Razón social</label>
                  <input
                    id="clienteRfc"
                    type="text"
                    class="form-control"
                    formControlName="rfc"
                    placeholder="RFC con homoclave"
                  />
                </div>
                <div class="col-span-12 md:col-span-6">
                  <label class="form-label" for="clienteSegmento">Segmento</label>
                  <select id="clienteSegmento" class="form-select" formControlName="segmento">
                    <option value="particular">Particular</option>
                    <option value="pyme">Pyme</option>
                    <option value="corporativo">Corporativo</option>
                    <option value="eventos">Eventos</option>
                    <option value="escolar">Escolar</option>
                    <option value="gobierno">Gobierno</option>
                  </select>
                </div>
                <div class="col-span-12">
                  <label class="form-label" for="clienteDireccion">Dirección de entrega</label>
                  <input
                    id="clienteDireccion"
                    type="text"
                    class="form-control"
                    formControlName="direccion"
                    placeholder="Calle, número, colonia y ciudad"
                  />
                </div>
              </div>
            </section>

            <section class="panel-card mb-6">
              <div class="panel-head">
                <div class="flex items-center gap-4">
                  <span class="step-number">02</span>
                  <div>
                    <span class="panel-kicker">Configuración de partida</span>
                    <h2>Producto a cotizar</h2>
                  </div>
                </div>
                <span class="badge badge-soft-cyan">{{ partidas().length }} partidas</span>
              </div>

              <div class="grid grid-cols-12 gap-4 items-end">
                <div class="col-span-12 md:col-span-4">
                  <label class="form-label" for="productoSelect">Producto terminado</label>
                  <select
                    id="productoSelect"
                    class="form-select"
                    [value]="productoId() ?? ''"
                    (change)="cambiarProducto($event)"
                  >
                    <option value="">Concepto manual</option>
                    @for (producto of productos(); track producto.id) {
                      <option [value]="producto.id">{{ producto.nombre }}</option>
                    }
                  </select>
                </div>
                <div class="col-span-12 md:col-span-4">
                  <label class="form-label" for="productoDescripcion">Concepto</label>
                  <input
                    id="productoDescripcion"
                    type="text"
                    class="form-control"
                    placeholder="Ej. Lona impresa 2 × 1 m"
                    [value]="descripcion()"
                    (input)="cambiarDescripcion($event)"
                  />
                </div>
                <div class="col-span-12 md:col-span-4">
                  <label class="form-label" for="productoEspecificaciones">Especificaciones</label>
                  <input
                    id="productoEspecificaciones"
                    type="text"
                    class="form-control"
                    placeholder="Acabado, medida, tintas..."
                    [value]="especificaciones()"
                    (input)="cambiarEspecificaciones($event)"
                  />
                </div>
                <div class="col-span-4 md:col-span-2">
                  <label class="form-label" for="productoCantidad">Cantidad</label>
                  <input
                    id="productoCantidad"
                    type="number"
                    class="form-control"
                    min="1"
                    step="1"
                    [value]="cantidad()"
                    (input)="cambiarCantidad($event)"
                  />
                </div>
                <div class="col-span-4 md:col-span-3">
                  <label class="form-label" for="productoPrecio">Precio unitario</label>
                  <input
                    id="productoPrecio"
                    type="number"
                    class="form-control"
                    min="0"
                    step="0.01"
                    [value]="precio()"
                    (input)="cambiarPrecio($event)"
                  />
                </div>
                <div class="col-span-4 md:col-span-3">
                  <button class="btn btn-ink w-full" type="button" (click)="agregarPartida()">
                    <i class="bi bi-plus-lg"></i> Agregar
                  </button>
                </div>
                <div class="col-span-12 md:col-span-4">
                  <div class="capture-line-total">
                    <span>Importe de la línea</span>
                    <strong>{{ moneda(cantidad() * precio()) }}</strong>
                  </div>
                </div>
              </div>

              <div class="quote-note">
                <i class="bi bi-info-circle"></i>
                <span>
                  El precio unitario se toma del catálogo y puedes ajustarlo antes de agregar la
                  partida.
                </span>
              </div>
            </section>

            <section class="panel-card mb-6">
              <div class="panel-head">
                <div>
                  <span class="panel-kicker">Partidas de la cotización</span>
                  <h2>Detalle del pedido</h2>
                </div>
                <span class="badge badge-soft-cyan">
                  {{ partidas().length }} partidas · {{ piezas() }} piezas
                </span>
              </div>

              <div class="table-responsive">
                <table class="table table-llamma align-middle">
                  <caption class="sr-only">
                    Partidas de la cotización existente
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Producto</th>
                      <th scope="col" class="text-center capture-col-qty">Cant.</th>
                      <th scope="col" class="text-right capture-col-price">P. unitario</th>
                      <th scope="col" class="text-right">Importe</th>
                      <th scope="col"></th>
                    </tr>
                  </thead>
                  <tbody>
                    @for (item of partidas(); track $index) {
                      <tr>
                        <td>
                          <div class="cell-main">{{ item.descripcion }}</div>
                          <div class="cell-muted">
                            {{ item.especificaciones || 'Sin especificaciones' }}
                          </div>
                        </td>
                        <td>
                          <input
                            class="form-control form-control-sm text-center"
                            type="number"
                            min="1"
                            step="1"
                            [value]="item.cantidad"
                            (input)="actualizarCantidad($index, $event)"
                            [attr.aria-label]="'Cantidad de ' + item.descripcion"
                          />
                        </td>
                        <td>
                          <input
                            class="form-control form-control-sm text-right"
                            type="number"
                            min="0"
                            step="0.01"
                            [value]="item.precioUnitario"
                            (input)="actualizarPrecio($index, $event)"
                            [attr.aria-label]="'Precio unitario de ' + item.descripcion"
                          />
                        </td>
                        <td class="text-right cell-main">{{ moneda(item.importe) }}</td>
                        <td class="text-right">
                          <button
                            class="btn btn-icon"
                            type="button"
                            [attr.aria-label]="'Eliminar ' + item.descripcion"
                            (click)="quitarPartida($index)"
                          >
                            <i class="bi bi-trash3"></i>
                          </button>
                        </td>
                      </tr>
                    } @empty {
                      <tr>
                        <td colspan="5">
                          <div class="capture-empty">
                            <i class="bi bi-bag-plus"></i>
                            <span>Aún no hay partidas. Agrega productos o conceptos manuales.</span>
                          </div>
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>

              <p class="table-note">
                <i class="bi bi-palette"></i>
                Los acabados especiales y el desperdicio de material se agregan al costo final.
              </p>
            </section>

            <section class="panel-card">
              <div class="panel-head">
                <div class="flex items-center gap-4">
                  <span class="step-number">03</span>
                  <div>
                    <span class="panel-kicker">Condiciones comerciales</span>
                    <h2>Vigencia y notas</h2>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 md:col-span-4">
                  <label class="form-label" for="vigenciaDias">Vigencia (días)</label>
                  <input
                    id="vigenciaDias"
                    type="number"
                    class="form-control"
                    min="1"
                    max="90"
                    formControlName="vigenciaDias"
                    [attr.aria-invalid]="
                      form.controls.vigenciaDias.touched && form.controls.vigenciaDias.invalid
                    "
                    [class.is-invalid]="
                      form.controls.vigenciaDias.touched && form.controls.vigenciaDias.invalid
                    "
                  />
                </div>
                <div class="col-span-12 md:col-span-8">
                  <label class="form-label" for="cotizacionNotas">Notas para el cliente</label>
                  <textarea
                    id="cotizacionNotas"
                    class="form-control"
                    rows="2"
                    formControlName="notas"
                    placeholder="Condiciones, tiempos de entrega o aclaraciones..."
                  ></textarea>
                </div>
              </div>
            </section>
          </form>
        </div>

        <div class="col-span-12 xl:col-span-4 summary-sidebar">
          <aside class="quote-summary">
            <div class="quote-summary-head">
              <span>Resumen de cotización</span>
              <span class="badge badge-soft-cyan">Borrador</span>
            </div>

            <div class="summary-client">
              <span class="avatar avatar-magenta">
                {{ iniciales(form.controls.nombreCliente.value || 'Nuevo cliente') }}
              </span>
              <div>
                <strong>{{ form.controls.nombreCliente.value || 'Cliente sin nombre' }}</strong>
                <small>
                  {{ form.controls.empresa.value || 'Sin empresa' }} ·
                  {{ form.controls.segmento.value }}
                </small>
              </div>
            </div>

            @if (partidas().length) {
              <div class="summary-lines">
                @for (item of partidas(); track $index) {
                  <div>
                    <span>{{ item.descripcion }} · {{ item.cantidad }}</span>
                    <strong>{{ moneda(item.importe) }}</strong>
                  </div>
                }
              </div>
            } @else {
              <p class="capture-summary-empty">Agrega partidas para ver el desglose.</p>
            }

            <div class="summary-totals">
              <div>
                <span>Subtotal</span><strong>{{ moneda(subtotal()) }}</strong>
              </div>
              <div>
                <span>IVA (16%)</span><strong>{{ moneda(impuestos()) }}</strong>
              </div>
              <div class="summary-total">
                <span>Total</span><strong>{{ moneda(total()) }}</strong>
              </div>
              <div>
                <span>Anticipo (50%)</span><strong>{{ moneda(anticipo()) }}</strong>
              </div>
              <div>
                <span>Saldo</span><strong>{{ moneda(saldo()) }}</strong>
              </div>
            </div>

            <button
              class="btn btn-brand w-full"
              type="button"
              [disabled]="guardando()"
              (click)="guardar()"
            >
              @if (guardando()) {
                <i class="bi bi-hourglass-split"></i> Guardando cotización...
              } @else {
                <i class="bi bi-file-earmark-check"></i> Guardar cotización
              }
            </button>

            <p class="summary-note">
              <i class="bi bi-shield-check"></i>
              Cotización válida por {{ form.controls.vigenciaDias.value }} días naturales. Precios
              sujetos a revisión de archivo.
            </p>
          </aside>

          <div class="help-card mt-6">
            <i class="bi bi-headset"></i>
            <div>
              <strong>¿Necesitas ayuda?</strong>
              <p>Nuestro equipo de producción te acompaña con materiales y acabados.</p>
              <a href="tel:+525512345678">55 1234 5678</a>
            </div>
          </div>
        </div>
      </div>
    }
  </div>
</div>
</file>

<file path="src/app/llamma/clientes/clientes.component.css">
/* Ajustes visuales del directorio de clientes. */

.client-stat {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  height: 100%;
  padding: 1rem 1.1rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.client-stat strong {
  display: block;
  font-family: var(--llamma-font-display);
  font-size: 1.3rem;
  line-height: 1;
}

.client-stat span:not(.icon-tile) {
  display: block;
  margin-top: 0.25rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  font-weight: 500;
}

.client-profile {
  padding: 1.5rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius);
  background: var(--llamma-carbon);
  color: rgba(255, 255, 255, 0.68);
  box-shadow: var(--llamma-shadow);
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding-bottom: 1.1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.profile-avatar {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 3.4rem;
  height: 3.4rem;
  border-radius: 1rem;
  background: rgba(var(--llamma-yellow-rgb), 0.16);
  color: var(--llamma-yellow);
  font-family: var(--llamma-font-display);
  font-size: 1rem;
  font-weight: 700;
}

.profile-head h2 {
  margin: 0.15rem 0 0.35rem;
  color: #fff;
  font-size: 1.15rem;
}

.profile-head .panel-kicker {
  color: rgba(255, 255, 255, 0.45);
}

.profile-contact {
  display: grid;
  gap: 0.55rem;
  margin: 1.05rem 0;
  padding: 0;
  list-style: none;
}

.profile-contact li {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  font-size: 0.72rem;
}

.profile-contact i {
  margin-top: 0.12rem;
  color: var(--llamma-cyan);
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.4rem;
  margin-bottom: 1rem;
  padding: 0.8rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  text-align: center;
}

.profile-stats strong {
  display: block;
  color: #fff;
  font-family: var(--llamma-font-display);
  font-size: 1rem;
  line-height: 1;
}

.profile-stats span {
  display: block;
  margin-top: 0.2rem;
  color: rgba(255, 255, 255, 0.45);
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.client-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  margin-bottom: 1.1rem;
}

.client-tags span {
  padding: 0.3rem 0.55rem;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 999px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.62rem;
  font-weight: 600;
}

.note-list {
  display: grid;
  gap: 0.9rem;
}

.note-item {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  padding-bottom: 0.9rem;
  border-bottom: 1px dashed var(--llamma-line);
}

.note-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.note-dot {
  flex: 0 0 auto;
  width: 0.5rem;
  height: 0.5rem;
  margin-top: 0.35rem;
  border-radius: 50%;
}

.note-item strong {
  display: block;
  font-size: 0.77rem;
  font-weight: 600;
}

.note-item p {
  margin: 0.18rem 0 0;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  line-height: 1.5;
}

.note-item small {
  display: block;
  margin-top: 0.25rem;
  color: #9a9992;
  font-size: 0.62rem;
}

.segment-list {
  display: grid;
  gap: 0.8rem;
}

.segment-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.32rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
}

.segment-top strong {
  color: var(--llamma-carbon);
  font-family: var(--llamma-font-display);
  font-size: 0.74rem;
}

.segment-track {
  height: 6px;
  overflow: hidden;
  border-radius: 999px;
  background: #efeee9;
}

.segment-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--llamma-cyan), var(--llamma-magenta));
}

/* La tabla tiene siete columnas: compactamos el espaciado para que quepa
   completa en escritorio sin recortar la columna de estado. */
.clientes-page .table-llamma > :not(caption) > * > * {
  padding-right: 0.7rem;
  padding-left: 0.7rem;
}

@media (max-width: 575.98px) {
  .client-stat {
    padding: 0.9rem;
  }

  .client-profile {
    padding: 1.2rem;
  }
}

.clientes-page tbody tr[role='button'] {
  cursor: pointer;
}

.clientes-page tbody tr.table-active > * {
  background-color: rgba(var(--llamma-cyan-rgb), 0.1);
}
</file>

<file path="src/app/llamma/clientes/clientes.component.html">
<div class="module-page clientes-page">
  <div class="llamma-container">
    <header class="page-header flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Relación y seguimiento</span>
        <h1>Directorio de clientes.</h1>
        <p class="page-lead">
          Segmentación, datos fiscales, historial de compras y notas de seguimiento para cada
          cuenta. Todo el contexto comercial en un solo lugar.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button class="btn btn-outline-ink" type="button" (click)="exportar()">
          <i class="bi bi-download"></i> Exportar
        </button>
        @if (puedeGestionar()) {
          <button class="btn btn-brand" type="button" (click)="abrirNuevo()">
            <i class="bi bi-person-plus"></i> Nuevo cliente
          </button>
        }
      </div>
    </header>

    <div class="grid grid-cols-12 gap-4 mb-6">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-span-12 sm:col-span-6 xl:col-span-3">
          <div class="client-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div>
              <strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span>
            </div>
          </div>
        </div>
      }
    </div>

    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 xl:col-span-8">
        <section class="panel-card h-full">
          <div class="panel-head flex-wrap">
            <div>
              <span class="panel-kicker">Base comercial</span>
              <h2>Clientes registrados</h2>
            </div>
            <div class="flex items-center gap-2">
              <span class="badge badge-soft-success">{{ total() }} cuentas</span>
              @if (cargando()) {
                <span
                  class="spinner-border spinner-border-sm text-llamma-cyan-deep"
                  aria-hidden="true"
                ></span>
              }
            </div>
          </div>

          <form class="grid grid-cols-12 gap-2 mb-4" [formGroup]="filtros" (ngSubmit)="buscar()">
            <div class="col-span-12 lg:col-span-6">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input
                  type="search"
                  class="form-control"
                  placeholder="Buscar cliente, empresa o RFC…"
                  aria-label="Buscar cliente"
                  formControlName="q"
                />
                <button class="btn btn-ink" type="submit">Buscar</button>
              </div>
            </div>
            <div class="col-span-6 lg:col-span-3">
              <select
                class="form-select"
                aria-label="Filtrar por segmento"
                formControlName="segmento"
              >
                <option value="">Todos los segmentos</option>
                @for (segmento of segmentos; track segmento.valor) {
                  <option [value]="segmento.valor">{{ segmento.etiqueta }}</option>
                }
              </select>
            </div>
            <div class="col-span-6 lg:col-span-3">
              <div class="flex gap-2">
                <select
                  class="form-select"
                  aria-label="Filtrar por estado"
                  formControlName="estado"
                >
                  <option value="">Todo estado</option>
                  <option value="activo">Activo</option>
                  <option value="inactivo">Inactivo</option>
                </select>
                <button
                  class="btn btn-soft"
                  type="button"
                  aria-label="Limpiar filtros"
                  (click)="limpiar()"
                >
                  <i class="bi bi-arrow-counterclockwise"></i>
                </button>
              </div>
            </div>
          </form>

          @if (error()) {
            <div class="alert alert-danger flex items-center gap-2" role="alert">
              <i class="bi bi-exclamation-octagon-fill"></i>
              <span class="grow">{{ error() }}</span>
              <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar(pagina())">
                Reintentar
              </button>
            </div>
          }

          <div class="table-responsive">
            <table class="table table-llamma align-middle">
              <caption class="sr-only">
                Directorio de clientes
              </caption>
              <thead>
                <tr>
                  <th scope="col">Cliente</th>
                  <th scope="col">Segmento</th>
                  <th scope="col">Contacto</th>
                  <th scope="col" class="text-center">Pedidos</th>
                  <th scope="col">Alta</th>
                  <th scope="col" class="text-right">Total</th>
                  <th scope="col">Estado</th>
                </tr>
              </thead>
              <tbody>
                @for (cliente of clientes(); track cliente.id) {
                  <tr
                    role="button"
                    [class.table-active]="cliente.id === seleccionado()?.id"
                    (click)="seleccionar(cliente)"
                  >
                    <td>
                      <div class="client-cell">
                        <span class="avatar" [class]="'avatar ' + avatar(cliente.id)">
                          {{ iniciales(cliente.nombre) }}
                        </span>
                        <div>
                          <strong>{{ cliente.nombre }}</strong>
                          <small>{{ cliente.rfc ? 'RFC · ' + cliente.rfc : cliente.correo }}</small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge" [class]="claseSegmento(cliente.segmento)">
                        {{ etiquetaSegmento(cliente.segmento) }}
                      </span>
                    </td>
                    <td>
                      <div class="cell-main">{{ cliente.correo }}</div>
                      <div class="cell-muted">{{ cliente.telefono || 'Sin teléfono' }}</div>
                    </td>
                    <td class="text-center">{{ cliente.totalPedidos ?? 0 }}</td>
                    <td>{{ fechaCorta(cliente.fechaRegistro) }}</td>
                    <td class="text-right cell-main">{{ moneda(cliente.totalFacturado) }}</td>
                    <td>
                      <span
                        class="badge"
                        [class]="cliente.activo ? 'badge-soft-success' : 'badge-soft-muted'"
                      >
                        {{ cliente.activo ? 'Activo' : 'Inactivo' }}
                      </span>
                    </td>
                  </tr>
                } @empty {
                  <tr>
                    <td colspan="7" class="text-center text-llamma-muted py-12">
                      <i class="bi bi-people block text-2xl mb-2"></i>
                      No hay clientes con esos filtros.
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span>{{ rangoTexto() }}</span>
            <nav aria-label="Paginación de clientes">
              <ul class="pagination pagination-sm mb-0">
                <li class="page-item" [class.disabled]="pagina() <= 1">
                  <button
                    class="page-link"
                    type="button"
                    aria-label="Anterior"
                    (click)="cargar(pagina() - 1)"
                  >
                    <i class="bi bi-chevron-left"></i>
                  </button>
                </li>
                @for (numero of listaPaginas(); track numero) {
                  <li class="page-item" [class.active]="numero === pagina()">
                    <button class="page-link" type="button" (click)="cargar(numero)">
                      {{ numero }}
                    </button>
                  </li>
                }
                <li class="page-item" [class.disabled]="pagina() >= paginas()">
                  <button
                    class="page-link"
                    type="button"
                    aria-label="Siguiente"
                    (click)="cargar(pagina() + 1)"
                  >
                    <i class="bi bi-chevron-right"></i>
                  </button>
                </li>
              </ul>
            </nav>
          </div>
        </section>
      </div>

      <div class="col-span-12 xl:col-span-4">
        @if (seleccionado(); as cliente) {
          <section class="client-profile mb-6">
            <div class="profile-head">
              <span class="profile-avatar">{{ iniciales(cliente.nombre) }}</span>
              <div>
                <span class="panel-kicker">Cliente seleccionado</span>
                <h2>{{ cliente.nombre }}</h2>
                <span class="badge" [class]="claseSegmento(cliente.segmento)">
                  {{ etiquetaSegmento(cliente.segmento) }}
                </span>
              </div>
            </div>

            <ul class="profile-contact">
              <li>
                <i class="bi bi-building"></i> {{ cliente.empresa || 'Sin empresa registrada' }}
              </li>
              <li><i class="bi bi-envelope"></i> {{ cliente.correo }}</li>
              <li><i class="bi bi-telephone"></i> {{ cliente.telefono || 'Sin teléfono' }}</li>
              <li><i class="bi bi-geo-alt"></i> {{ cliente.direccion || 'Sin dirección' }}</li>
            </ul>

            <div class="profile-stats">
              <div>
                <strong>{{ cliente.totalPedidos ?? 0 }}</strong><span>Pedidos</span>
              </div>
              <div>
                <strong>{{ moneda(cliente.totalFacturado) }}</strong><span>Facturado</span>
              </div>
              <div>
                <strong>{{ ticket(cliente) }}</strong><span>Ticket</span>
              </div>
            </div>

            <div class="client-tags">
              <span>{{ etiquetaSegmento(cliente.segmento) }}</span>
              <span>{{ cliente.activo ? 'Activo' : 'Inactivo' }}</span>
              @if ((cliente.totalPedidos ?? 0) > 1) {
                <span>Recurrente</span>
              }
            </div>

            @if (puedeGestionar()) {
              <button class="btn btn-brand w-full" type="button" (click)="abrirEditar(cliente)">
                <i class="bi bi-pencil-square"></i> Editar ficha
              </button>
            }
            @if (puedeDesactivar() && cliente.activo) {
              <button
                class="btn btn-outline-ink w-full mt-2"
                type="button"
                (click)="desactivar(cliente)"
              >
                <i class="bi bi-person-dash"></i> Desactivar cliente
              </button>
            }
          </section>

          <section class="panel-card mb-6">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Seguimiento</span>
                <h2>Notas del expediente</h2>
              </div>
              <span class="badge badge-soft-muted">{{ notas().length }}</span>
            </div>

            <div class="note-list">
              @for (nota of notas(); track nota) {
                <div class="note-item">
                  <span class="note-dot dot-cyan"></span>
                  <div>
                    <p>{{ nota }}</p>
                  </div>
                </div>
              } @empty {
                <p class="text-llamma-muted mb-0 small">
                  Este cliente todavía no tiene notas de seguimiento.
                </p>
              }
            </div>

            @if (puedeGestionar()) {
              @if (!notaAbierta()) {
                <button
                  class="btn btn-outline-ink w-full mt-4"
                  type="button"
                  (click)="notaAbierta.set(true)"
                >
                  <i class="bi bi-journal-plus"></i> Agregar nota
                </button>
              } @else {
                <form class="mt-4" [formGroup]="notaForm" (ngSubmit)="agregarNota()">
                  <textarea
                    class="form-control"
                    rows="2"
                    placeholder="Escribe una nota de seguimiento…"
                    aria-label="Nota de seguimiento del cliente"
                    formControlName="nota"
                  ></textarea>
                  <div class="flex gap-2 mt-2">
                    <button
                      class="btn btn-brand btn-sm grow"
                      type="submit"
                      [disabled]="notaForm.invalid"
                    >
                      Guardar nota
                    </button>
                    <button
                      class="btn btn-outline-ink btn-sm"
                      type="button"
                      (click)="notaAbierta.set(false)"
                    >
                      Cancelar
                    </button>
                  </div>
                </form>
              }
            }
          </section>
        } @else {
          <section class="panel-card mb-6">
            <p class="text-llamma-muted mb-0">Selecciona un cliente para ver su ficha completa.</p>
          </section>
        }

        <section class="panel-card">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Composición</span>
              <h2>Segmentos de clientes</h2>
            </div>
            @if (cargandoTodos()) {
              <span
                class="spinner-border spinner-border-sm text-llamma-cyan-deep"
                aria-hidden="true"
              ></span>
            }
          </div>

          <div class="segment-list">
            @for (segmento of distribucion(); track segmento.valor) {
              <div class="segment-row">
                <div class="segment-top">
                  <span>{{ segmento.etiqueta }}</span><strong>{{ segmento.cantidad }}</strong>
                </div>
                <div class="segment-track">
                  <span [style.width]="segmento.porcentaje + '%'"></span>
                </div>
              </div>
            }
          </div>
        </section>
      </div>
    </div>
  </div>
</div>

@if (formularioAbierto()) {
  <div
    class="modal fade show block"
    tabindex="-1"
    appModalAccesible
    (cerrar)="cerrarFormulario()"
    style="z-index: 1055"
  >
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <form [formGroup]="formulario" (ngSubmit)="guardar()">
          <div class="modal-header">
            <div>
              <span class="panel-kicker">{{
                editando() ? 'Editar cliente' : 'Alta de cliente'
              }}</span>
              <h2 class="modal-title h5 mb-0">
