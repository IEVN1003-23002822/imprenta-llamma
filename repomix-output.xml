<file path="src/app/llamma/marketing/marketing.component.html">
<div class="module-page marketing-page">
  <div class="llamma-container">
    <header class="page-header flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Campañas y crecimiento</span>
        <h1>Marketing y crecimiento.</h1>
        <p class="page-lead">
          Calendario de actividades, inversión por canal y retorno de cada campaña. Conecta el
          esfuerzo comercial con los pedidos que llegan al taller.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button class="btn btn-outline-ink" type="button" (click)="exportar()">
          <i class="bi bi-download"></i> Exportar
        </button>
        @if (puedeGestionar()) {
          <button class="btn btn-brand" type="button" (click)="abrirNueva()">
            <i class="bi bi-megaphone"></i> Nueva campaña
          </button>
        }
      </div>
    </header>

    @if (error()) {
      <div class="alert alert-danger flex items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="grow">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar()">
          Reintentar
        </button>
      </div>
    }

    <div class="grid grid-cols-12 gap-4 mb-6">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-span-12 sm:col-span-6 xl:col-span-3">
          <div class="mkt-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div>
              <strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span>
            </div>
          </div>
        </div>
      }
    </div>

    <div class="grid grid-cols-12 gap-6 mb-6">
      <div class="col-span-12 xl:col-span-8">
        <section class="panel-card h-full">
          <div class="panel-head flex-wrap">
            <div>
              <span class="panel-kicker">Campañas</span>
              <h2>Desempeño por campaña</h2>
            </div>
            <div class="flex items-center gap-2">
              <span class="badge badge-soft-muted">{{ filtradas().length }} campañas</span>
              @if (cargando()) {
                <span
                  class="spinner-border spinner-border-sm text-llamma-cyan-deep"
                  aria-hidden="true"
                ></span>
              }
            </div>
          </div>

          <form class="grid grid-cols-12 gap-2 mb-4" [formGroup]="filtros" (ngSubmit)="filtrar()">
            <div class="col-span-12 lg:col-span-5">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input
                  type="search"
                  class="form-control"
                  placeholder="Buscar campaña…"
                  aria-label="Buscar campaña"
                  formControlName="q"
                />
                <button class="btn btn-ink" type="submit">Buscar</button>
              </div>
            </div>
            <div class="col-span-6 lg:col-span-3">
              <select class="form-select" aria-label="Filtrar por canal" formControlName="canal">
                <option value="">Todos los canales</option>
                @for (canal of canales; track canal.valor) {
                  <option [value]="canal.valor">{{ canal.etiqueta }}</option>
                }
              </select>
            </div>
            <div class="col-span-6 lg:col-span-2">
              <select class="form-select" aria-label="Filtrar por estado" formControlName="estado">
                <option value="">Todo estado</option>
                @for (estado of estados; track estado.valor) {
                  <option [value]="estado.valor">{{ estado.etiqueta }}</option>
                }
              </select>
            </div>
            <div class="col-span-12 lg:col-span-2">
              <button class="btn btn-soft w-full" type="button" (click)="limpiar()">
                <i class="bi bi-arrow-counterclockwise"></i> Limpiar
              </button>
            </div>
          </form>

          <div class="table-responsive">
            <table class="table table-llamma align-middle">
              <caption class="sr-only">
                Campañas registradas
              </caption>
              <thead>
                <tr>
                  <th scope="col">Campaña</th>
                  <th scope="col">Periodo</th>
                  <th scope="col" class="text-right">Inversión</th>
                  <th scope="col" class="text-right">Ingreso</th>
                  <th scope="col" class="text-right">ROI</th>
                  <th scope="col">Estado</th>
                  @if (puedeGestionar()) {
                    <th scope="col" class="text-right">Acciones</th>
                  }
                </tr>
              </thead>
              <tbody>
                @for (actividad of visibles(); track actividad.id) {
                  <tr>
                    <td>
                      <div class="campaign-cell">
                        <span
                          class="icon-tile icon-tile-sm"
                          [class]="'icon-tile icon-tile-sm ' + tonoCanal(actividad.canal)"
                        >
                          <i class="bi" [class]="'bi ' + iconoCanal(actividad.canal)"></i>
                        </span>
                        <div>
                          <strong>{{ actividad.nombre }}</strong>
                          <small>
                            {{ etiquetaCanal(actividad.canal) }}
                            @if (actividad.descripcion) {
                              · {{ actividad.descripcion }}
                            }
                          </small>
                        </div>
                      </div>
                    </td>
                    <td class="cell-muted">{{ periodo(actividad) }}</td>
                    <td class="text-right">{{ moneda(actividad.inversionReal) }}</td>
                    <td class="text-right cell-main">{{ moneda(actividad.ingresosAtribuidos) }}</td>
                    <td class="text-right">
                      <span class="badge" [class]="claseRoi(actividad.roi)">
                        {{ actividad.roi.toFixed(1) }}x
                      </span>
                    </td>
                    <td>
                      @if (puedeGestionar()) {
                        <select
                          class="form-select form-select-sm state-select"
                          [value]="actividad.estado"
                          (change)="cambiarEstado($event, actividad)"
                          [attr.aria-label]="'Estado de ' + actividad.nombre"
                        >
                          @for (estado of estados; track estado.valor) {
                            <option
                              [value]="estado.valor"
                              [selected]="estado.valor === actividad.estado"
                            >
                              {{ estado.etiqueta }}
                            </option>
                          }
                        </select>
                      } @else {
                        <span class="badge" [class]="claseEstado(actividad.estado)">
                          {{ etiquetaEstado(actividad.estado) }}
                        </span>
                      }
                    </td>
                    @if (puedeGestionar()) {
                      <td class="text-right">
                        <button
                          class="btn btn-icon"
                          type="button"
                          aria-label="Editar campaña"
                          title="Editar campaña"
                          (click)="abrirEditar(actividad)"
                        >
                          <i class="bi bi-pencil"></i>
                        </button>
                      </td>
                    }
                  </tr>
                } @empty {
                  <tr>
                    <td
                      [attr.colspan]="puedeGestionar() ? 7 : 6"
                      class="text-center text-llamma-muted py-12"
                    >
                      <i class="bi bi-megaphone block text-2xl mb-2"></i>
                      No hay campañas con esos filtros.
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span>{{ rangoTexto() }}</span>
            <nav aria-label="Paginación de campañas">
              <ul class="pagination pagination-sm mb-0">
                <li class="page-item" [class.disabled]="pagina() <= 1">
                  <button
                    class="page-link"
                    type="button"
                    aria-label="Anterior"
                    (click)="irA(pagina() - 1)"
                  >
                    <i class="bi bi-chevron-left"></i>
                  </button>
                </li>
                @for (numero of listaPaginas(); track numero) {
                  <li class="page-item" [class.active]="numero === pagina()">
                    <button class="page-link" type="button" (click)="irA(numero)">
                      {{ numero }}
                    </button>
                  </li>
                }
                <li class="page-item" [class.disabled]="pagina() >= paginas()">
                  <button
                    class="page-link"
                    type="button"
                    aria-label="Siguiente"
                    (click)="irA(pagina() + 1)"
                  >
                    <i class="bi bi-chevron-right"></i>
                  </button>
                </li>
              </ul>
            </nav>
          </div>
        </section>
      </div>

      <div class="col-span-12 xl:col-span-4">
        <section class="panel-card h-full">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Mezcla de medios</span>
              <h2>Desempeño por canal</h2>
            </div>
            <span class="badge badge-soft-muted">Ingresos</span>
          </div>

          <div class="channel-list">
            @for (fila of canalesResumen(); track fila.canal) {
              <div class="channel-row">
                <div class="channel-top">
                  <span><span [class]="fila.dot"></span> {{ fila.etiqueta }}</span>
                  <strong>{{ moneda(fila.ingresos) }}</strong>
                </div>
                <div class="channel-track">
                  <span [class]="fila.fill" [style.width]="fila.porcentaje + '%'"></span>
                </div>
              </div>
            } @empty {
              <p class="text-llamma-muted mb-0 small">
                Aún no hay campañas registradas para calcular la mezcla de medios.
              </p>
            }
          </div>

          <div class="quote-note">
            <i class="bi bi-info-circle"></i>
            <span
              >El ingreso atribuido se calcula con el primer contacto registrado en cada
              pedido.</span
            >
          </div>

          <a class="btn btn-outline-ink w-full mt-auto" routerLink="/clientes">
            <i class="bi bi-people"></i> Ver origen de clientes
          </a>
        </section>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-7">
        <section class="panel-card h-full">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Agenda</span>
              <h2>Calendario de actividades</h2>
            </div>
            <span class="badge badge-soft-muted">{{ hoyTexto() }}</span>
          </div>

          <div class="calendar-list">
            @for (actividad of calendario(); track actividad.id) {
              <div class="calendar-item">
                <span class="calendar-date">
                  <strong>{{ diaCalendario(actividad.fechaInicio) }}</strong>
                  <span>{{ mesCalendario(actividad.fechaInicio) }}</span>
                </span>
                <div class="grow min-w-0">
                  <strong>{{ actividad.nombre }}</strong>
                  <small>
                    {{ etiquetaCanal(actividad.canal) }} · {{ periodo(actividad) }} ·
                    {{ moneda(actividad.presupuesto) }} de presupuesto
                  </small>
                </div>
                <span class="badge" [class]="claseEstado(actividad.estado)">
                  {{ etiquetaEstado(actividad.estado) }}
                </span>
              </div>
            } @empty {
              <p class="text-llamma-muted mb-0 small">
                No hay actividades programadas. Crea una campaña para llenar el calendario.
              </p>
            }
          </div>
        </section>
      </div>

      <div class="col-span-12 lg:col-span-5">
        <section class="panel-card h-full">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Presupuesto</span>
              <h2>Inversión vs. plan</h2>
            </div>
            <span
              class="badge"
              [class]="presupuesto().porcentaje > 100 ? 'badge-soft-danger' : 'badge-soft-success'"
            >
              {{ presupuesto().porcentaje }}% ejercido
            </span>
          </div>

          <div class="budget-summary">
            <div>
              <span>Presupuesto</span>
              <strong>{{ moneda(presupuesto().plan) }}</strong>
            </div>
            <div>
              <span>Inversión</span>
              <strong>{{ moneda(presupuesto().ejercido) }}</strong>
            </div>
            <div>
              <span>Disponible</span>
              <strong [class]="presupuesto().desviacion ? 'text-[#dc3545]' : 'text-[#198754]'">
                {{ moneda(presupuesto().disponible) }}
              </strong>
            </div>
          </div>

          <div class="budget-track">
            <span [style.width]="presupuesto().porcentaje + '%'"></span>
          </div>

          <div class="budget-list">
            @for (fila of distribucionPresupuesto(); track fila.canal) {
              <div class="budget-row">
                <span class="budget-dot" [style.background]="fila.color"></span>
                <span>{{ fila.etiqueta }}</span>
                <strong>{{ moneda(fila.monto) }}</strong>
              </div>
            } @empty {
              <p class="text-llamma-muted mb-0 small">Sin inversión registrada todavía.</p>
            }
          </div>

          @if (puedeGestionar()) {
            <button class="btn btn-ink w-full mt-4" type="button" (click)="abrirNueva()">
              <i class="bi bi-sliders"></i> Registrar campaña
            </button>
          }
        </section>
      </div>
    </div>
  </div>
</div>

@if (formularioAbierto()) {
  <div
    class="modal fade show block"
    tabindex="-1"
    appModalAccesible
    (cerrar)="cerrarFormulario()"
    style="z-index: 1055"
  >
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <form [formGroup]="formulario" (ngSubmit)="guardar()">
          <div class="modal-header">
            <div>
              <span class="panel-kicker">{{
                editando() ? 'Editar campaña' : 'Nueva campaña'
              }}</span>
              <h2 class="modal-title h5 mb-0">
                {{ editando() ? editando()!.nombre : 'Registrar campaña' }}
              </h2>
            </div>
            <button
              class="btn btn-icon"
              type="button"
              aria-label="Cerrar"
              (click)="cerrarFormulario()"
            >
              <i class="bi bi-x-lg"></i>
            </button>
          </div>

          <div class="modal-body">
            <div class="grid grid-cols-12 gap-4">
              <div class="col-span-12 md:col-span-7">
                <label class="form-label" for="campNombre">Nombre de la campaña *</label>
                <input id="campNombre" class="form-control" formControlName="nombre" />
                @if (formulario.controls.nombre.invalid && formulario.controls.nombre.touched) {
                  <small class="text-red-600">Indica al menos tres caracteres.</small>
                }
              </div>
              <div class="col-span-12 md:col-span-5">
                <label class="form-label" for="campCanal">Canal</label>
                <select id="campCanal" class="form-select" formControlName="canal">
                  @for (canal of canales; track canal.valor) {
                    <option [value]="canal.valor">{{ canal.etiqueta }}</option>
                  }
                </select>
              </div>
              <div class="col-span-12 md:col-span-4">
                <label class="form-label" for="campEstado">Estado</label>
                <select id="campEstado" class="form-select" formControlName="estado">
                  @for (estado of estados; track estado.valor) {
                    <option [value]="estado.valor">{{ estado.etiqueta }}</option>
                  }
                </select>
              </div>
              <div class="col-span-12 md:col-span-4">
                <label class="form-label" for="campInicio">Inicio *</label>
                <input
                  id="campInicio"
                  type="date"
                  class="form-control"
                  formControlName="fechaInicio"
                />
              </div>
              <div class="col-span-12 md:col-span-4">
                <label class="form-label" for="campFin">Fin</label>
                <input id="campFin" type="date" class="form-control" formControlName="fechaFin" />
              </div>
              <div class="col-span-12 md:col-span-4">
                <label class="form-label" for="campPresupuesto">Presupuesto</label>
                <input
                  id="campPresupuesto"
                  type="number"
                  min="0"
                  step="0.01"
                  class="form-control"
                  formControlName="presupuesto"
                />
              </div>
              <div class="col-span-12 md:col-span-4">
                <label class="form-label" for="campInversion">Inversión real</label>
                <input
                  id="campInversion"
                  type="number"
                  min="0"
                  step="0.01"
                  class="form-control"
                  formControlName="inversionReal"
                />
              </div>
              <div class="col-span-12 md:col-span-4">
                <label class="form-label" for="campIngresos">Ingresos atribuidos</label>
                <input
                  id="campIngresos"
                  type="number"
                  min="0"
                  step="0.01"
                  class="form-control"
                  formControlName="ingresosAtribuidos"
                />
              </div>
              <div class="col-span-12">
                <label class="form-label" for="campDescripcion">Descripción</label>
                <textarea
                  id="campDescripcion"
                  class="form-control"
                  rows="2"
                  placeholder="Objetivo, audiencia, piezas de la campaña…"
                  formControlName="descripcion"
                ></textarea>
              </div>
            </div>

            <div class="quote-note mt-4 mb-0">
              <i class="bi bi-calculator"></i>
              <span>
                El ROI se calcula automáticamente como ingresos atribuidos entre inversión real.
              </span>
            </div>
          </div>

          <div class="modal-footer">
            <button class="btn btn-outline-ink" type="button" (click)="cerrarFormulario()">
              Cancelar
            </button>
            <button class="btn btn-brand" type="submit" [disabled]="guardando()">
              <i class="bi" [class]="guardando() ? 'bi-arrow-repeat spin' : 'bi-check2'"></i>
              {{ guardando() ? 'Guardando…' : 'Guardar campaña' }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}
</file>

<file path="src/app/llamma/produccion/produccion.component.html">
<div class="module-page produccion-page">
  <div class="llamma-container">
    <header class="page-header flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Taller y calidad</span>
        <h1>Producción en tiempo real.</h1>
        <p class="page-lead">
          Tablero de etapas, responsables y control de calidad. Visualiza qué está en el taller y
          qué necesita atención antes de la entrega.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="date-chip">
          <i class="bi bi-calendar3"></i>
          Hoy · {{ hoy | date: 'dd MMM yyyy' }}
        </span>
        <button class="btn btn-outline-ink" type="button" (click)="exportar()">
          <i class="bi bi-file-earmark-bar-graph"></i> Reporte de turno
        </button>
      </div>
    </header>

    @if (error()) {
      <div class="alert alert-danger flex items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="grow">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar()">
          Reintentar
        </button>
      </div>
    }

    <div class="grid grid-cols-12 gap-4 mb-6">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-span-12 sm:col-span-6 xl:col-span-3">
          <div class="prod-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div>
              <strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span>
            </div>
          </div>
        </div>
      }
    </div>

    <div class="kanban-head-bar">
      <div>
        <span class="panel-kicker">Flujo del taller</span>
        <h2>Tablero de producción</h2>
      </div>
      <div class="flex items-center gap-2">
        @if (cargando()) {
          <span
            class="spinner-border spinner-border-sm text-llamma-cyan-deep"
            aria-hidden="true"
          ></span>
        }
        <span class="kanban-hint hidden xl:inline-flex">
          <i class="bi bi-arrows-expand"></i> Desplázate para ver las 8 etapas
        </span>
        <span class="badge badge-soft-muted">{{ ordenes().length }} órdenes en piso</span>
      </div>
    </div>

    <div class="kanban-scroll mb-6">
      <div class="kanban-board">
        @for (columna of columnas(); track columna.valor) {
          <section class="kanban-col">
            <header class="kanban-col-head">
              <span [class]="dotEtapa(columna.valor)"></span>
              <strong>{{ columna.etiqueta }}</strong>
              <span class="kanban-count">{{ columna.ordenes.length }}</span>
            </header>

            @for (orden of columna.ordenes; track orden.id) {
              <article
                class="task-card"
                [class.is-featured]="orden.estado === 'pausada' || orden.estado === 'rechazada'"
              >
                <div class="task-top">
                  <span class="order-id">#{{ orden.pedidoFolio ?? orden.pedidoId }}</span>
                  <span class="badge" [class]="claseEstado(orden.estado)">{{
                    etiquetaEstado(orden.estado)
                  }}</span>
                </div>
                <strong class="task-title">{{ titulo(orden) }}</strong>
                <span class="task-client"><i class="bi bi-person"></i> {{ cliente(orden) }}</span>
                <div class="task-meta">
                  <span><i class="bi bi-clock"></i> Entrega {{ fechaEntrega(orden) }}</span>
                  <span
                    ><i class="bi bi-person-badge"></i>
                    {{ orden.responsable || 'Sin asignar' }}</span
                  >
                </div>
                @if (orden.estado === 'pausada' && orden.observaciones) {
                  <p class="task-note">
                    <i class="bi bi-exclamation-triangle"></i> {{ orden.observaciones }}
                  </p>
                }
                <div class="task-foot">
                  <span class="task-progress-track"
                    ><span [style.width]="progreso(orden) + '%'"></span
                  ></span>
                  <span>{{ progreso(orden) }}%</span>
                </div>

                @if (puedeGestionar()) {
                  <div class="task-actions">
                    <button
                      class="btn btn-icon btn-icon-xs"
                      type="button"
                      aria-label="Regresar etapa"
                      title="Regresar etapa"
                      [disabled]="!puedeRetroceder(orden) || moviendoId() === orden.id"
                      (click)="mover(orden, -1)"
                    >
                      <i class="bi bi-chevron-left"></i>
                    </button>
                    <button
                      class="btn btn-icon btn-icon-xs"
                      type="button"
                      aria-label="Avanzar etapa"
                      title="Avanzar etapa"
                      [disabled]="!puedeAvanzar(orden) || moviendoId() === orden.id"
                      (click)="mover(orden, 1)"
                    >
                      <i class="bi bi-chevron-right"></i>
                    </button>
                    <button
                      class="btn btn-icon btn-icon-xs ms-auto"
                      type="button"
                      aria-label="Abrir orden"
                      title="Abrir orden"
                      (click)="abrirDetalle(orden)"
                    >
                      <i class="bi bi-arrows-angle-expand"></i>
                    </button>
                  </div>
                } @else {
                  <div class="task-actions">
                    <button
                      class="btn btn-icon btn-icon-xs ms-auto"
                      type="button"
                      aria-label="Abrir orden"
                      title="Abrir orden"
                      (click)="abrirDetalle(orden)"
                    >
                      <i class="bi bi-arrows-angle-expand"></i>
                    </button>
                  </div>
                }
              </article>
            } @empty {
              <p class="kanban-empty"><i class="bi bi-inbox"></i> Sin órdenes en esta etapa</p>
            }
          </section>
        }
      </div>
    </div>

    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 xl:col-span-7">
        <section class="panel-card h-full">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Capacidad del taller</span>
              <h2>Carga por etapa</h2>
            </div>
            <span class="badge badge-soft-success">
              {{ ordenes().length ? 'Operación en curso' : 'Sin paros' }}
            </span>
          </div>

          <div class="stage-load">
            @for (columna of resumenEtapas(); track columna.valor) {
              <div class="stage-load-row">
                <span class="stage-load-name">
                  <i class="bi" [class]="'bi ' + columna.icono"></i> {{ columna.etiqueta }}
                </span>
                <div class="stage-meter">
                  <span [style.width]="columna.porcentaje + '%'"></span>
                </div>
                <strong>{{ columna.total }}</strong>
              </div>
            }
          </div>
        </section>
      </div>

      <div class="col-span-12 xl:col-span-5">
        <section class="panel-card h-full flex flex-col">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Calidad</span>
              <h2>Últimos controles</h2>
            </div>
            <span
              class="badge"
              [class]="controlesPendientes() ? 'badge-soft-warning' : 'badge-soft-success'"
            >
              {{ controlesPendientes() ? controlesPendientes() + ' por atender' : 'Todo en orden' }}
            </span>
          </div>

          <div class="quality-list">
            @for (fila of calidadReciente(); track fila.control.id) {
              <div class="quality-row" [class.is-done]="fila.control.aprobado">
                <span class="quality-check">
                  <i
                    class="bi"
                    [class]="fila.control.aprobado ? 'bi-check-lg' : 'bi-hourglass-split'"
                  ></i>
                </span>
                <div>
                  <strong>{{ fila.control.criterio }}</strong>
                  <small>
                    #{{ fila.folio }} · {{ fila.control.revisadoPor || 'Sin revisor' }} ·
                    {{ fechaHora(fila.control.fecha) }}
                  </small>
                </div>
                <span
                  class="badge"
                  [class]="fila.control.aprobado ? 'badge-soft-success' : 'badge-soft-warning'"
                >
                  {{ fila.control.aprobado ? 'OK' : 'Pendiente' }}
                </span>
              </div>
            } @empty {
              <p class="text-llamma-muted mb-0 small">
                Aún no hay controles de calidad registrados. Abre una orden para capturar el
                primero.
              </p>
            }
          </div>

          <div class="quote-note">
            <i class="bi bi-shield-check"></i>
            <span
              >Ninguna orden sale del taller sin el checklist de calidad completo y firmado.</span
            >
          </div>

          <a class="btn btn-outline-ink w-full mt-auto" routerLink="/detalle">
            <i class="bi bi-receipt"></i> Ver detalle de la orden
          </a>
        </section>
      </div>
    </div>
  </div>
</div>

@if (seleccionada(); as orden) {
  <div
    class="modal fade show block"
    tabindex="-1"
    appModalAccesible
    (cerrar)="cerrarDetalle()"
    style="z-index: 1055"
  >
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <span class="panel-kicker">Orden de producción</span>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="modal-title h5 mb-0">#{{ orden.pedidoFolio ?? orden.pedidoId }}</h2>
              <span class="badge" [class]="claseEstado(orden.estado)">{{
                etiquetaEstado(orden.estado)
              }}</span>
              <span class="badge badge-soft-muted">
                <i class="bi" [class]="'bi ' + iconoEtapa(orden.etapa)"></i>
                {{ etiquetaEtapa(orden.etapa) }}
              </span>
            </div>
          </div>
          <button class="btn btn-icon" type="button" aria-label="Cerrar" (click)="cerrarDetalle()">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>

        <div class="modal-body">
          <div class="grid grid-cols-12 gap-6">
            <div class="col-span-12 lg:col-span-5">
              <div class="order-brief mb-4">
                <span class="order-brief-icon"><i class="bi bi-printer"></i></span>
                <div>
                  <strong>{{ titulo(orden) }}</strong>
                  <span>{{ cliente(orden) }}</span>
                </div>
              </div>

              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-6">
                  <span class="panel-kicker">Entrega</span>
                  <strong class="block">{{ fechaEntrega(orden) }}</strong>
                </div>
                <div class="col-span-6">
                  <span class="panel-kicker">Prioridad</span>
                  <span class="badge" [class]="clasePrioridad(orden)">{{ prioridad(orden) }}</span>
                </div>
                <div class="col-span-6">
                  <span class="panel-kicker">Responsable</span>
                  <strong class="block">{{ orden.responsable || 'Sin asignar' }}</strong>
                </div>
                <div class="col-span-6">
                  <span class="panel-kicker">Inicio</span>
                  <strong class="block">{{ fechaHora(orden.fechaInicio) }}</strong>
                </div>
              </div>

              <div class="stage-list mt-4">
                @for (etapa of orden.historialEtapas; track etapa.id) {
                  <div
                    class="stage-list-item"
                    [class.is-done]="etapa.estado === 'completada'"
                    [class.is-active]="etapa.estado === 'en-proceso'"
                  >
                    <span class="stage-list-dot"
                      ><i class="bi" [class]="'bi ' + iconoEtapa(etapa.etapa)"></i
                    ></span>
                    <div class="grow min-w-0">
                      <strong>{{ etiquetaEtapa(etapa.etapa) }}</strong>
                      <small>
                        {{ etapa.responsable || 'Sin responsable' }} ·
                        {{
                          etapa.fin
                            ? fechaHora(etapa.fin)
                            : etapa.inicio
                              ? fechaHora(etapa.inicio)
                              : 'Programado'
                        }}
                      </small>
                    </div>
                    <span
                      class="badge"
                      [class]="
                        etapa.estado === 'completada'
                          ? 'badge-soft-success'
                          : etapa.estado === 'en-proceso'
                            ? 'badge-soft-cyan'
                            : 'badge-soft-muted'
                      "
                    >
                      {{ etapa.estado }}
                    </span>
                  </div>
                } @empty {
                  <p class="text-llamma-muted mb-0 small">Sin historial de etapas.</p>
                }
              </div>

              <p class="table-note mt-4 mb-0">
                <i class="bi bi-journal-text"></i>
                {{ orden.observaciones || 'Sin observaciones registradas.' }}
              </p>
            </div>

            <div class="col-span-12 lg:col-span-7">
              @if (puedeGestionar()) {
                <form [formGroup]="ordenForm" (ngSubmit)="guardarCambios()">
                  <div class="grid grid-cols-12 gap-4">
                    <div class="col-span-12 md:col-span-6">
                      <label class="form-label" for="prodEtapa">Etapa actual</label>
                      <select id="prodEtapa" class="form-select" formControlName="etapa">
                        @for (etapa of etapas; track etapa.valor) {
                          <option [value]="etapa.valor">{{ etapa.etiqueta }}</option>
                        }
                      </select>
                    </div>
                    <div class="col-span-12 md:col-span-6">
                      <label class="form-label" for="prodEstado">Estado</label>
                      <select id="prodEstado" class="form-select" formControlName="estado">
                        @for (estado of estados; track estado.valor) {
                          <option [value]="estado.valor">{{ estado.etiqueta }}</option>
                        }
                      </select>
                    </div>
                    <div class="col-span-12">
                      <label class="form-label" for="prodObs">Observaciones</label>
                      <textarea
                        id="prodObs"
                        class="form-control"
                        rows="2"
                        formControlName="observaciones"
                      ></textarea>
                    </div>
                  </div>
                  <div class="flex flex-wrap gap-2 mt-4">
                    <button class="btn btn-brand" type="submit" [disabled]="guardando()">
                      <i
                        class="bi"
                        [class]="guardando() ? 'bi-arrow-repeat spin' : 'bi-check2'"
                      ></i>
                      {{ guardando() ? 'Guardando…' : 'Guardar cambios' }}
                    </button>
                    @if (orden.estado !== 'completada') {
                      <button
                        class="btn btn-outline-ink"
                        type="button"
                        [disabled]="guardando()"
                        (click)="completar(orden)"
                      >
                        <i class="bi bi-flag"></i> Completar orden
                      </button>
                    }
                  </div>
                </form>
              }

              <div class="panel-head mt-6">
                <div>
                  <span class="panel-kicker">Checklist de calidad</span>
                  <h2>Controles de la orden</h2>
                </div>
                <span class="badge badge-soft-muted"
                  >{{ controlesDe(orden).length }} registros</span
                >
              </div>

              <div class="table-responsive">
                <table class="table table-llamma align-middle">
                  <caption class="sr-only">
                    Controles de calidad de la orden
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Criterio</th>
                      <th scope="col">Resultado</th>
                      <th scope="col">Revisó</th>
                      <th scope="col" class="text-right">Fecha</th>
                    </tr>
                  </thead>
                  <tbody>
                    @for (control of controlesDe(orden); track control.id) {
                      <tr>
                        <td>
                          <div class="cell-main">{{ control.criterio }}</div>
                          <div class="cell-muted">
                            {{ control.observaciones || 'Sin observaciones' }}
                          </div>
                        </td>
                        <td>
                          <span
                            class="badge"
                            [class]="control.aprobado ? 'badge-soft-success' : 'badge-soft-danger'"
                          >
                            {{ control.aprobado ? 'Aprobado' : 'Rechazado' }}
                          </span>
                        </td>
                        <td>{{ control.revisadoPor || '—' }}</td>
                        <td class="text-right cell-muted">{{ fechaHora(control.fecha) }}</td>
                      </tr>
                    } @empty {
                      <tr>
                        <td colspan="4" class="text-center text-llamma-muted py-6">
                          Aún no hay controles registrados para esta orden.
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>

              @if (puedeGestionar()) {
                <form
                  class="quality-form"
                  [formGroup]="calidadForm"
                  (ngSubmit)="registrarCalidad()"
                >
                  <span class="panel-kicker">Nuevo control</span>
                  <div class="grid grid-cols-12 gap-2 mt-1">
                    <div class="col-span-12 md:col-span-6">
                      <input
                        class="form-control form-control-sm"
                        placeholder="Criterio: color, medidas, empaque…"
                        aria-label="Criterio de calidad"
                        formControlName="criterio"
                      />
                      @if (
                        calidadForm.controls.criterio.invalid &&
                        calidadForm.controls.criterio.touched
                      ) {
                        <small class="text-red-600">Describe el criterio a revisar.</small>
                      }
                    </div>
                    <div class="col-span-12 md:col-span-6">
                      <input
                        class="form-control form-control-sm"
                        placeholder="Observaciones"
                        aria-label="Observaciones de calidad"
                        formControlName="observaciones"
                      />
                    </div>
                    <div class="col-span-12 flex flex-wrap items-center gap-4">
                      <div class="form-check form-switch mb-0">
                        <input
                          id="calidadAprobado"
                          class="form-check-input"
                          type="checkbox"
                          formControlName="aprobado"
                        />
                        <label class="form-check-label small" for="calidadAprobado">Aprobado</label>
                      </div>
                      <button
                        class="btn btn-ink btn-sm ms-auto"
                        type="submit"
                        [disabled]="registrandoCalidad()"
                      >
                        <i
                          class="bi"
                          [class]="
                            registrandoCalidad() ? 'bi-arrow-repeat spin' : 'bi-clipboard-check'
                          "
                        ></i>
                        {{ registrandoCalidad() ? 'Registrando…' : 'Registrar control' }}
                      </button>
                    </div>
                  </div>
                </form>
              }
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-ink" type="button" (click)="cerrarDetalle()">
            Cerrar
          </button>
          <a class="btn btn-brand" routerLink="/detalle" [queryParams]="{ pedido: orden.pedidoId }">
            <i class="bi bi-receipt"></i> Ver pedido
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}
</file>

<file path="src/app/llamma/productos/productos.component.html">
<div class="module-page productos-page">
  <div class="llamma-container">
    <header class="page-header flex flex-wrap items-end justify-between gap-4">
      <div class="page-brand">
        <img
          class="page-brand-logo"
          src="assets/images/logo-llamma-128.webp"
          srcset="assets/images/logo-llamma-128.webp 2x, assets/images/logo-llamma-256.webp 4x"
          alt="Imprenta Llamma Logo"
          width="38"
          height="54"
        />
        <div>
          <span class="eyebrow">Catálogo público</span>
          <h1>Productos que podemos transformar.</h1>
          <p class="page-lead">
            Gran formato, textil, promocionales y papelería creativa. Explora el catálogo, elige tus
            piezas y solicita una cotización a tu medida. Los precios son referenciales y se
            confirman al revisar medidas, materiales y archivo de diseño.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn btn-brand" routerLink="/cotizar">
          <i class="bi bi-send"></i> Solicitar cotización
        </a>
        @if (puedeGestionar()) {
          <button class="btn btn-outline-ink" type="button" (click)="abrirGestion()">
            <i class="bi bi-sliders"></i> Gestionar catálogo
          </button>
        } @else {
          <a class="btn btn-soft" routerLink="/login">
            <i class="bi bi-shield-lock"></i> Acceso equipo
          </a>
        }
      </div>
    </header>

    <section class="panel-card mb-6">
      <div class="catalog-toolbar">
        <div class="catalog-tabs" role="tablist" aria-label="Filtrar por línea de producción">
          @for (opcion of lineas; track opcion.valor) {
            <button
              class="filter-chip"
              type="button"
              [class.is-active]="linea() === opcion.valor"
              (click)="filtrarPor(opcion.valor)"
            >
              {{ opcion.etiqueta }}
            </button>
          }
        </div>

        <div class="catalog-search">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input
            type="search"
            class="form-control"
            placeholder="Buscar producto..."
            aria-label="Buscar producto en el catálogo"
            [value]="busqueda()"
            (input)="actualizarBusqueda($event)"
          />
        </div>
      </div>
    </section>

    @if (error()) {
      <div class="catalog-error mb-6" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>{{ error() }}</span>
      </div>
    }

    @if (cargando()) {
      <div class="panel-card catalog-empty">
        <i class="bi bi-arrow-repeat"></i>
        <p>Cargando catálogo...</p>
      </div>
    } @else if (!filtrados().length) {
      <div class="panel-card catalog-empty">
        <i class="bi bi-search"></i>
        <p>No encontramos productos con ese filtro. Prueba con otra línea o palabra.</p>
      </div>
    } @else {
      <div class="catalog-grid">
        @for (producto of filtrados(); track producto.id) {
          <article class="product-card">
            @if (producto.imagenUrl && !imagenesConError().has(producto.id)) {
              <figure class="product-card-media">
                <img
                  [src]="producto.imagenUrl"
                  [alt]="'Foto de ' + producto.nombre"
                  width="640"
                  height="420"
                  loading="lazy"
                  decoding="async"
                  (error)="marcarImagenRota(producto.id)"
                />
                <span class="badge badge-soft-muted product-card-badge">
                  {{ etiquetaLinea(producto.lineaProduccion) }}
                </span>
              </figure>
            } @else {
              <div class="product-card-head">
                <span class="icon-tile icon-tile-cyan">
                  <i class="bi {{ producto.icono || 'bi-box-seam' }}"></i>
                </span>
                <span class="badge badge-soft-muted">{{
                  etiquetaLinea(producto.lineaProduccion)
                }}</span>
              </div>
            }

            <h2>{{ producto.nombre }}</h2>
            <p>{{ producto.descripcion || 'Producto personalizable según tu proyecto.' }}</p>

            <div class="product-card-footer">
              <div class="product-price">
                <span>Desde</span>
                <strong>{{ moneda(producto.precioBase) }}</strong>
                <small>por {{ unidad(producto.unidadVenta) }}</small>
              </div>
              <a
                class="btn btn-sm btn-brand"
                routerLink="/cotizar"
                [queryParams]="{ producto: producto.id }"
              >
                <i class="bi bi-plus-lg"></i> Cotizar
              </a>
            </div>
          </article>
        }
      </div>
    }

    <section class="catalog-help">
      <div class="catalog-help-text">
        <span class="eyebrow">¿No encuentras tu producto?</span>
        <h2>Lo desarrollamos contigo.</h2>
        <p>
          Cuéntanos qué necesitas y armamos una propuesta con materiales, acabados y tiempos de
          producción para tu proyecto.
        </p>
      </div>
      <a class="btn btn-yellow" routerLink="/cotizar">
        <i class="bi bi-chat-square-text"></i> Describir mi proyecto
      </a>
    </section>
  </div>
</div>

