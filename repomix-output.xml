  font-family: var(--llamma-font-display);
  font-size: 1.3rem;
  line-height: 1;
}

.supply-stat span:not(.icon-tile) {
  display: block;
  margin-top: 0.25rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  font-weight: 500;
}

.supplier-meta {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  min-width: 10.5rem;
}

.abastecimiento-page .table-llamma tbody td:first-child {
