}

.materials-panel::after {
  content: '';
  position: absolute;
  bottom: -40%;
  left: -8%;
  width: 380px;
  height: 380px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--llamma-magenta-rgb), 0.17), transparent 68%);
}

.materials-panel .row {
