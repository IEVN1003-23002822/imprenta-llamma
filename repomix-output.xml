            "presupuesto": float(self.presupuesto or 0),
            "inversionReal": float(self.inversion_real or 0),
            "ingresosAtribuidos": float(self.ingresos_atribuidos or 0),
            "roi": self.roi,
            "estado": self.estado,
            "descripcion": self.descripcion,
