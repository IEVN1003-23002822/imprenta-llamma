}

.cta-ink {
  position: absolute;
  right: -0.08em;
  bottom: -0.48em;
  font-family: var(--llamma-font-display);
  font-size: clamp(6rem, 15vw, 13rem);
  font-weight: 700;
  letter-spacing: -0.08em;
  line-height: 1;
  color: rgba(255, 255, 255, 0.045);
  pointer-events: none;
