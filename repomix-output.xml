              </div>
              <div class="col-6 col-md-3">
                <label class="form-label" for="ocEstado">Estado inicial</label>
                <select id="ocEstado" class="form-select" formControlName="estado">
                  @for (estado of estados; track estado.valor) {
                    @if (estado.valor !== 'recibida' && estado.valor !== 'cancelada') {
                      <option [value]="estado.valor">{{ estado.etiqueta }}</option>
                    }
                  }
                </select>
              </div>
              <div class="col-6 col-md-4">
                <label class="form-label" for="ocEntrega">Entrega estimada</label>
                <input id="ocEntrega" type="date" class="form-control" formControlName="fechaEntrega" />
