/* Ajustes visuales del módulo de abastecimiento. */

.supply-stat {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  height: 100%;
  padding: 1rem 1.1rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
