<div class="module-page marketing-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Campañas y crecimiento</span>
        <h1>Marketing y crecimiento.</h1>
        <p class="page-lead">
          Calendario de actividades, inversión por canal y retorno de cada campaña. Conecta el
          esfuerzo comercial con los pedidos que llegan al taller.
        </p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-ink" type="button" (click)="exportar()">
          <i class="bi bi-download"></i> Exportar
        </button>
        @if (puedeGestionar()) {
          <button class="btn btn-brand" type="button" (click)="abrirNueva()">
            <i class="bi bi-megaphone"></i> Nueva campaña
          </button>
        }
      </div>
    </header>

    @if (error()) {
      <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="flex-grow-1">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar()">Reintentar</button>
      </div>
    }

    <div class="row g-3 mb-4">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-sm-6 col-xl-3">
          <div class="mkt-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div><strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span></div>
          </div>
        </div>
      }
    </div>

    <div class="row g-4 mb-4">
      <div class="col-xl-8">
        <section class="panel-card h-100">
          <div class="panel-head flex-wrap">
            <div>
              <span class="panel-kicker">Campañas</span>
              <h2>Desempeño por campaña</h2>
            </div>
            <div class="d-flex align-items-center gap-2">
              <span class="badge badge-soft-muted">{{ filtradas().length }} campañas</span>
              @if (cargando()) {
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
              }
            </div>
          </div>

          <form class="row g-2 mb-3" [formGroup]="filtros" (ngSubmit)="filtrar()">
            <div class="col-lg-5">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input
                  type="search"
                  class="form-control"
                  placeholder="Buscar campaña…"
                  aria-label="Buscar campaña"
                  formControlName="q"
                />
                <button class="btn btn-ink" type="submit">Buscar</button>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <select class="form-select" aria-label="Filtrar por canal" formControlName="canal">
                <option value="">Todos los canales</option>
                @for (canal of canales; track canal.valor) {
                  <option [value]="canal.valor">{{ canal.etiqueta }}</option>
                }
              </select>
            </div>
            <div class="col-6 col-lg-2">
              <select class="form-select" aria-label="Filtrar por estado" formControlName="estado">
                <option value="">Todo estado</option>
                @for (estado of estados; track estado.valor) {
                  <option [value]="estado.valor">{{ estado.etiqueta }}</option>
                }
              </select>
            </div>
            <div class="col-lg-2">
              <button class="btn btn-soft w-100" type="button" (click)="limpiar()">
                <i class="bi bi-arrow-counterclockwise"></i> Limpiar
              </button>
            </div>
          </form>

          <div class="table-responsive">
            <table class="table table-llamma align-middle">
              <thead>
                <tr>
                  <th>Campaña</th>
                  <th>Periodo</th>
                  <th class="text-end">Inversión</th>
                  <th class="text-end">Ingreso</th>
                  <th class="text-end">ROI</th>
                  <th>Estado</th>
                  @if (puedeGestionar()) {
                    <th class="text-end">Acciones</th>
                  }
                </tr>
              </thead>
              <tbody>
                @for (actividad of visibles(); track actividad.id) {
                  <tr>
                    <td>
                      <div class="campaign-cell">
                        <span class="icon-tile icon-tile-sm" [class]="'icon-tile icon-tile-sm ' + tonoCanal(actividad.canal)">
                          <i class="bi" [class]="'bi ' + iconoCanal(actividad.canal)"></i>
                        </span>
                        <div>
                          <strong>{{ actividad.nombre }}</strong>
                          <small>
                            {{ etiquetaCanal(actividad.canal) }}
                            @if (actividad.descripcion) {
                              · {{ actividad.descripcion }}
                            }
                          </small>
                        </div>
                      </div>
                    </td>
                    <td class="cell-muted">{{ periodo(actividad) }}</td>
                    <td class="text-end">{{ moneda(actividad.inversionReal) }}</td>
                    <td class="text-end cell-main">{{ moneda(actividad.ingresosAtribuidos) }}</td>
                    <td class="text-end">
                      <span class="badge" [class]="claseRoi(actividad.roi)">
                        {{ actividad.roi.toFixed(1) }}x
                      </span>
                    </td>
                    <td>
                      @if (puedeGestionar()) {
                        <select
                          class="form-select form-select-sm state-select"
                          [value]="actividad.estado"
                          (change)="cambiarEstado($event, actividad)"
                          [attr.aria-label]="'Estado de ' + actividad.nombre"
                        >
                          @for (estado of estados; track estado.valor) {
                            <option [value]="estado.valor" [selected]="estado.valor === actividad.estado">
                              {{ estado.etiqueta }}
                            </option>
                          }
                        </select>
                      } @else {
                        <span class="badge" [class]="claseEstado(actividad.estado)">
                          {{ etiquetaEstado(actividad.estado) }}
                        </span>
                      }
                    </td>
                    @if (puedeGestionar()) {
                      <td class="text-end">
                        <button
                          class="btn btn-icon"
                          type="button"
                          aria-label="Editar campaña"
                          title="Editar campaña"
                          (click)="abrirEditar(actividad)"
                        >
                          <i class="bi bi-pencil"></i>
                        </button>
                      </td>
                    }
                  </tr>
                } @empty {
                  <tr>
                    <td [attr.colspan]="puedeGestionar() ? 7 : 6" class="text-center text-muted py-5">
                      <i class="bi bi-megaphone d-block fs-4 mb-2"></i>
                      No hay campañas con esos filtros.
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span>{{ rangoTexto() }}</span>
            <nav aria-label="Paginación de campañas">
              <ul class="pagination pagination-sm mb-0">
                <li class="page-item" [class.disabled]="pagina() <= 1">
                  <button class="page-link" type="button" aria-label="Anterior" (click)="irA(pagina() - 1)">
                    <i class="bi bi-chevron-left"></i>
                  </button>
                </li>
                @for (numero of listaPaginas(); track numero) {
                  <li class="page-item" [class.active]="numero === pagina()">
                    <button class="page-link" type="button" (click)="irA(numero)">{{ numero }}</button>
                  </li>
                }
                <li class="page-item" [class.disabled]="pagina() >= paginas()">
                  <button class="page-link" type="button" aria-label="Siguiente" (click)="irA(pagina() + 1)">
                    <i class="bi bi-chevron-right"></i>
                  </button>
                </li>
              </ul>
            </nav>
          </div>
        </section>
      </div>

      <div class="col-xl-4">
        <section class="panel-card h-100">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Mezcla de medios</span>
              <h2>Desempeño por canal</h2>
            </div>
            <span class="badge badge-soft-muted">Ingresos</span>
          </div>

          <div class="channel-list">
            @for (fila of canalesResumen(); track fila.canal) {
              <div class="channel-row">
                <div class="channel-top">
                  <span><span [class]="fila.dot"></span> {{ fila.etiqueta }}</span>
                  <strong>{{ moneda(fila.ingresos) }}</strong>
                </div>
                <div class="channel-track">
                  <span [class]="fila.fill" [style.width]="fila.porcentaje + '%'"></span>
                </div>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">
                Aún no hay campañas registradas para calcular la mezcla de medios.
              </p>
            }
          </div>

          <div class="quote-note">
            <i class="bi bi-info-circle"></i>
            <span>El ingreso atribuido se calcula con el primer contacto registrado en cada pedido.</span>
          </div>

          <a class="btn btn-outline-ink w-100 mt-auto" routerLink="/clientes">
            <i class="bi bi-people"></i> Ver origen de clientes
          </a>
        </section>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-7">
        <section class="panel-card h-100">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Agenda</span>
              <h2>Calendario de actividades</h2>
            </div>
            <span class="badge badge-soft-muted">{{ hoyTexto() }}</span>
          </div>

          <div class="calendar-list">
            @for (actividad of calendario(); track actividad.id) {
              <div class="calendar-item">
                <span class="calendar-date">
                  <strong>{{ diaCalendario(actividad.fechaInicio) }}</strong>
                  <span>{{ mesCalendario(actividad.fechaInicio) }}</span>
                </span>
                <div class="flex-grow-1 min-w-0">
                  <strong>{{ actividad.nombre }}</strong>
                  <small>
                    {{ etiquetaCanal(actividad.canal) }} · {{ periodo(actividad) }} ·
                    {{ moneda(actividad.presupuesto) }} de presupuesto
                  </small>
                </div>
                <span class="badge" [class]="claseEstado(actividad.estado)">
                  {{ etiquetaEstado(actividad.estado) }}
                </span>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">
                No hay actividades programadas. Crea una campaña para llenar el calendario.
              </p>
            }
          </div>
        </section>
      </div>

      <div class="col-lg-5">
        <section class="panel-card h-100">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Presupuesto</span>
              <h2>Inversión vs. plan</h2>
            </div>
            <span class="badge" [class]="presupuesto().porcentaje > 100 ? 'badge-soft-danger' : 'badge-soft-success'">
              {{ presupuesto().porcentaje }}% ejercido
            </span>
          </div>

          <div class="budget-summary">
            <div>
              <span>Presupuesto</span>
              <strong>{{ moneda(presupuesto().plan) }}</strong>
            </div>
            <div>
              <span>Inversión</span>
              <strong>{{ moneda(presupuesto().ejercido) }}</strong>
            </div>
            <div>
              <span>Disponible</span>
              <strong [class]="presupuesto().desviacion ? 'text-danger' : 'text-success'">
                {{ moneda(presupuesto().disponible) }}
              </strong>
            </div>
          </div>

          <div class="budget-track">
            <span [style.width]="presupuesto().porcentaje + '%'"></span>
          </div>

          <div class="budget-list">
            @for (fila of distribucionPresupuesto(); track fila.canal) {
              <div class="budget-row">
                <span class="budget-dot" [style.background]="fila.color"></span>
                <span>{{ fila.etiqueta }}</span>
                <strong>{{ moneda(fila.monto) }}</strong>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">Sin inversión registrada todavía.</p>
            }
          </div>

          @if (puedeGestionar()) {
            <button class="btn btn-ink w-100 mt-3" type="button" (click)="abrirNueva()">
              <i class="bi bi-sliders"></i> Registrar campaña
            </button>
          }
        </section>
      </div>
    </div>
  </div>
</div>

@if (formularioAbierto()) {
  <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="z-index: 1055">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <form [formGroup]="formulario" (ngSubmit)="guardar()">
          <div class="modal-header">
            <div>
              <span class="panel-kicker">{{ editando() ? 'Editar campaña' : 'Nueva campaña' }}</span>
              <h2 class="modal-title h5 mb-0">
                {{ editando() ? editando()!.nombre : 'Registrar campaña' }}
              </h2>
            </div>
            <button class="btn btn-icon" type="button" aria-label="Cerrar" (click)="cerrarFormulario()">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>

          <div class="modal-body">
            <div class="row g-3">
              <div class="col-md-7">
                <label class="form-label" for="campNombre">Nombre de la campaña *</label>
                <input id="campNombre" class="form-control" formControlName="nombre" />
                @if (formulario.controls.nombre.invalid && formulario.controls.nombre.touched) {
                  <small class="text-danger">Indica al menos tres caracteres.</small>
                }
              </div>
              <div class="col-md-5">
                <label class="form-label" for="campCanal">Canal</label>
                <select id="campCanal" class="form-select" formControlName="canal">
                  @for (canal of canales; track canal.valor) {
                    <option [value]="canal.valor">{{ canal.etiqueta }}</option>
                  }
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="campEstado">Estado</label>
                <select id="campEstado" class="form-select" formControlName="estado">
                  @for (estado of estados; track estado.valor) {
                    <option [value]="estado.valor">{{ estado.etiqueta }}</option>
                  }
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="campInicio">Inicio *</label>
                <input id="campInicio" type="date" class="form-control" formControlName="fechaInicio" />
              </div>
              <div class="col-md-4">
                <label class="form-label" for="campFin">Fin</label>
                <input id="campFin" type="date" class="form-control" formControlName="fechaFin" />
              </div>
              <div class="col-md-4">
                <label class="form-label" for="campPresupuesto">Presupuesto</label>
                <input id="campPresupuesto" type="number" min="0" step="0.01" class="form-control" formControlName="presupuesto" />
              </div>
              <div class="col-md-4">
                <label class="form-label" for="campInversion">Inversión real</label>
                <input id="campInversion" type="number" min="0" step="0.01" class="form-control" formControlName="inversionReal" />
              </div>
              <div class="col-md-4">
                <label class="form-label" for="campIngresos">Ingresos atribuidos</label>
                <input id="campIngresos" type="number" min="0" step="0.01" class="form-control" formControlName="ingresosAtribuidos" />
              </div>
              <div class="col-12">
                <label class="form-label" for="campDescripcion">Descripción</label>
                <textarea
                  id="campDescripcion"
                  class="form-control"
                  rows="2"
                  placeholder="Objetivo, audiencia, piezas de la campaña…"
                  formControlName="descripcion"
                ></textarea>
              </div>
            </div>

            <div class="quote-note mt-3 mb-0">
              <i class="bi bi-calculator"></i>
              <span>
                El ROI se calcula automáticamente como ingresos atribuidos entre inversión real.
              </span>
            </div>
          </div>

          <div class="modal-footer">
            <button class="btn btn-outline-ink" type="button" (click)="cerrarFormulario()">Cancelar</button>
            <button class="btn btn-brand" type="submit" [disabled]="guardando()">
              <i class="bi" [class]="guardando() ? 'bi-arrow-repeat spin' : 'bi-check2'"></i>
              {{ guardando() ? 'Guardando…' : 'Guardar campaña' }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}
</file>

<file path="src/app/llamma/marketing/marketing.component.ts">
import {
  ChangeDetectionStrategy,
  Component,
  OnInit,
  computed,
  inject,
  signal,
} from '@angular/core';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { finalize } from 'rxjs';

import { AuthService } from '../auth.service';
import {
  ActividadMarketingApi,
  CanalMarketing,
  EstadoActividadMarketing,
} from '../llamma.models';
import { LlammaService } from '../llamma.service';
import { UiService } from '../ui.service';

const CANALES: Array<{ valor: CanalMarketing; etiqueta: string; icono: string; dot: string }> = [
  { valor: 'redes-sociales', etiqueta: 'Redes sociales', icono: 'bi-camera', dot: 'dot-cyan' },
  { valor: 'google-ads', etiqueta: 'Google Ads', icono: 'bi-google', dot: 'dot-yellow' },
  { valor: 'correo', etiqueta: 'Email', icono: 'bi-envelope-paper', dot: 'dot-ink' },
  { valor: 'punto-de-venta', etiqueta: 'Punto de venta', icono: 'bi-shop', dot: 'dot-magenta' },
  { valor: 'referidos', etiqueta: 'Referidos', icono: 'bi-people', dot: 'dot-cyan' },
  { valor: 'otro', etiqueta: 'Otro', icono: 'bi-three-dots', dot: 'dot-ink' },
];

const ESTADOS: Array<{ valor: EstadoActividadMarketing; etiqueta: string; badge: string }> = [
  { valor: 'planeada', etiqueta: 'Planeación', badge: 'badge-soft-warning' },
  { valor: 'activa', etiqueta: 'Activa', badge: 'badge-soft-cyan' },
  { valor: 'finalizada', etiqueta: 'Finalizada', badge: 'badge-soft-success' },
  { valor: 'cancelada', etiqueta: 'Cancelada', badge: 'badge-soft-danger' },
];

const TONO_CANAL: Record<string, string> = {
  'redes-sociales': 'icon-tile-cyan',
  'google-ads': 'icon-tile-yellow',
  correo: 'icon-tile-ink',
  'punto-de-venta': 'icon-tile-magenta',
  referidos: 'icon-tile-cyan',
  otro: 'icon-tile-ink',
};

const FILL_CANAL: Record<string, string> = {
  'redes-sociales': 'fill-cyan',
  'google-ads': 'fill-yellow',
  correo: 'fill-ink',
  'punto-de-venta': 'fill-magenta',
  referidos: 'fill-cyan',
  otro: 'fill-muted',
};

@Component({
  selector: 'app-marketing',
  imports: [ReactiveFormsModule, RouterLink],
  templateUrl: './marketing.component.html',
  styleUrl: './marketing.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class MarketingComponent implements OnInit {
  private readonly service = inject(LlammaService);
  private readonly ui = inject(UiService);
  private readonly fb = inject(FormBuilder);
  readonly auth = inject(AuthService);

  readonly canales = CANALES;
  readonly estados = ESTADOS;

  readonly actividades = signal<ActividadMarketingApi[]>([]);
  readonly cargando = signal(true);
  readonly error = signal<string | null>(null);
  readonly pagina = signal(1);
  readonly porPagina = 6;

  readonly formularioAbierto = signal(false);
  readonly editando = signal<ActividadMarketingApi | null>(null);
  readonly guardando = signal(false);

  readonly puedeGestionar = computed(() => this.auth.tieneRol('admin', 'marketing'));

  readonly filtros = this.fb.nonNullable.group({ q: [''], canal: [''], estado: [''] });

  readonly formulario = this.fb.nonNullable.group({
    nombre: ['', [Validators.required, Validators.minLength(3)]],
    canal: ['redes-sociales' as CanalMarketing, [Validators.required]],
    estado: ['planeada' as EstadoActividadMarketing, [Validators.required]],
    fechaInicio: [this.hoyISO(), [Validators.required]],
    fechaFin: [''],
    presupuesto: [0, [Validators.required, Validators.min(0)]],
    inversionReal: [0, [Validators.required, Validators.min(0)]],
    ingresosAtribuidos: [0, [Validators.required, Validators.min(0)]],
    descripcion: [''],
  });

  readonly filtradas = computed(() => {
    const { q, canal, estado } = this.filtros.getRawValue();
    const termino = q.trim().toLowerCase();
    return this.actividades().filter((actividad) => {
      if (canal && actividad.canal !== canal) return false;
      if (estado && actividad.estado !== estado) return false;
      if (!termino) return true;
      return [actividad.nombre, actividad.descripcion ?? '', this.etiquetaCanal(actividad.canal)]
        .join(' ')
        .toLowerCase()
        .includes(termino);
    });
  });

  readonly paginas = computed(() => Math.max(1, Math.ceil(this.filtradas().length / this.porPagina)));

  readonly visibles = computed(() => {
    const inicio = (this.pagina() - 1) * this.porPagina;
    return this.filtradas().slice(inicio, inicio + this.porPagina);
  });

  readonly listaPaginas = computed(() => {
    const total = this.paginas();
    const actual = this.pagina();
    const desde = Math.max(1, actual - 2);
    const hasta = Math.min(total, desde + 4);
    return Array.from({ length: Math.max(0, hasta - desde + 1) }, (_, i) => desde + i);
  });

  readonly estadisticas = computed(() => {
    const actividades = this.actividades();
    const activas = actividades.filter((actividad) => actividad.estado === 'activa');
    const inversion = actividades.reduce((total, a) => total + Number(a.inversionReal ?? 0), 0);
    const ingresos = actividades.reduce((total, a) => total + Number(a.ingresosAtribuidos ?? 0), 0);
    const roi = inversion > 0 ? ingresos / inversion : 0;
    return [
      {
        icono: 'bi-wallet2',
        tono: 'icon-tile-cyan',
        valor: this.moneda(inversion),
        etiqueta: 'Inversión ejercida',
      },
      {
        icono: 'bi-graph-up-arrow',
        tono: 'icon-tile-magenta',
        valor: this.moneda(ingresos),
        etiqueta: 'Ingresos atribuidos',
      },
      {
        icono: 'bi-stars',
        tono: 'icon-tile-yellow',
        valor: `${roi.toFixed(1)}x`,
        etiqueta: 'Retorno de inversión',
      },
      {
        icono: 'bi-megaphone',
        tono: 'icon-tile-success',
        valor: this.dosDigitos(activas.length),
        etiqueta: 'Campañas activas',
      },
    ];
  });

  readonly canalesResumen = computed(() => {
    const mapa = new Map<string, { ingresos: number; inversion: number; campanas: number }>();
    for (const actividad of this.actividades()) {
      const fila = mapa.get(actividad.canal) ?? { ingresos: 0, inversion: 0, campanas: 0 };
      fila.ingresos += Number(actividad.ingresosAtribuidos ?? 0);
      fila.inversion += Number(actividad.inversionReal ?? 0);
      fila.campanas += 1;
      mapa.set(actividad.canal, fila);
    }
    const filas = [...mapa.entries()]
      .map(([canal, datos]) => ({ canal, ...datos }))
      .sort((a, b) => b.ingresos - a.ingresos);
    const maximo = Math.max(1, ...filas.map((fila) => fila.ingresos));
    return filas.slice(0, 6).map((fila) => ({
      ...fila,
      porcentaje: Math.max(4, Math.round((fila.ingresos / maximo) * 100)),
      etiqueta: this.etiquetaCanal(fila.canal),
      dot: `channel-dot ${this.dotCanal(fila.canal)}`,
      fill: FILL_CANAL[fila.canal] ?? 'fill-muted',
    }));
  });

  readonly presupuesto = computed(() => {
    const actividades = this.actividades().filter(
      (actividad) => actividad.estado !== 'cancelada',
    );
    const plan = actividades.reduce((total, a) => total + Number(a.presupuesto ?? 0), 0);
    const ejercido = actividades.reduce((total, a) => total + Number(a.inversionReal ?? 0), 0);
    const disponible = Math.max(plan - ejercido, 0);
    const porcentaje = plan > 0 ? Math.min(100, Math.round((ejercido / plan) * 100)) : 0;
    return {
      plan,
      ejercido,
      disponible,
      porcentaje,
      desviacion: ejercido > plan ? ejercido - plan : 0,
    };
  });

  readonly calendario = computed(() =>
    this.actividades()
      .filter((actividad) => actividad.estado === 'activa' || actividad.estado === 'planeada')
      .sort((a, b) => String(a.fechaInicio).localeCompare(String(b.fechaInicio)))
      .slice(0, 5),
  );

  readonly distribucionPresupuesto = computed(() => {
    const mapa = new Map<string, number>();
    for (const actividad of this.actividades()) {
      if (actividad.estado === 'cancelada') continue;
      mapa.set(
        actividad.canal,
        (mapa.get(actividad.canal) ?? 0) + Number(actividad.inversionReal ?? 0),
      );
    }
    const filas = [...mapa.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4);
    const total = filas.reduce((suma, fila) => suma + fila[1], 0) || 1;
    return filas.map(([canal, monto], indice) => ({
      canal,
      etiqueta: this.etiquetaCanal(canal),
      monto,
      porcentaje: Math.round((monto / total) * 100),
      color: ['var(--llamma-cyan)', 'var(--llamma-magenta)', 'var(--llamma-yellow)', 'var(--llamma-carbon)'][
        indice % 4
      ],
    }));
  });

  ngOnInit(): void {
    this.cargar();
  }

  cargar(): void {
    this.cargando.set(true);
    this.error.set(null);
    this.service
      .listarActividades()
      .pipe(finalize(() => this.cargando.set(false)))
      .subscribe({
        next: (respuesta) => {
          this.actividades.set(respuesta.items);
          const paginas = Math.max(1, Math.ceil(this.filtradas().length / this.porPagina));
          if (this.pagina() > paginas) this.pagina.set(paginas);
        },
        error: (error) => {
          this.error.set(this.ui.mensajeDeError(error, 'No pudimos cargar las campañas.'));
        },
      });
  }

  filtrar(): void {
    this.pagina.set(1);
  }

  limpiar(): void {
    this.filtros.reset({ q: '', canal: '', estado: '' });
    this.pagina.set(1);
  }

  irA(pagina: number): void {
    this.pagina.set(Math.min(Math.max(pagina, 1), this.paginas()));
  }

  abrirNueva(): void {
    this.editando.set(null);
    this.formulario.reset({
      nombre: '',
      canal: 'redes-sociales',
      estado: 'planeada',
      fechaInicio: this.hoyISO(),
      fechaFin: '',
      presupuesto: 0,
      inversionReal: 0,
      ingresosAtribuidos: 0,
      descripcion: '',
    });
    this.formularioAbierto.set(true);
  }

  abrirEditar(actividad: ActividadMarketingApi): void {
    this.editando.set(actividad);
    this.formulario.reset({
      nombre: actividad.nombre,
      canal: actividad.canal,
      estado: actividad.estado,
      fechaInicio: actividad.fechaInicio ?? this.hoyISO(),
      fechaFin: actividad.fechaFin ?? '',
      presupuesto: Number(actividad.presupuesto ?? 0),
      inversionReal: Number(actividad.inversionReal ?? 0),
      ingresosAtribuidos: Number(actividad.ingresosAtribuidos ?? 0),
      descripcion: actividad.descripcion ?? '',
    });
    this.formularioAbierto.set(true);
  }

  cerrarFormulario(): void {
    this.formularioAbierto.set(false);
    this.editando.set(null);
  }

  guardar(): void {
    if (this.formulario.invalid) {
      this.formulario.markAllAsTouched();
      return;
    }
    const valores = this.formulario.getRawValue();
    const body: Record<string, unknown> = {
      nombre: valores.nombre.trim(),
      canal: valores.canal,
      estado: valores.estado,
      fechaInicio: valores.fechaInicio,
      fechaFin: valores.fechaFin || null,
      presupuesto: Number(valores.presupuesto),
      inversionReal: Number(valores.inversionReal),
      ingresosAtribuidos: Number(valores.ingresosAtribuidos),
      descripcion: valores.descripcion.trim() || null,
    };
    const edicion = this.editando();
    this.guardando.set(true);
    const peticion = edicion
      ? this.service.actualizarActividad(edicion.id, body)
      : this.service.crearActividad(body);
    peticion.pipe(finalize(() => this.guardando.set(false))).subscribe({
      next: () => {
        this.ui.exito(edicion ? 'Campaña actualizada.' : 'Campaña registrada.');
        this.cerrarFormulario();
        this.cargar();
      },
      error: (error) =>
        this.ui.error(this.ui.mensajeDeError(error, 'No pudimos guardar la campaña.')),
    });
  }

  cambiarEstado(evento: Event, actividad: ActividadMarketingApi): void {
    const estado = (evento.target as HTMLSelectElement).value as EstadoActividadMarketing;
    if (estado === actividad.estado) return;
    this.service.actualizarActividad(actividad.id, { estado }).subscribe({
      next: (actualizada) => {
        this.actividades.update((lista) =>
          lista.map((fila) => (fila.id === actualizada.id ? actualizada : fila)),
        );
        this.ui.exito(`Campaña ${actualizada.nombre}: ${this.etiquetaEstado(actualizada.estado)}.`);
      },
      error: (error) => {
        (evento.target as HTMLSelectElement).value = actividad.estado;
        this.ui.error(this.ui.mensajeDeError(error, 'No pudimos cambiar el estado.'));
      },
    });
  }

  exportar(): void {
    const filas = [
      [
        'Campaña',
        'Canal',
        'Estado',
        'Inicio',
        'Fin',
        'Presupuesto',
        'Inversión',
        'Ingresos atribuidos',
        'ROI',
      ],
      ...this.filtradas().map((actividad) => [
        actividad.nombre,
        this.etiquetaCanal(actividad.canal),
        this.etiquetaEstado(actividad.estado),
        actividad.fechaInicio ?? '',
        actividad.fechaFin ?? '',
        String(actividad.presupuesto),
        String(actividad.inversionReal),
        String(actividad.ingresosAtribuidos),
        `${Number(actividad.roi ?? 0).toFixed(2)}x`,
      ]),
    ];
    const csv = filas.map((fila) => fila.map((celda) => `"${celda}"`).join(',')).join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    const enlace = document.createElement('a');
    enlace.href = url;
    enlace.download = 'campanas-llamma.csv';
    enlace.click();
    URL.revokeObjectURL(url);
    this.ui.exito('Campañas exportadas en CSV.');
  }

  etiquetaCanal(canal: string): string {
    return CANALES.find((fila) => fila.valor === canal)?.etiqueta ?? canal;
  }

  iconoCanal(canal: string): string {
    return CANALES.find((fila) => fila.valor === canal)?.icono ?? 'bi-three-dots';
  }

  dotCanal(canal: string): string {
    return CANALES.find((fila) => fila.valor === canal)?.dot ?? 'dot-ink';
  }

  tonoCanal(canal: string): string {
    return TONO_CANAL[canal] ?? 'icon-tile-ink';
  }

  etiquetaEstado(estado: string): string {
    return ESTADOS.find((fila) => fila.valor === estado)?.etiqueta ?? estado;
  }

  claseEstado(estado: string): string {
    return ESTADOS.find((fila) => fila.valor === estado)?.badge ?? 'badge-soft-muted';
  }

  claseRoi(roi: number): string {
    const valor = Number(roi ?? 0);
    if (valor >= 4) return 'badge-soft-success';
    if (valor >= 2) return 'badge-soft-cyan';
    if (valor > 0) return 'badge-soft-warning';
    return 'badge-soft-muted';
  }

  periodo(actividad: ActividadMarketingApi): string {
    const inicio = this.fechaCorta(actividad.fechaInicio);
    if (!actividad.fechaFin) return `${inicio} · en curso`;
    return `${inicio} – ${this.fechaCorta(actividad.fechaFin)}`;
  }
  rangoTexto(): string {
    const total = this.filtradas().length;
    const inicio = total ? (this.pagina() - 1) * this.porPagina + 1 : 0;
    return `Mostrando ${inicio}–${Math.min(this.pagina() * this.porPagina, total)} de ${total} campañas`;
  }

  diaCalendario(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    return fecha ? String(fecha.getDate()).padStart(2, '0') : '—';
  }

  mesCalendario(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    return fecha
      ? fecha.toLocaleDateString('es-MX', { month: 'short' }).replace('.', '').toUpperCase()
      : '—';
  }

  hoyTexto(): string {
    return new Date().toLocaleDateString('es-MX', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    });
  }

  moneda(valor: number | null | undefined): string {
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0,
    }).format(Number(valor ?? 0));
  }

  fechaCorta(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    if (!fecha) return 'Sin fecha';
    const opciones: Intl.DateTimeFormatOptions =
      fecha.getFullYear() === new Date().getFullYear()
        ? { day: '2-digit', month: 'short' }
        : { day: '2-digit', month: 'short', year: 'numeric' };
    return fecha.toLocaleDateString('es-MX', opciones);
  }

  private aFecha(valor: string | null | undefined): Date | null {
    if (!valor) return null;
    const fecha = new Date(valor.length > 10 ? valor : `${valor}T00:00:00`);
    return Number.isNaN(fecha.getTime()) ? null : fecha;
  }

  private hoyISO(): string {
    const fecha = new Date();
    const mes = String(fecha.getMonth() + 1).padStart(2, '0');
    const dia = String(fecha.getDate()).padStart(2, '0');
    return `${fecha.getFullYear()}-${mes}-${dia}`;
  }

  private dosDigitos(valor: number): string {
    return String(valor).padStart(2, '0');
  }
}
