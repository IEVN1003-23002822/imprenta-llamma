<file path="src/app/llamma/clientes/clientes.component.html">
<div class="module-page clientes-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Relación y seguimiento</span>
        <h1>Directorio de clientes.</h1>
        <p class="page-lead">
          Segmentación, datos fiscales, historial de compras y notas de seguimiento para cada
          cuenta. Todo el contexto comercial en un solo lugar.
        </p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-ink" type="button" (click)="exportar()">
          <i class="bi bi-download"></i> Exportar
        </button>
        @if (puedeGestionar()) {
          <button class="btn btn-brand" type="button" (click)="abrirNuevo()">
            <i class="bi bi-person-plus"></i> Nuevo cliente
          </button>
        }
      </div>
    </header>

    <div class="row g-3 mb-4">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-sm-6 col-xl-3">
          <div class="client-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div><strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span></div>
          </div>
        </div>
      }
    </div>

    <div class="row g-4">
      <div class="col-xl-8">
        <section class="panel-card h-100">
          <div class="panel-head flex-wrap">
            <div>
              <span class="panel-kicker">Base comercial</span>
              <h2>Clientes registrados</h2>
            </div>
            <div class="d-flex align-items-center gap-2">
              <span class="badge badge-soft-success">{{ total() }} cuentas</span>
              @if (cargando()) {
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
              }
            </div>
          </div>

          <form class="row g-2 mb-3" [formGroup]="filtros" (ngSubmit)="buscar()">
            <div class="col-lg-6">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input
                  type="search"
                  class="form-control"
                  placeholder="Buscar cliente, empresa o RFC…"
                  aria-label="Buscar cliente"
                  formControlName="q"
                />
                <button class="btn btn-ink" type="submit">Buscar</button>
              </div>
            </div>
            <div class="col-6 col-lg-3">
              <select class="form-select" aria-label="Filtrar por segmento" formControlName="segmento">
                <option value="">Todos los segmentos</option>
                @for (segmento of segmentos; track segmento.valor) {
                  <option [value]="segmento.valor">{{ segmento.etiqueta }}</option>
                }
              </select>
            </div>
            <div class="col-6 col-lg-3">
              <div class="d-flex gap-2">
                <select class="form-select" aria-label="Filtrar por estado" formControlName="estado">
                  <option value="">Todo estado</option>
                  <option value="activo">Activo</option>
                  <option value="inactivo">Inactivo</option>
                </select>
                <button class="btn btn-soft" type="button" aria-label="Limpiar filtros" (click)="limpiar()">
                  <i class="bi bi-arrow-counterclockwise"></i>
                </button>
              </div>
            </div>
          </form>

          @if (error()) {
            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
              <i class="bi bi-exclamation-octagon-fill"></i>
              <span class="flex-grow-1">{{ error() }}</span>
              <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar(pagina())">
                Reintentar
              </button>
            </div>
          }

          <div class="table-responsive">
            <table class="table table-llamma align-middle">
              <thead>
                <tr>
                  <th>Cliente</th>
                  <th>Segmento</th>
                  <th>Contacto</th>
                  <th class="text-center">Pedidos</th>
                  <th>Alta</th>
                  <th class="text-end">Total</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                @for (cliente of clientes(); track cliente.id) {
                  <tr
                    role="button"
                    [class.table-active]="cliente.id === seleccionado()?.id"
                    (click)="seleccionar(cliente)"
                  >
                    <td>
                      <div class="client-cell">
                        <span class="avatar" [class]="'avatar ' + avatar(cliente.id)">
                          {{ iniciales(cliente.nombre) }}
                        </span>
                        <div>
                          <strong>{{ cliente.nombre }}</strong>
                          <small>{{ cliente.rfc ? 'RFC · ' + cliente.rfc : cliente.correo }}</small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge" [class]="claseSegmento(cliente.segmento)">
                        {{ etiquetaSegmento(cliente.segmento) }}
                      </span>
                    </td>
                    <td>
                      <div class="cell-main">{{ cliente.correo }}</div>
                      <div class="cell-muted">{{ cliente.telefono || 'Sin teléfono' }}</div>
                    </td>
                    <td class="text-center">{{ cliente.totalPedidos ?? 0 }}</td>
                    <td>{{ fechaCorta(cliente.fechaRegistro) }}</td>
                    <td class="text-end cell-main">{{ moneda(cliente.totalFacturado) }}</td>
                    <td>
                      <span class="badge" [class]="cliente.activo ? 'badge-soft-success' : 'badge-soft-muted'">
                        {{ cliente.activo ? 'Activo' : 'Inactivo' }}
                      </span>
                    </td>
                  </tr>
                } @empty {
                  <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                      <i class="bi bi-people d-block fs-4 mb-2"></i>
                      No hay clientes con esos filtros.
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span>{{ rangoTexto() }}</span>
            <nav aria-label="Paginación de clientes">
              <ul class="pagination pagination-sm mb-0">
                <li class="page-item" [class.disabled]="pagina() <= 1">
                  <button class="page-link" type="button" aria-label="Anterior" (click)="cargar(pagina() - 1)">
                    <i class="bi bi-chevron-left"></i>
                  </button>
                </li>
                @for (numero of listaPaginas(); track numero) {
                  <li class="page-item" [class.active]="numero === pagina()">
                    <button class="page-link" type="button" (click)="cargar(numero)">{{ numero }}</button>
                  </li>
                }
                <li class="page-item" [class.disabled]="pagina() >= paginas()">
                  <button class="page-link" type="button" aria-label="Siguiente" (click)="cargar(pagina() + 1)">
                    <i class="bi bi-chevron-right"></i>
                  </button>
                </li>
              </ul>
            </nav>
          </div>
        </section>
      </div>

      <div class="col-xl-4">
        @if (seleccionado(); as cliente) {
          <section class="client-profile mb-4">
            <div class="profile-head">
              <span class="profile-avatar">{{ iniciales(cliente.nombre) }}</span>
              <div>
                <span class="panel-kicker">Cliente seleccionado</span>
                <h2>{{ cliente.nombre }}</h2>
                <span class="badge" [class]="claseSegmento(cliente.segmento)">
                  {{ etiquetaSegmento(cliente.segmento) }}
                </span>
              </div>
            </div>

            <ul class="profile-contact">
              <li><i class="bi bi-building"></i> {{ cliente.empresa || 'Sin empresa registrada' }}</li>
              <li><i class="bi bi-envelope"></i> {{ cliente.correo }}</li>
              <li><i class="bi bi-telephone"></i> {{ cliente.telefono || 'Sin teléfono' }}</li>
              <li><i class="bi bi-geo-alt"></i> {{ cliente.direccion || 'Sin dirección' }}</li>
            </ul>

            <div class="profile-stats">
              <div><strong>{{ cliente.totalPedidos ?? 0 }}</strong><span>Pedidos</span></div>
              <div><strong>{{ moneda(cliente.totalFacturado) }}</strong><span>Facturado</span></div>
              <div><strong>{{ ticket(cliente) }}</strong><span>Ticket</span></div>
            </div>

            <div class="client-tags">
              <span>{{ etiquetaSegmento(cliente.segmento) }}</span>
              <span>{{ cliente.activo ? 'Activo' : 'Inactivo' }}</span>
              @if ((cliente.totalPedidos ?? 0) > 1) {
                <span>Recurrente</span>
              }
            </div>

            @if (puedeGestionar()) {
              <button class="btn btn-brand w-100" type="button" (click)="abrirEditar(cliente)">
                <i class="bi bi-pencil-square"></i> Editar ficha
              </button>
            }
            @if (puedeDesactivar() && cliente.activo) {
              <button class="btn btn-outline-ink w-100 mt-2" type="button" (click)="desactivar(cliente)">
                <i class="bi bi-person-dash"></i> Desactivar cliente
              </button>
            }
          </section>

          <section class="panel-card mb-4">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Seguimiento</span>
                <h2>Notas del expediente</h2>
              </div>
              <span class="badge badge-soft-muted">{{ notas().length }}</span>
            </div>

            <div class="note-list">
              @for (nota of notas(); track nota) {
                <div class="note-item">
                  <span class="note-dot dot-cyan"></span>
                  <div>
                    <p>{{ nota }}</p>
                  </div>
                </div>
              } @empty {
                <p class="text-muted mb-0 small">Este cliente todavía no tiene notas de seguimiento.</p>
              }
            </div>

            @if (puedeGestionar()) {
              @if (!notaAbierta()) {
                <button class="btn btn-outline-ink w-100 mt-3" type="button" (click)="notaAbierta.set(true)">
                  <i class="bi bi-journal-plus"></i> Agregar nota
                </button>
              } @else {
                <form class="mt-3" [formGroup]="notaForm" (ngSubmit)="agregarNota()">
                  <textarea
                    class="form-control"
                    rows="2"
                    placeholder="Escribe una nota de seguimiento…"
                    formControlName="nota"
                  ></textarea>
                  <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-brand btn-sm flex-grow-1" type="submit" [disabled]="notaForm.invalid">
                      Guardar nota
                    </button>
                    <button class="btn btn-outline-ink btn-sm" type="button" (click)="notaAbierta.set(false)">
                      Cancelar
                    </button>
                  </div>
                </form>
              }
            }
          </section>
        } @else {
          <section class="panel-card mb-4">
            <p class="text-muted mb-0">Selecciona un cliente para ver su ficha completa.</p>
          </section>
        }

        <section class="panel-card">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Composición</span>
              <h2>Segmentos de clientes</h2>
            </div>
            @if (cargandoTodos()) {
              <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
            }
          </div>

          <div class="segment-list">
            @for (segmento of distribucion(); track segmento.valor) {
              <div class="segment-row">
                <div class="segment-top">
                  <span>{{ segmento.etiqueta }}</span><strong>{{ segmento.cantidad }}</strong>
                </div>
                <div class="segment-track">
                  <span [style.width]="segmento.porcentaje + '%'"></span>
                </div>
              </div>
            }
          </div>
        </section>
      </div>
    </div>
  </div>
</div>

@if (formularioAbierto()) {
  <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="z-index: 1055">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <form [formGroup]="formulario" (ngSubmit)="guardar()">
          <div class="modal-header">
            <div>
              <span class="panel-kicker">{{ editando() ? 'Editar cliente' : 'Alta de cliente' }}</span>
              <h2 class="modal-title h5 mb-0">
                {{ editando() ? editando()!.nombre : 'Nuevo cliente' }}
              </h2>
            </div>
            <button class="btn btn-icon" type="button" aria-label="Cerrar" (click)="cerrarFormulario()">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>

          <div class="modal-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="clienteNombre">Nombre o razón social *</label>
                <input id="clienteNombre" class="form-control" formControlName="nombre" />
                @if (formulario.controls.nombre.invalid && formulario.controls.nombre.touched) {
                  <small class="text-danger">Indica al menos dos caracteres.</small>
                }
              </div>
              <div class="col-md-6">
                <label class="form-label" for="clienteEmpresa">Empresa</label>
                <input id="clienteEmpresa" class="form-control" formControlName="empresa" />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="clienteCorreo">Correo *</label>
                <input id="clienteCorreo" type="email" class="form-control" formControlName="correo" />
                @if (formulario.controls.correo.invalid && formulario.controls.correo.touched) {
                  <small class="text-danger">Captura un correo válido.</small>
                }
              </div>
              <div class="col-md-6">
                <label class="form-label" for="clienteTelefono">Teléfono</label>
                <input id="clienteTelefono" class="form-control" formControlName="telefono" />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="clienteRfc">RFC</label>
                <input id="clienteRfc" class="form-control" formControlName="rfc" maxlength="20" />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="clienteSegmento">Segmento</label>
                <select id="clienteSegmento" class="form-select" formControlName="segmento">
                  @for (segmento of segmentos; track segmento.valor) {
                    <option [value]="segmento.valor">{{ segmento.etiqueta }}</option>
                  }
                </select>
              </div>
              <div class="col-12">
                <label class="form-label" for="clienteDireccion">Dirección</label>
                <input id="clienteDireccion" class="form-control" formControlName="direccion" />
              </div>
              <div class="col-12">
                <label class="form-label" for="clienteNotas">Notas</label>
                <textarea id="clienteNotas" class="form-control" rows="3" formControlName="notas"></textarea>
              </div>
              <div class="col-12">
                <div class="form-check form-switch">
                  <input id="clienteActivo" class="form-check-input" type="checkbox" formControlName="activo" />
                  <label class="form-check-label" for="clienteActivo">Cliente activo</label>
                </div>
              </div>
            </div>
          </div>

          <div class="modal-footer">
            <button class="btn btn-outline-ink" type="button" (click)="cerrarFormulario()">Cancelar</button>
            <button class="btn btn-brand" type="submit" [disabled]="guardando()">
              <i class="bi" [class]="guardando() ? 'bi-arrow-repeat spin' : 'bi-check2'"></i>
              {{ guardando() ? 'Guardando…' : 'Guardar cliente' }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}
</file>

<file path="src/app/llamma/clientes/clientes.component.ts">
import {
  ChangeDetectionStrategy,
  Component,
  OnInit,
  computed,
  inject,
  signal,
} from '@angular/core';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { finalize } from 'rxjs';

import { AuthService } from '../auth.service';
import { ClienteApi, SegmentoCliente } from '../llamma.models';
import { LlammaService } from '../llamma.service';
import { UiService } from '../ui.service';

const SEGMENTOS: { valor: SegmentoCliente; etiqueta: string }[] = [
  { valor: 'corporativo', etiqueta: 'Corporativo' },
  { valor: 'pyme', etiqueta: 'Pyme' },
  { valor: 'eventos', etiqueta: 'Eventos' },
  { valor: 'escolar', etiqueta: 'Escolar' },
  { valor: 'particular', etiqueta: 'Particular' },
];

const COLOR_SEGMENTO: Record<string, string> = {
  corporativo: 'badge-soft-cyan',
  pyme: 'badge-soft-magenta',
  eventos: 'badge-soft-yellow',
  escolar: 'badge-soft-muted',
  particular: 'badge-soft-success',
};

@Component({
  selector: 'app-clientes',
  imports: [ReactiveFormsModule],
  templateUrl: './clientes.component.html',
  styleUrl: './clientes.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class ClientesComponent implements OnInit {
  private readonly service = inject(LlammaService);
  private readonly ui = inject(UiService);
  private readonly fb = inject(FormBuilder);
  readonly auth = inject(AuthService);

  readonly segmentos = SEGMENTOS;
  readonly clientes = signal<ClienteApi[]>([]);
  readonly todos = signal<ClienteApi[]>([]);
  readonly seleccionado = signal<ClienteApi | null>(null);
  readonly cargando = signal(false);
  readonly cargandoTodos = signal(true);
  readonly error = signal<string | null>(null);
  readonly pagina = signal(1);
  readonly paginas = signal(1);
  readonly total = signal(0);
  readonly formularioAbierto = signal(false);
  readonly editando = signal<ClienteApi | null>(null);
  readonly guardando = signal(false);
  readonly notaAbierta = signal(false);

  readonly puedeGestionar = computed(() => this.auth.tieneRol('admin', 'ventas'));
  readonly puedeDesactivar = computed(() => this.auth.tieneRol('admin'));

  readonly filtros = this.fb.nonNullable.group({
    q: [''],
    segmento: [''],
    estado: [''],
  });

  readonly formulario = this.fb.nonNullable.group({
    nombre: ['', [Validators.required, Validators.minLength(2)]],
    empresa: [''],
    correo: ['', [Validators.required, Validators.email]],
    telefono: [''],
    rfc: [''],
    direccion: [''],
    segmento: ['particular' as SegmentoCliente, [Validators.required]],
    notas: [''],
    activo: [true],
  });

  readonly notaForm = this.fb.nonNullable.group({ nota: ['', [Validators.required]] });

  readonly estadisticas = computed(() => {
    const todos = this.todos();
    const activos = todos.filter((cliente) => cliente.activo).length;
    const ahora = new Date();
    const nuevos = todos.filter((cliente) => {
      const fecha = new Date(cliente.fechaRegistro);
      return fecha.getFullYear() === ahora.getFullYear() && fecha.getMonth() === ahora.getMonth();
    }).length;
    const pedidos = todos.reduce((total, cliente) => total + (cliente.totalPedidos ?? 0), 0);
    const facturado = todos.reduce((total, cliente) => total + (cliente.totalFacturado ?? 0), 0);
    const recurrentes = todos.filter((cliente) => (cliente.totalPedidos ?? 0) > 1).length;
    const conPedidos = todos.filter((cliente) => (cliente.totalPedidos ?? 0) > 0).length;

    return [
      {
        icono: 'bi-people',
        tono: 'icon-tile-cyan',
        valor: String(activos),
        etiqueta: 'Clientes activos',
      },
      {
        icono: 'bi-person-plus',
        tono: 'icon-tile-magenta',
        valor: String(nuevos),
        etiqueta: 'Nuevos este mes',
      },
      {
        icono: 'bi-receipt-cutoff',
        tono: 'icon-tile-yellow',
        valor: this.moneda(pedidos ? facturado / pedidos : 0),
        etiqueta: 'Ticket promedio',
      },
      {
        icono: 'bi-arrow-repeat',
        tono: 'icon-tile-success',
        valor: `${conPedidos ? Math.round((recurrentes / conPedidos) * 100) : 0}%`,
        etiqueta: 'Tasa de recompra',
      },
    ];
  });

  readonly distribucion = computed(() => {
    const todos = this.todos();
    const total = Math.max(1, todos.length);
    return SEGMENTOS.map((segmento) => {
      const cantidad = todos.filter((cliente) => cliente.segmento === segmento.valor).length;
      return {
        ...segmento,
        cantidad,
        porcentaje: Math.max(4, Math.round((cantidad / total) * 100)),
      };
    });
  });

  readonly notas = computed(() => {
    const texto = this.seleccionado()?.notas ?? '';
    return texto
      .split('\n')
      .map((linea) => linea.trim())
      .filter(Boolean)
      .reverse();
  });

  readonly listaPaginas = computed(() => {
    const total = this.paginas();
    const actual = this.pagina();
    const desde = Math.max(1, actual - 2);
    const hasta = Math.min(total, desde + 4);
    return Array.from({ length: Math.max(0, hasta - desde + 1) }, (_, i) => desde + i);
  });

  ngOnInit(): void {
    this.cargarTodos();
    this.cargar(1);
  }

  cargarTodos(): void {
    this.cargandoTodos.set(true);
    this.service
      .listarClientes({ page: 1, perPage: 100 })
      .pipe(finalize(() => this.cargandoTodos.set(false)))
      .subscribe({
        next: (respuesta) => this.todos.set(respuesta.items),
        error: () => this.todos.set([]),
      });
  }

  cargar(page = 1): void {
    this.cargando.set(true);
    this.error.set(null);
    const valores = this.filtros.getRawValue();
    this.service
      .listarClientes({
        q: valores.q.trim() || undefined,
        segmento: valores.segmento || undefined,
        activo:
          valores.estado === 'activo' ? true : valores.estado === 'inactivo' ? false : undefined,
        page,
        perPage: 10,
      })
      .pipe(finalize(() => this.cargando.set(false)))
      .subscribe({
        next: (respuesta) => {
          this.clientes.set(respuesta.items);
          this.pagina.set(respuesta.pagina);
          this.paginas.set(respuesta.paginas);
          this.total.set(respuesta.total);
          const actual = this.seleccionado();
          const vigente = respuesta.items.find((cliente) => cliente.id === actual?.id);
          this.seleccionado.set(vigente ?? respuesta.items[0] ?? null);
        },
        error: (error) => {
          this.error.set(this.ui.mensajeDeError(error, 'No pudimos cargar el directorio.'));
        },
      });
  }

  seleccionar(cliente: ClienteApi): void {
    this.seleccionado.set(cliente);
    this.notaAbierta.set(false);
    this.notaForm.reset({ nota: '' });
  }

  buscar(): void {
    this.cargar(1);
  }

  limpiar(): void {
    this.filtros.reset({ q: '', segmento: '', estado: '' });
    this.cargar(1);
  }

  abrirNuevo(): void {
    this.editando.set(null);
    this.formulario.reset({
      nombre: '',
      empresa: '',
      correo: '',
      telefono: '',
      rfc: '',
      direccion: '',
      segmento: 'particular',
      notas: '',
      activo: true,
    });
    this.formularioAbierto.set(true);
  }

  abrirEditar(cliente: ClienteApi): void {
    this.editando.set(cliente);
    this.formulario.reset({
      nombre: cliente.nombre,
      empresa: cliente.empresa ?? '',
      correo: cliente.correo,
      telefono: cliente.telefono ?? '',
      rfc: cliente.rfc ?? '',
      direccion: cliente.direccion ?? '',
      segmento: cliente.segmento,
      notas: cliente.notas ?? '',
      activo: cliente.activo,
    });
    this.formularioAbierto.set(true);
  }

  cerrarFormulario(): void {
    this.formularioAbierto.set(false);
    this.editando.set(null);
  }

  guardar(): void {
    if (this.formulario.invalid) {
      this.formulario.markAllAsTouched();
      return;
    }
    const valores = this.formulario.getRawValue();
    const edicion = this.editando();
    this.guardando.set(true);
    const peticion = edicion
      ? this.service.actualizarCliente(edicion.id, valores)
      : this.service.crearCliente(valores);

    peticion.pipe(finalize(() => this.guardando.set(false))).subscribe({
      next: (cliente) => {
        this.ui.exito(edicion ? 'Cliente actualizado.' : 'Cliente registrado.');
        this.cerrarFormulario();
        this.cargar(edicion ? this.pagina() : 1);
        this.cargarTodos();
        this.seleccionado.set(cliente);
      },
      error: (error) => this.ui.error(this.ui.mensajeDeError(error, 'No pudimos guardar el cliente.')),
    });
  }

  desactivar(cliente: ClienteApi): void {
    if (!window.confirm(`¿Desactivar a ${cliente.nombre}? Su historial se conservará.`)) return;
    this.service.desactivarCliente(cliente.id).subscribe({
      next: () => {
        this.ui.exito('Cliente desactivado.');
        this.cargar(this.pagina());
        this.cargarTodos();
      },
      error: (error) => this.ui.error(this.ui.mensajeDeError(error, 'No pudimos desactivar el cliente.')),
    });
  }

  agregarNota(): void {
    const cliente = this.seleccionado();
    if (!cliente || this.notaForm.invalid) return;
    const autor = this.auth.usuario()?.nombre ?? 'Equipo';
    const fecha = new Date().toLocaleDateString('es-MX', { day: '2-digit', month: 'short' });
    const nueva = `[${fecha} · ${autor}] ${this.notaForm.getRawValue().nota.trim()}`;
    const notas = [cliente.notas, nueva].filter(Boolean).join('\n');

    this.service.actualizarCliente(cliente.id, { notas }).subscribe({
      next: (actualizado) => {
        this.seleccionado.set(actualizado);
        this.todos.update((lista) =>
          lista.map((fila) => (fila.id === actualizado.id ? { ...fila, notas: actualizado.notas } : fila)),
        );
        this.clientes.update((lista) =>
          lista.map((fila) => (fila.id === actualizado.id ? { ...fila, notas: actualizado.notas } : fila)),
        );
        this.notaForm.reset({ nota: '' });
        this.notaAbierta.set(false);
        this.ui.exito('Nota agregada al expediente.');
      },
      error: (error) => this.ui.error(this.ui.mensajeDeError(error, 'No pudimos guardar la nota.')),
    });
  }

  exportar(): void {
    const filas = [
      ['Nombre', 'Empresa', 'Correo', 'Teléfono', 'RFC', 'Segmento', 'Pedidos', 'Facturado', 'Activo'],
      ...this.todos().map((cliente) => [
        cliente.nombre,
        cliente.empresa ?? '',
        cliente.correo,
        cliente.telefono ?? '',
        cliente.rfc ?? '',
        this.etiquetaSegmento(cliente.segmento),
        String(cliente.totalPedidos ?? 0),
        String(cliente.totalFacturado ?? 0),
        cliente.activo ? 'Sí' : 'No',
      ]),
    ];
    const csv = filas.map((fila) => fila.map((celda) => `"${celda}"`).join(',')).join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    const enlace = document.createElement('a');
    enlace.href = url;
    enlace.download = 'clientes-llamma.csv';
    enlace.click();
    URL.revokeObjectURL(url);
    this.ui.exito('Directorio exportado.');
  }

  rangoTexto(): string {
    const inicio = this.total() ? (this.pagina() - 1) * 10 + 1 : 0;
    return `Mostrando ${inicio}–${Math.min(this.pagina() * 10, this.total())} de ${this.total()} clientes`;
  }

  etiquetaSegmento(segmento: string): string {
    return SEGMENTOS.find((fila) => fila.valor === segmento)?.etiqueta ?? segmento;
  }

  claseSegmento(segmento: string): string {
    return COLOR_SEGMENTO[segmento] ?? 'badge-soft-muted';
  }

  iniciales(nombre: string): string {
    return nombre
      .split(' ')
      .filter(Boolean)
      .slice(0, 2)
      .map((parte) => parte[0])
      .join('')
      .toUpperCase();
  }

  avatar(id: number): string {
    return ['avatar-cyan', 'avatar-magenta', 'avatar-yellow', 'avatar-ink'][id % 4];
  }

  moneda(valor: number | null | undefined): string {
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0,
    }).format(Number(valor ?? 0));
  }

  fechaCorta(valor: string | null | undefined): string {
    if (!valor) return 'Sin fecha';
    const fecha = new Date(valor);
    if (Number.isNaN(fecha.getTime())) return 'Sin fecha';
    return fecha.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  ticket(cliente: ClienteApi): string {
    const pedidos = cliente.totalPedidos ?? 0;
    return this.moneda(pedidos ? (cliente.totalFacturado ?? 0) / pedidos : 0);
  }
}
