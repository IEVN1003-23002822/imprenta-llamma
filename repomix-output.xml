<div class="module-page abastecimiento-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Compras y reposición</span>
        <h1>Abastecimiento.</h1>
        <p class="page-lead">
          Reglas de stock mínimo y máximo, órdenes de compra y seguimiento de proveedores para que
          el taller nunca se detenga por falta de material.
        </p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-ink" type="button" (click)="exportar()">
          <i class="bi bi-download"></i> Exportar
        </button>
        @if (puedeGestionar()) {
          <button class="btn btn-outline-ink" type="button" (click)="abrirProveedor()">
            <i class="bi bi-person-plus"></i> Nuevo proveedor
          </button>
          <button class="btn btn-brand" type="button" (click)="abrirNueva()">
            <i class="bi bi-cart-plus"></i> Nueva orden de compra
          </button>
        }
      </div>
    </header>

    @if (error()) {
      <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="flex-grow-1">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar()">Reintentar</button>
      </div>
    }

    @if (resumenAlerta().total > 0) {
      <div class="inventory-alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>
          <strong>{{ resumenAlerta().total }} insumos requieren reposición.</strong>
          {{ resumenAlerta().nombres }} están por debajo de su punto de reorden.
        </span>
        <a routerLink="/inventario">Revisar existencias <i class="bi bi-arrow-right"></i></a>
      </div>
    }

    <div class="row g-3 mb-4">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-sm-6 col-xl-3">
          <div class="supply-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div><strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span></div>
          </div>
        </div>
      }
    </div>

    <div class="row g-4 mb-4">
      <div class="col-xl-8">
        <section class="panel-card h-100">
          <div class="panel-head flex-wrap">
            <div>
              <span class="panel-kicker">Compras en curso</span>
              <h2>Órdenes de compra</h2>
            </div>
            <div class="d-flex align-items-center gap-2">
              <span class="badge badge-soft-cyan">{{ filtradas().length }} órdenes</span>
              @if (cargando()) {
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
              }
            </div>
          </div>

          <form class="row g-2 mb-3" [formGroup]="filtros" (ngSubmit)="filtrar()">
            <div class="col-lg-7">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input
                  type="search"
                  class="form-control"
                  placeholder="Buscar folio, proveedor o insumo…"
                  aria-label="Buscar orden de compra"
                  formControlName="q"
                />
                <button class="btn btn-ink" type="submit">Buscar</button>
              </div>
            </div>
            <div class="col-7 col-lg-3">
              <select class="form-select" aria-label="Filtrar por estado" formControlName="estado">
                <option value="">Todo estado</option>
                @for (estado of estados; track estado.valor) {
                  <option [value]="estado.valor">{{ estado.etiqueta }}</option>
                }
              </select>
            </div>
            <div class="col-5 col-lg-2">
              <button class="btn btn-soft w-100" type="button" (click)="limpiar()">
                <i class="bi bi-arrow-counterclockwise"></i> Limpiar
              </button>
            </div>
          </form>

          <div class="table-responsive">
            <table class="table table-llamma align-middle">
              <thead>
                <tr>
                  <th>Folio</th>
                  <th>Proveedor e insumo</th>
                  <th>Entrega</th>
                  <th class="text-end">Monto</th>
                  <th>Estado</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                @for (orden of visibles(); track orden.id) {
                  <tr>
                    <td>
                      <div class="order-id">{{ orden.folio }}</div>
                      <div class="cell-muted">Emitida {{ fechaCorta(orden.fechaEmision) }}</div>
                    </td>
                    <td>
                      <div class="supplier-meta">
                        <span class="avatar" [class]="'avatar ' + avatarProveedor(orden.proveedor)">
                          {{ iniciales(orden.proveedor) }}
                        </span>
                        <div>
                          <strong>{{ orden.proveedor || 'Sin proveedor' }}</strong>
                          <small>{{ etiquetaItems(orden) }}</small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="cell-main">{{ fechaCorta(orden.fechaEntrega) }}</div>
                      <div class="cell-muted">{{ etiquetaEstado(orden.estado) }}</div>
                    </td>
                    <td class="text-end cell-main">{{ monedaExacta(orden.total) }}</td>
                    <td>
                      <span class="badge" [class]="claseEstado(orden.estado)">
                        {{ etiquetaEstado(orden.estado) }}
                      </span>
                    </td>
                    <td class="text-end">
                      <div class="d-inline-flex gap-1">
                        <button
                          class="btn btn-icon"
                          type="button"
                          aria-label="Ver orden"
                          title="Ver orden"
                          (click)="abrirDetalle(orden)"
                        >
                          <i class="bi bi-eye"></i>
                        </button>
                        @if (puedeGestionar() && (orden.estado === 'pendiente' || orden.estado === 'confirmada' || orden.estado === 'en-transito')) {
                          <button
                            class="btn btn-icon"
                            type="button"
                            aria-label="Marcar como recibida"
                            title="Marcar como recibida"
                            [disabled]="cambiandoEstado()"
                            (click)="recibir(orden)"
                          >
                            <i class="bi bi-box-arrow-in-down"></i>
                          </button>
                        }
                      </div>
                    </td>
                  </tr>
                } @empty {
                  <tr>
                    <td colspan="6" class="text-center text-muted py-5">
                      <i class="bi bi-cart-x d-block fs-4 mb-2"></i>
                      No hay órdenes de compra con esos filtros.
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span>{{ rangoTexto() }}</span>
            <nav aria-label="Paginación de órdenes de compra">
              <ul class="pagination pagination-sm mb-0">
                <li class="page-item" [class.disabled]="pagina() <= 1">
                  <button class="page-link" type="button" aria-label="Anterior" (click)="irA(pagina() - 1)">
                    <i class="bi bi-chevron-left"></i>
                  </button>
                </li>
                @for (numero of listaPaginas(); track numero) {
                  <li class="page-item" [class.active]="numero === pagina()">
                    <button class="page-link" type="button" (click)="irA(numero)">{{ numero }}</button>
                  </li>
                }
                <li class="page-item" [class.disabled]="pagina() >= paginas()">
                  <button class="page-link" type="button" aria-label="Siguiente" (click)="irA(pagina() + 1)">
                    <i class="bi bi-chevron-right"></i>
                  </button>
                </li>
              </ul>
            </nav>
          </div>
        </section>
      </div>

      <div class="col-xl-4">
        <section class="panel-card h-100 d-flex flex-column">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Reposición sugerida</span>
              <h2>Compras recomendadas</h2>
            </div>
            <span class="badge badge-soft-danger">{{ sugerencias().length }} insumos</span>
          </div>

          <div>
            @for (sugerencia of sugerencias().slice(0, 4); track sugerencia.materia.id) {
              <div class="purchase-item">
                <span class="icon-tile icon-tile-sm" [class]="'icon-tile icon-tile-sm ' + sugerencia.tono">
                  <i class="bi" [class]="'bi ' + sugerencia.icono"></i>
                </span>
                <div>
                  <strong>{{ sugerencia.materia.nombre }}</strong>
                  <small>
                    Reponer {{ cantidad(sugerencia.reposicion, sugerencia.materia.unidadMedida) }} ·
                    {{ sugerencia.materia.proveedor || 'Sin proveedor' }}
                  </small>
                </div>
                <span class="badge" [class]="sugerencia.critico ? 'badge-soft-danger' : 'badge-soft-warning'">
                  {{ sugerencia.critico ? 'Urgente' : 'Esta semana' }}
                </span>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">
                No hay insumos por debajo de su punto de reorden. El inventario está cubierto.
              </p>
            }
          </div>

          <div class="quote-note">
            <i class="bi bi-calculator"></i>
            <span>
              La sugerencia repone hasta el stock máximo o el doble del mínimo, el mayor de ambos.
            </span>
          </div>

          @if (puedeGestionar()) {
            <button class="btn btn-ink w-100 mt-auto" type="button" (click)="generarConsolidada()">
              <i class="bi bi-file-earmark-plus"></i> Generar orden consolidada
            </button>
          }
        </section>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <section class="panel-card h-100">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Directorio</span>
              <h2>Proveedores estratégicos</h2>
            </div>
            <div class="d-flex align-items-center gap-2">
              @if (cargandoCatalogos()) {
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
              }
              <a class="panel-link mt-0" routerLink="/inventario">
                Ver insumos <i class="bi bi-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="supplier-list">
            @for (proveedor of proveedores(); track proveedor.id; let i = $index) {
              <div class="supplier-row">
                <span class="avatar" [class]="'avatar ' + avatar(i)">{{ iniciales(proveedor.nombre) }}</span>
                <div class="flex-grow-1 min-w-0">
                  <strong>{{ proveedor.nombre }}</strong>
                  <small>
                    {{ proveedor.contacto || 'Sin contacto' }}
                    @if (proveedor.telefono) {
                      · {{ proveedor.telefono }}
                    }
                    @if (proveedor.condicionesPago) {
                      · {{ proveedor.condicionesPago }}
                    }
                  </small>
                </div>
                <span class="badge" [class]="proveedor.activo ? 'badge-soft-success' : 'badge-soft-muted'">
                  {{ proveedor.activo ? 'Activo' : 'Inactivo' }}
                </span>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">Aún no hay proveedores registrados.</p>
            }
          </div>
        </section>
      </div>

      <div class="col-lg-6">
        <section class="panel-card h-100">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Calendario</span>
              <h2>Recepciones programadas</h2>
            </div>
            <span class="badge badge-soft-muted">{{ recepciones().length }} en camino</span>
          </div>

          <div class="receipt-list">
            @for (orden of recepciones(); track orden.id) {
              <div class="receipt-item">
                <span class="receipt-date">
                  <strong>{{ diaRecepcion(orden.fechaEntrega) }}</strong>
                  <span>{{ mesRecepcion(orden.fechaEntrega) }}</span>
                </span>
                <div class="flex-grow-1 min-w-0">
                  <strong>{{ orden.proveedor || 'Sin proveedor' }}</strong>
                  <small>{{ orden.folio }} · {{ etiquetaItems(orden) }}</small>
                </div>
                <span class="badge" [class]="claseEstado(orden.estado)">{{ etiquetaEstado(orden.estado) }}</span>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">No hay recepciones programadas para los próximos días.</p>
            }
          </div>

          <p class="table-note">
            <i class="bi bi-upc-scan"></i>
            Al recibir, valida cantidades y calidad antes de actualizar el inventario.
          </p>
        </section>
      </div>
    </div>
  </div>
</div>

@if (ordenAbierta()) {
  <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="z-index: 1055">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <form [formGroup]="ordenForm" (ngSubmit)="crearOrden()">
          <div class="modal-header">
            <div>
              <span class="panel-kicker">Compras y reposición</span>
              <h2 class="modal-title h5 mb-0">Nueva orden de compra</h2>
            </div>
            <button class="btn btn-icon" type="button" aria-label="Cerrar" (click)="cerrarNueva()">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>

          <div class="modal-body">
            <div class="row g-3">
              <div class="col-md-5">
                <label class="form-label" for="ocProveedor">Proveedor *</label>
                <select id="ocProveedor" class="form-select" formControlName="proveedorId">
                  <option value="">Selecciona un proveedor…</option>
