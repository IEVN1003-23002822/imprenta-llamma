    <section id="seguimiento" class="panel-card tracking-card">
      <div class="panel-head flex-wrap">
        <div>
          <span class="panel-kicker">Seguimiento</span>
          <h2>Consulta el estatus de tu solicitud</h2>
        </div>
        <span class="badge badge-soft-muted">Folio + correo</span>
      </div>

      <form [formGroup]="seguimientoForm" (ngSubmit)="consultar()" class="row g-3 align-items-end">
        <div class="col-md-5">
          <label class="form-label" for="segFolio">Folio de solicitud</label>
          <input
            id="segFolio"
            type="text"
            class="form-control"
            formControlName="folio"
            placeholder="SOL-2026-001"
            autocomplete="off"
          >
        </div>
        <div class="col-md-5">
          <label class="form-label" for="segCorreo">Correo registrado</label>
          <input
            id="segCorreo"
            type="email"
            class="form-control"
            formControlName="correo"
            placeholder="nombre&#64;empresa.mx"
            autocomplete="email"
          >
        </div>
        <div class="col-md-2">
          <button class="btn btn-ink w-100" type="submit" [disabled]="buscando()">
            @if (buscando()) {
              <i class="bi bi-hourglass-split"></i>
            } @else {
              <i class="bi bi-search"></i>
            }
            Buscar
          </button>
        </div>
      </form>

      @if (errorSeguimiento()) {
        <div class="request-error mt-3" role="alert">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span>{{ errorSeguimiento() }}</span>
        </div>
      }

      @if (seguimiento(); as solicitud) {
        <div class="tracking-result">
          <div class="tracking-head">
            <div>
              <span class="panel-kicker">Solicitud {{ solicitud.folio }}</span>
              <h3>{{ solicitud.nombreCliente }}</h3>
            </div>
            <span class="badge" [class]="claseEstado(solicitud.estado)">
              {{ etiquetaEstado(solicitud.estado) }}
            </span>
          </div>

          <div class="tracking-grid">
            <div>
              <span>Recibida</span>
              <strong>{{ fecha(solicitud.fechaCreacion) }}</strong>
            </div>
            <div>
              <span>Entrega deseada</span>
              <strong>{{ fecha(solicitud.fechaDeseada) }}</strong>
            </div>
            <div>
              <span>Partidas</span>
              <strong>{{ solicitud.items.length }}</strong>
            </div>
            <div>
              <span>Última actualización</span>
              <strong>{{ fecha(solicitud.actualizadoEn) }}</strong>
            </div>
          </div>

          @if (solicitud.mensaje) {
            <p class="tracking-message">{{ solicitud.mensaje }}</p>
          }

          @if (solicitud.cotizacion) {
            <div class="tracking-quote">
              <i class="bi bi-file-earmark-check"></i>
              <div>
                <strong>Cotización {{ solicitud.cotizacion.folio }}</strong>
                <span>
                  {{ moneda(solicitud.cotizacion.total) }} · estado
                  {{ solicitud.cotizacion.estado }}
                </span>
              </div>
            </div>
          }
        </div>
      }
    </section>
  </div>
</div>
</file>

