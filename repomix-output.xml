            }
          </div>

          <div class="mb-3">
            <label class="form-label" for="authPassword">Contraseña</label>
            <div class="auth-password">
              <input
                id="authPassword"
                [type]="mostrarPassword() ? 'text' : 'password'"
                class="form-control"
                formControlName="password"
                placeholder="Tu contraseña"
                autocomplete="current-password"
                [class.is-invalid]="form.controls.password.touched && form.controls.password.invalid"
              >
              <button
                class="btn btn-icon"
                type="button"
                (click)="alternarPassword()"
                [attr.aria-label]="mostrarPassword() ? 'Ocultar contraseña' : 'Mostrar contraseña'"
              >
                <i class="bi" [class.bi-eye]="!mostrarPassword()" [class.bi-eye-slash]="mostrarPassword()"></i>
              </button>
            </div>
            @if (form.controls.password.touched && form.controls.password.invalid) {
              <span class="field-error">La contraseña es obligatoria.</span>
            }
          </div>

          <div class="auth-row">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="authRemember" formControlName="recordarme">
              <label class="form-check-label" for="authRemember">Recordarme</label>
            </div>
            <a class="auth-link" href="#">¿Olvidaste tu contraseña?</a>
          </div>

          <button class="btn btn-brand w-100" type="submit" [disabled]="enviando()">
            @if (enviando()) {
              <i class="bi bi-hourglass-split"></i> Validando credenciales...
            } @else {
              <i class="bi bi-box-arrow-in-right"></i> Entrar al panel
            }
          </button>

          <div class="auth-divider"><span>accesos de demostración</span></div>

          <div class="demo-grid">
            <button class="btn btn-outline-ink btn-sm" type="button" (click)="usarDemo('ana@llamma.mx')">
