            <div class="table-responsive">
              <table class="table table-llamma align-middle mb-0">
                <thead>
                  <tr>
                    <th style="min-width: 14rem">Insumo</th>
                    <th style="min-width: 7rem">Cantidad</th>
                    <th style="min-width: 9rem">Precio unitario</th>
                    <th class="text-end">Importe</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody formArrayName="items">
                  @for (grupo of itemsArray.controls; track grupo; let i = $index) {
                    <tr [formGroupName]="i">
                      <td>
                        <select class="form-select form-select-sm" formControlName="materiaPrimaId" (change)="actualizarPrecio(i)">
                          <option value="">Selecciona insumo…</option>
