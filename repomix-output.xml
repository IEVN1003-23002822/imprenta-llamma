/* Ajustes específicos del cotizador. */
.captura-page .panel-card .panel-head h2 {
  font-size: 1.08rem;
}

/* ---------------------------- Flujo funcional ------------------------------ */

.field-error {
  display: block;
  margin-top: 0.25rem;
  color: #b42318;
  font-size: 0.66rem;
  font-weight: 500;
}

.form-control.is-invalid,
.form-select.is-invalid {
  border-color: #d92d20;
}

.capture-success,
.capture-created {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
  padding: 1.4rem;
  border-left: 5px solid var(--llamma-cyan);
}

.capture-created {
  border-left-color: var(--llamma-magenta);
}

.capture-success h2,
.capture-created h2 {
  margin: 0.2rem 0 0.4rem;
  font-family: var(--llamma-font-display);
  font-size: 1.4rem;
}

.capture-success p,
.capture-created p {
  max-width: 44rem;
  margin: 0;
  color: var(--llamma-muted);
  font-size: 0.76rem;
  line-height: 1.6;
}

.success-mark {
  display: inline-grid;
  place-items: center;
  width: 3rem;
  height: 3rem;
  flex: 0 0 auto;
  border-radius: 50%;
  background: rgba(var(--llamma-cyan-rgb), 0.12);
  color: var(--llamma-cyan-deep);
  font-size: 1.4rem;
}

.capture-created .success-mark {
  background: rgba(var(--llamma-magenta-rgb), 0.1);
  color: var(--llamma-magenta);
}

.capture-alert {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-bottom: 1.25rem;
  padding: 0.7rem 0.85rem;
  border: 1px solid rgba(180, 35, 24, 0.26);
  border-radius: 0.7rem;
  background: #fdecec;
  color: #a01212;
  font-size: 0.72rem;
  line-height: 1.45;
}

.capture-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 3rem 1rem;
  color: var(--llamma-muted);
  font-size: 0.8rem;
}

.capture-loading i {
  color: var(--llamma-cyan-deep);
  font-size: 1.3rem;
}

.capture-meta {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.6rem;
  margin-bottom: 0.4rem;
}

.capture-meta > div {
  padding: 0.65rem 0.8rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.7rem;
  background: #fbfaf7;
}

.capture-meta span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.capture-meta strong {
  display: block;
  margin-top: 0.2rem;
  font-size: 0.76rem;
}

.capture-check {
  margin: 0.9rem 0 0.75rem;
  font-size: 0.7rem;
}

.capture-check .form-check-label {
  color: var(--llamma-muted);
  line-height: 1.45;
}

.capture-locked {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-top: 0.5rem;
  padding: 0.7rem 0.8rem;
  border: 1px solid rgba(20, 122, 74, 0.25);
  border-radius: 0.7rem;
  background: #eaf7f0;
  color: #146c43;
  font-size: 0.7rem;
  line-height: 1.5;
}

.capture-locked a {
  color: #146c43;
  font-weight: 700;
}

.capture-line-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.55rem 0.7rem;
  border-radius: 0.6rem;
  background: rgba(var(--llamma-cyan-rgb), 0.06);
}

.capture-line-total span {
  color: var(--llamma-muted);
  font-size: 0.66rem;
}

.capture-line-total strong {
  font-family: var(--llamma-font-display);
  font-size: 0.9rem;
}

.capture-col-qty {
  width: 6.5rem;
}

.capture-col-price {
  width: 8.5rem;
}

.capture-empty {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 0.25rem;
  color: var(--llamma-muted);
  font-size: 0.72rem;
}

.capture-empty i {
  color: var(--llamma-cyan-deep);
  font-size: 1.1rem;
}

.capture-summary-empty {
  margin: 0.5rem 0 0.9rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
}

@media (max-width: 767.98px) {
  .capture-meta {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 575.98px) {
  .capture-meta {
    grid-template-columns: 1fr;
  }
}
</file>

