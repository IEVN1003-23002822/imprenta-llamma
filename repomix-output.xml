<file path="src/app/llamma/seguimiento/seguimiento.component.html">
<div class="module-page seguimiento-page">
  <div class="llamma-container">
    <header class="page-header flex flex-wrap items-end justify-between gap-4">
      <div class="page-brand">
        <img
          class="page-brand-logo"
          src="assets/images/logo-llamma-128.webp"
          srcset="assets/images/logo-llamma-128.webp 2x, assets/images/logo-llamma-256.webp 4x"
          alt="Imprenta Llamma Logo"
          width="38"
          height="54"
        />
        <div>
          <span class="eyebrow">Portal de clientes</span>
          <h1>Sigue tu solicitud.</h1>
          <p class="page-lead">
            Consulta el avance de tu cotización y conversa con nuestro equipo. Solo necesitas el
            folio que te entregamos al enviar la solicitud y el correo con el que la registraste.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn btn-brand" routerLink="/cotizar">
          <i class="bi bi-pencil-square"></i> Nueva solicitud
        </a>
        <a class="btn btn-outline-ink" routerLink="/productos">
          <i class="bi bi-grid-3x3-gap"></i> Ver catálogo
        </a>
      </div>
    </header>

    <section class="panel-card tracking-card" aria-labelledby="tituloConsulta">
      <div class="panel-head flex-wrap">
        <div>
          <span class="panel-kicker">Seguimiento</span>
          <h2 id="tituloConsulta">Consulta el estatus de tu solicitud</h2>
        </div>
        <span class="badge badge-soft-muted">Folio + correo</span>
      </div>

      <form
        [formGroup]="seguimientoForm"
        (ngSubmit)="consultar()"
        class="grid grid-cols-12 gap-4 items-end"
        novalidate
      >
        <div class="col-span-12 md:col-span-5">
          <label class="form-label" for="segFolio">Folio de solicitud</label>
          <input
            id="segFolio"
            type="text"
            class="form-control"
            formControlName="folio"
            placeholder="SOL-2026-001"
            autocomplete="off"
            aria-describedby="segFolioAyuda"
            [attr.aria-invalid]="
              seguimientoForm.controls.folio.touched && seguimientoForm.controls.folio.invalid
            "
            [class.is-invalid]="
              seguimientoForm.controls.folio.touched && seguimientoForm.controls.folio.invalid
            "
          />
          @if (seguimientoForm.controls.folio.touched && seguimientoForm.controls.folio.invalid) {
            <span class="field-error" id="segFolioAyuda">Escribe el folio de tu solicitud.</span>
          } @else {
            <span class="field-hint" id="segFolioAyuda"
              >Lo encuentras en el comprobante o en el correo de confirmación.</span
            >
          }
        </div>
        <div class="col-span-12 md:col-span-5">
          <label class="form-label" for="segCorreo">Correo registrado</label>
          <input
            id="segCorreo"
            type="email"
            class="form-control"
            formControlName="correo"
            placeholder="nombre&#64;empresa.mx"
            autocomplete="email"
            aria-describedby="segCorreoAyuda"
            [attr.aria-invalid]="
              seguimientoForm.controls.correo.touched && seguimientoForm.controls.correo.invalid
            "
            [class.is-invalid]="
              seguimientoForm.controls.correo.touched && seguimientoForm.controls.correo.invalid
            "
          />
          @if (seguimientoForm.controls.correo.touched && seguimientoForm.controls.correo.invalid) {
            <span class="field-error" id="segCorreoAyuda"
              >Ingresa el mismo correo con el que registraste la solicitud.</span
            >
          } @else {
            <span class="field-hint" id="segCorreoAyuda"
              >Debe coincidir exactamente con el correo de la solicitud.</span
            >
          }
        </div>
        <div class="col-span-12 md:col-span-2">
          <button class="btn btn-ink w-full" type="submit" [disabled]="buscando()">
            @if (buscando()) {
              <i class="bi bi-hourglass-split"></i>
            } @else {
              <i class="bi bi-search"></i>
            }
            Buscar
          </button>
        </div>
      </form>

      @if (errorSeguimiento()) {
        <div class="request-error mt-4" role="alert">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span>{{ errorSeguimiento() }}</span>
        </div>
      }
    </section>

    @if (seguimiento(); as solicitud) {
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 xl:col-span-7">
          <section
            id="resultadoSeguimiento"
            class="panel-card tracking-result-card"
            tabindex="-1"
            aria-labelledby="tituloResultado"
          >
            <div class="tracking-head">
              <div>
                <span class="panel-kicker">Solicitud {{ solicitud.folio }}</span>
                <h2 id="tituloResultado">{{ solicitud.nombreCliente }}</h2>
              </div>
              <span class="badge" [class]="claseEstado(solicitud.estado)">
                {{ etiquetaEstado(solicitud.estado) }}
              </span>
            </div>

            <div class="tracking-grid">
              <div>
                <span>Recibida</span>
                <strong>{{ fecha(solicitud.fechaCreacion) }}</strong>
              </div>
              <div>
                <span>Entrega deseada</span>
                <strong>{{ fecha(solicitud.fechaDeseada) }}</strong>
              </div>
              <div>
                <span>Partidas</span>
                <strong>{{ solicitud.items.length }}</strong>
              </div>
              <div>
                <span>Última actualización</span>
                <strong>{{ fecha(solicitud.actualizadoEn) }}</strong>
              </div>
            </div>

            @if (solicitud.mensaje) {
              <p class="tracking-message">{{ solicitud.mensaje }}</p>
            }

            @if (solicitud.items.length) {
              <div class="tracking-items">
                <span class="panel-kicker">Partidas de la solicitud</span>
                <ul>
                  @for (item of solicitud.items; track $index) {
                    <li>
                      <strong>{{ item.cantidad }} × {{ item.nombreProducto }}</strong>
                      <span>{{ item.especificaciones || 'Especificaciones por confirmar' }}</span>
                    </li>
                  }
                </ul>
              </div>
            }

            @if (solicitud.archivos.length) {
              <p class="tracking-files">
                <i class="bi bi-paperclip"></i>
                {{ solicitud.archivos.length }}
                {{
                  solicitud.archivos.length === 1
                    ? 'archivo de referencia'
                    : 'archivos de referencia'
                }}
                recibidos.
              </p>
            }

            @if (solicitud.cotizacion) {
              <div class="tracking-quote">
                <i class="bi bi-file-earmark-check"></i>
                <div>
                  <strong>Cotización {{ solicitud.cotizacion.folio }}</strong>
                  <span>
                    {{ moneda(solicitud.cotizacion.total) }} · estado
                    {{ solicitud.cotizacion.estado }}
                  </span>
                </div>
              </div>
            }
          </section>
        </div>

        <div class="col-span-12 xl:col-span-5">
          <section class="panel-card chat-card" aria-labelledby="tituloChat">
            <div class="chat-head">
              <div>
                <span class="panel-kicker">Chat de la solicitud</span>
                <h2 id="tituloChat">Conversación con el equipo</h2>
              </div>
              <button class="btn btn-sm btn-outline-ink" type="button" (click)="refrescarChat()">
                <i class="bi bi-arrow-clockwise"></i> Actualizar
              </button>
            </div>

            <div
              #hiloChat
              class="chat-thread"
              role="log"
              aria-live="polite"
              aria-label="Mensajes de la solicitud"
            >
              @for (mensaje of mensajes(); track mensaje.id) {
                <div
                  class="chat-bubble"
                  [class.chat-bubble-propio]="mensaje.remitenteTipo === 'cliente'"
                >
                  <div class="chat-meta">
                    <strong>{{
                      mensaje.remitenteTipo === 'cliente' ? 'Tú' : mensaje.autor
                    }}</strong>
                    <time>{{ fechaHoraChat(mensaje.creadoEn) }}</time>
                  </div>
                  @if (mensaje.mensaje) {
                    <p>{{ mensaje.mensaje }}</p>
                  }
                  @if (mensaje.adjunto) {
                    <button
                      class="chat-file"
                      type="button"
                      [disabled]="descargandoAdjunto() === mensaje.id"
                      (click)="descargarAdjuntoChat(mensaje)"
                    >
                      <i class="bi bi-paperclip"></i>
                      <span class="chat-file-name">{{ mensaje.adjunto.nombre }}</span>
                      <small>{{ tamanoChat(mensaje.adjunto.tamanoBytes) }}</small>
                      <i class="bi bi-download"></i>
                      <span class="sr-only">Descargar {{ mensaje.adjunto.nombre }}</span>
                    </button>
                  }
                </div>
              } @empty {
                <p class="chat-empty">
                  <i class="bi bi-chat-dots"></i>
                  Aún no hay mensajes. Escríbenos si necesitas aclarar algo de tu solicitud.
                </p>
              }
            </div>

            @if (errorChat()) {
              <div class="request-error" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>{{ errorChat() }}</span>
              </div>
            }

            <div class="chat-compose">
              <label class="sr-only" for="chatPublicoMensaje"
                >Mensaje para el equipo de Llamma</label
              >
              <textarea
                id="chatPublicoMensaje"
                class="form-control"
                rows="2"
                maxlength="4000"
                placeholder="Escribe tu mensaje..."
                aria-describedby="chatAyuda"
                [value]="borrador()"
                (input)="actualizarBorrador($event)"
              ></textarea>
              <div class="chat-compose-actions">
                <div class="chat-adjunto">
                  <label class="btn btn-sm btn-outline-ink mb-0">
                    <i class="bi bi-paperclip"></i> Adjuntar
                    <input
                      type="file"
                      hidden
                      accept=".pdf,.ai,.psd,.png,.jpg,.jpeg,.svg,.zip"
                      (change)="seleccionarAdjunto($event)"
                    />
                  </label>
                  @if (adjuntoChat(); as archivo) {
                    <span class="chat-adjunto-chip">
                      {{ archivo.name }}
                      <button
                        type="button"
                        aria-label="Quitar adjunto"
                        (click)="quitarAdjuntoChat()"
                      >
                        <i class="bi bi-x"></i>
                      </button>
                    </span>
                  }
                </div>
                <button
                  class="btn btn-ink btn-sm"
                  type="button"
                  [disabled]="enviandoMensaje()"
                  (click)="enviarMensaje()"
                >
                  @if (enviandoMensaje()) {
                    <i class="bi bi-hourglass-split"></i> Enviando...
                  } @else {
                    <i class="bi bi-send"></i> Enviar
                  }
                </button>
              </div>
              <small class="chat-hint" id="chatAyuda">
                Adjuntos permitidos: PDF, AI, PSD, PNG, JPG, SVG o ZIP (máx. 25 MB).
              </small>
            </div>
          </section>
        </div>
      </div>
    } @else {
      <section class="panel-card tracking-help" aria-labelledby="tituloAyuda">
        <div class="panel-head">
          <div>
            <span class="panel-kicker">Antes de consultar</span>
            <h2 id="tituloAyuda">¿Cómo funciona el seguimiento?</h2>
          </div>
        </div>
        <ol class="tracking-steps">
          <li>
            <span class="step-number">01</span>
            <div>
              <strong>Ten a la mano tu folio</strong>
              <p>
                Empieza con SOL- y aparece en el comprobante que descargaste al enviar tu solicitud.
              </p>
            </div>
          </li>
          <li>
            <span class="step-number">02</span>
            <div>
              <strong>Usa el correo exacto</strong>
              <p>Por seguridad solo mostramos la solicitud si el folio y el correo coinciden.</p>
            </div>
          </li>
          <li>
            <span class="step-number">03</span>
            <div>
              <strong>Consulta y conversa</strong>
              <p>Verás el estatus, la cotización y podrás enviar mensajes o archivos al equipo.</p>
            </div>
          </li>
        </ol>
      </section>
    }
  </div>
</div>
</file>

<file path="src/app/llamma/solicitudes/solicitudes.component.css">
/* Bandeja interna de solicitudes de cotización. */

.min-w-0 {
  min-width: 0;
}

.inbox-stat {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  height: 100%;
  padding: 0.9rem 1rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.inbox-stat strong {
  display: block;
  font-family: var(--llamma-font-display);
  font-size: 1.35rem;
  line-height: 1;
}

.inbox-stat span:not(.icon-tile) {
  display: block;
  margin-top: 0.2rem;
  color: var(--llamma-muted);
  font-size: 0.68rem;
  font-weight: 500;
}

.inbox-stat-cyan {
  border-color: rgba(var(--llamma-cyan-rgb), 0.35);
  background: rgba(var(--llamma-cyan-rgb), 0.05);
}

/* --------------------------- Layout de dos paneles ------------------------- */

.solicitudes-page .row > [class*='col-'] {
  min-width: 0;
}

.inbox-panel,
.detail-panel {
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

/* ---------------------------------- Filtros -------------------------------- */

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.inbox-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.filter-chip {
  padding: 0.4rem 0.7rem;
  border: 1px solid var(--llamma-line);
  border-radius: 999px;
  background: #fbfaf7;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  font-weight: 600;
}

.filter-chip.is-active {
  border-color: var(--llamma-carbon);
  background: var(--llamma-carbon);
  color: #fff;
}

.inbox-search {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex: 1 1 22rem;
  max-width: 32rem;
}

.inbox-search .input-group {
  flex: 1 1 auto;
}

.inbox-search .btn {
  white-space: nowrap;
}

/* ----------------------------------- Lista --------------------------------- */

.inbox-alert {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-bottom: 1rem;
  padding: 0.65rem 0.8rem;
  border: 1px solid rgba(180, 35, 24, 0.26);
  border-radius: 0.7rem;
  background: #fdecec;
  color: #a01212;
  font-size: 0.72rem;
  line-height: 1.45;
}

.inbox-alert i {
  margin-top: 0.05rem;
}

.inbox-loading,
.inbox-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  padding: 2.2rem 1rem;
  color: var(--llamma-muted);
  text-align: center;
}

.inbox-loading i {
  font-size: 1.4rem;
  color: var(--llamma-cyan-deep);
}

.inbox-empty i {
  font-size: 1.8rem;
  color: var(--llamma-cyan-deep);
}

.inbox-empty strong {
  color: var(--llamma-carbon);
  font-size: 0.9rem;
}

.inbox-empty p {
  max-width: 24rem;
  margin: 0;
  font-size: 0.74rem;
  line-height: 1.5;
}

.request-list {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0.55rem;
  min-width: 0;
  margin-top: 1rem;
}

.request-row {
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding: 0.85rem 0.9rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.85rem;
  background: #fff;
  color: inherit;
  text-align: left;
}

.request-row:hover {
  border-color: rgba(var(--llamma-cyan-rgb), 0.55);
  background: rgba(var(--llamma-cyan-rgb), 0.03);
}

.request-row.is-active {
  border-color: var(--llamma-cyan);
  box-shadow: inset 3px 0 0 var(--llamma-cyan);
  background: rgba(var(--llamma-cyan-rgb), 0.05);
}

.request-main {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  flex: 1 1 auto;
  min-width: 0;
}

.request-top {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  min-width: 0;
}

.request-top strong {
  font-size: 0.85rem;
  overflow-wrap: anywhere;
}

.request-company {
  color: var(--llamma-muted);
  font-size: 0.68rem;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.request-preview {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  margin-top: 0.1rem;
  color: #4a4a4a;
  font-size: 0.7rem;
  line-height: 1.45;
  text-overflow: ellipsis;
