  font-weight: 700;
}

.rank-item strong {
  display: block;
  font-size: 0.77rem;
  font-weight: 600;
}

.rank-item small {
  display: block;
  margin-top: 0.1rem;
  color: var(--llamma-muted);
  font-size: 0.67rem;
}

.rank-amount {
