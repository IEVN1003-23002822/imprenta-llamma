}

.fill-cyan {
  background: var(--llamma-cyan);
}

.fill-magenta {
  background: var(--llamma-magenta);
}

.fill-yellow {
  background: #e8da00;
}

.fill-ink {
  background: var(--llamma-carbon);
}

.rank-list {
  display: grid;
  gap: 0.95rem;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.rank-number {
