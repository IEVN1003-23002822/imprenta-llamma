/* Ajustes visuales del módulo de acceso y roles. */

.auth-shell {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  overflow: hidden;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-lg);
  background: #fff;
  box-shadow: var(--llamma-shadow);
}

.auth-brand {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
  padding: clamp(1.8rem, 4vw, 3.2rem);
  overflow: hidden;
  background: var(--llamma-carbon);
  color: rgba(255, 255, 255, 0.66);
}

.auth-brand::before {
  content: '';
  position: absolute;
  top: -140px;
  right: -110px;
  width: 360px;
  height: 360px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--llamma-cyan-rgb), 0.28), transparent 68%);
  pointer-events: none;
}

.auth-brand::after {
  content: '';
  position: absolute;
  bottom: -170px;
  left: -100px;
  width: 340px;
  height: 340px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--llamma-magenta-rgb), 0.2), transparent 68%);
  pointer-events: none;
}

.auth-brand > * {
  position: relative;
  z-index: 1;
}

.auth-copy {
  margin-top: auto;
}

.auth-copy h1 {
  max-width: 20rem;
  margin-bottom: 0.8rem;
  color: #fff;
  font-size: clamp(2.2rem, 4vw, 3.2rem);
  line-height: 0.98;
}

.auth-copy p {
  max-width: 24rem;
  margin: 0;
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.88rem;
}

.auth-points {
  display: grid;
  gap: 0.65rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.auth-points li {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.78rem;
}

.auth-points i {
  color: var(--llamma-yellow);
}

.auth-colors {
  display: flex;
  align-items: center;
