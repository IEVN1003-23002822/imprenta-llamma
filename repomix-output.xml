  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.filter-chip {
  padding: 0.4rem 0.7rem;
  border: 1px solid var(--llamma-line);
  border-radius: 999px;
  background: #fbfaf7;
