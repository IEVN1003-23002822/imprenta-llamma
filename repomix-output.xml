  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.query-stat strong {
  display: block;
  font-family: var(--llamma-font-display);
  font-size: 1.3rem;
  line-height: 1;
}

.query-stat span:not(.icon-tile) {
  display: block;
  margin-top: 0.25rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  font-weight: 500;
}

.distribution {
  display: grid;
  gap: 1rem;
}

.distribution-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.6rem;
  margin-bottom: 0.4rem;
  font-size: 0.74rem;
}

.distribution-top span {
  color: var(--llamma-muted);
  font-weight: 500;
}

.distribution-top strong {
  font-family: var(--llamma-font-display);
  font-size: 0.78rem;
}

.distribution-track {
  height: 7px;
  overflow: hidden;
  border-radius: 999px;
  background: #efeee9;
}

.distribution-track span {
  display: block;
