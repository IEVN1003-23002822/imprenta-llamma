<file path="src/app/llamma/inventario/inventario.component.html">
<div class="module-page inventario-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Materias primas e insumos</span>
        <h1>Control de inventario.</h1>
        <p class="page-lead">
          Existencias, umbrales y costos en una sola vista. Detecta a tiempo los materiales que
          frenan una línea de producción.
        </p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-ink" type="button" (click)="exportar()">
          <i class="bi bi-download"></i> Exportar
        </button>
        @if (puedeGestionar()) {
          <button class="btn btn-outline-ink" type="button" (click)="abrirNuevo()">
            <i class="bi bi-plus-lg"></i> Nuevo insumo
          </button>
          <button class="btn btn-brand" type="button" (click)="abrirAjuste()">
            <i class="bi bi-arrow-left-right"></i> Registrar movimiento
          </button>
        }
      </div>
    </header>

    @if (error()) {
      <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="flex-grow-1">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar()">Reintentar</button>
      </div>
    }

    @if (resumenAlerta().total > 0) {
      <div class="inventory-alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>
          <strong>{{ dosDigitos(resumenAlerta().criticos) }} insumos críticos</strong>
          y {{ dosDigitos(resumenAlerta().bajos) }} con stock bajo.
          @if (resumenAlerta().nombres) {
            {{ resumenAlerta().nombres }} pueden detener la producción de esta semana.
          }
        </span>
        <a routerLink="/abastecimiento">Generar orden de compra <i class="bi bi-arrow-right"></i></a>
      </div>
    } @else if (!cargando()) {
      <div class="inventory-alert is-ok">
        <i class="bi bi-shield-check"></i>
        <span>
          <strong>Inventario saludable.</strong> Todos los insumos están por encima de su umbral
          mínimo de operación.
        </span>
        <a routerLink="/abastecimiento">Ver abastecimiento <i class="bi bi-arrow-right"></i></a>
      </div>
    }

    <div class="row g-3 mb-4">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-sm-6 col-xl-3">
          <div class="inventory-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div><strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span></div>
          </div>
        </div>
      }
    </div>

    <section class="panel-card mb-4">
      <div class="panel-head flex-wrap">
        <div>
          <span class="panel-kicker">Existencias en tiempo real</span>
          <h2>Materias primas</h2>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge badge-soft-muted">{{ filtradas().length }} insumos</span>
          @if (cargando()) {
            <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
          }
        </div>
      </div>

      <form class="row g-2 mb-3" [formGroup]="filtros" (ngSubmit)="filtrar()">
        <div class="col-lg-5">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input
              type="search"
              class="form-control"
              placeholder="Buscar insumo, categoría o proveedor…"
              aria-label="Buscar insumo"
              formControlName="q"
            />
            <button class="btn btn-ink" type="submit">Buscar</button>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <select class="form-select" aria-label="Filtrar por categoría" formControlName="categoria">
            <option value="">Todas las categorías</option>
            @for (categoria of categorias; track categoria.valor) {
              <option [value]="categoria.valor">{{ categoria.etiqueta }}</option>
            }
          </select>
        </div>
        <div class="col-6 col-lg-2">
          <select class="form-select" aria-label="Filtrar por estado" formControlName="estado">
            <option value="">Todo estado</option>
            <option value="critico">Crítico</option>
            <option value="bajo">Bajo</option>
            <option value="optimo">Óptimo</option>
          </select>
        </div>
        <div class="col-lg-2">
          <button class="btn btn-soft w-100" type="button" (click)="limpiar()">
            <i class="bi bi-arrow-counterclockwise"></i> Limpiar
          </button>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-llamma align-middle">
          <thead>
            <tr>
              <th>Insumo</th>
              <th>Categoría</th>
              <th class="text-end">Stock actual</th>
              <th class="text-center">Mín / Máx</th>
              <th>Nivel de stock</th>
              <th class="text-end">Costo unitario</th>
              <th>Estado</th>
              @if (puedeGestionar()) {
                <th class="text-end">Acciones</th>
              }
            </tr>
          </thead>
          <tbody>
            @for (materia of visibles(); track materia.id) {
              @let estado = estadoStock(materia);
              <tr>
                <td>
                  <div class="product-cell">
                    <span class="icon-tile icon-tile-sm" [class]="'icon-tile icon-tile-sm ' + tonoCategoria(materia.categoria)">
                      <i class="bi" [class]="'bi ' + iconoCategoria(materia.categoria)"></i>
                    </span>
                    <div>
                      <strong>{{ materia.nombre }}</strong>
                      <small>{{ materia.proveedor ? 'Proveedor · ' + materia.proveedor : 'Sin proveedor asignado' }}</small>
                    </div>
                  </div>
                </td>
                <td>{{ etiquetaCategoria(materia.categoria) }}</td>
                <td class="text-end cell-main">
                  {{ cantidad(materia.stockActual, materia.unidadMedida) }}
                </td>
                <td class="text-center">
                  {{ cantidad(materia.stockMinimo) }} / {{ cantidad(materia.stockMaximo) }}
                </td>
                <td>
                  <div class="stock-cell">
                    <div class="stock-cell-top">
                      <strong [class]="estado.texto">{{ estado.porcentaje }}%</strong>
                      <span>{{ estado.etiqueta }}</span>
                    </div>
                    <div class="stock-track stock-track-lg">
                      <span class="stock-fill" [class]="'stock-fill ' + estado.barra" [style.width]="estado.porcentaje + '%'"></span>
                    </div>
                  </div>
                </td>
                <td class="text-end">{{ costoUnitario(materia) }}</td>
                <td>
                  <span class="badge" [class]="estado.badge">{{ estado.etiqueta }}</span>
                </td>
                @if (puedeGestionar()) {
                  <td class="text-end">
                    <div class="d-inline-flex gap-1">
                      <button
                        class="btn btn-icon"
                        type="button"
                        aria-label="Registrar movimiento"
                        title="Registrar movimiento"
                        (click)="abrirAjuste(materia)"
                      >
                        <i class="bi bi-arrow-left-right"></i>
                      </button>
                      <button
                        class="btn btn-icon"
                        type="button"
                        aria-label="Editar insumo"
                        title="Editar insumo"
                        (click)="abrirEditar(materia)"
                      >
                        <i class="bi bi-pencil"></i>
                      </button>
                      <button
                        class="btn btn-icon"
                        type="button"
                        aria-label="Dar de baja"
                        title="Dar de baja"
                        (click)="desactivar(materia)"
                      >
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  </td>
                }
              </tr>
            } @empty {
              <tr>
                <td [attr.colspan]="puedeGestionar() ? 8 : 7" class="text-center text-muted py-5">
                  <i class="bi bi-boxes d-block fs-4 mb-2"></i>
                  No hay insumos con esos filtros.
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>

      <div class="table-footer">
        <span>{{ rangoTexto() }}</span>
        <nav aria-label="Paginación del inventario">
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item" [class.disabled]="pagina() <= 1">
              <button class="page-link" type="button" aria-label="Anterior" (click)="irA(pagina() - 1)">
                <i class="bi bi-chevron-left"></i>
              </button>
            </li>
            @for (numero of listaPaginas(); track numero) {
              <li class="page-item" [class.active]="numero === pagina()">
                <button class="page-link" type="button" (click)="irA(numero)">{{ numero }}</button>
              </li>
            }
            <li class="page-item" [class.disabled]="pagina() >= paginas()">
              <button class="page-link" type="button" aria-label="Siguiente" (click)="irA(pagina() + 1)">
                <i class="bi bi-chevron-right"></i>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </section>

    <div class="row g-4">
      <div class="col-lg-6">
        <article class="panel-card h-100">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Trazabilidad</span>
              <h2>Movimientos recientes</h2>
            </div>
            @if (cargandoMovimientos()) {
              <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
            } @else {
              <span class="badge badge-soft-muted">{{ movimientosRecientes().length }} registros</span>
            }
          </div>

          <div class="movement-list">
            @for (movimiento of movimientosRecientes(); track movimiento.id) {
              @let estilo = claseMovimiento(movimiento.tipo);
              <div class="movement-row">
                <span class="icon-tile icon-tile-sm" [class]="'icon-tile icon-tile-sm ' + estilo.tono">
                  <i class="bi" [class]="'bi ' + estilo.icono"></i>
                </span>
                <div class="flex-grow-1">
                  <strong>{{ etiquetaTipo(movimiento.tipo) }} · {{ movimiento.materiaPrima }}</strong>
                  <small>
                    {{ movimiento.motivo || movimiento.referencia || (movimiento.usuario || 'Sistema') }}
                    · {{ fechaHora(movimiento.fecha) }}
                  </small>
                </div>
                <span class="movement-amount" [class]="'movement-amount ' + estilo.monto">
                  {{ signoTipo(movimiento.tipo) }}{{ cantidad(movimiento.cantidad, movimiento.unidadMedida) }}
                </span>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">
                Aún no hay movimientos registrados. Captura una entrada para comenzar el historial.
              </p>
            }
          </div>
        </article>
      </div>

      <div class="col-lg-6">
        <article class="panel-card h-100 d-flex flex-column">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Reposición sugerida</span>
              <h2>Sugerencias de compra</h2>
            </div>
            <span class="badge badge-soft-magenta">{{ sugerencias().length }} insumos</span>
          </div>

          <div>
            @for (sugerencia of sugerencias().slice(0, 5); track sugerencia.materia.id) {
              <div class="purchase-item">
                <span class="icon-tile icon-tile-sm" [class]="'icon-tile icon-tile-sm ' + tonoCategoria(sugerencia.materia.categoria)">
                  <i class="bi" [class]="'bi ' + sugerencia.icono"></i>
                </span>
                <div>
                  <strong>{{ sugerencia.materia.nombre }}</strong>
                  <small>
                    Reponer {{ cantidad(sugerencia.reposicion, sugerencia.materia.unidadMedida) }} ·
                    {{ sugerencia.materia.proveedor || 'Sin proveedor' }}
                  </small>
                </div>
                <span class="badge" [class]="sugerencia.estado.clave === 'critico' ? 'badge-soft-danger' : 'badge-soft-warning'">
                  {{ sugerencia.estado.clave === 'critico' ? 'Urgente' : 'Esta semana' }}
                </span>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">
                No hay reposiciones urgentes: el inventario cubre los umbrales definidos.
              </p>
            }
          </div>

          <a class="btn btn-outline-ink w-100 mt-auto" routerLink="/abastecimiento">
            <i class="bi bi-cart-plus"></i> Generar orden de compra
          </a>
        </article>
      </div>
    </div>
  </div>
</div>

@if (formularioAbierto()) {
  <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="z-index: 1055">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <form [formGroup]="formulario" (ngSubmit)="guardar()">
          <div class="modal-header">
            <div>
              <span class="panel-kicker">{{ editando() ? 'Editar insumo' : 'Alta de insumo' }}</span>
              <h2 class="modal-title h5 mb-0">
                {{ editando() ? editando()!.nombre : 'Nuevo insumo' }}
              </h2>
            </div>
            <button class="btn btn-icon" type="button" aria-label="Cerrar" (click)="cerrarFormulario()">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>

          <div class="modal-body">
            <div class="row g-3">
              <div class="col-md-7">
                <label class="form-label" for="insumoNombre">Nombre del insumo *</label>
                <input id="insumoNombre" class="form-control" formControlName="nombre" />
                @if (formulario.controls.nombre.invalid && formulario.controls.nombre.touched) {
                  <small class="text-danger">Indica al menos dos caracteres.</small>
                }
              </div>
              <div class="col-md-5">
                <label class="form-label" for="insumoCategoria">Categoría</label>
                <select id="insumoCategoria" class="form-select" formControlName="categoria">
                  @for (categoria of categorias; track categoria.valor) {
                    <option [value]="categoria.valor">{{ categoria.etiqueta }}</option>
                  }
                </select>
              </div>
              <div class="col-md-5">
                <label class="form-label" for="insumoUnidad">Unidad de medida</label>
                <select id="insumoUnidad" class="form-select" formControlName="unidadMedida">
                  @for (unidad of unidades; track unidad.valor) {
                    <option [value]="unidad.valor">{{ unidad.etiqueta }}</option>
                  }
                </select>
              </div>
              <div class="col-md-7">
                <label class="form-label" for="insumoProveedor">Proveedor</label>
                <select id="insumoProveedor" class="form-select" formControlName="proveedorId">
                  <option value="">Sin proveedor asignado</option>
                  @for (proveedor of proveedores(); track proveedor.id) {
                    <option [value]="proveedor.id">{{ proveedor.nombre }}</option>
                  }
                </select>
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label" for="insumoActual">Stock actual</label>
                <input id="insumoActual" type="number" min="0" step="0.01" class="form-control" formControlName="stockActual" />
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label" for="insumoMinimo">Stock mínimo</label>
                <input id="insumoMinimo" type="number" min="0" step="0.01" class="form-control" formControlName="stockMinimo" />
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label" for="insumoMaximo">Stock máximo</label>
                <input id="insumoMaximo" type="number" min="0" step="0.01" class="form-control" formControlName="stockMaximo" />
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label" for="insumoCosto">Costo unitario</label>
                <input id="insumoCosto" type="number" min="0" step="0.01" class="form-control" formControlName="costoUnitario" />
              </div>
            </div>
          </div>

          <div class="modal-footer">
            <button class="btn btn-outline-ink" type="button" (click)="cerrarFormulario()">Cancelar</button>
            <button class="btn btn-brand" type="submit" [disabled]="guardando()">
              <i class="bi" [class]="guardando() ? 'bi-arrow-repeat spin' : 'bi-check2'"></i>
              {{ guardando() ? 'Guardando…' : 'Guardar insumo' }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}

@if (ajusteAbierto()) {
  <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="z-index: 1055">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form [formGroup]="ajusteForm" (ngSubmit)="registrarMovimiento()">
          <div class="modal-header">
            <div>
              <span class="panel-kicker">Trazabilidad de inventario</span>
              <h2 class="modal-title h5 mb-0">Registrar movimiento</h2>
            </div>
            <button class="btn btn-icon" type="button" aria-label="Cerrar" (click)="cerrarAjuste()">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>

          <div class="modal-body">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label" for="movInsumo">Insumo *</label>
                <select id="movInsumo" class="form-select" formControlName="materiaId">
                  <option value="">Selecciona un insumo…</option>
                  @for (materia of materias(); track materia.id) {
                    <option [value]="materia.id">{{ materia.nombre }}</option>
                  }
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="movTipo">Tipo de movimiento *</label>
                <select id="movTipo" class="form-select" formControlName="tipo">
                  @for (tipo of tiposMovimiento; track tipo.valor) {
                    <option [value]="tipo.valor">{{ tipo.etiqueta }}</option>
                  }
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="movCantidad">Cantidad *</label>
                <input id="movCantidad" type="number" min="0" step="0.01" class="form-control" formControlName="cantidad" />
                @if (ajusteForm.controls.cantidad.invalid && ajusteForm.controls.cantidad.touched) {
                  <small class="text-danger">Captura una cantidad mayor a cero.</small>
                }
              </div>
              <div class="col-12">
                <label class="form-label" for="movReferencia">Referencia</label>
                <input id="movReferencia" class="form-control" formControlName="referencia" placeholder="Orden de compra, folio, proveedor…" />
              </div>
              <div class="col-12">
                <label class="form-label" for="movMotivo">Motivo</label>
                <input id="movMotivo" class="form-control" formControlName="motivo" placeholder="Compra, consumo de producción, conteo físico…" />
              </div>
            </div>

            @if (vistaPreviaAjuste(); as previa) {
              <div class="movement-preview mt-3">
                <div>
                  <span>Stock actual</span>
                  <strong>{{ cantidad(previa.materia.stockActual, previa.materia.unidadMedida) }}</strong>
                </div>
                <i class="bi bi-arrow-right"></i>
                <div>
                  <span>Stock resultante</span>
                  <strong>{{ cantidad(previa.resultado, previa.materia.unidadMedida) }}</strong>
                </div>
              </div>
              <p class="text-muted small mb-0 mt-2">
                <i class="bi bi-info-circle"></i>
                Usa <strong>Ajuste de conteo</strong> para fijar el stock final; entrada, salida, merma y
                devolución operan como suma o resta.
              </p>
            }
          </div>

          <div class="modal-footer">
            <button class="btn btn-outline-ink" type="button" (click)="cerrarAjuste()">Cancelar</button>
            <button class="btn btn-brand" type="submit" [disabled]="ajustando() || !vistaPreviaAjuste()">
              <i class="bi" [class]="ajustando() ? 'bi-arrow-repeat spin' : 'bi-check2'"></i>
              {{ ajustando() ? 'Registrando…' : 'Registrar movimiento' }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}
</file>

<file path="src/app/llamma/inventario/inventario.component.ts">
import {
  ChangeDetectionStrategy,
  Component,
  OnInit,
  computed,
  inject,
  signal,
} from '@angular/core';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { finalize } from 'rxjs';

import { AuthService } from '../auth.service';
import {
  CategoriaMateriaPrima,
  MateriaPrimaApi,
  MovimientoApi,
  ProveedorApi,
  TipoMovimiento,
  UnidadMedida,
} from '../llamma.models';
import { LlammaService } from '../llamma.service';
import { UiService } from '../ui.service';

const CATEGORIAS: { valor: CategoriaMateriaPrima; etiqueta: string; icono: string }[] = [
  { valor: 'lona', etiqueta: 'Lonas', icono: 'bi-layers' },
  { valor: 'vinil', etiqueta: 'Viniles', icono: 'bi-square' },
  { valor: 'tinta', etiqueta: 'Tintas', icono: 'bi-droplet-half' },
  { valor: 'papel', etiqueta: 'Papeles', icono: 'bi-file-earmark-text' },
  { valor: 'herrajes', etiqueta: 'Herrajes', icono: 'bi-disc' },
  { valor: 'estructura', etiqueta: 'Estructuras', icono: 'bi-bounding-box' },
  { valor: 'lamina', etiqueta: 'Rígidos', icono: 'bi-grid-3x3' },
  { valor: 'laminado', etiqueta: 'Acabados', icono: 'bi-arrow-repeat' },
  { valor: 'adhesivo', etiqueta: 'Adhesivos', icono: 'bi-stickies' },
  { valor: 'perfil', etiqueta: 'Perfiles', icono: 'bi-bounding-box-circles' },
  { valor: 'textil', etiqueta: 'Textil', icono: 'bi-bag' },
  { valor: 'promocional', etiqueta: 'Promocionales', icono: 'bi-gift' },
  { valor: 'otro', etiqueta: 'Otros', icono: 'bi-box-seam' },
];

const UNIDADES: { valor: UnidadMedida; etiqueta: string; corta: string }[] = [
  { valor: 'm2', etiqueta: 'Metro cuadrado (m²)', corta: 'm²' },
  { valor: 'ml', etiqueta: 'Metro lineal (ml)', corta: 'ml' },
  { valor: 'pieza', etiqueta: 'Pieza', corta: 'pza' },
  { valor: 'hoja', etiqueta: 'Hoja', corta: 'hoja' },
  { valor: 'kg', etiqueta: 'Kilogramo', corta: 'kg' },
  { valor: 'litro', etiqueta: 'Litro', corta: 'L' },
];

const TIPOS_MOVIMIENTO: { valor: TipoMovimiento; etiqueta: string; signo: string }[] = [
  { valor: 'entrada', etiqueta: 'Entrada', signo: '+' },
  { valor: 'salida', etiqueta: 'Salida', signo: '−' },
  { valor: 'ajuste', etiqueta: 'Ajuste de conteo', signo: '=' },
  { valor: 'merma', etiqueta: 'Merma', signo: '−' },
  { valor: 'devolucion', etiqueta: 'Devolución', signo: '+' },
];

const TONO_CATEGORIA: Record<string, string> = {
  lona: 'icon-tile-cyan',
  vinil: 'icon-tile-cyan',
  tinta: 'icon-tile-magenta',
  papel: 'icon-tile-ink',
  herrajes: 'icon-tile-ink',
  estructura: 'icon-tile-yellow',
  lamina: 'icon-tile-cyan',
  laminado: 'icon-tile-cyan',
  adhesivo: 'icon-tile-cyan',
  perfil: 'icon-tile-yellow',
  textil: 'icon-tile-magenta',
  promocional: 'icon-tile-magenta',
  otro: 'icon-tile-ink',
};

type ClaveEstado = 'critico' | 'bajo' | 'optimo';

interface EstadoStock {
  clave: ClaveEstado;
  etiqueta: string;
  badge: string;
  barra: string;
  texto: string;
  porcentaje: number;
}

@Component({
  selector: 'app-inventario',
  imports: [ReactiveFormsModule, RouterLink],
  templateUrl: './inventario.component.html',
  styleUrl: './inventario.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class InventarioComponent implements OnInit {
  private readonly service = inject(LlammaService);
  private readonly ui = inject(UiService);
  private readonly fb = inject(FormBuilder);
  readonly auth = inject(AuthService);

  readonly categorias = CATEGORIAS;
  readonly unidades = UNIDADES;
  readonly tiposMovimiento = TIPOS_MOVIMIENTO;

  readonly materias = signal<MateriaPrimaApi[]>([]);
  readonly movimientos = signal<MovimientoApi[]>([]);
  readonly proveedores = signal<ProveedorApi[]>([]);
  readonly cargando = signal(true);
  readonly cargandoMovimientos = signal(true);
  readonly error = signal<string | null>(null);
  readonly pagina = signal(1);
  readonly porPagina = 8;

  readonly formularioAbierto = signal(false);
  readonly editando = signal<MateriaPrimaApi | null>(null);
  readonly guardando = signal(false);
  readonly ajusteAbierto = signal(false);
  readonly materiaAjuste = signal<MateriaPrimaApi | null>(null);
  readonly ajustando = signal(false);

  readonly puedeGestionar = computed(() => this.auth.tieneRol('admin', 'inventario'));

  readonly filtros = this.fb.nonNullable.group({
    q: [''],
    categoria: [''],
    estado: [''],
  });

  readonly formulario = this.fb.nonNullable.group({
    nombre: ['', [Validators.required, Validators.minLength(2)]],
    categoria: ['otro' as CategoriaMateriaPrima, [Validators.required]],
    unidadMedida: ['pieza' as UnidadMedida, [Validators.required]],
    stockActual: [0, [Validators.required, Validators.min(0)]],
    stockMinimo: [0, [Validators.required, Validators.min(0)]],
    stockMaximo: [0, [Validators.required, Validators.min(0)]],
    costoUnitario: [0, [Validators.required, Validators.min(0)]],
    proveedorId: [''],
  });

  readonly ajusteForm = this.fb.nonNullable.group({
    materiaId: ['', [Validators.required]],
    tipo: ['entrada' as TipoMovimiento, [Validators.required]],
    cantidad: [0, [Validators.required, Validators.min(0.0001)]],
    referencia: [''],
    motivo: [''],
  });

  readonly filtradas = computed(() => {
    const { q, categoria, estado } = this.filtros.getRawValue();
    const termino = q.trim().toLowerCase();
    return this.materias().filter((materia) => {
      if (categoria && materia.categoria !== categoria) return false;
      if (estado && this.estadoStock(materia).clave !== estado) return false;
      if (!termino) return true;
      const etiqueta = this.etiquetaCategoria(materia.categoria).toLowerCase();
      return [materia.nombre, materia.proveedor ?? '', etiqueta, materia.categoria]
        .join(' ')
        .toLowerCase()
        .includes(termino);
    });
  });

  readonly paginas = computed(() => Math.max(1, Math.ceil(this.filtradas().length / this.porPagina)));

  readonly visibles = computed(() => {
    const inicio = (this.pagina() - 1) * this.porPagina;
    return this.filtradas().slice(inicio, inicio + this.porPagina);
  });

  readonly listaPaginas = computed(() => {
    const total = this.paginas();
    const actual = this.pagina();
    const desde = Math.max(1, actual - 2);
    const hasta = Math.min(total, desde + 4);
    return Array.from({ length: Math.max(0, hasta - desde + 1) }, (_, i) => desde + i);
  });

  readonly estadisticas = computed(() => {
    const materias = this.materias();
    const valor = materias.reduce(
      (total, materia) => total + materia.stockActual * materia.costoUnitario,
      0,
    );
    const criticos = materias.filter((m) => this.estadoStock(m).clave === 'critico').length;
    const proveedores = new Set(
      materias.map((materia) => materia.proveedorId).filter((id) => id != null),
    ).size;
    return [
      {
        icono: 'bi-cash-stack',
        tono: 'icon-tile-cyan',
        valor: this.moneda(valor),
        etiqueta: 'Valor del inventario',
      },
      {
        icono: 'bi-boxes',
        tono: 'icon-tile-magenta',
        valor: String(materias.length),
        etiqueta: 'Insumos controlados',
      },
      {
        icono: 'bi-exclamation-octagon',
        tono: criticos ? 'icon-tile-danger' : 'icon-tile-success',
        valor: this.dosDigitos(criticos),
        etiqueta: 'Insumos críticos',
      },
      {
        icono: 'bi-truck',
        tono: 'icon-tile-yellow',
        valor: this.dosDigitos(proveedores),
        etiqueta: 'Proveedores con suministro',
      },
    ];
  });

  readonly resumenAlerta = computed(() => {
    const criticos = this.materias().filter((m) => this.estadoStock(m).clave === 'critico');
    const bajos = this.materias().filter((m) => this.estadoStock(m).clave === 'bajo');
    const nombres = criticos.slice(0, 2).map((m) => m.nombre);
    return {
      criticos: criticos.length,
      bajos: bajos.length,
      nombres: nombres.join(' y '),
      total: criticos.length + bajos.length,
    };
  });

  readonly sugerencias = computed(() =>
    this.materias()
      .filter((materia) => this.estadoStock(materia).clave !== 'optimo')
      .map((materia) => {
        const estado = this.estadoStock(materia);
        const objetivo = Math.max(materia.stockMaximo, materia.stockMinimo * 2, materia.stockActual);
        return {
          materia,
          estado,
          reposicion: Math.max(objetivo - materia.stockActual, 0),
          icono: this.iconoCategoria(materia.categoria),
        };
      })
      .sort((a, b) => a.estado.porcentaje - b.estado.porcentaje),
  );

  readonly movimientosRecientes = computed(() => this.movimientos().slice(0, 8));

  readonly vistaPreviaAjuste = computed(() => {
    const valores = this.ajusteForm.getRawValue();
    const materia = this.materias().find((m) => m.id === Number(valores.materiaId));
    if (!materia) return null;
    const cantidad = Number(valores.cantidad) || 0;
    const actual = materia.stockActual;
    let resultado = actual;
    if (valores.tipo === 'entrada' || valores.tipo === 'devolucion') resultado = actual + cantidad;
    else if (valores.tipo === 'salida' || valores.tipo === 'merma')
      resultado = Math.max(actual - cantidad, 0);
    else resultado = Math.max(cantidad, 0);
    return { materia, resultado };
  });

  ngOnInit(): void {
    this.cargar();
    this.cargarMovimientos();
    this.cargarProveedores();
  }

  cargar(): void {
    this.cargando.set(true);
    this.error.set(null);
    this.service
      .listarMaterias()
      .pipe(finalize(() => this.cargando.set(false)))
      .subscribe({
        next: (respuesta) => {
          this.materias.set(respuesta.items);
          const paginas = Math.max(1, Math.ceil(this.filtradas().length / this.porPagina));
          if (this.pagina() > paginas) this.pagina.set(paginas);
        },
        error: (error) => {
          this.error.set(this.ui.mensajeDeError(error, 'No pudimos cargar el inventario.'));
        },
      });
  }

  cargarMovimientos(): void {
    this.cargandoMovimientos.set(true);
    this.service
      .listarMovimientos({ page: 1, perPage: 8 })
      .pipe(finalize(() => this.cargandoMovimientos.set(false)))
      .subscribe({
        next: (respuesta) => this.movimientos.set(respuesta.items),
        error: () => this.movimientos.set([]),
      });
  }

  cargarProveedores(): void {
    this.service.listarProveedores().subscribe({
      next: (respuesta) => this.proveedores.set(respuesta.items),
      error: () => this.proveedores.set([]),
    });
  }

  filtrar(): void {
    this.pagina.set(1);
  }

  limpiar(): void {
    this.filtros.reset({ q: '', categoria: '', estado: '' });
    this.pagina.set(1);
  }

  irA(pagina: number): void {
    const destino = Math.min(Math.max(pagina, 1), this.paginas());
    this.pagina.set(destino);
  }

  abrirNuevo(): void {
    this.editando.set(null);
    this.formulario.reset({
      nombre: '',
      categoria: 'otro',
      unidadMedida: 'pieza',
      stockActual: 0,
      stockMinimo: 0,
      stockMaximo: 0,
      costoUnitario: 0,
      proveedorId: '',
    });
    this.formularioAbierto.set(true);
  }

  abrirEditar(materia: MateriaPrimaApi): void {
    this.editando.set(materia);
    this.formulario.reset({
      nombre: materia.nombre,
      categoria: materia.categoria as CategoriaMateriaPrima,
      unidadMedida: materia.unidadMedida,
      stockActual: materia.stockActual,
      stockMinimo: materia.stockMinimo,
      stockMaximo: materia.stockMaximo,
      costoUnitario: materia.costoUnitario,
      proveedorId: materia.proveedorId ? String(materia.proveedorId) : '',
    });
    this.formularioAbierto.set(true);
  }

  cerrarFormulario(): void {
    this.formularioAbierto.set(false);
    this.editando.set(null);
  }

  guardar(): void {
    if (this.formulario.invalid) {
      this.formulario.markAllAsTouched();
      return;
    }
    const valores = this.formulario.getRawValue();
    const body: Record<string, unknown> = {
      nombre: valores.nombre.trim(),
      categoria: valores.categoria,
      unidadMedida: valores.unidadMedida,
      stockActual: Number(valores.stockActual),
      stockMinimo: Number(valores.stockMinimo),
      stockMaximo: Number(valores.stockMaximo),
      costoUnitario: Number(valores.costoUnitario),
      proveedorId: valores.proveedorId ? Number(valores.proveedorId) : null,
    };
    const edicion = this.editando();
    this.guardando.set(true);
    const peticion = edicion
      ? this.service.actualizarMateria(edicion.id, body)
      : this.service.crearMateria(body);

    peticion.pipe(finalize(() => this.guardando.set(false))).subscribe({
      next: () => {
        this.ui.exito(edicion ? 'Insumo actualizado.' : 'Insumo registrado.');
        this.cerrarFormulario();
        this.cargar();
      },
      error: (error) => this.ui.error(this.ui.mensajeDeError(error, 'No pudimos guardar el insumo.')),
    });
  }

  desactivar(materia: MateriaPrimaApi): void {
    if (!window.confirm(`¿Dar de baja ${materia.nombre}? Su historial de movimientos se conserva.`))
      return;
    this.service.desactivarMateria(materia.id).subscribe({
      next: () => {
        this.ui.exito('Insumo dado de baja.');
        this.cargar();
      },
      error: (error) => this.ui.error(this.ui.mensajeDeError(error, 'No pudimos dar de baja el insumo.')),
    });
  }

  abrirAjuste(materia?: MateriaPrimaApi, tipo: TipoMovimiento = 'entrada'): void {
    const objetivo = materia ?? this.filtradas()[0] ?? this.materias()[0];
    if (!objetivo) {
      this.ui.info('Registra primero un insumo para capturar movimientos.');
      return;
    }
    this.materiaAjuste.set(objetivo);
    this.ajusteForm.reset({
      materiaId: String(objetivo.id),
      tipo,
      cantidad: 0,
      referencia: '',
      motivo: '',
    });
    this.ajusteAbierto.set(true);
  }

  cerrarAjuste(): void {
    this.ajusteAbierto.set(false);
    this.materiaAjuste.set(null);
  }

  registrarMovimiento(): void {
    if (this.ajusteForm.invalid) {
      this.ajusteForm.markAllAsTouched();
      return;
    }
    const valores = this.ajusteForm.getRawValue();
    const materia = this.materias().find((m) => m.id === Number(valores.materiaId));
    if (!materia) {
      this.ui.error('Selecciona un insumo válido.');
      return;
    }
    this.ajustando.set(true);
    this.service
      .ajustarInventario(materia.id, {
        tipo: valores.tipo,
        cantidad: Number(valores.cantidad),
        referencia: valores.referencia.trim() || undefined,
        motivo: valores.motivo.trim() || undefined,
      })
      .pipe(finalize(() => this.ajustando.set(false)))
      .subscribe({
        next: (respuesta) => {
          this.materias.update((lista) =>
            lista.map((fila) => (fila.id === respuesta.materia.id ? respuesta.materia : fila)),
          );
          this.cerrarAjuste();
          this.cargarMovimientos();
          this.cargar();
          this.ui.exito(
            `Movimiento registrado. ${respuesta.materia.nombre}: ${this.cantidad(
              respuesta.materia.stockActual,
            )}.`,
          );
        },
        error: (error) => this.ui.error(this.ui.mensajeDeError(error, 'No pudimos registrar el movimiento.')),
      });
  }

  exportar(): void {
    const filas = [
      [
        'Insumo',
        'Categoría',
        'Unidad',
        'Stock actual',
        'Stock mínimo',
        'Stock máximo',
        'Costo unitario',
        'Valor',
        'Proveedor',
        'Estado',
      ],
      ...this.filtradas().map((materia) => {
        const estado = this.estadoStock(materia);
        return [
          materia.nombre,
          this.etiquetaCategoria(materia.categoria),
          materia.unidadMedida,
          String(materia.stockActual),
          String(materia.stockMinimo),
          String(materia.stockMaximo),
          String(materia.costoUnitario),
          String(Math.round(materia.stockActual * materia.costoUnitario * 100) / 100),
          materia.proveedor ?? '',
          estado.etiqueta,
        ];
      }),
    ];
    const csv = filas.map((fila) => fila.map((celda) => `"${celda}"`).join(',')).join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    const enlace = document.createElement('a');
    enlace.href = url;
    enlace.download = 'inventario-llamma.csv';
    enlace.click();
    URL.revokeObjectURL(url);
    this.ui.exito('Inventario exportado en CSV.');
  }

  estadoStock(materia: MateriaPrimaApi): EstadoStock {
    const actual = Number(materia.stockActual) || 0;
    const minimo = Number(materia.stockMinimo) || 0;
    const maximo = Number(materia.stockMaximo) || 0;
    const base = maximo > 0 ? maximo : Math.max(minimo * 2, actual, 1);
    const porcentaje = Math.min(100, Math.max(2, Math.round((actual / base) * 100)));

    if (actual <= 0 || (minimo > 0 && actual <= minimo * 0.5)) {
      return {
        clave: 'critico',
        etiqueta: 'Crítico',
        badge: 'badge-soft-danger',
        barra: 'bg-danger',
        texto: 'text-danger',
        porcentaje,
      };
    }
    if (minimo > 0 && actual <= minimo) {
      return {
        clave: 'bajo',
        etiqueta: 'Bajo',
        badge: 'badge-soft-warning',
        barra: 'bg-warning',
        texto: 'text-warning',
        porcentaje,
      };
    }
    return {
      clave: 'optimo',
      etiqueta: 'Óptimo',
      badge: 'badge-soft-success',
      barra: 'bg-success',
      texto: 'text-success',
      porcentaje,
    };
  }

  iconoCategoria(categoria: string): string {
    return CATEGORIAS.find((fila) => fila.valor === categoria)?.icono ?? 'bi-box-seam';
  }

  tonoCategoria(categoria: string): string {
    return TONO_CATEGORIA[categoria] ?? 'icon-tile-ink';
  }

  etiquetaCategoria(categoria: string): string {
    return CATEGORIAS.find((fila) => fila.valor === categoria)?.etiqueta ?? categoria;
  }

  unidadCorta(unidad: string): string {
    return UNIDADES.find((fila) => fila.valor === unidad)?.corta ?? unidad;
  }

  etiquetaTipo(tipo: string): string {
    return TIPOS_MOVIMIENTO.find((fila) => fila.valor === tipo)?.etiqueta ?? tipo;
  }

  signoTipo(tipo: string): string {
    return TIPOS_MOVIMIENTO.find((fila) => fila.valor === tipo)?.signo ?? '';
  }

  claseMovimiento(tipo: string): { icono: string; tono: string; monto: string } {
    switch (tipo) {
      case 'entrada':
      case 'devolucion':
        return { icono: 'bi-box-arrow-in-down', tono: 'icon-tile-success', monto: 'text-success' };
      case 'salida':
      case 'merma':
        return { icono: 'bi-box-arrow-up', tono: 'icon-tile-danger', monto: 'text-danger' };
      default:
        return { icono: 'bi-sliders', tono: 'icon-tile-warning', monto: 'text-warning' };
    }
  }

  rangoTexto(): string {
    const total = this.filtradas().length;
    const inicio = total ? (this.pagina() - 1) * this.porPagina + 1 : 0;
    return `Mostrando ${inicio}–${Math.min(this.pagina() * this.porPagina, total)} de ${total} insumos`;
  }

  cantidad(valor: number, unidad?: string): string {
    const numero = new Intl.NumberFormat('es-MX', { maximumFractionDigits: 2 }).format(
      Number(valor ?? 0),
    );
    return unidad ? `${numero} ${this.unidadCorta(unidad)}` : numero;
  }

  moneda(valor: number | null | undefined): string {
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0,
    }).format(Number(valor ?? 0));
  }

  costoUnitario(materia: MateriaPrimaApi): string {
    const numero = new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(Number(materia.costoUnitario ?? 0));
    return `${numero} / ${this.unidadCorta(materia.unidadMedida)}`;
  }

  fechaHora(valor: string | null | undefined): string {
    if (!valor) return 'Sin fecha';
    const fecha = new Date(valor);
    if (Number.isNaN(fecha.getTime())) return 'Sin fecha';
    return fecha.toLocaleString('es-MX', {
      day: '2-digit',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  dosDigitos(valor: number): string {
    return String(valor).padStart(2, '0');
  }
}
