<div class="module-page captura-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Cotizador interno</span>
        <h1>{{ modoExistente() ? 'Revisa y convierte.' : 'Captura tu cotización.' }}</h1>
        <p class="page-lead">
          @if (modoExistente()) {
            Revisa las partidas y los totales de la cotización, registra el anticipo y conviértela
            en pedido para enviarla a producción.
          } @else {
            Completa los datos del cliente, define las partidas con precios y guarda la cotización.
            Si vienes de una solicitud del portal, los datos ya están precargados.
          }
        </p>
      </div>
      <div class="quote-chip">
        <span>Cotización</span>
        <strong>{{ cotizacion()?.folio || 'Nueva' }}</strong>
      </div>
    </header>

    <div class="checkout-stepper">
      <div class="step-item" [class.is-active]="!modoExistente()">
        <span>1</span>
        <div><strong>Cliente</strong><small>Datos de contacto</small></div>
      </div>
      <div class="step-line"></div>
      <div class="step-item" [class.is-active]="!modoExistente()">
        <span>2</span>
        <div><strong>Productos</strong><small>Partidas y precios</small></div>
      </div>
      <div class="step-line"></div>
      <div class="step-item">
        <span>3</span>
        <div><strong>Condiciones</strong><small>Vigencia y notas</small></div>
      </div>
      <div class="step-line"></div>
      <div class="step-item" [class.is-active]="modoExistente()">
        <span>4</span>
        <div><strong>Confirmación</strong><small>Anticipo y pedido</small></div>
      </div>
    </div>

    @if (pedidoCreado()) {
      <section class="panel-card capture-success">
        <span class="success-mark"><i class="bi bi-check2-circle"></i></span>
        <div class="flex-grow-1">
          <span class="panel-kicker">Pedido en producción</span>
          <h2>{{ pedidoCreado() }}</h2>
          <p>
            El pedido se creó a partir de {{ cotizacion()?.folio }}. El inventario se descontó según
            las recetas y la orden ya aparece en el tablero de producción.
          </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-brand btn-sm" routerLink="/detalle">
            <i class="bi bi-receipt"></i> Ver órdenes
          </a>
          <button class="btn btn-outline-ink btn-sm" type="button" (click)="nuevaCotizacion()">
            <i class="bi bi-plus-lg"></i> Nueva cotización
          </button>
        </div>
      </section>
    }

    @if (error()) {
      <div class="capture-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>{{ error() }}</span>
      </div>
    }

    @if (cargando()) {
      <div class="panel-card capture-loading">
        <i class="bi bi-arrow-repeat"></i>
        <span>Cargando información...</span>
      </div>
    } @else if (modoExistente()) {
      @if (creada() && !pedidoCreado() && cotizacion(); as cot) {
        <section class="panel-card capture-created">
          <span class="success-mark"><i class="bi bi-file-earmark-check"></i></span>
          <div class="flex-grow-1">
            <span class="panel-kicker">Cotización guardada</span>
            <h2>{{ cot.folio }}</h2>
            <p>
              Total {{ moneda(cot.total) }} para {{ cot.cliente || form.controls.nombreCliente.value }}.
              Ya puedes convertirla en pedido con el anticipo del 50%.
            </p>
          </div>
          @if (!pedidoCreado()) {
            <button class="btn btn-outline-ink btn-sm" type="button" (click)="nuevaCotizacion()">
              <i class="bi bi-plus-lg"></i> Nueva cotización
            </button>
          }
        </section>
      }

      <div class="row g-4">
        <div class="col-xl-8">
          <section class="panel-card mb-4">
            <div class="panel-head">
              <div class="d-flex align-items-center gap-3">
                <span class="step-number">01</span>
                <div>
                  <span class="panel-kicker">Cotización {{ cotizacion()?.folio }}</span>
                  <h2>{{ cotizacion()?.cliente || form.controls.nombreCliente.value }}</h2>
                </div>
              </div>
              <span class="badge" [class]="claseEstado()">{{ etiquetaEstado() }}</span>
            </div>

            <div class="capture-meta">
              <div>
                <span>Cliente</span>
                <strong>{{ cotizacion()?.cliente || '—' }}</strong>
              </div>
              <div>
                <span>Emisión</span>
                <strong>{{ fecha(cotizacion()?.fechaEmision) }}</strong>
              </div>
              <div>
                <span>Vigencia</span>
                <strong>{{ cotizacion()?.vigenciaDias }} días</strong>
              </div>
              <div>
                <span>Partidas</span>
                <strong>{{ partidas().length }}</strong>
              </div>
            </div>

            @if (cotizacion()?.notas) {
              <div class="quote-note">
                <i class="bi bi-chat-left-text"></i>
                <span>{{ cotizacion()?.notas }}</span>
              </div>
            }
          </section>

          <section class="panel-card">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Detalle</span>
                <h2>Partidas de la cotización</h2>
              </div>
              <span class="badge badge-soft-cyan">{{ piezas() }} piezas / unidades</span>
            </div>

            <div class="table-responsive">
              <table class="table table-llamma align-middle">
                <thead>
                  <tr>
                    <th>Producto</th>
                    <th class="text-center">Cant.</th>
                    <th class="text-end">P. unitario</th>
                    <th class="text-end">Importe</th>
                  </tr>
                </thead>
                <tbody>
                  @for (item of partidas(); track $index) {
                    <tr>
                      <td>
                        <div class="cell-main">{{ item.descripcion }}</div>
                        <div class="cell-muted">
                          {{ item.especificaciones || 'Sin especificaciones' }}
                        </div>
                      </td>
                      <td class="text-center">{{ item.cantidad }}</td>
                      <td class="text-end">{{ moneda(item.precioUnitario) }}</td>
                      <td class="text-end cell-main">{{ moneda(item.importe) }}</td>
                    </tr>
                  } @empty {
                    <tr>
                      <td colspan="4" class="text-center cell-muted">
                        Esta cotización no tiene partidas registradas.
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </section>
        </div>

        <div class="col-xl-4 summary-sidebar">
          <aside class="quote-summary">
            <div class="quote-summary-head">
              <span>Resumen de cotización</span>
              <span class="badge" [class]="claseEstado()">{{ etiquetaEstado() }}</span>
            </div>

            <div class="summary-lines">
              @for (item of partidas(); track $index) {
                <div>
                  <span>{{ item.descripcion }} · {{ item.cantidad }}</span>
                  <strong>{{ moneda(item.importe) }}</strong>
                </div>
              }
            </div>

            <div class="summary-totals">
              <div><span>Subtotal</span><strong>{{ moneda(subtotal()) }}</strong></div>
              <div><span>IVA (16%)</span><strong>{{ moneda(impuestos()) }}</strong></div>
              <div class="summary-total"><span>Total</span><strong>{{ moneda(total()) }}</strong></div>
              <div><span>Anticipo (50%)</span><strong>{{ moneda(anticipo()) }}</strong></div>
              <div><span>Saldo</span><strong>{{ moneda(saldo()) }}</strong></div>
            </div>

            @if (!yaConvertida()) {
              <div class="form-check capture-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  id="anticipoPagado"
                  [checked]="anticipoPagado()"
                  (change)="toggleAnticipo($event)"
                >
                <label class="form-check-label" for="anticipoPagado">
                  Registrar anticipo de {{ moneda(anticipo()) }} como pagado
                </label>
              </div>

              <button
                class="btn btn-brand w-100"
                type="button"
                [disabled]="convirtiendo()"
                (click)="convertirAPedido()"
              >
                @if (convirtiendo()) {
                  <i class="bi bi-hourglass-split"></i> Generando pedido...
                } @else {
                  <i class="bi bi-box-seam"></i> Convertir en pedido
                }
              </button>
            } @else {
              <div class="capture-locked">
                <i class="bi bi-check2-circle"></i>
                <span>
                  Esta cotización ya se convirtió en pedido.
                  <a routerLink="/detalle">Ver órdenes</a>
                </span>
              </div>
            }

            <button class="btn btn-outline-ink w-100 mt-2" type="button" (click)="nuevaCotizacion()">
              <i class="bi bi-plus-lg"></i> Nueva cotización
            </button>

            <p class="summary-note">
              <i class="bi bi-shield-check"></i>
              Al convertir se descuenta el inventario según la receta y se crea la orden de
              producción en la etapa de diseño.
            </p>
          </aside>

          <div class="help-card mt-4">
            <i class="bi bi-headset"></i>
            <div>
              <strong>¿Necesitas ayuda?</strong>
              <p>Nuestro equipo de producción te acompaña con materiales y acabados.</p>
              <a href="tel:+525512345678">55 1234 5678</a>
            </div>
          </div>
        </div>
      </div>
    } @else {
      <div class="row g-4">
        <div class="col-xl-8">
          @if (solicitud(); as origen) {
            <div class="quote-note mb-4">
              <i class="bi bi-inbox"></i>
              <span>
                Cotizando la solicitud <strong>{{ origen.folio }}</strong> de
                {{ origen.nombreCliente }}. Los datos y las partidas se precargaron desde el portal.
              </span>
            </div>
          }

          <form [formGroup]="form" (ngSubmit)="guardar()" novalidate>
            <section class="panel-card mb-4">
              <div class="panel-head">
                <div class="d-flex align-items-center gap-3">
                  <span class="step-number">01</span>
                  <div>
                    <span class="panel-kicker">Información general</span>
                    <h2>Datos del cliente</h2>
                  </div>
                </div>
                <span class="badge badge-soft-muted">Borrador</span>
              </div>

              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label" for="clienteNombre">Nombre del contacto</label>
                  <input
                    id="clienteNombre"
                    type="text"
                    class="form-control"
                    formControlName="nombreCliente"
                    placeholder="Ej. Ana Torres"
                    [class.is-invalid]="form.controls.nombreCliente.touched && form.controls.nombreCliente.invalid"
                  >
                  @if (form.controls.nombreCliente.touched && form.controls.nombreCliente.invalid) {
                    <span class="field-error">Escribe el nombre del contacto.</span>
                  }
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="clienteEmpresa">Empresa o marca</label>
                  <input
                    id="clienteEmpresa"
                    type="text"
                    class="form-control"
                    formControlName="empresa"
                    placeholder="Ej. Estudio Nómada"
                  >
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="clienteCorreo">Correo electrónico</label>
                  <input
                    id="clienteCorreo"
                    type="email"
                    class="form-control"
                    formControlName="correo"
                    placeholder="nombre&#64;empresa.mx"
                    [class.is-invalid]="form.controls.correo.touched && form.controls.correo.invalid"
                  >
                  @if (form.controls.correo.touched && form.controls.correo.invalid) {
                    <span class="field-error">Ingresa un correo válido.</span>
                  }
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="clienteTelefono">Teléfono</label>
                  <input
                    id="clienteTelefono"
                    type="tel"
                    class="form-control"
                    formControlName="telefono"
                    placeholder="55 0000 0000"
                    [class.is-invalid]="form.controls.telefono.touched && form.controls.telefono.invalid"
                  >
                  @if (form.controls.telefono.touched && form.controls.telefono.invalid) {
                    <span class="field-error">Escribe un teléfono de contacto.</span>
                  }
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="clienteRfc">RFC / Razón social</label>
                  <input
                    id="clienteRfc"
                    type="text"
                    class="form-control"
                    formControlName="rfc"
                    placeholder="RFC con homoclave"
                  >
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="clienteSegmento">Segmento</label>
                  <select id="clienteSegmento" class="form-select" formControlName="segmento">
                    <option value="particular">Particular</option>
                    <option value="pyme">Pyme</option>
                    <option value="corporativo">Corporativo</option>
                    <option value="eventos">Eventos</option>
                    <option value="escolar">Escolar</option>
                    <option value="gobierno">Gobierno</option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label" for="clienteDireccion">Dirección de entrega</label>
                  <input
                    id="clienteDireccion"
                    type="text"
                    class="form-control"
                    formControlName="direccion"
                    placeholder="Calle, número, colonia y ciudad"
                  >
                </div>
              </div>
            </section>

            <section class="panel-card mb-4">
              <div class="panel-head">
                <div class="d-flex align-items-center gap-3">
                  <span class="step-number">02</span>
                  <div>
                    <span class="panel-kicker">Configuración de partida</span>
                    <h2>Producto a cotizar</h2>
                  </div>
                </div>
                <span class="badge badge-soft-cyan">{{ partidas().length }} partidas</span>
              </div>

              <div class="row g-3 align-items-end">
                <div class="col-md-4">
                  <label class="form-label" for="productoSelect">Producto terminado</label>
                  <select
                    id="productoSelect"
                    class="form-select"
                    [value]="productoId() ?? ''"
                    (change)="cambiarProducto($event)"
                  >
                    <option value="">Concepto manual</option>
                    @for (producto of productos(); track producto.id) {
                      <option [value]="producto.id">{{ producto.nombre }}</option>
                    }
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label" for="productoDescripcion">Concepto</label>
                  <input
                    id="productoDescripcion"
                    type="text"
                    class="form-control"
                    placeholder="Ej. Lona impresa 2 × 1 m"
                    [value]="descripcion()"
                    (input)="cambiarDescripcion($event)"
                  >
                </div>
                <div class="col-md-4">
                  <label class="form-label" for="productoEspecificaciones">Especificaciones</label>
                  <input
                    id="productoEspecificaciones"
                    type="text"
                    class="form-control"
                    placeholder="Acabado, medida, tintas..."
                    [value]="especificaciones()"
                    (input)="cambiarEspecificaciones($event)"
                  >
                </div>
                <div class="col-4 col-md-2">
                  <label class="form-label" for="productoCantidad">Cantidad</label>
                  <input
                    id="productoCantidad"
                    type="number"
                    class="form-control"
                    min="1"
                    step="1"
                    [value]="cantidad()"
                    (input)="cambiarCantidad($event)"
                  >
                </div>
                <div class="col-4 col-md-3">
                  <label class="form-label" for="productoPrecio">Precio unitario</label>
                  <input
                    id="productoPrecio"
                    type="number"
                    class="form-control"
                    min="0"
                    step="0.01"
                    [value]="precio()"
                    (input)="cambiarPrecio($event)"
                  >
                </div>
                <div class="col-4 col-md-3">
                  <button class="btn btn-ink w-100" type="button" (click)="agregarPartida()">
                    <i class="bi bi-plus-lg"></i> Agregar
                  </button>
                </div>
                <div class="col-md-4">
                  <div class="capture-line-total">
                    <span>Importe de la línea</span>
                    <strong>{{ moneda(cantidad() * precio()) }}</strong>
                  </div>
                </div>
              </div>

              <div class="quote-note">
                <i class="bi bi-info-circle"></i>
                <span>
                  El precio unitario se toma del catálogo y puedes ajustarlo antes de agregar la
                  partida.
                </span>
              </div>
            </section>

            <section class="panel-card mb-4">
              <div class="panel-head">
                <div>
                  <span class="panel-kicker">Partidas de la cotización</span>
                  <h2>Detalle del pedido</h2>
                </div>
                <span class="badge badge-soft-cyan">
                  {{ partidas().length }} partidas · {{ piezas() }} piezas
                </span>
              </div>

              <div class="table-responsive">
                <table class="table table-llamma align-middle">
                  <thead>
                    <tr>
                      <th>Producto</th>
                      <th class="text-center capture-col-qty">Cant.</th>
                      <th class="text-end capture-col-price">P. unitario</th>
                      <th class="text-end">Importe</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    @for (item of partidas(); track $index) {
                      <tr>
                        <td>
                          <div class="cell-main">{{ item.descripcion }}</div>
                          <div class="cell-muted">
                            {{ item.especificaciones || 'Sin especificaciones' }}
                          </div>
                        </td>
                        <td>
                          <input
                            class="form-control form-control-sm text-center"
                            type="number"
                            min="1"
                            step="1"
                            [value]="item.cantidad"
                            (input)="actualizarCantidad($index, $event)"
                            [attr.aria-label]="'Cantidad de ' + item.descripcion"
                          >
                        </td>
                        <td>
                          <input
                            class="form-control form-control-sm text-end"
                            type="number"
                            min="0"
                            step="0.01"
                            [value]="item.precioUnitario"
                            (input)="actualizarPrecio($index, $event)"
                            [attr.aria-label]="'Precio unitario de ' + item.descripcion"
                          >
                        </td>
                        <td class="text-end cell-main">{{ moneda(item.importe) }}</td>
                        <td class="text-end">
                          <button
                            class="btn btn-icon"
                            type="button"
                            [attr.aria-label]="'Eliminar ' + item.descripcion"
                            (click)="quitarPartida($index)"
                          >
                            <i class="bi bi-trash3"></i>
                          </button>
                        </td>
                      </tr>
                    } @empty {
                      <tr>
                        <td colspan="5">
                          <div class="capture-empty">
                            <i class="bi bi-bag-plus"></i>
                            <span>Aún no hay partidas. Agrega productos o conceptos manuales.</span>
                          </div>
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>

              <p class="table-note">
                <i class="bi bi-palette"></i>
                Los acabados especiales y el desperdicio de material se agregan al costo final.
              </p>
            </section>

            <section class="panel-card">
              <div class="panel-head">
                <div class="d-flex align-items-center gap-3">
                  <span class="step-number">03</span>
                  <div>
                    <span class="panel-kicker">Condiciones comerciales</span>
                    <h2>Vigencia y notas</h2>
                  </div>
                </div>
              </div>

              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label" for="vigenciaDias">Vigencia (días)</label>
                  <input
                    id="vigenciaDias"
                    type="number"
                    class="form-control"
                    min="1"
                    max="90"
                    formControlName="vigenciaDias"
                    [class.is-invalid]="form.controls.vigenciaDias.touched && form.controls.vigenciaDias.invalid"
                  >
                </div>
                <div class="col-md-8">
                  <label class="form-label" for="cotizacionNotas">Notas para el cliente</label>
                  <textarea
                    id="cotizacionNotas"
                    class="form-control"
                    rows="2"
                    formControlName="notas"
                    placeholder="Condiciones, tiempos de entrega o aclaraciones..."
                  ></textarea>
                </div>
              </div>
            </section>
          </form>
        </div>

        <div class="col-xl-4 summary-sidebar">
          <aside class="quote-summary">
            <div class="quote-summary-head">
              <span>Resumen de cotización</span>
              <span class="badge badge-soft-cyan">Borrador</span>
            </div>

            <div class="summary-client">
              <span class="avatar avatar-magenta">
                {{ iniciales(form.controls.nombreCliente.value || 'Nuevo cliente') }}
              </span>
              <div>
                <strong>{{ form.controls.nombreCliente.value || 'Cliente sin nombre' }}</strong>
                <small>
                  {{ form.controls.empresa.value || 'Sin empresa' }} ·
                  {{ form.controls.segmento.value }}
                </small>
              </div>
            </div>

            @if (partidas().length) {
              <div class="summary-lines">
                @for (item of partidas(); track $index) {
                  <div>
                    <span>{{ item.descripcion }} · {{ item.cantidad }}</span>
                    <strong>{{ moneda(item.importe) }}</strong>
                  </div>
                }
              </div>
            } @else {
              <p class="capture-summary-empty">Agrega partidas para ver el desglose.</p>
            }

            <div class="summary-totals">
              <div><span>Subtotal</span><strong>{{ moneda(subtotal()) }}</strong></div>
              <div><span>IVA (16%)</span><strong>{{ moneda(impuestos()) }}</strong></div>
              <div class="summary-total"><span>Total</span><strong>{{ moneda(total()) }}</strong></div>
              <div><span>Anticipo (50%)</span><strong>{{ moneda(anticipo()) }}</strong></div>
              <div><span>Saldo</span><strong>{{ moneda(saldo()) }}</strong></div>
            </div>

            <button class="btn btn-brand w-100" type="button" [disabled]="guardando()" (click)="guardar()">
              @if (guardando()) {
                <i class="bi bi-hourglass-split"></i> Guardando cotización...
              } @else {
                <i class="bi bi-file-earmark-check"></i> Guardar cotización
              }
            </button>

            <p class="summary-note">
              <i class="bi bi-shield-check"></i>
              Cotización válida por {{ form.controls.vigenciaDias.value }} días naturales. Precios
              sujetos a revisión de archivo.
            </p>
          </aside>

          <div class="help-card mt-4">
            <i class="bi bi-headset"></i>
            <div>
              <strong>¿Necesitas ayuda?</strong>
              <p>Nuestro equipo de producción te acompaña con materiales y acabados.</p>
              <a href="tel:+525512345678">55 1234 5678</a>
            </div>
          </div>
        </div>
      </div>
    }
  </div>
</div>
</file>

<file path="src/app/llamma/clientes/clientes.component.css">
/* Ajustes visuales del directorio de clientes. */

.client-stat {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  height: 100%;
  padding: 1rem 1.1rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.client-stat strong {
  display: block;
  font-family: var(--llamma-font-display);
  font-size: 1.3rem;
  line-height: 1;
}

.client-stat span:not(.icon-tile) {
  display: block;
  margin-top: 0.25rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  font-weight: 500;
}

.client-profile {
  padding: 1.5rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius);
  background: var(--llamma-carbon);
  color: rgba(255, 255, 255, 0.68);
  box-shadow: var(--llamma-shadow);
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding-bottom: 1.1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.profile-avatar {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 3.4rem;
  height: 3.4rem;
  border-radius: 1rem;
  background: rgba(var(--llamma-yellow-rgb), 0.16);
  color: var(--llamma-yellow);
  font-family: var(--llamma-font-display);
  font-size: 1rem;
  font-weight: 700;
}

.profile-head h2 {
  margin: 0.15rem 0 0.35rem;
  color: #fff;
  font-size: 1.15rem;
}

.profile-head .panel-kicker {
  color: rgba(255, 255, 255, 0.45);
}

.profile-contact {
  display: grid;
  gap: 0.55rem;
  margin: 1.05rem 0;
  padding: 0;
  list-style: none;
}

.profile-contact li {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  font-size: 0.72rem;
}

.profile-contact i {
  margin-top: 0.12rem;
  color: var(--llamma-cyan);
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.4rem;
  margin-bottom: 1rem;
  padding: 0.8rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  text-align: center;
}

.profile-stats strong {
  display: block;
  color: #fff;
  font-family: var(--llamma-font-display);
  font-size: 1rem;
  line-height: 1;
}

.profile-stats span {
  display: block;
  margin-top: 0.2rem;
  color: rgba(255, 255, 255, 0.45);
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.client-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  margin-bottom: 1.1rem;
}

.client-tags span {
  padding: 0.3rem 0.55rem;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 999px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.62rem;
  font-weight: 600;
}

.note-list {
  display: grid;
  gap: 0.9rem;
}

.note-item {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  padding-bottom: 0.9rem;
  border-bottom: 1px dashed var(--llamma-line);
}

.note-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.note-dot {
  flex: 0 0 auto;
  width: 0.5rem;
  height: 0.5rem;
  margin-top: 0.35rem;
  border-radius: 50%;
}

.note-item strong {
  display: block;
  font-size: 0.77rem;
  font-weight: 600;
}

.note-item p {
  margin: 0.18rem 0 0;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  line-height: 1.5;
}

.note-item small {
  display: block;
  margin-top: 0.25rem;
  color: #9a9992;
  font-size: 0.62rem;
}

.segment-list {
  display: grid;
  gap: 0.8rem;
}

.segment-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.32rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
}

.segment-top strong {
  color: var(--llamma-carbon);
  font-family: var(--llamma-font-display);
  font-size: 0.74rem;
}

.segment-track {
  height: 6px;
  overflow: hidden;
  border-radius: 999px;
  background: #efeee9;
}

.segment-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--llamma-cyan), var(--llamma-magenta));
}

/* La tabla tiene siete columnas: compactamos el espaciado para que quepa
   completa en escritorio sin recortar la columna de estado. */
.clientes-page .table-llamma > :not(caption) > * > * {
  padding-right: 0.7rem;
  padding-left: 0.7rem;
}

@media (max-width: 575.98px) {
  .client-stat {
    padding: 0.9rem;
  }

  .client-profile {
    padding: 1.2rem;
  }
}

.clientes-page tbody tr[role='button'] {
  cursor: pointer;
}

.clientes-page tbody tr.table-active > * {
  --bs-table-bg-state: rgba(var(--llamma-cyan-rgb), 0.1);
}
</file>

<file path="src/app/llamma/detalle/detalle.component.css">
/* Ajustes visuales del detalle de órdenes. */

.order-switcher {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.order-switcher-label {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--llamma-muted);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
}

.order-switcher-label i {
  color: var(--llamma-magenta);
}

.order-switcher-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.order-pill {
  padding: 0.38rem 0.62rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.55rem;
  background: #fbfaf7;
  color: var(--llamma-carbon);
  font-family: var(--llamma-font-display);
  font-size: 0.68rem;
  font-weight: 700;
}

.order-pill span {
  display: block;
  margin-top: 0.12rem;
  color: var(--llamma-muted);
  font-family: var(--llamma-font-body);
  font-size: 0.56rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.order-pill.is-current {
  border-color: rgba(var(--llamma-cyan-rgb), 0.4);
  background: rgba(var(--llamma-cyan-rgb), 0.08);
}

.order-pill.is-current span {
  color: #007ba8;
}

.order-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  padding-bottom: 1.25rem;
  border-bottom: 1px solid var(--llamma-line);
}

.order-emblem {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 3.4rem;
  height: 3.4rem;
  border-radius: 1.05rem;
  background: var(--llamma-carbon);
  color: var(--llamma-yellow);
  font-size: 1.45rem;
}

.order-title {
  margin: 0;
  font-size: clamp(1.6rem, 2.6vw, 2.1rem);
  letter-spacing: -0.05em;
}

.order-meta {
  padding-top: 1.25rem;
}

.order-meta-item span {
  display: block;
  margin-bottom: 0.28rem;
  color: var(--llamma-muted);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.order-meta-item strong {
  display: block;
  font-size: 0.86rem;
  font-weight: 600;
}

.order-meta-item small {
  display: block;
  margin-top: 0.15rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
}

.timeline {
  margin: 0;
  padding: 0;
  list-style: none;
}

.timeline-item {
  position: relative;
  display: flex;
  gap: 0.9rem;
  padding-bottom: 1.35rem;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  content: '';
  position: absolute;
  top: 2.3rem;
  bottom: 0;
  left: 1.1rem;
  width: 1px;
  background: var(--llamma-line);
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 2.2rem;
  height: 2.2rem;
  border-radius: 50%;
  font-size: 0.9rem;
}

.is-done .timeline-dot {
  background: rgba(var(--llamma-cyan-rgb), 0.12);
  color: var(--llamma-cyan-deep);
}

.is-active .timeline-dot {
  background: var(--llamma-magenta);
  color: #fff;
}

.is-pending .timeline-dot {
  background: #f2f1ec;
  color: #96958f;
}

.timeline-body {
  flex: 1;
  min-width: 0;
  padding-top: 0.15rem;
}

.timeline-top {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.4rem 1rem;
}

.timeline-top strong {
  font-size: 0.86rem;
  font-weight: 600;
}

.timeline-top span {
  color: var(--llamma-muted);
  font-size: 0.68rem;
  white-space: nowrap;
}

.timeline-body p {
  margin: 0.28rem 0 0;
  color: var(--llamma-muted);
  font-size: 0.76rem;
  line-height: 1.55;
}

.order-summary {
  padding: 1.5rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius);
  background: #fff;
  box-shadow: var(--llamma-shadow);
}

.payment-state {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  margin-bottom: 1.1rem;
  padding: 0.7rem;
  border-radius: 0.75rem;
  background: #f0faf4;
}

.payment-state strong {
  display: block;
  font-size: 0.78rem;
}

.payment-state small {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.66rem;
}

.delivery-list {
  display: grid;
  gap: 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.delivery-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
}

.delivery-list i {
  margin-top: 0.12rem;
  color: var(--llamma-cyan-deep);
  font-size: 1rem;
}

.delivery-list strong {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
}

.delivery-list span {
  display: block;
  margin-top: 0.12rem;
  color: var(--llamma-muted);
  font-size: 0.7rem;
}

.file-list {
  display: grid;
  gap: 0.85rem;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.file-row strong {
  display: block;
  overflow: hidden;
  font-size: 0.76rem;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-row small {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.66rem;
}

@media (max-width: 575.98px) {
  .order-head {
    align-items: flex-start;
  }

  .order-emblem {
    width: 2.9rem;
    height: 2.9rem;
    font-size: 1.2rem;
  }

  .order-switcher-list {
    width: 100%;
  }

  .order-pill {
    flex: 1 1 auto;
  }
}

.pago-list {
  display: grid;
  gap: 0.55rem;
  padding-top: 0.55rem;
  border-top: 1px solid var(--llamma-line);
}
</file>

<file path="src/app/llamma/detalle/detalle.component.html">
<div class="module-page detalle-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Órdenes y seguimiento</span>
        <h1>Detalle de órdenes.</h1>
        <p class="page-lead">
          Desglose completo del pedido: partidas, materiales, tiempos de producción, anticipos y
          estado de entrega en una sola vista.
        </p>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="date-chip">
          <i class="bi bi-calendar3"></i>
          {{ pedido() ? fechaCorta(pedido()!.fechaPedido) : 'Sin fecha' }}
        </span>
        <button class="btn btn-outline-ink" type="button" (click)="imprimir()" [disabled]="!pedido()">
          <i class="bi bi-printer"></i> Imprimir
        </button>
        @if (puedeGestionar()) {
          <a class="btn btn-brand" routerLink="/captura">
            <i class="bi bi-plus-lg"></i> Nuevo pedido
          </a>
        }
      </div>
    </header>

    <div class="order-switcher">
      <span class="order-switcher-label"><i class="bi bi-clock-history"></i> Órdenes recientes</span>
      <div class="order-switcher-list">
        @if (cargandoLista()) {
          <span class="text-muted small d-inline-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Cargando…
          </span>
        } @else {
          @for (fila of pedidos(); track fila.id) {
            <button
              class="order-pill"
              type="button"
              [class.is-current]="fila.id === pedido()?.id"
              (click)="seleccionar(fila.id)"
            >
              #{{ fila.folio }} <span>{{ etiquetaEstado(fila.estado) }}</span>
            </button>
          } @empty {
            <span class="text-muted small">No hay órdenes registradas todavía.</span>
          }
        }
      </div>
    </div>

    @if (error()) {
      <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="flex-grow-1">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargarLista()">
          Reintentar
        </button>
      </div>
    }

    @if (cargandoDetalle() && !pedido()) {
      <div class="panel-card text-center py-5">
        <span class="spinner-border text-primary" role="status" aria-hidden="true"></span>
        <p class="mt-3 mb-0 text-muted">Cargando la orden…</p>
      </div>
    }

    @if (pedido(); as orden) {
      <div class="row g-4">
        <div class="col-xl-8">
          <section class="panel-card mb-4">
            <div class="order-head">
              <span class="order-emblem"><i class="bi bi-receipt"></i></span>
              <div class="flex-grow-1 min-w-0">
                <span class="panel-kicker">Orden de producción</span>
                <div class="d-flex flex-wrap align-items-center gap-2">
                  <h2 class="order-title">#{{ orden.folio }}</h2>
                  <span class="badge" [class]="claseEstado(orden.estado)">{{ etiquetaEstado(orden.estado) }}</span>
                  <span class="badge" [class]="clasePrioridad(orden.prioridad)">{{ etiquetaPrioridad(orden.prioridad) }}</span>
                </div>
              </div>
              <div class="d-flex flex-wrap align-items-center gap-2">
                <button class="btn btn-icon" type="button" aria-label="Imprimir orden" (click)="imprimir()">
                  <i class="bi bi-printer"></i>
                </button>
                @if (puedeGestionar()) {
                  <select
                    class="form-select form-select-sm"
                    style="min-width: 11rem"
                    [value]="orden.estado"
                    [disabled]="guardandoEstado()"
                    (change)="cambiarEstado($event)"
                    aria-label="Cambiar estado del pedido"
                  >
                    @for (estado of estados; track estado.valor) {
                      <option [value]="estado.valor">{{ estado.etiqueta }}</option>
                    }
                  </select>
                }
              </div>
            </div>

            <div class="row g-3 order-meta">
              <div class="col-sm-6 col-lg-3">
                <div class="order-meta-item">
                  <span>Cliente</span>
                  <strong>{{ cliente()?.nombre ?? orden.cliente ?? 'Mostrador' }}</strong>
                  <small>
                    {{ cliente()?.empresa || (cliente()?.segmento ?? 'particular') }}
                    @if (cliente()?.rfc) {
                      · {{ cliente()!.rfc }}
                    }
                  </small>
                </div>
              </div>
              <div class="col-sm-6 col-lg-3">
                <div class="order-meta-item">
                  <span>Fecha de alta</span>
                  <strong>{{ fechaCorta(orden.fechaPedido) }}</strong>
                  <small>
                    @if (orden.cotizacionId) {
                      Cotización #{{ orden.cotizacionId }}
                    } @else {
                      Pedido directo
                    }
                  </small>
                </div>
              </div>
              <div class="col-sm-6 col-lg-3">
                <div class="order-meta-item">
                  <span>Entrega comprometida</span>
                  <strong>{{ fechaCorta(orden.fechaEntrega) }}</strong>
                  <small>{{ orden.saldo <= 0.01 ? 'Liquidado' : 'Saldo: ' + moneda(orden.saldo) }}</small>
                </div>
              </div>
              <div class="col-sm-6 col-lg-3">
                <div class="order-meta-item">
                  <span>Responsable</span>
                  <strong>{{ orden.ordenProduccion?.responsable || 'Sin asignar' }}</strong>
                  <small>
                    {{ orden.ordenProduccion ? 'Etapa: ' + (etapas()[etapaActual() - 1]?.etiqueta ?? 'Diseño') : 'Sin orden de producción' }}
                  </small>
                </div>
              </div>
            </div>
          </section>

          <section class="panel-card mb-4">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Partidas del pedido</span>
                <h2>Productos y especificaciones</h2>
              </div>
              <span class="badge badge-soft-cyan">
                {{ partidas().length }} partidas · {{ totalPiezas() }} piezas
              </span>
            </div>

            <div class="table-responsive">
              <table class="table table-llamma align-middle">
                <thead>
                  <tr>
                    <th>Producto</th>
                    <th>Especificación</th>
                    <th class="text-center">Cant.</th>
                    <th class="text-end">P. unitario</th>
                    <th class="text-end">Importe</th>
                  </tr>
                </thead>
                <tbody>
                  @for (item of partidas(); track item.id) {
                    <tr>
                      <td>
                        <div class="product-cell">
                          <span class="icon-tile icon-tile-sm icon-tile-cyan"><i class="bi bi-box"></i></span>
                          <div>
                            <strong>{{ item.descripcion }}</strong>
                            <small>{{ item.archivoDiseno ? 'Con archivo de diseño' : 'Sin archivo' }}</small>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div class="cell-main">{{ item.especificaciones || 'Sin especificaciones' }}</div>
                        <div class="cell-muted">Precio unitario {{ moneda(item.precioUnitario) }}</div>
                      </td>
                      <td class="text-center">{{ item.cantidad }}</td>
                      <td class="text-end">{{ moneda(item.precioUnitario) }}</td>
                      <td class="text-end cell-main">{{ moneda(item.importe) }}</td>
                    </tr>
                  } @empty {
                    <tr>
                      <td colspan="5" class="text-center text-muted py-4">
                        Esta orden no tiene partidas registradas.
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>

            <p class="table-note">
              <i class="bi bi-palette"></i>
              Los acabados especiales se confirman al aprobar el archivo final de preprensa.
            </p>
          </section>

          <section class="panel-card">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Trazabilidad</span>
                <h2>Seguimiento de producción</h2>
              </div>
              <span class="badge badge-soft-warning">
                Etapa {{ etapaActual() }} de {{ etapas().length || 0 }}
              </span>
            </div>

            <ol class="timeline">
              @for (etapa of etapas(); track etapa.id) {
                <li class="timeline-item" [class]="etapa.clase">
                  <span class="timeline-dot"><i class="bi" [class]="'bi ' + etapa.icono"></i></span>
                  <div class="timeline-body">
                    <div class="timeline-top">
                      <strong>{{ etapa.etiqueta }}</strong>
                      <span>
                        {{ etapa.clase === 'is-pending' ? 'Programado' : fechaHora(etapa.fin || etapa.inicio) }}
                      </span>
                    </div>
                    <p>
                      {{ etapa.responsable || 'Sin responsable' }} ·
                      {{ etapa.estado.replace('-', ' ') }}
                      @if (etapa.notas) {
                        · {{ etapa.notas }}
                      }
                    </p>
                  </div>
                </li>
              } @empty {
                <li class="text-muted">Aún no hay etapas registradas para esta orden.</li>
              }
            </ol>

            @if (controles().length) {
              <div class="panel-head mt-4">
                <div>
                  <span class="panel-kicker">Control de calidad</span>
                  <h2>Revisiones de la orden</h2>
                </div>
              </div>
              <div class="table-responsive">
                <table class="table table-llamma align-middle mb-0">
                  <thead>
                    <tr>
                      <th>Criterio</th>
                      <th>Resultado</th>
                      <th>Revisó</th>
                      <th class="text-end">Fecha</th>
                    </tr>
                  </thead>
                  <tbody>
                    @for (control of controles(); track control.id) {
                      <tr>
                        <td>
                          <div class="cell-main">{{ control.criterio }}</div>
                          <div class="cell-muted">{{ control.observaciones || 'Sin observaciones' }}</div>
                        </td>
                        <td>
                          <span class="badge" [class]="control.aprobado ? 'badge-soft-success' : 'badge-soft-danger'">
                            {{ control.aprobado ? 'Aprobado' : 'Rechazado' }}
                          </span>
                        </td>
                        <td>{{ control.revisadoPor || '—' }}</td>
                        <td class="text-end cell-muted">{{ fechaHora(control.fecha) }}</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            }
          </section>
        </div>

        <div class="col-xl-4 summary-sidebar">
          <aside class="order-summary mb-4">
            <div class="quote-summary-head">
              <span>Resumen del pedido</span>
              <span class="badge" [class]="claseEstado(orden.estado)">{{ etiquetaEstado(orden.estado) }}</span>
            </div>

            <div class="summary-client">
              <span class="avatar avatar-magenta">{{ iniciales(cliente()?.nombre ?? orden.cliente) }}</span>
              <div>
                <strong>{{ cliente()?.nombre ?? orden.cliente ?? 'Mostrador' }}</strong>
                <small>
                  {{ cliente()?.telefono || 'Sin teléfono' }} · {{ cliente()?.correo || 'Sin correo' }}
                </small>
              </div>
            </div>

            <div class="summary-totals">
              <div><span>Subtotal</span><strong>{{ moneda(orden.subtotal) }}</strong></div>
              <div><span>IVA (16%)</span><strong>{{ moneda(orden.impuestos) }}</strong></div>
              <div class="summary-total"><span>Total</span><strong>{{ moneda(orden.total) }}</strong></div>
              <div><span>Anticipo recibido</span><strong>{{ moneda(orden.anticipo) }}</strong></div>
              <div><span>Saldo pendiente</span><strong>{{ moneda(orden.saldo) }}</strong></div>
            </div>

            <div class="payment-state">
              <span
                class="icon-tile icon-tile-sm"
                [class]="estadoPago().ok ? 'icon-tile icon-tile-sm icon-tile-success' : 'icon-tile icon-tile-sm icon-tile-danger'"
              >
                <i class="bi" [class]="estadoPago().ok ? 'bi bi-shield-check' : 'bi bi-exclamation-circle'"></i>
              </span>
              <div>
                <strong>{{ estadoPago().titulo }}</strong>
                <small>{{ estadoPago().detalle }}</small>
              </div>
            </div>

            @if (puedeGestionar() && orden.saldo > 0.01) {
              @if (!mostrarPago()) {
                <button class="btn btn-brand w-100" type="button" (click)="abrirPago()">
                  <i class="bi bi-cash-coin"></i> Registrar pago
                </button>
              } @else {
                <form class="mt-2" [formGroup]="pagoForm" (ngSubmit)="registrarPago()">
                  <div class="row g-2">
                    <div class="col-6">
                      <label class="form-label small fw-semibold" for="pago-tipo">Tipo</label>
                      <select id="pago-tipo" class="form-select form-select-sm" formControlName="tipo">
                        <option value="anticipo">Anticipo</option>
                        <option value="abono">Abono</option>
                        <option value="saldo">Liquidación</option>
                      </select>
                    </div>
                    <div class="col-6">
                      <label class="form-label small fw-semibold" for="pago-metodo">Método</label>
                      <select id="pago-metodo" class="form-select form-select-sm" formControlName="metodo">
                        <option value="transferencia">Transferencia</option>
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="cheque">Cheque</option>
                      </select>
                    </div>
                    <div class="col-6">
                      <label class="form-label small fw-semibold" for="pago-monto">Monto</label>
                      <input
                        id="pago-monto"
                        class="form-control form-control-sm"
                        type="number"
                        min="1"
                        step="0.01"
                        formControlName="monto"
                      />
                      @if (pagoForm.controls.monto.invalid && pagoForm.controls.monto.touched) {
                        <small class="text-danger">Indica un monto mayor a cero.</small>
                      }
                    </div>
                    <div class="col-6">
                      <label class="form-label small fw-semibold" for="pago-referencia">Referencia</label>
                      <input
                        id="pago-referencia"
                        class="form-control form-control-sm"
                        type="text"
                        formControlName="referencia"
                        placeholder="SPEI, folio…"
                      />
                    </div>
                  </div>
                  <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-brand btn-sm flex-grow-1" type="submit" [disabled]="registrandoPago()">
                      <i class="bi" [class]="registrandoPago() ? 'bi-arrow-repeat spin' : 'bi-check2'"></i>
                      {{ registrandoPago() ? 'Guardando…' : 'Confirmar pago' }}
                    </button>
                    <button class="btn btn-outline-ink btn-sm" type="button" (click)="mostrarPago.set(false)">
                      Cancelar
                    </button>
                  </div>
                </form>
              }
            }

            @if (pagos().length) {
              <div class="mt-3">
                <span class="panel-kicker">Pagos registrados</span>
                <div class="pago-list mt-2">
                  @for (pago of pagos(); track pago.id) {
                    <div class="d-flex align-items-start justify-content-between gap-2">
                      <div>
                        <strong class="small text-capitalize">{{ pago.tipo }} · {{ pago.metodo }}</strong>
                        <small class="d-block text-muted">
                          {{ fechaHora(pago.fechaPago) }}
                          @if (pago.referencia) {
                            · {{ pago.referencia }}
                          }
                        </small>
                      </div>
                      <span class="fw-semibold small">{{ moneda(pago.monto) }}</span>
                    </div>
                  }
                </div>
              </div>
            }
          </aside>

          <section class="panel-card mb-4">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Logística</span>
                <h2>Datos de entrega</h2>
              </div>
            </div>

            <ul class="delivery-list">
              <li>
                <i class="bi bi-geo-alt"></i>
                <div>
                  <strong>{{ cliente()?.direccion || 'Dirección por confirmar' }}</strong>
                  <span>{{ cliente()?.empresa || cliente()?.nombre || 'Cliente' }}</span>
                </div>
              </li>
              <li>
                <i class="bi bi-truck"></i>
                <div>
                  <strong>Entrega: {{ fechaCorta(orden.fechaEntrega) }}</strong>
                  <span>Recepción de 9:00 a 18:00 h</span>
                </div>
              </li>
              <li>
                <i class="bi bi-person"></i>
                <div>
                  <strong>{{ cliente()?.nombre || 'Contacto' }}</strong>
                  <span>{{ cliente()?.telefono || 'Sin teléfono' }} · {{ cliente()?.correo || 'Sin correo' }}</span>
                </div>
              </li>
            </ul>
          </section>

          <section class="panel-card">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Documentos</span>
                <h2>Archivos del pedido</h2>
              </div>
              <span class="badge badge-soft-muted">{{ archivos().length }}</span>
            </div>

            <div class="file-list">
              @for (archivo of archivos(); track archivo.nombre + archivo.descripcion) {
                <div class="file-row">
                  <span class="icon-tile icon-tile-sm icon-tile-magenta"><i class="bi bi-file-earmark-image"></i></span>
                  <div class="flex-grow-1 min-w-0">
                    <strong>{{ archivo.nombre }}</strong>
                    <small>{{ archivo.descripcion }}</small>
                  </div>
                  <a
                    class="btn btn-icon"
                    [href]="archivo.ruta"
                    target="_blank"
                    rel="noopener"
                    aria-label="Abrir archivo"
                  >
                    <i class="bi bi-box-arrow-up-right"></i>
                  </a>
                </div>
              } @empty {
                <p class="text-muted mb-0 small">
                  Esta orden no tiene archivos adjuntos. Los diseños se cargan desde la solicitud.
                </p>
              }
            </div>
          </section>
        </div>
      </div>
    }
  </div>
</div>
</file>

<file path="src/styles.css">
/* ==========================================================================
   LLAMMA · Sistema visual institucional
   Cian + Magenta + Amarillo proceso + Negro carbón
   ========================================================================== */

:root {
  --llamma-cyan: #00aeef;
  --llamma-cyan-rgb: 0, 174, 239;
  --llamma-cyan-deep: #008fca;
  --llamma-magenta: #ec008c;
  --llamma-magenta-rgb: 236, 0, 140;
  --llamma-yellow: #fff200;
  --llamma-yellow-rgb: 255, 242, 0;
  --llamma-carbon: #1a1a1a;
  --llamma-carbon-soft: #252525;
  --llamma-ink: #101010;
  --llamma-paper: #f5f4f0;
  --llamma-paper-deep: #edece6;
  --llamma-surface: #ffffff;
  --llamma-muted: #6d6e74;
  --llamma-line: #e4e2dc;

  --llamma-radius-sm: 0.85rem;
  --llamma-radius: 1.25rem;
  --llamma-radius-lg: 1.75rem;
  --llamma-shadow-sm: 0 8px 24px rgba(26, 26, 26, 0.06);
  --llamma-shadow: 0 22px 60px rgba(26, 26, 26, 0.14);

  --llamma-font-display: 'Space Grotesk', 'Segoe UI', sans-serif;
  --llamma-font-body: 'Inter', 'Segoe UI', sans-serif;

  --bs-body-font-family: var(--llamma-font-body);
  --bs-body-color: var(--llamma-carbon);
  --bs-body-bg: var(--llamma-paper);
  --bs-border-color: var(--llamma-line);
  --bs-link-color: var(--llamma-carbon);
  --bs-link-hover-color: var(--llamma-magenta);
}

body {
  min-height: 100vh;
  max-width: 100%;
  overflow-x: clip;
  background-color: var(--llamma-paper);
  color: var(--llamma-carbon);
  font-family: var(--llamma-font-body);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

h1,
h2,
h3,
h4,
h5,
h6,
.display-font {
  font-family: var(--llamma-font-display);
  font-weight: 700;
  letter-spacing: -0.035em;
}

p {
  line-height: 1.7;
}

::selection {
  background: var(--llamma-yellow);
  color: var(--llamma-carbon);
}

a {
  text-decoration: none;
}

a:focus-visible,
button:focus-visible,
.btn:focus-visible,
.form-control:focus-visible,
.form-select:focus-visible {
  outline: 0;
  box-shadow: 0 0 0 0.25rem rgba(var(--llamma-cyan-rgb), 0.28);
}

/* --------------------------------------------------------------------------
   Shell, navegación y pie de página
   -------------------------------------------------------------------------- */

.ink-strip {
  height: 5px;
  background: linear-gradient(
    90deg,
    var(--llamma-cyan) 0 25%,
    var(--llamma-magenta) 25% 50%,
    var(--llamma-yellow) 50% 75%,
    var(--llamma-carbon) 75% 100%
  );
}

.app-shell {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.app-main {
  flex: 1;
}

.navbar-llamma {
  padding: 0.9rem 0;
  background: rgba(26, 26, 26, 0.97);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(16px);
}

.brand-lockup {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
}

.brand-logo {
  display: block;
  width: auto;
  height: 44px;
  flex: 0 0 auto;
  filter: drop-shadow(0 5px 12px rgba(0, 0, 0, 0.3));
}

.navbar-llamma .brand-lockup {
  padding-top: 0;
  padding-bottom: 0;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-text strong {
  font-family: var(--llamma-font-display);
  font-size: 1.15rem;
  letter-spacing: 0.22em;
  line-height: 1;
  color: #fff;
}

.brand-text small {
  margin-top: 0.32rem;
  font-size: 0.57rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  line-height: 1;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
}

.navbar-llamma .nav-link {
  padding: 0.55rem 0.85rem !important;
  border-radius: 0.65rem;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.88rem;
  font-weight: 500;
}

.navbar-llamma .nav-link:hover,
.navbar-llamma .nav-link.active {
  color: #fff;
  background: rgba(255, 255, 255, 0.075);
}

.navbar-llamma .nav-link.active {
  box-shadow: inset 0 -2px 0 var(--llamma-cyan);
}

.navbar-llamma .navbar-toggler {
  border-color: rgba(255, 255, 255, 0.2);
  padding: 0.4rem 0.55rem;
}

.navbar-llamma .navbar-toggler:focus {
  box-shadow: 0 0 0 0.2rem rgba(var(--llamma-cyan-rgb), 0.25);
}

.navbar-llamma .dropdown-menu-llamma {
  margin-top: 0.7rem;
  padding: 0.5rem;
  background: #232323;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 1rem;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
}

.navbar-llamma .dropdown-item {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.62rem 0.75rem;
  border-radius: 0.6rem;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.88rem;
}

.navbar-llamma .dropdown-item i {
  width: 1.1rem;
  color: var(--llamma-cyan);
}

.navbar-llamma .dropdown-item:hover,
.navbar-llamma .dropdown-item:focus {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}

.navbar-llamma .dropdown-divider {
  border-color: rgba(255, 255, 255, 0.1);
}

/* --------------------------------------------------------------------------
   Tipografía y utilidades
   -------------------------------------------------------------------------- */

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.9rem;
  color: var(--llamma-magenta);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.eyebrow::before {
  content: '';
  width: 1.6rem;
  height: 4px;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--llamma-cyan), var(--llamma-magenta) 60%, var(--llamma-yellow));
}

.eyebrow-light {
  color: var(--llamma-yellow);
}

.section-title {
  margin-bottom: 1rem;
  font-size: clamp(2rem, 3.6vw, 3.4rem);
  line-height: 1.02;
}

.section-lead {
  max-width: 38rem;
  margin-bottom: 0;
  color: var(--llamma-muted);
  font-size: 1rem;
}

.section-pad {
  padding: 5.5rem 0;
}

.text-cyan {
  color: var(--llamma-cyan) !important;
}

.text-magenta {
  color: var(--llamma-magenta) !important;
}

.text-yellow {
  color: var(--llamma-yellow) !important;
}

.text-carbon {
  color: var(--llamma-carbon) !important;
}

.bg-ink {
  background: var(--llamma-carbon) !important;
}

.bg-paper {
  background: var(--llamma-paper) !important;
}

.bg-cyan-soft {
  background: rgba(var(--llamma-cyan-rgb), 0.09) !important;
}

.bg-magenta-soft {
  background: rgba(var(--llamma-magenta-rgb), 0.09) !important;
}

.bg-yellow-soft {
  background: rgba(var(--llamma-yellow-rgb), 0.18) !important;
}

.min-w-0 {
  min-width: 0;
}

/* --------------------------------------------------------------------------
   Botones
   -------------------------------------------------------------------------- */

.btn {
  --bs-btn-font-weight: 600;
  --bs-btn-border-radius: 0.72rem;
  --bs-btn-padding-y: 0.62rem;
  --bs-btn-padding-x: 1.05rem;
}

.btn-brand {
  border: 0;
  background: linear-gradient(115deg, var(--llamma-cyan) 0%, var(--llamma-magenta) 100%);
  color: #fff;
  box-shadow: 0 10px 28px rgba(var(--llamma-magenta-rgb), 0.24);
}

.btn-brand:hover,
.btn-brand:focus {
  background: linear-gradient(115deg, var(--llamma-cyan-deep) 0%, #cf007b 100%);
  color: #fff;
  box-shadow: 0 14px 34px rgba(var(--llamma-magenta-rgb), 0.3);
}

.btn-yellow {
  border: 0;
  background: var(--llamma-yellow);
  color: var(--llamma-carbon);
  box-shadow: 0 8px 22px rgba(var(--llamma-yellow-rgb), 0.18);
}

.btn-yellow:hover,
.btn-yellow:focus {
  background: #f4e700;
  color: var(--llamma-carbon);
}

.btn-ink {
  border: 1px solid var(--llamma-carbon);
  background: var(--llamma-carbon);
  color: #fff;
}

.btn-ink:hover,
.btn-ink:focus {
  border-color: #000;
  background: #000;
  color: #fff;
}

.btn-outline-ink {
  border: 1px solid rgba(26, 26, 26, 0.22);
  background: transparent;
  color: var(--llamma-carbon);
}

.btn-outline-ink:hover,
.btn-outline-ink:focus {
  border-color: var(--llamma-carbon);
  background: var(--llamma-carbon);
  color: #fff;
}

.btn-soft {
  border: 1px solid transparent;
  background: rgba(26, 26, 26, 0.055);
  color: var(--llamma-carbon);
}

.btn-soft:hover,
.btn-soft:focus,
.btn-soft.active {
  border-color: rgba(26, 26, 26, 0.1);
  background: rgba(26, 26, 26, 0.1);
  color: var(--llamma-carbon);
}

.btn-ghost-light {
  border: 1px solid rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.055);
  color: #fff;
  backdrop-filter: blur(10px);
}

.btn-ghost-light:hover,
.btn-ghost-light:focus {
  border-color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
}

.btn-outline-light-soft {
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: transparent;
  color: rgba(255, 255, 255, 0.86);
}

.btn-outline-light-soft:hover,
.btn-outline-light-soft:focus {
  border-color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.09);
  color: #fff;
}

.btn-nav-cta {
  border: 0;
  background: var(--llamma-yellow);
  color: var(--llamma-carbon);
  font-weight: 700;
}

.btn-nav-cta:hover,
.btn-nav-cta:focus {
  background: #f0e400;
  color: var(--llamma-carbon);
  box-shadow: 0 0 0 3px rgba(var(--llamma-yellow-rgb), 0.18);
}

.btn-link-light {
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.88rem;
  font-weight: 600;
}

.btn-link-light:hover {
  color: var(--llamma-yellow);
}

.btn-icon {
  display: inline-grid;
  place-items: center;
  width: 2.25rem;
  height: 2.25rem;
  padding: 0;
  border: 1px solid var(--llamma-line);
  border-radius: 0.65rem;
  background: #fff;
  color: var(--llamma-muted);
}

.btn-icon:hover {
  border-color: rgba(26, 26, 26, 0.22);
  background: var(--llamma-paper);
  color: var(--llamma-carbon);
}

/* --------------------------------------------------------------------------
   Página, tarjetas y encabezados internos
   -------------------------------------------------------------------------- */

/* Las columnas de Bootstrap son flex items: sin min-width: 0 su contenido
   (tablas, correos, folios) puede empujar el ancho y desbordar la fila. */
.row > [class*='col-'] {
  min-width: 0;
}

.module-page {
  padding: 2.75rem 0 5.5rem;
}

.page-header {
  margin-bottom: 2.2rem;
}

.page-brand {
  display: flex;
  align-items: flex-start;
  gap: 1.1rem;
}

.page-brand-logo {
  flex: 0 0 auto;
  width: auto;
  height: 54px;
  margin-top: 0.15rem;
  filter: drop-shadow(0 6px 14px rgba(26, 26, 26, 0.12));
}

@media (max-width: 575.98px) {
  .page-brand {
    gap: 0.75rem;
  }

  .page-brand-logo {
    height: 44px;
  }
}

.page-header h1 {
  margin-bottom: 0.65rem;
  font-size: clamp(2.15rem, 4.1vw, 3.45rem);
  line-height: 1.02;
}

.page-lead {
  max-width: 44rem;
  margin-bottom: 0;
  color: var(--llamma-muted);
  font-size: 1rem;
}

.date-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.62rem 0.9rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.75rem;
  background: #fff;
  color: var(--llamma-muted);
  font-size: 0.82rem;
  font-weight: 600;
  box-shadow: var(--llamma-shadow-sm);
}

.date-chip i {
  color: var(--llamma-magenta);
}

.panel-card {
  padding: 1.5rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius);
  background: var(--llamma-surface);
  box-shadow: var(--llamma-shadow-sm);
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.35rem;
}

.panel-head h2 {
  margin: 0;
  font-size: 1.15rem;
  letter-spacing: -0.025em;
}

.panel-kicker {
  display: block;
  margin-bottom: 0.25rem;
  color: var(--llamma-muted);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.panel-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  margin-top: 1.2rem;
  color: var(--llamma-carbon);
  font-size: 0.82rem;
  font-weight: 700;
}

.panel-link i {
  color: var(--llamma-magenta);
}

.panel-link:hover {
  color: var(--llamma-magenta);
}

.panel-card-dark {
  border-color: transparent;
  background: var(--llamma-carbon);
  color: #fff;
}

/* --------------------------------------------------------------------------
   Badges, iconos y avatares
   -------------------------------------------------------------------------- */

.badge {
  padding: 0.42rem 0.65rem;
  border-radius: 999px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.badge-soft-cyan {
  background: rgba(var(--llamma-cyan-rgb), 0.11);
  color: #007ba8;
}

.badge-soft-magenta {
  background: rgba(var(--llamma-magenta-rgb), 0.1);
  color: #b00068;
}

.badge-soft-yellow {
  background: rgba(var(--llamma-yellow-rgb), 0.28);
  color: #6d6500;
}

.badge-soft-success {
  background: #e7f6ee;
  color: #18794e;
}

.badge-soft-warning {
  background: #fff4d7;
  color: #8a5a00;
}

.badge-soft-danger {
  background: #fde9eb;
  color: #b42335;
}

.badge-soft-muted {
  background: rgba(26, 26, 26, 0.06);
  color: var(--llamma-muted);
}

.icon-tile {
  display: inline-grid;
  place-items: center;
  flex: 0 0 auto;
  width: 2.9rem;
  height: 2.9rem;
  border-radius: 0.95rem;
  font-size: 1.18rem;
}

.icon-tile-sm {
  width: 2.35rem;
  height: 2.35rem;
  border-radius: 0.75rem;
  font-size: 0.98rem;
}

.icon-tile-lg {
  width: 3.6rem;
  height: 3.6rem;
  border-radius: 1.15rem;
  font-size: 1.5rem;
}

.icon-tile-cyan {
  background: rgba(var(--llamma-cyan-rgb), 0.11);
  color: var(--llamma-cyan-deep);
}

.icon-tile-magenta {
  background: rgba(var(--llamma-magenta-rgb), 0.1);
  color: var(--llamma-magenta);
}

.icon-tile-yellow {
  background: rgba(var(--llamma-yellow-rgb), 0.24);
  color: #776f00;
}

.icon-tile-ink {
  background: var(--llamma-carbon);
  color: #fff;
}

.icon-tile-success {
  background: #e7f6ee;
  color: #18794e;
}

.icon-tile-warning {
  background: #fff4d7;
  color: #8a5a00;
}

.icon-tile-danger {
  background: #fde9eb;
  color: #b42335;
}

.avatar {
  display: inline-grid;
  place-items: center;
  flex: 0 0 auto;
  width: 2.45rem;
  height: 2.45rem;
  border-radius: 50%;
  font-family: var(--llamma-font-display);
  font-size: 0.72rem;
  font-weight: 700;
}

.avatar-cyan {
  background: rgba(var(--llamma-cyan-rgb), 0.14);
  color: #007ba8;
}

.avatar-magenta {
  background: rgba(var(--llamma-magenta-rgb), 0.12);
  color: #b00068;
}

.avatar-yellow {
  background: rgba(var(--llamma-yellow-rgb), 0.28);
  color: #6d6500;
}

.avatar-ink {
  background: rgba(26, 26, 26, 0.08);
  color: var(--llamma-carbon);
}

/* --------------------------------------------------------------------------
   Formularios
   -------------------------------------------------------------------------- */

.form-label {
  margin-bottom: 0.42rem;
  color: #47484d;
  font-size: 0.76rem;
  font-weight: 600;
}

.form-control,
.form-select {
  min-height: 2.8rem;
  padding: 0.62rem 0.82rem;
  border-color: var(--llamma-line);
  border-radius: 0.72rem;
  background-color: #fbfaf7;
  color: var(--llamma-carbon);
  font-size: 0.88rem;
}

.form-control::placeholder {
  color: #9b9b9f;
}

.form-control:focus,
.form-select:focus {
  border-color: var(--llamma-cyan);
  background-color: #fff;
  box-shadow: 0 0 0 0.22rem rgba(var(--llamma-cyan-rgb), 0.13);
}

.form-check-input:checked {
  border-color: var(--llamma-magenta);
  background-color: var(--llamma-magenta);
}

.form-check-input:focus {
  border-color: var(--llamma-magenta);
  box-shadow: 0 0 0 0.22rem rgba(var(--llamma-magenta-rgb), 0.13);
}

.form-check-label {
  color: var(--llamma-muted);
  font-size: 0.82rem;
}

.input-group-text {
  border-color: var(--llamma-line);
  background: #f2f1ec;
  color: var(--llamma-muted);
  font-size: 0.85rem;
}

.form-hint {
  margin-top: 0.35rem;
  margin-bottom: 0;
  color: var(--llamma-muted);
  font-size: 0.72rem;
}

/* --------------------------------------------------------------------------
   Tablas
   -------------------------------------------------------------------------- */

.table-llamma {
  --bs-table-bg: transparent;
  margin-bottom: 0;
  color: var(--llamma-carbon);
}

.table-llamma > :not(caption) > * > * {
  padding: 0.95rem 1.1rem;
  border-bottom-color: var(--llamma-line);
  background-color: transparent;
  box-shadow: none;
}

.table-llamma thead th {
  padding-top: 0.8rem;
  padding-bottom: 0.8rem;
  border-bottom: 1px solid var(--llamma-line);
  background: #f8f7f3;
  color: #7b7c80;
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  white-space: nowrap;
}

.table-llamma tbody tr:hover {
  background: #fbfaf7;
}

.table-llamma tbody tr:last-child td {
  border-bottom: 0;
}

.table-llamma .cell-main {
  font-size: 0.85rem;
  font-weight: 600;
}

.table-llamma .cell-muted {
  margin-top: 0.15rem;
  color: var(--llamma-muted);
  font-size: 0.72rem;
}

.table-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
  padding: 1rem 1.1rem 0;
  border-top: 1px solid var(--llamma-line);
  color: var(--llamma-muted);
  font-size: 0.76rem;
}

.client-cell {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  min-width: 9rem;
}

.client-cell strong {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
}

.client-cell small {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.68rem;
}

.product-cell {
  display: flex;
  align-items: center;
  gap: 0.72rem;
  min-width: 13rem;
}

.product-cell strong {
  display: block;
  font-size: 0.83rem;
  font-weight: 600;
}

.product-cell small {
  display: block;
  margin-top: 0.12rem;
  color: var(--llamma-muted);
  font-size: 0.68rem;
}

.order-id {
  font-family: var(--llamma-font-display);
  font-size: 0.82rem;
  font-weight: 700;
  white-space: nowrap;
}

.pagination {
  --bs-pagination-color: var(--llamma-carbon);
  --bs-pagination-bg: transparent;
  --bs-pagination-border-color: var(--llamma-line);
  --bs-pagination-hover-color: var(--llamma-magenta);
  --bs-pagination-hover-bg: rgba(var(--llamma-magenta-rgb), 0.06);
  --bs-pagination-hover-border-color: var(--llamma-line);
  --bs-pagination-focus-color: var(--llamma-magenta);
  --bs-pagination-focus-bg: rgba(var(--llamma-magenta-rgb), 0.06);
  --bs-pagination-focus-box-shadow: 0 0 0 0.2rem rgba(var(--llamma-cyan-rgb), 0.15);
  --bs-pagination-active-color: #fff;
  --bs-pagination-active-bg: var(--llamma-carbon);
  --bs-pagination-active-border-color: var(--llamma-carbon);
  --bs-pagination-disabled-color: #b8b6af;
  --bs-pagination-disabled-bg: transparent;
  --bs-pagination-disabled-border-color: var(--llamma-line);
  --bs-pagination-font-size: 0.76rem;
}

.pagination .page-link {
  min-width: 2rem;
  margin: 0 0.1rem;
  border-radius: 0.45rem;
  text-align: center;
}

/* --------------------------------------------------------------------------
   Dashboard: KPIs, gráficas y listas
   -------------------------------------------------------------------------- */

.kpi-card {
  position: relative;
  padding: 1.4rem;
  overflow: hidden;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.kpi-card::after {
  content: '';
  position: absolute;
  right: -40px;
  bottom: -55px;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(26, 26, 26, 0.035), transparent 70%);
  pointer-events: none;
}

.kpi-label {
  margin: 1.1rem 0 0.25rem;
  color: var(--llamma-muted);
  font-size: 0.73rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.kpi-value {
  margin-bottom: 0.55rem;
  font-size: clamp(1.65rem, 2.4vw, 2.15rem);
  line-height: 1;
}

.kpi-foot {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--llamma-muted);
  font-size: 0.72rem;
}

.trend {
  display: inline-flex;
  align-items: center;
  gap: 0.2rem;
  padding: 0.3rem 0.48rem;
  border-radius: 999px;
  font-size: 0.67rem;
  font-weight: 700;
  white-space: nowrap;
}

.trend-up {
  background: #e7f6ee;
  color: #18794e;
}

.trend-down {
  background: #fde9eb;
  color: #b42335;
}

.trend-flat {
  background: rgba(26, 26, 26, 0.06);
  color: var(--llamma-muted);
}

.chart-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.65rem;
  margin-bottom: 1.2rem;
}

.chart-summary strong {
  font-family: var(--llamma-font-display);
  font-size: 1.85rem;
  letter-spacing: -0.04em;
}

.chart-summary span {
  color: var(--llamma-muted);
  font-size: 0.76rem;
}

.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 0.55rem;
  min-height: 220px;
  padding: 0.5rem 0 0;
  border-bottom: 1px solid var(--llamma-line);
  background-image: repeating-linear-gradient(
    to top,
    transparent 0,
    transparent 43px,
    rgba(26, 26, 26, 0.055) 43px,
    rgba(26, 26, 26, 0.055) 44px
  );
}

.bar-group {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 0.55rem;
  height: 220px;
}

.bar-set {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 4px;
  width: 100%;
  height: 188px;
}

.bar {
  display: block;
  width: 18%;
  max-width: 12px;
  height: var(--bar, 40%);
  min-height: 6px;
  border-radius: 999px 999px 4px 4px;
}

.bar-cyan {
  background: linear-gradient(180deg, var(--llamma-cyan), #56cbf2);
}

.bar-magenta {
  background: linear-gradient(180deg, var(--llamma-magenta), #f25bb0);
}

.bar-yellow {
  background: linear-gradient(180deg, #f3e700, var(--llamma-yellow));
}

.bar-label {
  color: var(--llamma-muted);
  font-size: 0.67rem;
  font-weight: 600;
}

.chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 1rem;
  color: var(--llamma-muted);
  font-size: 0.72rem;
}

.legend-item {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.legend-dot {
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--legend-color, var(--llamma-cyan));
}

.production-donut {
  position: relative;
  display: grid;
  place-items: center;
  width: 158px;
  height: 158px;
  margin: 0.6rem auto 1.4rem;
  border-radius: 50%;
  background: conic-gradient(
    var(--llamma-cyan) 0 42%,
    var(--llamma-magenta) 42% 68%,
    var(--llamma-yellow) 68% 86%,
    #e9e7df 86% 100%
  );
}

.production-donut::before {
  content: '';
  position: absolute;
  inset: 20px;
  border-radius: 50%;
  background: #fff;
}

.donut-center {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.donut-center strong {
  font-family: var(--llamma-font-display);
  font-size: 2rem;
  line-height: 1;
}

.donut-center span {
  margin-top: 0.2rem;
  color: var(--llamma-muted);
  font-size: 0.64rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.stage-list {
  display: grid;
  gap: 0.72rem;
}

.stage-row {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  font-size: 0.74rem;
}

.stage-row > span:nth-child(2) {
  width: 4.7rem;
  color: var(--llamma-muted);
  font-weight: 500;
}

.stage-row strong {
  width: 1.3rem;
  font-size: 0.75rem;
  text-align: right;
}

.stage-dot {
  width: 0.52rem;
  height: 0.52rem;
  border-radius: 50%;
  flex: 0 0 auto;
}

.dot-cyan {
  background: var(--llamma-cyan);
}

.dot-magenta {
  background: var(--llamma-magenta);
}

.dot-yellow {
  background: var(--llamma-yellow);
}

.dot-muted {
  background: #cfcdc6;
}

.stage-meter {
  flex: 1;
  height: 5px;
  overflow: hidden;
  border-radius: 999px;
  background: #efeee9;
}

.stage-meter span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--llamma-cyan), var(--llamma-magenta));
}

.alert-list {
  display: grid;
  gap: 1rem;
}

.alert-row {
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
}

.alert-row strong {
  font-size: 0.79rem;
  font-weight: 600;
}

.alert-row small {
  display: block;
  margin-top: 0.28rem;
  color: var(--llamma-muted);
  font-size: 0.69rem;
}

.stock-text {
  font-family: var(--llamma-font-display);
  font-size: 0.72rem;
  font-weight: 700;
  white-space: nowrap;
}

.stock-track {
  height: 7px;
  overflow: hidden;
  border-radius: 999px;
  background: #efeee9;
}

.stock-fill {
  display: block;
  height: 100%;
  border-radius: inherit;
}

/* --------------------------------------------------------------------------
   Captura: stepper y resumen de cotización
   -------------------------------------------------------------------------- */

.checkout-stepper {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  margin-bottom: 1.75rem;
  padding: 1rem 1.2rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.step-item {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  min-width: 0;
}

.step-item > span {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 2rem;
  height: 2rem;
  border: 1px solid var(--llamma-line);
  border-radius: 50%;
  background: #f7f6f2;
  color: var(--llamma-muted);
  font-family: var(--llamma-font-display);
  font-size: 0.7rem;
  font-weight: 700;
}

.step-item strong {
  display: block;
  font-size: 0.78rem;
  font-weight: 600;
}

.step-item small {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.66rem;
}

.step-item.is-active > span {
  border-color: var(--llamma-magenta);
  background: var(--llamma-magenta);
  color: #fff;
  box-shadow: 0 0 0 4px rgba(var(--llamma-magenta-rgb), 0.09);
}

.step-item.is-done > span {
  border-color: rgba(var(--llamma-cyan-rgb), 0.2);
  background: rgba(var(--llamma-cyan-rgb), 0.11);
  color: var(--llamma-cyan-deep);
}

.step-line {
  flex: 1;
  height: 1px;
  min-width: 0.8rem;
  background: var(--llamma-line);
}

.step-number {
  display: inline-grid;
  place-items: center;
  flex: 0 0 auto;
  width: 2.35rem;
  height: 2.35rem;
  border-radius: 0.8rem;
  background: var(--llamma-carbon);
  color: #fff;
  font-family: var(--llamma-font-display);
  font-size: 0.68rem;
  font-weight: 700;
}

.quote-chip {
  display: inline-flex;
  flex-direction: column;
  gap: 0.08rem;
  padding: 0.7rem 1rem;
  border: 1px solid rgba(var(--llamma-cyan-rgb), 0.22);
  border-radius: 0.85rem;
  background: rgba(var(--llamma-cyan-rgb), 0.07);
}

.quote-chip span {
  color: var(--llamma-muted);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.quote-chip strong {
  font-family: var(--llamma-font-display);
  font-size: 0.92rem;
}

.quote-note {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-top: 1rem;
  padding: 0.65rem 0.8rem;
  border-radius: 0.65rem;
  background: rgba(var(--llamma-yellow-rgb), 0.14);
  color: #6b6200;
  font-size: 0.73rem;
}

.quote-note i {
  margin-top: 0.1rem;
}

.quote-summary {
  padding: 1.5rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius);
  background: #fff;
  box-shadow: var(--llamma-shadow);
}

/* Columna lateral de resúmenes en páginas donde la fila ocupa todo el
   contenido (detalle y captura). Se fija como una sola unidad con scroll
   propio para que el resumen nunca se monte sobre las tarjetas que van debajo.
   11rem = 6.5rem de separación superior + 5.5rem de padding inferior de
   .module-page menos un margen de seguridad. */
.summary-sidebar {
  min-width: 0;
}

@media (min-width: 1200px) {
  .summary-sidebar {
    position: sticky;
    top: 6.5rem;
    align-self: flex-start;
    max-height: calc(100vh - 11rem);
    max-height: calc(100dvh - 11rem);
    padding-bottom: 0.75rem;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(26, 26, 26, 0.22) transparent;
  }
}

.quote-summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.quote-summary-head > span:first-child {
  font-family: var(--llamma-font-display);
  font-size: 1.05rem;
  font-weight: 700;
}

.summary-client {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  margin-bottom: 1.1rem;
  padding-bottom: 1.1rem;
  border-bottom: 1px solid var(--llamma-line);
}

.summary-client strong {
  display: block;
  font-size: 0.82rem;
}

.summary-client small {
  color: var(--llamma-muted);
  font-size: 0.69rem;
}

.summary-lines {
  display: grid;
  gap: 0.6rem;
  padding-bottom: 1.1rem;
  border-bottom: 1px solid var(--llamma-line);
}

.summary-lines > div,
.summary-totals > div {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.8rem;
  font-size: 0.75rem;
}

.summary-lines span {
  color: var(--llamma-muted);
}

.summary-lines strong {
  font-size: 0.75rem;
  font-weight: 600;
  text-align: right;
}

.summary-totals {
  display: grid;
  gap: 0.56rem;
  padding: 1.1rem 0;
}

.summary-totals span {
  color: var(--llamma-muted);
}

.summary-totals strong {
  font-size: 0.78rem;
  font-weight: 600;
}

.summary-totals .summary-total {
  margin: 0.25rem 0;
  padding: 0.8rem 0;
  border-top: 1px dashed var(--llamma-line);
  border-bottom: 1px dashed var(--llamma-line);
}

.summary-totals .summary-total span {
  color: var(--llamma-carbon);
  font-weight: 700;
}

.summary-totals .summary-total strong {
  font-family: var(--llamma-font-display);
  font-size: 1.35rem;
  letter-spacing: -0.03em;
}

.summary-note {
  display: flex;
  align-items: flex-start;
  gap: 0.45rem;
  margin: 0.9rem 0 0;
  color: var(--llamma-muted);
  font-size: 0.68rem;
}

.summary-note i {
  color: #18794e;
}

.help-card {
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
  padding: 1.15rem;
  border-radius: var(--llamma-radius);
  background: var(--llamma-carbon);
  color: rgba(255, 255, 255, 0.65);
}

.help-card > i {
  color: var(--llamma-yellow);
  font-size: 1.35rem;
}

.help-card strong {
  display: block;
  color: #fff;
  font-size: 0.82rem;
}

.help-card p {
  margin: 0.25rem 0 0.45rem;
  font-size: 0.72rem;
}

.help-card a {
  color: var(--llamma-cyan);
  font-size: 0.78rem;
  font-weight: 600;
}

.table-note {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  margin: 0.9rem 0 0;
  color: var(--llamma-muted);
  font-size: 0.7rem;
}

.table-note i {
  color: var(--llamma-magenta);
}

/* --------------------------------------------------------------------------
   Inventario y abastecimiento
   -------------------------------------------------------------------------- */

.inventory-alert {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.8rem;
  margin-bottom: 1.5rem;
  padding: 0.85rem 1.1rem;
  border: 1px solid rgba(236, 0, 140, 0.14);
  border-radius: var(--llamma-radius-sm);
  background: linear-gradient(90deg, #fdf0f7, #fffaf0);
  color: #6f244f;
  font-size: 0.8rem;
}

.inventory-alert > i {
  color: var(--llamma-magenta);
  font-size: 1.1rem;
}

.inventory-alert strong {
  color: var(--llamma-carbon);
}

.inventory-alert a {
  margin-left: auto;
  color: var(--llamma-magenta);
  font-size: 0.75rem;
  font-weight: 700;
}

.stock-cell {
  min-width: 10.5rem;
}

.stock-cell-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.6rem;
  margin-bottom: 0.38rem;
  font-size: 0.72rem;
}

.stock-cell-top strong {
  font-family: var(--llamma-font-display);
  font-size: 0.78rem;
}

.stock-cell-top span {
  color: var(--llamma-muted);
  font-size: 0.66rem;
}

.stock-track-lg {
  height: 8px;
}

.movement-list {
  display: grid;
  gap: 0.95rem;
}

.movement-row {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
}

.movement-row strong {
  display: block;
  font-size: 0.78rem;
}

.movement-row small {
  display: block;
  margin-top: 0.15rem;
  color: var(--llamma-muted);
  font-size: 0.67rem;
}

.movement-amount {
  margin-left: auto;
  font-family: var(--llamma-font-display);
  font-size: 0.72rem;
  font-weight: 700;
  white-space: nowrap;
}

.purchase-item {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  padding: 0.7rem 0;
  border-bottom: 1px dashed var(--llamma-line);
}

.purchase-item:last-of-type {
  border-bottom: 0;
}

.purchase-item strong {
  display: block;
  font-size: 0.78rem;
}

.purchase-item small {
  color: var(--llamma-muted);
  font-size: 0.68rem;
}

.purchase-item .badge {
  margin-left: auto;
  white-space: nowrap;
}

/* --------------------------------------------------------------------------
   Módulos en preparación
   -------------------------------------------------------------------------- */

.construction-card {
  position: relative;
  padding: clamp(2rem, 5vw, 4rem);
  overflow: hidden;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-lg);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.construction-card::before {
  content: '';
  position: absolute;
  top: -80px;
  right: -80px;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--llamma-cyan-rgb), 0.1), transparent 68%);
}

.construction-card::after {
  content: '';
  position: absolute;
  bottom: -100px;
  left: -80px;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--llamma-magenta-rgb), 0.08), transparent 68%);
}

.construction-icon {
  display: inline-grid;
  place-items: center;
  width: 4.4rem;
  height: 4.4rem;
  margin-bottom: 1.5rem;
  border-radius: 1.35rem;
  background: var(--llamma-carbon);
  color: var(--llamma-yellow);
  font-size: 1.8rem;
}

.construction-card h1 {
  max-width: 38rem;
  margin-bottom: 0.8rem;
  font-size: clamp(2rem, 4vw, 3.2rem);
}

.construction-card p {
  max-width: 38rem;
  color: var(--llamma-muted);
}

.construction-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 1.6rem 0 2rem;
}

.construction-tags span {
  padding: 0.45rem 0.7rem;
  border: 1px solid var(--llamma-line);
  border-radius: 999px;
  background: #faf9f6;
  color: var(--llamma-muted);
  font-size: 0.72rem;
  font-weight: 600;
}

.construction-list {
  display: grid;
  gap: 0.85rem;
  margin: 1.2rem 0 1.6rem;
  padding: 0;
  list-style: none;
}

.construction-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  color: var(--llamma-muted);
  font-size: 0.82rem;
  line-height: 1.55;
}

.construction-list i {
  margin-top: 0.15rem;
  color: var(--llamma-cyan-deep);
}

/* --------------------------------------------------------------------------
   Responsive y accesibilidad
   -------------------------------------------------------------------------- */

@media (min-width: 768px) {
  .panel-card {
    padding: 1.75rem;
  }
}

@media (max-width: 991.98px) {
  .navbar-llamma .navbar-collapse {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 0.8rem;
  }

  .navbar-llamma .nav-link {
    padding-left: 0.5rem !important;
  }
}

@media (max-width: 767.98px) {
  .row {
    --bs-gutter-x: 1.5rem;
  }

  .section-pad {
    padding: 3.75rem 0;
  }

  .module-page {
    padding: 1.75rem 0 3.75rem;
  }

  .page-header {
    margin-bottom: 1.6rem;
  }

  .checkout-stepper {
    align-items: stretch;
    flex-direction: column;
    gap: 0;
    padding: 1rem;
  }

  .step-item {
    padding: 0.3rem 0;
  }

  .step-line {
    width: 1px;
    height: 1rem;
    flex: 0 0 auto;
    margin-left: 1rem;
    background: var(--llamma-line);
  }

  .bar-chart {
    gap: 0.2rem;
  }

  .bar-set {
    gap: 2px;
  }

  .bar {
    max-width: 8px;
  }
}

@media (max-width: 575.98px) {
  .brand-text small {
    display: none;
  }

  .page-header h1 {
    font-size: 2rem;
  }

  .kpi-card {
    padding: 1.2rem;
  }

  .production-donut {
    width: 140px;
    height: 140px;
  }
}

/* --------------------------------------------------------------------------
   Notificaciones (toasts)
   -------------------------------------------------------------------------- */

.toast-stack {
  position: fixed;
  right: 1.1rem;
  bottom: 1.1rem;
  z-index: 1090;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  max-width: min(26rem, calc(100vw - 2.2rem));
  pointer-events: none;
}

.app-toast {
  display: flex;
  align-items: flex-start;
  gap: 0.65rem;
  padding: 0.75rem 0.9rem;
  border: 1px solid var(--llamma-line);
  border-left-width: 4px;
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  color: var(--llamma-carbon);
  font-size: 0.82rem;
  line-height: 1.35;
  box-shadow: var(--llamma-shadow);
  pointer-events: auto;
  animation: toast-in 0.22s ease-out;
}

.app-toast > i {
  margin-top: 0.1rem;
  font-size: 1rem;
}

.app-toast > span {
  flex: 1 1 auto;
  min-width: 0;
}

.app-toast > button {
  border: 0;
  background: transparent;
  color: var(--llamma-muted);
  padding: 0;
  line-height: 1;
}

.app-toast-success {
  border-left-color: #1f9d63;
}

.app-toast-success > i {
  color: #1f9d63;
}

.app-toast-error {
  border-left-color: #d4294f;
}

.app-toast-error > i {
  color: #d4294f;
}

.app-toast-info {
  border-left-color: var(--llamma-cyan);
}

.app-toast-info > i {
  color: var(--llamma-cyan);
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translateY(0.5rem);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 575.98px) {
  .toast-stack {
    right: 0.75rem;
    left: 0.75rem;
    bottom: 0.75rem;
    max-width: none;
  }
}

.spin {
  display: inline-block;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* Modales: encabezado consistente en todos los módulos. */
.modal-header {
  justify-content: space-between;
  gap: 1rem;
}

.modal-header > *:first-child {
  min-width: 0;
}

.modal-header .btn-icon,
.modal-footer .btn {
  flex: 0 0 auto;
}

.modal-title {
  overflow-wrap: anywhere;
}
