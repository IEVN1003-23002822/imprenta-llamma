import {
  ChangeDetectionStrategy,
  Component,
  OnInit,
  computed,
  inject,
  signal,
} from '@angular/core';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { finalize } from 'rxjs';

import { AuthService } from '../auth.service';
import { CANALES_MARKETING, ESTADOS_ACTIVIDAD, badgeDe, etiquetaDe } from '../estados';
import { ActividadMarketingApi, CanalMarketing, EstadoActividadMarketing } from '../llamma.models';
import { LlammaService } from '../llamma.service';
import { ModalAccesibleDirective } from '../modal-accesible.directive';
import { UiService } from '../ui.service';

const TONO_CANAL: Record<string, string> = {
  'redes-sociales': 'icon-tile-cyan',
  'google-ads': 'icon-tile-yellow',
  correo: 'icon-tile-ink',
  'punto-de-venta': 'icon-tile-magenta',
  referidos: 'icon-tile-cyan',
  otro: 'icon-tile-ink',
};

const FILL_CANAL: Record<string, string> = {
  'redes-sociales': 'fill-cyan',
  'google-ads': 'fill-yellow',
  correo: 'fill-ink',
  'punto-de-venta': 'fill-magenta',
  referidos: 'fill-cyan',
  otro: 'fill-muted',
};

@Component({
  selector: 'app-marketing',
  imports: [ReactiveFormsModule, RouterLink, ModalAccesibleDirective],
  templateUrl: './marketing.component.html',
  styleUrl: './marketing.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class MarketingComponent implements OnInit {
  private readonly service = inject(LlammaService);
  private readonly ui = inject(UiService);
  private readonly fb = inject(FormBuilder);
  readonly auth = inject(AuthService);

  readonly canales = CANALES_MARKETING;
  readonly estados = ESTADOS_ACTIVIDAD;

  readonly actividades = signal<ActividadMarketingApi[]>([]);
  readonly cargando = signal(true);
  readonly error = signal<string | null>(null);
  readonly pagina = signal(1);
  readonly porPagina = 6;

  readonly formularioAbierto = signal(false);
  readonly editando = signal<ActividadMarketingApi | null>(null);
  readonly guardando = signal(false);

  readonly puedeGestionar = computed(() => this.auth.tieneRol('admin', 'marketing'));

  readonly filtros = this.fb.nonNullable.group({ q: [''], canal: [''], estado: [''] });

  readonly formulario = this.fb.nonNullable.group({
    nombre: ['', [Validators.required, Validators.minLength(3)]],
    canal: ['redes-sociales' as CanalMarketing, [Validators.required]],
    estado: ['planeada' as EstadoActividadMarketing, [Validators.required]],
    fechaInicio: [this.hoyISO(), [Validators.required]],
    fechaFin: [''],
    presupuesto: [0, [Validators.required, Validators.min(0)]],
    inversionReal: [0, [Validators.required, Validators.min(0)]],
    ingresosAtribuidos: [0, [Validators.required, Validators.min(0)]],
    descripcion: [''],
  });

  readonly filtradas = computed(() => {
    const { q, canal, estado } = this.filtros.getRawValue();
    const termino = q.trim().toLowerCase();
    return this.actividades().filter((actividad) => {
      if (canal && actividad.canal !== canal) return false;
      if (estado && actividad.estado !== estado) return false;
      if (!termino) return true;
      return [actividad.nombre, actividad.descripcion ?? '', this.etiquetaCanal(actividad.canal)]
        .join(' ')
        .toLowerCase()
        .includes(termino);
    });
  });

  readonly paginas = computed(() =>
    Math.max(1, Math.ceil(this.filtradas().length / this.porPagina)),
  );

  readonly visibles = computed(() => {
    const inicio = (this.pagina() - 1) * this.porPagina;
    return this.filtradas().slice(inicio, inicio + this.porPagina);
  });

  readonly listaPaginas = computed(() => {
    const total = this.paginas();
    const actual = this.pagina();
    const desde = Math.max(1, actual - 2);
    const hasta = Math.min(total, desde + 4);
    return Array.from({ length: Math.max(0, hasta - desde + 1) }, (_, i) => desde + i);
  });

  readonly estadisticas = computed(() => {
    const actividades = this.actividades();
    const activas = actividades.filter((actividad) => actividad.estado === 'activa');
    const inversion = actividades.reduce((total, a) => total + Number(a.inversionReal ?? 0), 0);
    const ingresos = actividades.reduce((total, a) => total + Number(a.ingresosAtribuidos ?? 0), 0);
    const roi = inversion > 0 ? ingresos / inversion : 0;
    return [
      {
        icono: 'bi-wallet2',
        tono: 'icon-tile-cyan',
        valor: this.moneda(inversion),
        etiqueta: 'Inversión ejercida',
      },
      {
        icono: 'bi-graph-up-arrow',
        tono: 'icon-tile-magenta',
        valor: this.moneda(ingresos),
        etiqueta: 'Ingresos atribuidos',
      },
      {
        icono: 'bi-stars',
        tono: 'icon-tile-yellow',
        valor: `${roi.toFixed(1)}x`,
        etiqueta: 'Retorno de inversión',
      },
      {
        icono: 'bi-megaphone',
        tono: 'icon-tile-success',
        valor: this.dosDigitos(activas.length),
        etiqueta: 'Campañas activas',
      },
    ];
  });

  readonly canalesResumen = computed(() => {
    const mapa = new Map<string, { ingresos: number; inversion: number; campanas: number }>();
    for (const actividad of this.actividades()) {
      const fila = mapa.get(actividad.canal) ?? { ingresos: 0, inversion: 0, campanas: 0 };
      fila.ingresos += Number(actividad.ingresosAtribuidos ?? 0);
      fila.inversion += Number(actividad.inversionReal ?? 0);
      fila.campanas += 1;
      mapa.set(actividad.canal, fila);
    }
    const filas = [...mapa.entries()]
      .map(([canal, datos]) => ({ canal, ...datos }))
      .sort((a, b) => b.ingresos - a.ingresos);
    const maximo = Math.max(1, ...filas.map((fila) => fila.ingresos));
    return filas.slice(0, 6).map((fila) => ({
      ...fila,
      porcentaje: Math.max(4, Math.round((fila.ingresos / maximo) * 100)),
      etiqueta: this.etiquetaCanal(fila.canal),
      dot: `channel-dot ${this.dotCanal(fila.canal)}`,
      fill: FILL_CANAL[fila.canal] ?? 'fill-muted',
    }));
  });

  readonly presupuesto = computed(() => {
    const actividades = this.actividades().filter((actividad) => actividad.estado !== 'cancelada');
    const plan = actividades.reduce((total, a) => total + Number(a.presupuesto ?? 0), 0);
    const ejercido = actividades.reduce((total, a) => total + Number(a.inversionReal ?? 0), 0);
    const disponible = Math.max(plan - ejercido, 0);
    const porcentaje = plan > 0 ? Math.min(100, Math.round((ejercido / plan) * 100)) : 0;
    return {
      plan,
      ejercido,
      disponible,
      porcentaje,
      desviacion: ejercido > plan ? ejercido - plan : 0,
    };
  });

  readonly calendario = computed(() =>
    this.actividades()
      .filter((actividad) => actividad.estado === 'activa' || actividad.estado === 'planeada')
      .sort((a, b) => String(a.fechaInicio).localeCompare(String(b.fechaInicio)))
      .slice(0, 5),
  );

  readonly distribucionPresupuesto = computed(() => {
    const mapa = new Map<string, number>();
    for (const actividad of this.actividades()) {
      if (actividad.estado === 'cancelada') continue;
      mapa.set(
        actividad.canal,
        (mapa.get(actividad.canal) ?? 0) + Number(actividad.inversionReal ?? 0),
      );
    }
    const filas = [...mapa.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4);
    const total = filas.reduce((suma, fila) => suma + fila[1], 0) || 1;
    return filas.map(([canal, monto], indice) => ({
      canal,
      etiqueta: this.etiquetaCanal(canal),
      monto,
      porcentaje: Math.round((monto / total) * 100),
      color: [
        'var(--llamma-cyan)',
        'var(--llamma-magenta)',
        'var(--llamma-yellow)',
        'var(--llamma-carbon)',
      ][indice % 4],
    }));
  });

  ngOnInit(): void {
    this.cargar();
  }

  cargar(): void {
    this.cargando.set(true);
    this.error.set(null);
    this.service
      .listarActividades()
      .pipe(finalize(() => this.cargando.set(false)))
      .subscribe({
        next: (respuesta) => {
          this.actividades.set(respuesta.items);
          const paginas = Math.max(1, Math.ceil(this.filtradas().length / this.porPagina));
          if (this.pagina() > paginas) this.pagina.set(paginas);
        },
        error: (error) => {
          this.error.set(this.ui.mensajeDeError(error, 'No pudimos cargar las campañas.'));
        },
      });
  }

  filtrar(): void {
    this.pagina.set(1);
  }

  limpiar(): void {
    this.filtros.reset({ q: '', canal: '', estado: '' });
    this.pagina.set(1);
  }

  irA(pagina: number): void {
    this.pagina.set(Math.min(Math.max(pagina, 1), this.paginas()));
  }

  abrirNueva(): void {
    this.editando.set(null);
    this.formulario.reset({
      nombre: '',
      canal: 'redes-sociales',
      estado: 'planeada',
      fechaInicio: this.hoyISO(),
      fechaFin: '',
      presupuesto: 0,
      inversionReal: 0,
      ingresosAtribuidos: 0,
      descripcion: '',
    });
    this.formularioAbierto.set(true);
  }

  abrirEditar(actividad: ActividadMarketingApi): void {
    this.editando.set(actividad);
    this.formulario.reset({
      nombre: actividad.nombre,
      canal: actividad.canal,
      estado: actividad.estado,
      fechaInicio: actividad.fechaInicio ?? this.hoyISO(),
      fechaFin: actividad.fechaFin ?? '',
      presupuesto: Number(actividad.presupuesto ?? 0),
      inversionReal: Number(actividad.inversionReal ?? 0),
      ingresosAtribuidos: Number(actividad.ingresosAtribuidos ?? 0),
      descripcion: actividad.descripcion ?? '',
    });
    this.formularioAbierto.set(true);
  }

  cerrarFormulario(): void {
    this.formularioAbierto.set(false);
    this.editando.set(null);
  }

  guardar(): void {
    if (this.formulario.invalid) {
      this.formulario.markAllAsTouched();
      return;
    }
    const valores = this.formulario.getRawValue();
    const body: Record<string, unknown> = {
      nombre: valores.nombre.trim(),
      canal: valores.canal,
      estado: valores.estado,
      fechaInicio: valores.fechaInicio,
      fechaFin: valores.fechaFin || null,
      presupuesto: Number(valores.presupuesto),
      inversionReal: Number(valores.inversionReal),
      ingresosAtribuidos: Number(valores.ingresosAtribuidos),
      descripcion: valores.descripcion.trim() || null,
    };
    const edicion = this.editando();
    this.guardando.set(true);
    const peticion = edicion
      ? this.service.actualizarActividad(edicion.id, body)
      : this.service.crearActividad(body);
    peticion.pipe(finalize(() => this.guardando.set(false))).subscribe({
      next: () => {
        this.ui.exito(edicion ? 'Campaña actualizada.' : 'Campaña registrada.');
        this.cerrarFormulario();
        this.cargar();
      },
      error: (error) =>
        this.ui.error(this.ui.mensajeDeError(error, 'No pudimos guardar la campaña.')),
    });
  }

  cambiarEstado(evento: Event, actividad: ActividadMarketingApi): void {
    const estado = (evento.target as HTMLSelectElement).value as EstadoActividadMarketing;
    if (estado === actividad.estado) return;
    this.service.actualizarActividad(actividad.id, { estado }).subscribe({
      next: (actualizada) => {
        this.actividades.update((lista) =>
          lista.map((fila) => (fila.id === actualizada.id ? actualizada : fila)),
        );
        this.ui.exito(`Campaña ${actualizada.nombre}: ${this.etiquetaEstado(actualizada.estado)}.`);
      },
      error: (error) => {
        (evento.target as HTMLSelectElement).value = actividad.estado;
        this.ui.error(this.ui.mensajeDeError(error, 'No pudimos cambiar el estado.'));
      },
    });
  }

  exportar(): void {
    const filas = [
      [
        'Campaña',
        'Canal',
        'Estado',
        'Inicio',
        'Fin',
        'Presupuesto',
        'Inversión',
        'Ingresos atribuidos',
        'ROI',
      ],
      ...this.filtradas().map((actividad) => [
        actividad.nombre,
        this.etiquetaCanal(actividad.canal),
        this.etiquetaEstado(actividad.estado),
        actividad.fechaInicio ?? '',
        actividad.fechaFin ?? '',
        String(actividad.presupuesto),
        String(actividad.inversionReal),
        String(actividad.ingresosAtribuidos),
        `${Number(actividad.roi ?? 0).toFixed(2)}x`,
      ]),
    ];
    const csv = filas.map((fila) => fila.map((celda) => `"${celda}"`).join(',')).join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    const enlace = document.createElement('a');
    enlace.href = url;
    enlace.download = 'campanas-llamma.csv';
    enlace.click();
    URL.revokeObjectURL(url);
    this.ui.exito('Campañas exportadas en CSV.');
  }

  etiquetaCanal(canal: string): string {
    return etiquetaDe(CANALES_MARKETING, canal);
  }

  iconoCanal(canal: string): string {
    return CANALES_MARKETING.find((fila) => fila.valor === canal)?.icono ?? 'bi-three-dots';
  }

  dotCanal(canal: string): string {
    return CANALES_MARKETING.find((fila) => fila.valor === canal)?.dot ?? 'dot-ink';
  }

  tonoCanal(canal: string): string {
    return TONO_CANAL[canal] ?? 'icon-tile-ink';
  }

  etiquetaEstado(estado: string): string {
    return etiquetaDe(ESTADOS_ACTIVIDAD, estado);
  }

  claseEstado(estado: string): string {
    return badgeDe(ESTADOS_ACTIVIDAD, estado);
  }

  claseRoi(roi: number): string {
    const valor = Number(roi ?? 0);
    if (valor >= 4) return 'badge-soft-success';
    if (valor >= 2) return 'badge-soft-cyan';
    if (valor > 0) return 'badge-soft-warning';
    return 'badge-soft-muted';
  }

  periodo(actividad: ActividadMarketingApi): string {
    const inicio = this.fechaCorta(actividad.fechaInicio);
    if (!actividad.fechaFin) return `${inicio} · en curso`;
    return `${inicio} – ${this.fechaCorta(actividad.fechaFin)}`;
  }
  rangoTexto(): string {
    const total = this.filtradas().length;
    const inicio = total ? (this.pagina() - 1) * this.porPagina + 1 : 0;
    return `Mostrando ${inicio}–${Math.min(this.pagina() * this.porPagina, total)} de ${total} campañas`;
  }

  diaCalendario(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    return fecha ? String(fecha.getDate()).padStart(2, '0') : '—';
  }

  mesCalendario(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    return fecha
      ? fecha.toLocaleDateString('es-MX', { month: 'short' }).replace('.', '').toUpperCase()
      : '—';
  }

  hoyTexto(): string {
    return new Date().toLocaleDateString('es-MX', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    });
  }

  moneda(valor: number | null | undefined): string {
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0,
    }).format(Number(valor ?? 0));
  }

  fechaCorta(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    if (!fecha) return 'Sin fecha';
    const opciones: Intl.DateTimeFormatOptions =
      fecha.getFullYear() === new Date().getFullYear()
        ? { day: '2-digit', month: 'short' }
        : { day: '2-digit', month: 'short', year: 'numeric' };
    return fecha.toLocaleDateString('es-MX', opciones);
  }

  private aFecha(valor: string | null | undefined): Date | null {
    if (!valor) return null;
    const fecha = new Date(valor.length > 10 ? valor : `${valor}T00:00:00`);
    return Number.isNaN(fecha.getTime()) ? null : fecha;
  }

  private hoyISO(): string {
    const fecha = new Date();
    const mes = String(fecha.getMonth() + 1).padStart(2, '0');
    const dia = String(fecha.getDate()).padStart(2, '0');
    return `${fecha.getFullYear()}-${mes}-${dia}`;
  }

  private dosDigitos(valor: number): string {
    return String(valor).padStart(2, '0');
  }
}
</file>

<file path="src/app/llamma/produccion/produccion.component.ts">
import { DatePipe } from '@angular/common';
import {
  ChangeDetectionStrategy,
  Component,
  OnInit,
  computed,
  inject,
  signal,
} from '@angular/core';
import { FormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { finalize } from 'rxjs';

import { AuthService } from '../auth.service';
import { ConfirmacionService } from '../confirmacion.service';
import { ESTADOS_PRODUCCION, ETAPAS_PRODUCCION, badgeDe, etiquetaDe } from '../estados';
import {
  ControlCalidadApi,
  EtapaProduccion,
  EstadoProduccion,
  OrdenProduccionApi,
  PedidoApi,
  TableroProduccion,
} from '../llamma.models';
import { LlammaService } from '../llamma.service';
import { ModalAccesibleDirective } from '../modal-accesible.directive';
import { UiService } from '../ui.service';

@Component({
  selector: 'app-produccion',
  imports: [DatePipe, ReactiveFormsModule, RouterLink, ModalAccesibleDirective],
  templateUrl: './produccion.component.html',
  styleUrl: './produccion.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class ProduccionComponent implements OnInit {
  private readonly service = inject(LlammaService);
  private readonly ui = inject(UiService);
  private readonly confirmacion = inject(ConfirmacionService);
  private readonly fb = inject(FormBuilder);
  readonly auth = inject(AuthService);

  readonly etapas = ETAPAS_PRODUCCION;
  readonly estados = ESTADOS_PRODUCCION;

  readonly tablero = signal<TableroProduccion | null>(null);
  readonly pedidos = signal<PedidoApi[]>([]);
  readonly cargando = signal(true);
  readonly error = signal<string | null>(null);
  readonly seleccionada = signal<OrdenProduccionApi | null>(null);
  readonly guardando = signal(false);
  readonly registrandoCalidad = signal(false);
  readonly moviendoId = signal<number | null>(null);

  readonly puedeGestionar = computed(() => this.auth.tieneRol('admin', 'produccion'));

  readonly ordenForm = this.fb.nonNullable.group({
    etapa: ['diseno' as EtapaProduccion, [Validators.required]],
    estado: ['pendiente' as EstadoProduccion, [Validators.required]],
    observaciones: [''],
  });

  readonly calidadForm = this.fb.nonNullable.group({
    criterio: ['', [Validators.required, Validators.minLength(3)]],
    aprobado: [true],
    observaciones: [''],
  });

  readonly pedidosPorId = computed(() => {
    const mapa = new Map<number, PedidoApi>();
    for (const pedido of this.pedidos()) mapa.set(pedido.id, pedido);
    return mapa;
  });

  readonly columnas = computed(() => {
    const tablero = this.tablero();
    const porEtapa = new Map<EtapaProduccion, OrdenProduccionApi[]>();
    for (const columna of tablero?.columnas ?? []) porEtapa.set(columna.etapa, columna.ordenes);
    return ETAPAS_PRODUCCION.map((etapa) => ({
      ...etapa,
      ordenes: porEtapa.get(etapa.valor) ?? [],
    }));
  });

  readonly ordenes = computed(() =>
    (this.tablero()?.columnas ?? []).flatMap((columna) => columna.ordenes),
  );

  readonly estadisticas = computed(() => {
    const columnas = this.columnas();
    const total = this.tablero()?.total ?? 0;
    const enImpresion =
      columnas.find((columna) => columna.valor === 'impresion')?.ordenes.length ?? 0;
    const enEntrega = columnas.find((columna) => columna.valor === 'entrega')?.ordenes.length ?? 0;
    const atencion = this.ordenes().filter(
      (orden) => orden.estado === 'pausada' || orden.estado === 'rechazada',
    ).length;
    return [
      {
        icono: 'bi-gear-wide-connected',
        tono: 'icon-tile-cyan',
        valor: this.dosDigitos(total),
        etiqueta: 'Órdenes activas',
      },
      {
        icono: 'bi-printer',
        tono: 'icon-tile-magenta',
        valor: this.dosDigitos(enImpresion),
        etiqueta: 'En etapa de impresión',
      },
      {
        icono: 'bi-exclamation-triangle',
        tono: atencion ? 'icon-tile-warning' : 'icon-tile-success',
        valor: this.dosDigitos(atencion),
        etiqueta: 'Órdenes que requieren atención',
      },
      {
        icono: 'bi-box-seam',
        tono: 'icon-tile-success',
        valor: this.dosDigitos(enEntrega),
        etiqueta: 'Listas para entrega',
      },
    ];
  });

  readonly resumenEtapas = computed(() => {
    const columnas = this.columnas();
    const maximo = Math.max(1, ...columnas.map((columna) => columna.ordenes.length));
    return columnas.map((columna) => {
      const total = columna.ordenes.length;
      return {
        ...columna,
        total,
        porcentaje: total === 0 ? 0 : Math.max(6, Math.round((total / maximo) * 100)),
      };
    });
  });

  readonly calidadReciente = computed(() => {
    const filas = this.ordenes().flatMap((orden) =>
      (orden.controlesCalidad ?? []).map((control) => ({
        control,
        folio: orden.pedidoFolio ?? `Orden ${orden.id}`,
        ordenId: orden.id,
      })),
    );
    return filas
      .sort((a, b) => String(b.control.fecha).localeCompare(String(a.control.fecha)))
      .slice(0, 6);
  });

  readonly controlesPendientes = computed(
    () => this.calidadReciente().filter((fila) => !fila.control.aprobado).length,
  );

  readonly hoy = new Date();

  ngOnInit(): void {
    this.cargar();
    this.cargarPedidos();
  }

  cargar(seleccionarId?: number): void {
    this.cargando.set(true);
    this.error.set(null);
    this.service
      .tableroProduccion()
      .pipe(finalize(() => this.cargando.set(false)))
      .subscribe({
        next: (tablero) => {
          this.tablero.set(tablero);
          this.cargarDetalles(
            tablero.columnas.flatMap((columna) => columna.ordenes.map((orden) => orden.pedidoId)),
          );
          const objetivo = seleccionarId ?? this.seleccionada()?.id;
          if (objetivo) {
            const actual = tablero.columnas
              .flatMap((columna) => columna.ordenes)
              .find((orden) => orden.id === objetivo);
            this.seleccionada.set(actual ?? null);
            if (actual) this.sincronizarFormulario(actual);
          }
        },
        error: (error) => {
          this.error.set(
            this.ui.mensajeDeError(error, 'No pudimos cargar el tablero de producción.'),
          );
        },
      });
  }

  private cargarPedidos(): void {
    this.service.listarPedidos({ page: 1, perPage: 100 }).subscribe({
      next: (respuesta) =>
        this.pedidos.update((actuales) =>
          respuesta.items.map((pedido) => {
            const previo = actuales.find((fila) => fila.id === pedido.id);
            return previo?.items?.length
              ? { ...pedido, items: previo.items, pagos: previo.pagos ?? pedido.pagos }
              : pedido;
          }),
        ),
      error: () => this.pedidos.set([]),
    });
  }

  private cargarDetalles(ids: number[]): void {
    const unicos = [...new Set(ids)];
    for (const id of unicos) {
      const conocido = this.pedidos().find((pedido) => pedido.id === id);
      if (conocido?.items?.length) continue;
      this.service.detallePedido(id).subscribe({
        next: (pedido) => {
          this.pedidos.update((lista) => [
            ...lista.filter((fila) => fila.id !== pedido.id),
            pedido,
          ]);
        },
        error: () => undefined,
      });
    }
  }

  pedidoDe(orden: OrdenProduccionApi): PedidoApi | undefined {
    return this.pedidosPorId().get(orden.pedidoId);
  }

  titulo(orden: OrdenProduccionApi): string {
    const pedido = this.pedidoDe(orden);
    const primero = pedido?.items?.[0];
    if (primero) {
      const extra = (pedido?.items?.length ?? 0) - 1;
      return extra > 0 ? `${primero.descripcion} +${extra} más` : primero.descripcion;
    }
    return `Orden ${orden.pedidoFolio ?? orden.id}`;
  }

  cliente(orden: OrdenProduccionApi): string {
    return this.pedidoDe(orden)?.cliente ?? 'Cliente sin asignar';
  }

  fechaEntrega(orden: OrdenProduccionApi): string {
    return this.fechaCorta(this.pedidoDe(orden)?.fechaEntrega);
  }

  prioridad(orden: OrdenProduccionApi): string {
    return this.pedidoDe(orden)?.prioridad ?? 'media';
  }

  clasePrioridad(orden: OrdenProduccionApi): string {
    const mapa: Record<string, string> = {
      baja: 'badge-soft-muted',
      media: 'badge-soft-cyan',
      alta: 'badge-soft-magenta',
      urgente: 'badge-soft-danger',
    };
    return mapa[this.prioridad(orden)] ?? 'badge-soft-muted';
  }

  progreso(orden: OrdenProduccionApi): number {
    const indice = ETAPAS_PRODUCCION.findIndex((etapa) => etapa.valor === orden.etapa);
    return Math.round(((indice + 1) / ETAPAS_PRODUCCION.length) * 100);
  }

  indiceEtapa(etapa: string): number {
    return ETAPAS_PRODUCCION.findIndex((fila) => fila.valor === etapa);
  }

  etiquetaEtapa(etapa: string): string {
    return ETAPAS_PRODUCCION.find((fila) => fila.valor === etapa)?.etiqueta ?? etapa;
  }

  iconoEtapa(etapa: string): string {
    return ETAPAS_PRODUCCION.find((fila) => fila.valor === etapa)?.icono ?? 'bi-circle';
  }

  dotEtapa(etapa: string): string {
    return `kanban-dot ${ETAPAS_PRODUCCION.find((fila) => fila.valor === etapa)?.dot ?? 'dot-ink'}`;
  }

  etiquetaEstado(estado: string): string {
    return etiquetaDe(ESTADOS_PRODUCCION, estado);
  }

  claseEstado(estado: string): string {
    return badgeDe(ESTADOS_PRODUCCION, estado);
  }

  puedeAvanzar(orden: OrdenProduccionApi): boolean {
    return this.indiceEtapa(orden.etapa) < ETAPAS_PRODUCCION.length - 1;
  }

  puedeRetroceder(orden: OrdenProduccionApi): boolean {
    return this.indiceEtapa(orden.etapa) > 0;
  }

  mover(orden: OrdenProduccionApi, delta: number): void {
    const indice = this.indiceEtapa(orden.etapa);
    const destino = ETAPAS_PRODUCCION[indice + delta];
    if (!destino) return;
    this.moviendoId.set(orden.id);
    this.service
      .actualizarOrdenProduccion(orden.id, {
        etapa: destino.valor,
        estado: orden.estado === 'pendiente' ? 'en-proceso' : orden.estado,
      })
      .pipe(finalize(() => this.moviendoId.set(null)))
      .subscribe({
        next: (actualizada) => {
          this.ui.exito(`${actualizada.pedidoFolio}: ${this.etiquetaEtapa(actualizada.etapa)}.`);
          this.cargar();
        },
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos mover la orden de etapa.')),
      });
  }

  abrirDetalle(orden: OrdenProduccionApi): void {
    this.seleccionada.set(orden);
    this.sincronizarFormulario(orden);
    this.calidadForm.reset({ criterio: '', aprobado: true, observaciones: '' });
  }

  cerrarDetalle(): void {
    this.seleccionada.set(null);
  }

  private sincronizarFormulario(orden: OrdenProduccionApi): void {
    this.ordenForm.reset({
      etapa: orden.etapa,
      estado: orden.estado,
      observaciones: orden.observaciones ?? '',
    });
  }

  guardarCambios(): void {
    const orden = this.seleccionada();
    if (!orden || this.ordenForm.invalid) {
      this.ordenForm.markAllAsTouched();
      return;
    }
    const valores = this.ordenForm.getRawValue();
    this.guardando.set(true);
    this.service
      .actualizarOrdenProduccion(orden.id, {
        etapa: valores.etapa,
        estado: valores.estado,
        observaciones: valores.observaciones.trim() || undefined,
      })
      .pipe(finalize(() => this.guardando.set(false)))
      .subscribe({
        next: () => {
          this.ui.exito('Orden de producción actualizada.');
          this.cargar(orden.id);
        },
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos actualizar la orden.')),
      });
  }

  async completar(orden: OrdenProduccionApi): Promise<void> {
    const confirmado = await this.confirmacion.confirmar({
      titulo: 'Completar producción',
      mensaje: `¿Marcar ${orden.pedidoFolio ?? 'la orden'} como completada? El pedido se moverá a Listo.`,
      confirmar: 'Completar orden',
    });
    if (!confirmado) return;

    this.guardando.set(true);
    this.service
      .actualizarOrdenProduccion(orden.id, { estado: 'completada' })
      .pipe(finalize(() => this.guardando.set(false)))
      .subscribe({
        next: () => {
          this.ui.exito('Orden completada. El pedido está listo para entrega.');
          this.cargar(orden.id);
        },
        error: (error) =>
          this.ui.error(this.ui.mensajeDeError(error, 'No pudimos completar la orden.')),
      });
  }

  registrarCalidad(): void {
    const orden = this.seleccionada();
    if (!orden) return;
    if (this.calidadForm.invalid) {
      this.calidadForm.markAllAsTouched();
      return;
    }
    const valores = this.calidadForm.getRawValue();
    this.registrandoCalidad.set(true);
    this.service
      .registrarCalidad(orden.id, {
        criterio: valores.criterio.trim(),
        aprobado: valores.aprobado,
        observaciones: valores.observaciones.trim() || undefined,
      })
      .pipe(finalize(() => this.registrandoCalidad.set(false)))
      .subscribe({
        next: (control) => {
          this.ui.exito(
            control.aprobado
              ? 'Control de calidad aprobado.'
              : 'Control de calidad registrado como rechazado.',
          );
          this.calidadForm.reset({ criterio: '', aprobado: true, observaciones: '' });
          this.cargar(orden.id);
        },
        error: (error) =>
          this.ui.error(
            this.ui.mensajeDeError(error, 'No pudimos registrar el control de calidad.'),
          ),
      });
  }

  exportar(): void {
    const filas = [
      ['Pedido', 'Cliente', 'Etapa', 'Estado', 'Responsable', 'Entrega', 'Observaciones'],
      ...this.ordenes().map((orden) => [
        orden.pedidoFolio ?? String(orden.pedidoId),
        this.cliente(orden),
        this.etiquetaEtapa(orden.etapa),
        this.etiquetaEstado(orden.estado),
        orden.responsable ?? '',
        this.fechaEntrega(orden),
        orden.observaciones ?? '',
      ]),
    ];
    const csv = filas.map((fila) => fila.map((celda) => `"${celda}"`).join(',')).join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    const enlace = document.createElement('a');
    enlace.href = url;
    enlace.download = 'produccion-llamma.csv';
    enlace.click();
    URL.revokeObjectURL(url);
    this.ui.exito('Reporte de turno exportado en CSV.');
  }

  iniciales(nombre: string | null | undefined): string {
    return (nombre || 'LL')
      .split(' ')
      .filter(Boolean)
      .slice(0, 2)
      .map((parte) => parte[0])
      .join('')
      .toUpperCase();
  }

  fechaCorta(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    if (!fecha) return 'Sin fecha';
    return fecha.toLocaleDateString('es-MX', { day: '2-digit', month: 'short' });
  }

  fechaHora(valor: string | null | undefined): string {
    const fecha = this.aFecha(valor);
    if (!fecha) return 'Pendiente';
    return fecha.toLocaleString('es-MX', {
      day: '2-digit',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  controlesDe(orden: OrdenProduccionApi): ControlCalidadApi[] {
    return orden.controlesCalidad ?? [];
  }

  private aFecha(valor: string | null | undefined): Date | null {
    if (!valor) return null;
    const fecha = new Date(valor.length > 10 ? valor : `${valor}T00:00:00`);
    return Number.isNaN(fecha.getTime()) ? null : fecha;
  }

  private dosDigitos(valor: number): string {
    return String(valor).padStart(2, '0');
  }
}
</file>

<file path="src/app/llamma/productos/productos.component.css">
/* Catálogo público de productos. */

.catalog-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.catalog-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.filter-chip {
  padding: 0.4rem 0.85rem;
  border: 1px solid var(--llamma-line);
  border-radius: 999px;
  background: #fff;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  font-weight: 600;
}

.filter-chip.is-active {
  border-color: var(--llamma-cyan);
  background: rgba(var(--llamma-cyan-rgb), 0.1);
  color: var(--llamma-cyan-deep);
}

.catalog-search {
  display: flex;
  align-items: center;
  min-width: 15rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  overflow: hidden;
}

.catalog-search .input-group-text {
  border: 0;
  background: transparent;
  color: var(--llamma-muted);
}

.catalog-search .form-control {
  border: 0;
  box-shadow: none;
}

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  gap: 1rem;
}

.product-card {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  padding: 1.25rem;
  border: 1px solid var(--llamma-line);
  border-top: 4px solid var(--llamma-cyan);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.product-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.product-card-media {
  position: relative;
  margin: -1.25rem -1.25rem 0.55rem;
  aspect-ratio: 3 / 2;
  overflow: hidden;
  border-bottom: 1px solid var(--llamma-line);
  background: #f3f1eb;
}

.product-card-media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-card-badge {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
}

.product-card h2 {
  margin: 0.2rem 0 0;
  font-size: 1rem;
  line-height: 1.3;
}

.product-card p {
  margin: 0;
  color: var(--llamma-muted);
  font-size: 0.74rem;
  line-height: 1.55;
}

.product-card-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 0.75rem;
  padding-top: 0.85rem;
  margin-top: auto;
  border-top: 1px solid var(--llamma-line);
}

.product-price span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.product-price strong {
  display: block;
  font-family: var(--llamma-font-display);
  font-size: 1.05rem;
  line-height: 1.2;
}

.product-price small {
  color: var(--llamma-muted);
  font-size: 0.64rem;
}

.catalog-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  padding: 3rem 1.5rem;
  text-align: center;
}

.catalog-empty i {
  font-size: 1.8rem;
  color: var(--llamma-cyan-deep);
}

.catalog-empty p {
  margin: 0;
  color: var(--llamma-muted);
  font-size: 0.8rem;
}

.catalog-error {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.8rem 1rem;
  border: 1px solid rgba(180, 35, 24, 0.2);
  border-radius: var(--llamma-radius-sm);
  background: rgba(180, 35, 24, 0.06);
  color: #b42318;
  font-size: 0.76rem;
}

.catalog-help {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
  padding: 1.6rem 1.8rem;
  margin-top: 2.5rem;
  border-radius: var(--llamma-radius);
  background: var(--llamma-carbon);
  color: #fff;
}

.catalog-help h2 {
  margin: 0.3rem 0 0.4rem;
  color: #fff;
  font-size: 1.35rem;
}

.catalog-help p {
  max-width: 40rem;
  margin: 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.78rem;
  line-height: 1.6;
}

.catalog-help .eyebrow {
  color: var(--llamma-yellow);
}

@media (max-width: 575.98px) {
  .catalog-search {
    width: 100%;
    min-width: 0;
  }

  .catalog-grid {
    grid-template-columns: 1fr;
  }
}

.campaign-cell {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  min-width: 14rem;
}

.campaign-cell strong {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
}

.campaign-cell small {
  display: block;
  margin-top: 0.12rem;
