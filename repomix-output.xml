def _totales(subtotal: float) -> dict:
    impuestos = round(subtotal * 0.16, 2)
    total = round(subtotal + impuestos, 2)
    anticipo = round(total * 0.5, 2)
    return {
        "subtotal": round(subtotal, 2),
        "impuestos": impuestos,
        "total": total,
        "anticipo": anticipo,
        "saldo": round(total - anticipo, 2),
    }


