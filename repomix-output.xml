                          {{ materiaDe(i)?.stockActual ?? 0 }}
                        </small>
                      </td>
                      <td>
                        <input type="number" min="0" step="0.01" class="form-control form-control-sm" formControlName="cantidad" />
                      </td>
                      <td>
                        <input type="number" min="0" step="0.01" class="form-control form-control-sm" formControlName="precioUnitario" />
                      </td>
                      <td class="text-end cell-main">{{ monedaExacta(importeItem(i)) }}</td>
                      <td class="text-end">
                        <button
                          class="btn btn-icon"
                          type="button"
                          aria-label="Quitar partida"
                          title="Quitar partida"
                          (click)="quitarItem(i)"
                        >
                          <i class="bi bi-trash3"></i>
                        </button>
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>

            <div class="row g-3 mt-1">
              <div class="col-md-7">
                <label class="form-label" for="ocNotas">Notas</label>
                <textarea
