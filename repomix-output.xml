                    **sesion.to_dict(),
                    "usuario": sesion.usuario.nombre if sesion.usuario else None,
                    "correo": sesion.usuario.correo if sesion.usuario else None,
                    "rol": sesion.usuario.rol.nombre if sesion.usuario and sesion.usuario.rol else None,
