<file path="src/app/llamma/solicitudes/solicitudes.component.css">
/* Bandeja interna de solicitudes de cotización. */

.min-w-0 {
  min-width: 0;
}

.inbox-stat {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  height: 100%;
  padding: 0.9rem 1rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.inbox-stat strong {
  display: block;
  font-family: var(--llamma-font-display);
  font-size: 1.35rem;
  line-height: 1;
}

.inbox-stat span:not(.icon-tile) {
  display: block;
  margin-top: 0.2rem;
  color: var(--llamma-muted);
  font-size: 0.68rem;
  font-weight: 500;
}

.inbox-stat-cyan {
  border-color: rgba(var(--llamma-cyan-rgb), 0.35);
  background: rgba(var(--llamma-cyan-rgb), 0.05);
}

/* --------------------------- Layout de dos paneles ------------------------- */

.solicitudes-page .row > [class*='col-'] {
  min-width: 0;
}

.inbox-panel,
.detail-panel {
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

/* ---------------------------------- Filtros -------------------------------- */

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.inbox-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.filter-chip {
  padding: 0.4rem 0.7rem;
  border: 1px solid var(--llamma-line);
  border-radius: 999px;
  background: #fbfaf7;
  color: var(--llamma-muted);
  font-size: 0.7rem;
  font-weight: 600;
}

.filter-chip.is-active {
  border-color: var(--llamma-carbon);
  background: var(--llamma-carbon);
  color: #fff;
}

.inbox-search {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex: 1 1 22rem;
  max-width: 32rem;
}

.inbox-search .input-group {
  flex: 1 1 auto;
}

.inbox-search .btn {
  white-space: nowrap;
}

/* ----------------------------------- Lista --------------------------------- */

.inbox-alert {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-bottom: 1rem;
  padding: 0.65rem 0.8rem;
  border: 1px solid rgba(180, 35, 24, 0.26);
  border-radius: 0.7rem;
  background: #fdecec;
  color: #a01212;
  font-size: 0.72rem;
  line-height: 1.45;
}

.inbox-alert i {
  margin-top: 0.05rem;
}

.inbox-loading,
.inbox-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  padding: 2.2rem 1rem;
  color: var(--llamma-muted);
  text-align: center;
}

.inbox-loading i {
  font-size: 1.4rem;
  color: var(--llamma-cyan-deep);
}

.inbox-empty i {
  font-size: 1.8rem;
  color: var(--llamma-cyan-deep);
}

.inbox-empty strong {
  color: var(--llamma-carbon);
  font-size: 0.9rem;
}

.inbox-empty p {
  max-width: 24rem;
  margin: 0;
  font-size: 0.74rem;
  line-height: 1.5;
}

.request-list {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0.55rem;
  min-width: 0;
  margin-top: 1rem;
}

.request-row {
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding: 0.85rem 0.9rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.85rem;
  background: #fff;
  color: inherit;
  text-align: left;
}

.request-row:hover {
  border-color: rgba(var(--llamma-cyan-rgb), 0.55);
  background: rgba(var(--llamma-cyan-rgb), 0.03);
}

.request-row.is-active {
  border-color: var(--llamma-cyan);
  box-shadow: inset 3px 0 0 var(--llamma-cyan);
  background: rgba(var(--llamma-cyan-rgb), 0.05);
}

.request-main {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  flex: 1 1 auto;
  min-width: 0;
}

.request-top {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  min-width: 0;
}

.request-top strong {
  font-size: 0.85rem;
  overflow-wrap: anywhere;
}

.request-company {
  color: var(--llamma-muted);
  font-size: 0.68rem;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.request-preview {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  margin-top: 0.1rem;
  color: #4a4a4a;
  font-size: 0.7rem;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.request-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  min-width: 0;
  margin-top: 0.25rem;
  color: var(--llamma-muted);
  font-size: 0.62rem;
}

.request-meta i {
  color: var(--llamma-cyan-deep);
}

.request-chevron {
  margin-top: 0.2rem;
  color: #b8b6ad;
  font-size: 0.8rem;
}

.inbox-pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 1rem;
  padding-top: 0.9rem;
  border-top: 1px solid var(--llamma-line);
}

.inbox-pager span {
  color: var(--llamma-muted);
  font-size: 0.68rem;
  font-weight: 600;
}

/* ---------------------------------- Detalle -------------------------------- */

.detail-panel {
  position: sticky;
  top: 5.6rem;
  max-height: calc(100vh - 7rem);
  overflow-y: auto;
}

/* Solo se muestra en el modo hoja inferior (< 1200px). */
.detail-backdrop {
  display: none;
}

.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
}

.detail-head > div {
  min-width: 0;
}

.detail-head h2 {
  margin: 0.2rem 0 0;
  font-size: 1.2rem;
  overflow-wrap: anywhere;
}

.detail-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin-top: 0.8rem;
}

.detail-state .form-select {
  width: auto;
  min-width: 9.5rem;
}

.detail-contact {
  display: grid;
  gap: 0.35rem;
  margin-top: 0.9rem;
  padding: 0.75rem 0.85rem;
  border-radius: 0.7rem;
  background: #fbfaf7;
  font-size: 0.72rem;
  overflow-wrap: anywhere;
}

.detail-contact i {
  width: 1rem;
  margin-right: 0.3rem;
  color: var(--llamma-cyan-deep);
}

.detail-contact a {
  color: var(--llamma-carbon);
  text-decoration: none;
}

.detail-contact a:hover {
  text-decoration: underline;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.7rem;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.5rem;
  margin-top: 0.9rem;
}

.detail-grid > div {
  min-width: 0;
  padding: 0.55rem 0.7rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.6rem;
}

.detail-grid span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.detail-grid strong {
  display: block;
  margin-top: 0.15rem;
  font-size: 0.72rem;
  overflow-wrap: anywhere;
  text-transform: capitalize;
}

.detail-message {
  margin-top: 1rem;
  padding: 0.7rem 0.85rem;
  border-left: 3px solid var(--llamma-yellow);
  background: rgba(var(--llamma-yellow-rgb), 0.11);
}

.detail-message p {
  margin: 0.3rem 0 0;
  font-size: 0.74rem;
  line-height: 1.6;
}

.detail-items,
.detail-files {
  margin-top: 1rem;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.55rem 0;
  border-bottom: 1px solid var(--llamma-line);
}

.detail-item strong {
  display: block;
  font-size: 0.75rem;
}

.detail-item small {
  display: block;
  margin-top: 0.1rem;
  color: var(--llamma-muted);
  font-size: 0.64rem;
  line-height: 1.4;
}

.detail-qty {
  color: var(--llamma-muted);
  font-size: 0.68rem;
  font-weight: 700;
  white-space: nowrap;
}

.detail-amount {
  font-family: var(--llamma-font-display);
  font-size: 0.72rem !important;
  white-space: nowrap;
}

.detail-empty {
  margin: 0.5rem 0 0;
  color: var(--llamma-muted);
  font-size: 0.7rem;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  margin-top: 0.4rem;
  padding: 0.5rem 0.65rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.6rem;
  background: #fff;
  font-size: 0.68rem;
  text-align: left;
}

.file-row:hover {
  border-color: var(--llamma-cyan);
}

.file-row > i {
  color: var(--llamma-cyan-deep);
}

.file-row-name {
  flex: 1 1 auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-row small {
  color: var(--llamma-muted);
}

.inbox-success {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-top: 1rem;
  padding: 0.65rem 0.8rem;
  border: 1px solid rgba(20, 122, 74, 0.25);
  border-radius: 0.7rem;
  background: #eaf7f0;
  color: #146c43;
  font-size: 0.7rem;
  line-height: 1.45;
}

.detail-cta {
  display: grid;
  gap: 0.45rem;
  margin-top: 1.1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--llamma-line);
}

.detail-note {
  display: flex;
  align-items: flex-start;
  gap: 0.4rem;
  margin: 0.2rem 0 0;
  color: var(--llamma-muted);
  font-size: 0.64rem;
  line-height: 1.5;
}

.conversion-result {
  margin-top: 1rem;
  padding: 0.85rem;
  border: 1px solid rgba(var(--llamma-cyan-rgb), 0.35);
  border-radius: 0.8rem;
  background: rgba(var(--llamma-cyan-rgb), 0.05);
}

.conversion-head {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.conversion-head > i {
  font-size: 1.4rem;
  color: var(--llamma-cyan-deep);
}

.conversion-head > div {
  flex: 1 1 auto;
  min-width: 0;
}

.conversion-head strong {
  display: block;
  font-family: var(--llamma-font-display);
  font-size: 0.95rem;
}

.conversion-totals {
  display: grid;
  gap: 0.3rem;
  margin: 0.7rem 0;
  padding-top: 0.6rem;
  border-top: 1px dashed #cfcdc5;
}

.conversion-totals > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.7rem;
}

.conversion-totals span {
  color: var(--llamma-muted);
}

.conversion-locked {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-top: 1rem;
  padding: 0.75rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.7rem;
  background: #fbfaf7;
}

.conversion-locked > i {
  font-size: 1.2rem;
  color: var(--llamma-cyan-deep);
}

.conversion-locked > div {
  flex: 1 1 auto;
  min-width: 0;
}

.conversion-locked strong {
  display: block;
  font-size: 0.74rem;
}

.conversion-locked span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.64rem;
  line-height: 1.4;
}

/* ------------------------------- Placeholder ------------------------------- */

.detail-placeholder {
  text-align: center;
}

.detail-placeholder h2 {
  margin: 0.7rem 0 0.4rem;
  font-size: 1.05rem;
}

.detail-placeholder p {
  max-width: 22rem;
  margin: 0 auto;
  color: var(--llamma-muted);
  font-size: 0.74rem;
  line-height: 1.6;
}

.placeholder-steps {
  display: grid;
  gap: 0.45rem;
  margin-top: 1.2rem;
  padding-top: 1rem;
  border-top: 1px dashed var(--llamma-line);
  text-align: left;
}

.placeholder-steps span {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--llamma-muted);
  font-size: 0.72rem;
}

.placeholder-steps i {
  color: var(--llamma-cyan-deep);
}

/* -------------------------------- Responsive ------------------------------- */

@media (max-width: 1199.98px) {
  /* Al apilar las columnas el detalle quedaría debajo de toda la lista, así que
     se presenta como una hoja inferior fija sobre la bandeja. */
  .detail-placeholder {
    display: none;
  }

  .detail-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1070;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: rgba(20, 20, 20, 0.48);
    backdrop-filter: blur(2px);
    cursor: pointer;
  }

  .detail-panel-open {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1080;
    width: 100%;
    max-width: 100%;
    max-height: min(88vh, 48rem);
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    border-radius: 1.25rem 1.25rem 0 0;
    box-shadow: 0 -20px 48px rgba(20, 20, 20, 0.24);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: detail-sheet-in 0.22s ease-out;
  }
}

@keyframes detail-sheet-in {
  from {
    opacity: 0;
    transform: translateY(1.5rem);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* En tablet la hoja se centra y limita su ancho para no parecer una página
   completa; en móvil ocupa todo el ancho disponible. */
@media (min-width: 768px) and (max-width: 1199.98px) {
  .detail-panel-open {
    right: auto;
    left: 50%;
    width: min(42rem, calc(100% - 2rem));
    max-height: min(84vh, 48rem);
    margin-bottom: 1.25rem;
    border-radius: 1.25rem;
    translate: -50% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .detail-panel-open {
    animation: none;
  }
}

@media (max-width: 575.98px) {
  .inbox-search {
    flex: 1 1 100%;
    max-width: none;
    flex-wrap: wrap;
  }

  .inbox-search .input-group {
    flex: 1 1 100%;
  }

  .inbox-search .btn {
    flex: 1 1 auto;
  }

  .inbox-tabs {
    width: 100%;
  }

  .inbox-pager span {
    display: none;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }
}
