<div class="module-page dashboard-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Panel ejecutivo</span>
        <h1>Buenos días, equipo Llamma.</h1>
        <p class="page-lead">
          Una lectura rápida del taller: ventas, carga de producción y materiales que necesitan
          atención esta semana.
        </p>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="date-chip">
          <i class="bi bi-calendar3"></i>
          {{ resumen() ? fechaCorta(resumen()!.pedidosRecientes[0]?.fechaPedido) : '—' }}
        </span>
        <button class="btn btn-outline-ink" type="button" (click)="cargar()" [disabled]="cargando()">
          <i class="bi bi-arrow-clockwise" [class.spin]="cargando()"></i>
          {{ cargando() ? 'Actualizando…' : 'Actualizar' }}
        </button>
      </div>
    </header>

    @if (error()) {
      <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="flex-grow-1">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar()">Reintentar</button>
      </div>
    }

    @if (cargando() && !resumen()) {
      <div class="panel-card text-center py-5">
        <span class="spinner-border text-primary" role="status" aria-hidden="true"></span>
        <p class="mt-3 mb-0 text-muted">Cargando indicadores del taller…</p>
      </div>
    }

    @if (resumen(); as data) {
      <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
          <article class="kpi-card h-100">
            <div class="d-flex align-items-start justify-content-between gap-2">
              <span class="icon-tile icon-tile-cyan"><i class="bi bi-currency-dollar"></i></span>
              <span class="trend" [class.trend-up]="data.variacionVentas >= 0" [class.trend-down]="data.variacionVentas < 0">
                <i class="bi" [class.bi-arrow-up-right]="data.variacionVentas >= 0" [class.bi-arrow-down-right]="data.variacionVentas < 0"></i>
                {{ data.variacionVentas }}%
              </span>
            </div>
            <p class="kpi-label">Ventas del periodo</p>
            <h2 class="kpi-value">{{ moneda(data.ventasPeriodo) }}</h2>
            <div class="kpi-foot">
              <i class="bi bi-graph-up-arrow text-cyan"></i>
              <span>Mes anterior: {{ moneda(data.ventasMesAnterior) }}</span>
            </div>
          </article>
        </div>

        <div class="col-sm-6 col-xl-3">
          <article class="kpi-card h-100">
            <div class="d-flex align-items-start justify-content-between gap-2">
              <span class="icon-tile icon-tile-magenta"><i class="bi bi-receipt-cutoff"></i></span>
              <span class="trend trend-flat"><i class="bi bi-dot"></i> {{ data.pedidosPeriodo }} pedidos</span>
            </div>
            <p class="kpi-label">Ticket promedio</p>
            <h2 class="kpi-value">{{ moneda(data.ticketPromedio) }}</h2>
            <div class="kpi-foot">
              <i class="bi bi-bag-check text-magenta"></i>
              <span>{{ data.clientesActivos }} clientes activos</span>
            </div>
          </article>
        </div>

        <div class="col-sm-6 col-xl-3">
          <article class="kpi-card h-100">
            <div class="d-flex align-items-start justify-content-between gap-2">
              <span class="icon-tile icon-tile-yellow"><i class="bi bi-gear-wide-connected"></i></span>
              <span class="trend trend-flat"><i class="bi bi-dot"></i> {{ etapas().length }} etapas</span>
            </div>
            <p class="kpi-label">Órdenes en producción</p>
            <h2 class="kpi-value">{{ data.ordenesEnProduccion }}</h2>
            <div class="kpi-foot">
              <i class="bi bi-printer text-yellow"></i>
              <span>{{ etapas()[0]?.total ?? 0 }} en {{ etapas()[0]?.etiqueta ?? 'taller' }}</span>
            </div>
          </article>
        </div>

        <div class="col-sm-6 col-xl-3">
          <article class="kpi-card h-100">
            <div class="d-flex align-items-start justify-content-between gap-2">
              <span class="icon-tile icon-tile-danger"><i class="bi bi-exclamation-triangle"></i></span>
              <span class="trend trend-down"><i class="bi bi-arrow-down-right"></i> {{ data.solicitudesNuevas }} nuevas</span>
            </div>
            <p class="kpi-label">Alertas de inventario</p>
            <h2 class="kpi-value">{{ data.materiasPrimasBajoStock.toString().padStart(2, '0') }}</h2>
            <div class="kpi-foot">
              <i class="bi bi-droplet-half text-magenta"></i>
              <span>{{ data.bajoStock[0]?.nombre ?? 'Sin alertas críticas' }}</span>
            </div>
          </article>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-xl-8">
          <article class="panel-card h-100">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Rendimiento</span>
                <h2>Ventas por línea de negocio</h2>
              </div>
              <span class="badge badge-soft-cyan">últimos 6 meses</span>
            </div>

            @if (lineas().length) {
              <div class="chart-summary">
                <strong>{{ moneda(data.ventasPeriodo) }}</strong>
                <span>facturado este mes</span>
                <span class="trend ms-auto" [class.trend-up]="data.variacionVentas >= 0" [class.trend-down]="data.variacionVentas < 0">
                  <i class="bi" [class.bi-arrow-up-right]="data.variacionVentas >= 0" [class.bi-arrow-down-right]="data.variacionVentas < 0"></i>
                  {{ data.variacionVentas }}%
                </span>
              </div>

              <div class="bar-chart" role="img" aria-label="Ventas por línea de negocio en los últimos seis meses">
                @for (linea of lineas(); track linea.linea) {
                  <div class="bar-group">
                    <div class="bar-set">
                      <span class="bar" [style.--bar]="linea.porcentaje + '%'" [style.background]="linea.color"></span>
                    </div>
                    <span class="bar-label">{{ linea.etiqueta }}</span>
                  </div>
                }
              </div>

              <div class="chart-legend">
                @for (linea of lineas(); track linea.linea) {
                  <span class="legend-item">
                    <span class="legend-dot" [style.--legend-color]="linea.color"></span>
                    {{ linea.etiqueta }} · {{ moneda(linea.total) }}
                  </span>
                }
              </div>
            } @else {
              <p class="text-muted mb-0 py-4">Aún no hay pedidos con partidas de producto para graficar.</p>
            }
          </article>
        </div>

        <div class="col-xl-4">
          <article class="panel-card h-100 d-flex flex-column">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Taller</span>
                <h2>Estado de producción</h2>
              </div>
              <span class="badge badge-soft-warning">{{ data.ordenesEnProduccion }} activas</span>
            </div>

            <div class="production-donut" [style.background]="donutFondo()">
              <div class="donut-center">
                <strong>{{ data.ordenesEnProduccion }}</strong>
                <span>órdenes</span>
              </div>
            </div>

            <div class="stage-list">
              @for (etapa of etapas(); track etapa.etapa) {
                <div class="stage-row">
                  <span class="stage-dot dot-cyan"></span>
                  <span>{{ etapa.etiqueta }}</span>
                  <div class="stage-meter"><span [style.width]="etapa.porcentaje + '%'"></span></div>
                  <strong>{{ etapa.total }}</strong>
                </div>
              } @empty {
                <p class="text-muted mb-0">El tablero está vacío: no hay órdenes activas.</p>
              }
            </div>

            <a class="panel-link mt-auto" routerLink="/produccion">
              Ver tablero de producción <i class="bi bi-arrow-right"></i>
            </a>
          </article>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-xl-7">
          <article class="panel-card h-100">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Últimos movimientos</span>
                <h2>Órdenes recientes</h2>
              </div>
              <a class="panel-link mt-0" routerLink="/detalle">Ver todas <i class="bi bi-arrow-right"></i></a>
            </div>

            <div class="table-responsive">
              <table class="table table-llamma align-middle">
                <thead>
                  <tr>
                    <th>Orden</th>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                  </tr>
                </thead>
                <tbody>
                  @for (pedido of data.pedidosRecientes; track pedido.id) {
                    <tr>
                      <td>
                        <div class="order-id">#{{ pedido.folio }}</div>
                        <div class="cell-muted">{{ fechaCorta(pedido.fechaPedido) }}</div>
                      </td>
                      <td>
                        <div class="client-cell">
                          <span class="avatar avatar-cyan">{{ iniciales(pedido.cliente) }}</span>
                          <div>
                            <strong>{{ pedido.cliente || 'Mostrador' }}</strong>
                            <small>{{ pedido.prioridad }} prioridad</small>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span class="badge" [class]="claseEstado(pedido.estado)">{{ etiquetaEstado(pedido.estado) }}</span>
                      </td>
                      <td class="text-end cell-main">{{ moneda(pedido.total) }}</td>
                    </tr>
                  } @empty {
                    <tr>
                      <td colspan="4" class="text-center text-muted py-4">Todavía no hay pedidos registrados.</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </article>
        </div>

        <div class="col-xl-5">
          <article class="panel-card h-100 d-flex flex-column">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Atención inmediata</span>
                <h2>Alertas de inventario</h2>
              </div>
              <span class="badge badge-soft-danger">{{ data.materiasPrimasBajoStock }} críticas</span>
            </div>

            <div class="alert-list">
              @for (materia of data.bajoStock; track materia.id) {
                <div class="alert-row">
                  <span class="icon-tile icon-tile-danger"><i class="bi bi-box-seam"></i></span>
                  <div class="flex-grow-1 min-w-0">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                      <strong>{{ materia.nombre }}</strong>
                      <span class="stock-text text-danger">
                        {{ materia.stockActual }} / {{ materia.stockMinimo }} {{ materia.unidadMedida }}
                      </span>
                    </div>
                    <div class="stock-track mt-2">
                      <span class="stock-fill bg-danger" [style.width]="porcentajeStock(materia.stockActual, materia.stockMaximo) + '%'"></span>
                    </div>
                    <small>Mínimo requerido: {{ materia.stockMinimo }} {{ materia.unidadMedida }}</small>
                  </div>
                </div>
              } @empty {
                <p class="text-muted mb-0">Todo el inventario está por encima del mínimo.</p>
              }
            </div>

            <a class="panel-link mt-auto" routerLink="/abastecimiento">
              Generar orden de compra <i class="bi bi-arrow-right"></i>
            </a>
          </article>
        </div>
      </div>
    }
  </div>
</div>
</file>

