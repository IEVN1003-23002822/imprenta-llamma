    MateriaPrima,
    MovimientoInventario,
    OrdenCompra,
    OrdenCompraItem,
    SolicitudCotizacion,
    SolicitudItem,
    SolicitudArchivo,
    MensajeChat,
    Cotizacion,
    CotizacionItem,
    Pedido,
    PedidoItem,
    Pago,
    OrdenProduccion,
    ProduccionEtapa,
    ControlCalidad,
    ActividadMarketing,
]

assert len(TABLAS) == 27, "El esquema de Llamma debe contener 27 tablas"
