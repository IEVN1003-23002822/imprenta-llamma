<div class="module-page cotizar-page">
  <div class="llamma-container">
    <header class="page-header flex flex-wrap items-end justify-between gap-4">
      <div class="page-brand">
        <img
          class="page-brand-logo"
          src="assets/images/logo-llamma-128.webp"
          srcset="assets/images/logo-llamma-128.webp 2x, assets/images/logo-llamma-256.webp 4x"
          alt="Imprenta Llamma Logo"
          width="38"
          height="54"
        />
        <div>
          <span class="eyebrow">Portal de clientes</span>
          <h1>Solicita tu cotización.</h1>
          <p class="page-lead">
            Cuéntanos qué necesitas imprimir. Puedes elegir productos del catálogo, describir tu
            proyecto y adjuntar tu logotipo o referencias. Te respondemos con una propuesta a tu
            medida.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn btn-outline-ink" routerLink="/productos">
          <i class="bi bi-grid-3x3-gap"></i> Ver catálogo
        </a>
        <a class="btn btn-soft" routerLink="/login">
          <i class="bi bi-shield-lock"></i> Acceso equipo
        </a>
      </div>
    </header>

    @if (folio(); as folioActual) {
      <app-cotizar-comprobante
        [folio]="folioActual"
        [solicitud]="solicitudCreada()"
        [partidas]="partidasComprobante()"
        [totalPiezas]="totalPiezas()"
        [totalConIva]="totalConIva()"
        [correo]="form.controls.correo.value"
        [copiado]="copiado()"
        (copiar)="copiarFolio()"
        (descargar)="descargarComprobante()"
        (nueva)="nuevaSolicitud()"
      />
    } @else {
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 xl:col-span-8">
          <app-cotizar-pasos
            [paso]="paso()"
            [pasos]="pasos"
            [borradorRecuperado]="borradorRecuperado()"
            [archivosPendientes]="archivosPendientes()"
            (ir)="irAPaso($event)"
            (ocultarAviso)="ocultarAvisoBorrador()"
            (descartar)="descartarBorrador()"
          />

          <form id="solicitudForm" [formGroup]="form" (ngSubmit)="enviar()" novalidate>
            @if (paso() === 1) {
              <section id="paso1" tabindex="-1" class="panel-card mb-6">
                <div class="panel-head">
                  <div class="flex items-center gap-4">
                    <span class="step-number">01</span>
                    <div>
                      <span class="panel-kicker">Datos de contacto</span>
                      <h2>¿Con quién hablamos?</h2>
                    </div>
                  </div>
                  <span class="badge badge-soft-muted">Paso 1</span>
                </div>

                <div class="grid grid-cols-12 gap-4">
                  <div class="col-span-12 md:col-span-6">
                    <label class="form-label" for="cotNombre">Nombre completo</label>
                    <input
                      id="cotNombre"
                      type="text"
                      class="form-control"
                      formControlName="nombreCliente"
                      placeholder="Ej. Ana Torres"
                      autocomplete="name"
                      [attr.aria-invalid]="
                        form.controls.nombreCliente.touched && form.controls.nombreCliente.invalid
                      "
                      [attr.aria-describedby]="
                        form.controls.nombreCliente.touched && form.controls.nombreCliente.invalid
                          ? 'cotNombreError'
                          : null
                      "
                      [class.is-invalid]="
                        form.controls.nombreCliente.touched && form.controls.nombreCliente.invalid
                      "
                    />
                    @if (
                      form.controls.nombreCliente.touched && form.controls.nombreCliente.invalid
                    ) {
                      <span class="field-error" id="cotNombreError"
                        >Escribe tu nombre completo.</span
                      >
                    }
                  </div>
                  <div class="col-span-12 md:col-span-6">
                    <label class="form-label" for="cotEmpresa"
                      >Empresa o marca <span class="field-optional">(opcional)</span></label
                    >
                    <input
                      id="cotEmpresa"
                      type="text"
                      class="form-control"
                      formControlName="empresa"
                      placeholder="Ej. Estudio Nómada"
                      autocomplete="organization"
                    />
                  </div>
                  <div class="col-span-12 md:col-span-6">
                    <label class="form-label" for="cotCorreo">Correo electrónico</label>
                    <input
                      id="cotCorreo"
                      type="email"
                      class="form-control"
                      formControlName="correo"
                      placeholder="nombre&#64;empresa.mx"
                      autocomplete="email"
                      [attr.aria-invalid]="
                        form.controls.correo.touched && form.controls.correo.invalid
                      "
                      [attr.aria-describedby]="
                        form.controls.correo.touched && form.controls.correo.invalid
                          ? 'cotCorreoError'
                          : null
                      "
                      [class.is-invalid]="
                        form.controls.correo.touched && form.controls.correo.invalid
                      "
                    />
                    @if (form.controls.correo.touched && form.controls.correo.invalid) {
                      <span class="field-error" id="cotCorreoError">Ingresa un correo válido.</span>
                    }
                  </div>
                  <div class="col-span-12 md:col-span-6">
                    <label class="form-label" for="cotTelefono">Teléfono / WhatsApp</label>
                    <input
                      id="cotTelefono"
                      type="tel"
                      class="form-control"
                      formControlName="telefono"
                      placeholder="55 0000 0000"
                      autocomplete="tel"
                      [attr.aria-invalid]="
                        form.controls.telefono.touched && form.controls.telefono.invalid
                      "
                      [attr.aria-describedby]="
                        form.controls.telefono.touched && form.controls.telefono.invalid
                          ? 'cotTelefonoError'
                          : null
                      "
                      [class.is-invalid]="
                        form.controls.telefono.touched && form.controls.telefono.invalid
                      "
                    />
                    @if (form.controls.telefono.touched && form.controls.telefono.invalid) {
                      <span class="field-error" id="cotTelefonoError"
                        >Escribe un teléfono de contacto.</span
                      >
                    }
                  </div>
                  <div class="col-span-12 md:col-span-6">
                    <label class="form-label" for="cotSegmento">Tipo de cliente</label>
                    <select id="cotSegmento" class="form-select" formControlName="segmento">
                      <option value="particular">Particular</option>
                      <option value="pyme">Pyme</option>
                      <option value="corporativo">Corporativo</option>
                      <option value="eventos">Eventos</option>
                      <option value="escolar">Escolar</option>
                      <option value="gobierno">Gobierno</option>
                    </select>
                  </div>
                  <div class="col-span-12 md:col-span-6">
                    <label class="form-label" for="cotFecha">Fecha deseada de entrega</label>
                    <input
                      id="cotFecha"
                      type="date"
                      class="form-control"
                      formControlName="fechaDeseada"
                      [min]="hoy"
                    />
                  </div>
                </div>
              </section>
            }

            @if (paso() === 2) {
              <section id="paso2" tabindex="-1" class="panel-card mb-6">
                <div class="panel-head">
                  <div class="flex items-center gap-4">
                    <span class="step-number">02</span>
                    <div>
                      <span class="panel-kicker">Constructor de solicitud</span>
                      <h2>¿Qué quieres imprimir?</h2>
                    </div>
                  </div>
                  <span class="badge badge-soft-muted">Paso 2</span>
                </div>

                <div class="grid grid-cols-12 gap-4 items-end">
                  <div class="col-span-12 md:col-span-5">
                    <label class="form-label" for="cotProducto">Producto del catálogo</label>
                    <select
                      id="cotProducto"
                      class="form-select"
                      [value]="productoId() ?? ''"
                      (change)="cambiarProducto($event)"
                    >
                      @for (producto of productos(); track producto.id) {
                        <option [value]="producto.id">{{ producto.nombre }}</option>
                      }
                    </select>
                  </div>
                  <div class="col-span-4 md:col-span-2">
                    <label class="form-label" for="cotCantidad">Cantidad</label>
                    <input
                      id="cotCantidad"
                      type="number"
                      class="form-control"
                      min="1"
                      step="1"
                      [value]="cantidad()"
                      (input)="cambiarCantidad($event)"
                    />
                  </div>
                  <div class="col-span-8 md:col-span-5">
                    <label class="form-label" for="cotEspecificaciones">Especificaciones</label>
                    <input
                      id="cotEspecificaciones"
                      type="text"
                      class="form-control"
                      placeholder="Medida, talla, acabado, número de tintas..."
                      [value]="especificaciones()"
                      (input)="cambiarEspecificaciones($event)"
                    />
                  </div>
                  <div class="col-span-12">
                    <button class="btn btn-ink" type="button" (click)="agregarProducto()">
                      <i class="bi bi-plus-lg"></i> Agregar a mi solicitud
                    </button>
                  </div>
                </div>

                @if (productoActual(); as producto) {
                  <div class="picked-product">
                    <span class="icon-tile icon-tile-cyan">
                      <i class="bi {{ producto.icono || 'bi-box-seam' }}"></i>
                    </span>
                    <div class="grow min-w-0">
                      <strong>{{ producto.nombre }}</strong>
                      <small>{{ producto.descripcion }}</small>
                    </div>
                    <div class="picked-price">
                      <strong>{{ moneda(producto.precioBase) }}</strong>
                      <span>por {{ producto.unidadVenta }}</span>
                    </div>
                  </div>
                  <p class="line-estimate">
                    <i class="bi bi-calculator"></i>
                    Estimado de esta línea: <strong>{{ moneda(estimadoLinea()) }}</strong> + IVA ·
                    sujeto a revisión de diseño.
                  </p>
                }

                @if (carrito().length) {
                  <div class="cart-list">
                    @for (item of carrito(); track $index) {
                      <div class="cart-row">
                        <span class="cart-index">{{ $index + 1 }}</span>
                        <div class="grow min-w-0">
                          <strong>{{ item.nombreProducto }}</strong>
                          <small>{{ item.cantidad }} × {{ item.especificaciones }}</small>
                        </div>
                        <strong class="cart-amount">{{ moneda(item.precioEstimado ?? 0) }}</strong>
                        <button
                          class="btn btn-icon"
                          type="button"
                          (click)="quitarProducto($index)"
                          [attr.aria-label]="'Quitar ' + item.nombreProducto"
                        >
                          <i class="bi bi-x-lg"></i>
                        </button>
                      </div>
                    }
                  </div>
                } @else {
                  <div class="cart-empty">
                    <i class="bi bi-bag-plus"></i>
                    <p>
                      Aún no agregas productos. También puedes saltarte este paso y describir tu
                      proyecto en el siguiente campo.
                    </p>
                  </div>
                }
              </section>
            }

            @if (paso() === 3) {
              <section id="paso3" tabindex="-1" class="panel-card mb-6">
                <div class="panel-head">
                  <div class="flex items-center gap-4">
                    <span class="step-number">03</span>
                    <div>
                      <span class="panel-kicker">Tu proyecto</span>
                      <h2>Mensaje y logística</h2>
                    </div>
                  </div>
                  <span class="badge badge-soft-muted">Paso 3</span>
                </div>

                <div class="mb-4">
                  <label class="form-label" for="cotMensaje">Describe tu proyecto</label>
                  <textarea
                    id="cotMensaje"
                    class="form-control"
                    rows="5"
                    formControlName="mensaje"
                    placeholder="Ej. Hola, me recomendaron su imprenta. Quiero cotizar 50 playeras negras estampadas al frente y espalda para el 25 de este mes..."
                    aria-describedby="cotMensajeAyuda"
                    [attr.aria-invalid]="
                      form.controls.mensaje.touched && form.controls.mensaje.invalid
                    "
                    [class.is-invalid]="
                      form.controls.mensaje.touched && form.controls.mensaje.invalid
                    "
                  ></textarea>
                  <div class="field-hint" id="cotMensajeAyuda">
                    Incluye cantidades, medidas, materiales, colores y fechas importantes.
                  </div>
                  @if (form.controls.mensaje.touched && form.controls.mensaje.invalid) {
                    <span class="field-error" id="cotMensajeError"
                      >Cuéntanos un poco más (mínimo 20 caracteres).</span
                    >
                  }
                </div>

                <div class="grid grid-cols-12 gap-4">
                  <div class="col-span-12 md:col-span-6">
                    <label class="form-label" for="cotMetodo">Método de entrega</label>
                    <select id="cotMetodo" class="form-select" formControlName="metodoEntrega">
                      <option value="taller">Recoger en taller</option>
                      <option value="domicilio">Envío a domicilio</option>
                      <option value="paqueteria">Paquetería nacional</option>
                      <option value="instalacion">Instalación en sitio</option>
                    </select>
                  </div>
                  <div class="col-span-12 md:col-span-6">
                    <label class="form-label" for="cotArchivos">Archivos de referencia</label>
                    <label class="upload-box upload-box-compact" for="cotArchivos">
                      <i class="bi bi-cloud-arrow-up"></i>
                      <div>
                        <strong>Adjuntar logotipo o brief</strong>
                        <span>PDF, AI, PSD, PNG, JPG, SVG o ZIP · máx. 25 MB</span>
                      </div>
                      <span class="btn btn-sm btn-soft ms-auto">Examinar</span>
                      <input
                        id="cotArchivos"
                        class="sr-only"
                        type="file"
                        multiple
                        accept=".pdf,.ai,.psd,.png,.jpg,.jpeg,.svg,.zip"
                        (change)="agregarArchivos($event)"
                      />
                    </label>
                  </div>
                </div>

                @if (archivos().length) {
                  <div class="file-chips">
                    @for (archivo of archivos(); track $index) {
                      <span class="file-chip">
                        <i class="bi bi-paperclip"></i>
                        <span class="file-chip-name">{{ archivo.name }}</span>
                        <small>{{ tamano(archivo.size) }}</small>
                        <button
                          type="button"
                          (click)="quitarArchivo($index)"
                          [attr.aria-label]="'Quitar ' + archivo.name"
                        >
                          <i class="bi bi-x"></i>
                        </button>
                      </span>
                    }
                  </div>
                }
              </section>
            }

            <div class="quote-step-nav">
              @if (paso() > 1) {
                <button class="btn btn-outline-ink" type="button" (click)="pasoAnterior()">
                  <i class="bi bi-arrow-left"></i> Atrás
                </button>
              }
              @if (paso() < 3) {
                <button class="btn btn-ink ms-auto" type="button" (click)="pasoSiguiente()">
                  Continuar <i class="bi bi-arrow-right"></i>
                </button>
              } @else {
                <span class="quote-step-hint">
                  <i class="bi bi-check2-circle"></i>
                  Revisa el resumen y envía tu solicitud.
                </span>
              }
            </div>
          </form>
        </div>

        <div class="col-span-12 xl:col-span-4">
          <app-cotizar-resumen
            [carrito]="carrito()"
            [totalPiezas]="totalPiezas()"
            [totalEstimado]="totalEstimado()"
            [ivaEstimado]="ivaEstimado()"
            [totalConIva]="totalConIva()"
            [error]="error()"
            [enviando]="enviando()"
          />

          <div class="help-card mt-6">
            <i class="bi bi-headset"></i>
            <div>
              <strong>¿Prefieres hablar con alguien?</strong>
              <p>Escríbenos por WhatsApp y te ayudamos a armar tu solicitud.</p>
              <a href="https://wa.me/525512345678" target="_blank" rel="noopener"> 55 1234 5678 </a>
            </div>
          </div>
        </div>
      </div>
    }
  </div>
</div>
</file>

<file path="src/app/llamma/dashboard/dashboard.component.html">
<div class="module-page dashboard-page">
  <div class="llamma-container">
    <header class="page-header flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Panel ejecutivo</span>
        <h1>Buenos días, equipo Llamma.</h1>
        <p class="page-lead">
          Una lectura rápida del taller: ventas, carga de producción y materiales que necesitan
          atención esta semana.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="date-chip">
          <i class="bi bi-calendar3"></i>
          {{ resumen() ? fechaCorta(resumen()!.pedidosRecientes[0]?.fechaPedido) : '—' }}
        </span>
        <button
          class="btn btn-outline-ink"
          type="button"
          (click)="cargar()"
          [disabled]="cargando()"
        >
          <i class="bi bi-arrow-clockwise" [class.spin]="cargando()"></i>
          {{ cargando() ? 'Actualizando…' : 'Actualizar' }}
        </button>
      </div>
    </header>

    @if (error()) {
      <div class="alert alert-danger flex items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="grow">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar()">
          Reintentar
        </button>
      </div>
    }

    @if (cargando() && !resumen()) {
      <div class="panel-card text-center py-12">
        <span class="spinner-border text-llamma-cyan-deep" role="status" aria-hidden="true"></span>
        <p class="mt-4 mb-0 text-llamma-muted">Cargando indicadores del taller…</p>
      </div>
    }

    @if (resumen(); as data) {
      <div class="grid grid-cols-12 gap-6 mb-6">
        <div class="col-span-12 sm:col-span-6 xl:col-span-3">
          <article class="kpi-card h-full">
            <div class="flex items-start justify-between gap-2">
              <span class="icon-tile icon-tile-cyan"><i class="bi bi-currency-dollar"></i></span>
              <span
                class="trend"
                [class.trend-up]="data.variacionVentas >= 0"
                [class.trend-down]="data.variacionVentas < 0"
              >
                <i
                  class="bi"
                  [class.bi-arrow-up-right]="data.variacionVentas >= 0"
                  [class.bi-arrow-down-right]="data.variacionVentas < 0"
                ></i>
                {{ data.variacionVentas }}%
              </span>
            </div>
            <p class="kpi-label">Ventas del periodo</p>
            <h2 class="kpi-value">{{ moneda(data.ventasPeriodo) }}</h2>
            <div class="kpi-foot">
              <i class="bi bi-graph-up-arrow text-cyan"></i>
              <span>Mes anterior: {{ moneda(data.ventasMesAnterior) }}</span>
            </div>
          </article>
        </div>

        <div class="col-span-12 sm:col-span-6 xl:col-span-3">
          <article class="kpi-card h-full">
            <div class="flex items-start justify-between gap-2">
              <span class="icon-tile icon-tile-magenta"><i class="bi bi-receipt-cutoff"></i></span>
              <span class="trend trend-flat"
                ><i class="bi bi-dot"></i> {{ data.pedidosPeriodo }} pedidos</span
              >
            </div>
            <p class="kpi-label">Ticket promedio</p>
            <h2 class="kpi-value">{{ moneda(data.ticketPromedio) }}</h2>
            <div class="kpi-foot">
              <i class="bi bi-bag-check text-magenta"></i>
              <span>{{ data.clientesActivos }} clientes activos</span>
            </div>
          </article>
        </div>

        <div class="col-span-12 sm:col-span-6 xl:col-span-3">
          <article class="kpi-card h-full">
            <div class="flex items-start justify-between gap-2">
              <span class="icon-tile icon-tile-yellow"
                ><i class="bi bi-gear-wide-connected"></i
              ></span>
              <span class="trend trend-flat"
                ><i class="bi bi-dot"></i> {{ etapas().length }} etapas</span
              >
            </div>
            <p class="kpi-label">Órdenes en producción</p>
            <h2 class="kpi-value">{{ data.ordenesEnProduccion }}</h2>
            <div class="kpi-foot">
              <i class="bi bi-printer text-yellow"></i>
              <span>{{ etapas()[0]?.total ?? 0 }} en {{ etapas()[0]?.etiqueta ?? 'taller' }}</span>
            </div>
          </article>
        </div>

        <div class="col-span-12 sm:col-span-6 xl:col-span-3">
          <article class="kpi-card h-full">
            <div class="flex items-start justify-between gap-2">
              <span class="icon-tile icon-tile-danger"
                ><i class="bi bi-exclamation-triangle"></i
              ></span>
              <span class="trend trend-down"
                ><i class="bi bi-arrow-down-right"></i> {{ data.solicitudesNuevas }} nuevas</span
              >
            </div>
            <p class="kpi-label">Alertas de inventario</p>
            <h2 class="kpi-value">
              {{ data.materiasPrimasBajoStock.toString().padStart(2, '0') }}
            </h2>
            <div class="kpi-foot">
              <i class="bi bi-droplet-half text-magenta"></i>
              <span>{{ data.bajoStock[0]?.nombre ?? 'Sin alertas críticas' }}</span>
            </div>
          </article>
        </div>
      </div>

      <div class="grid grid-cols-12 gap-6 mb-6">
        <div class="col-span-12 xl:col-span-8">
          <article class="panel-card h-full">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Rendimiento</span>
                <h2>Ventas por línea de negocio</h2>
              </div>
              <span class="badge badge-soft-cyan">últimos 6 meses</span>
            </div>

            @if (lineas().length) {
              <div class="chart-summary">
                <strong>{{ moneda(data.ventasPeriodo) }}</strong>
                <span>facturado este mes</span>
                <span
                  class="trend ms-auto"
                  [class.trend-up]="data.variacionVentas >= 0"
                  [class.trend-down]="data.variacionVentas < 0"
                >
                  <i
                    class="bi"
                    [class.bi-arrow-up-right]="data.variacionVentas >= 0"
                    [class.bi-arrow-down-right]="data.variacionVentas < 0"
                  ></i>
                  {{ data.variacionVentas }}%
                </span>
              </div>

              <div
                class="bar-chart"
                role="img"
                aria-label="Ventas por línea de negocio en los últimos seis meses"
              >
                @for (linea of lineas(); track linea.linea) {
                  <div class="bar-group">
                    <div class="bar-set">
                      <span
                        class="bar"
                        [style.--bar]="linea.porcentaje + '%'"
                        [style.background]="linea.color"
                      ></span>
                    </div>
                    <span class="bar-label">{{ linea.etiqueta }}</span>
                  </div>
                }
              </div>

              <div class="chart-legend">
                @for (linea of lineas(); track linea.linea) {
                  <span class="legend-item">
                    <span class="legend-dot" [style.--legend-color]="linea.color"></span>
                    {{ linea.etiqueta }} · {{ moneda(linea.total) }}
                  </span>
                }
              </div>
            } @else {
              <p class="text-llamma-muted mb-0 py-6">
                Aún no hay pedidos con partidas de producto para graficar.
              </p>
            }
          </article>
        </div>

        <div class="col-span-12 xl:col-span-4">
          <article class="panel-card h-full flex flex-col">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Taller</span>
                <h2>Estado de producción</h2>
              </div>
              <span class="badge badge-soft-warning">{{ data.ordenesEnProduccion }} activas</span>
            </div>

            <div class="production-donut" [style.background]="donutFondo()">
              <div class="donut-center">
                <strong>{{ data.ordenesEnProduccion }}</strong>
                <span>órdenes</span>
              </div>
            </div>

            <div class="stage-list">
              @for (etapa of etapas(); track etapa.etapa) {
                <div class="stage-row">
                  <span class="stage-dot dot-cyan"></span>
                  <span>{{ etapa.etiqueta }}</span>
                  <div class="stage-meter">
                    <span [style.width]="etapa.porcentaje + '%'"></span>
                  </div>
                  <strong>{{ etapa.total }}</strong>
                </div>
              } @empty {
                <p class="text-llamma-muted mb-0">El tablero está vacío: no hay órdenes activas.</p>
              }
            </div>

            <a class="panel-link mt-auto" routerLink="/produccion">
              Ver tablero de producción <i class="bi bi-arrow-right"></i>
            </a>
          </article>
        </div>
      </div>

      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 xl:col-span-7">
          <article class="panel-card h-full">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Últimos movimientos</span>
                <h2>Órdenes recientes</h2>
              </div>
              <a class="panel-link mt-0" routerLink="/detalle"
                >Ver todas <i class="bi bi-arrow-right"></i
              ></a>
            </div>

            <div class="table-responsive">
              <table class="table table-llamma align-middle">
                <caption class="sr-only">
                  Pedidos recientes
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Orden</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-right">Total</th>
                  </tr>
                </thead>
                <tbody>
                  @for (pedido of data.pedidosRecientes; track pedido.id) {
                    <tr>
                      <td>
                        <div class="order-id">#{{ pedido.folio }}</div>
                        <div class="cell-muted">{{ fechaCorta(pedido.fechaPedido) }}</div>
                      </td>
                      <td>
                        <div class="client-cell">
                          <span class="avatar avatar-cyan">{{ iniciales(pedido.cliente) }}</span>
                          <div>
                            <strong>{{ pedido.cliente || 'Mostrador' }}</strong>
                            <small>{{ pedido.prioridad }} prioridad</small>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span class="badge" [class]="claseEstado(pedido.estado)">{{
                          etiquetaEstado(pedido.estado)
                        }}</span>
                      </td>
                      <td class="text-right cell-main">{{ moneda(pedido.total) }}</td>
                    </tr>
                  } @empty {
                    <tr>
                      <td colspan="4" class="text-center text-llamma-muted py-6">
                        Todavía no hay pedidos registrados.
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </article>
        </div>

        <div class="col-span-12 xl:col-span-5">
          <article class="panel-card h-full flex flex-col">
            <div class="panel-head">
              <div>
                <span class="panel-kicker">Atención inmediata</span>
                <h2>Alertas de inventario</h2>
              </div>
              <span class="badge badge-soft-danger"
                >{{ data.materiasPrimasBajoStock }} críticas</span
              >
            </div>

            <div class="alert-list">
              @for (materia of data.bajoStock; track materia.id) {
                <div class="alert-row">
                  <span class="icon-tile icon-tile-danger"><i class="bi bi-box-seam"></i></span>
                  <div class="grow min-w-0">
                    <div class="flex items-center justify-between gap-2">
                      <strong>{{ materia.nombre }}</strong>
                      <span class="stock-text text-red-600">
                        {{ materia.stockActual }} / {{ materia.stockMinimo }}
                        {{ materia.unidadMedida }}
                      </span>
                    </div>
                    <div class="stock-track mt-2">
                      <span
                        class="stock-fill bg-red-600"
                        [style.width]="
                          porcentajeStock(materia.stockActual, materia.stockMaximo) + '%'
                        "
                      ></span>
                    </div>
                    <small
                      >Mínimo requerido: {{ materia.stockMinimo }} {{ materia.unidadMedida }}</small
                    >
                  </div>
                </div>
              } @empty {
                <p class="text-llamma-muted mb-0">Todo el inventario está por encima del mínimo.</p>
              }
            </div>

            <a class="panel-link mt-auto" routerLink="/abastecimiento">
              Generar orden de compra <i class="bi bi-arrow-right"></i>
            </a>
          </article>
        </div>
      </div>
    }
  </div>
</div>
</file>

<file path="src/app/llamma/detalle/detalle.component.css">
/* Ajustes visuales del detalle de órdenes. */

.order-switcher {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.order-switcher-label {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--llamma-muted);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
}

.order-switcher-label i {
  color: var(--llamma-magenta);
}

.order-switcher-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.order-pill {
  padding: 0.38rem 0.62rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.55rem;
  background: #fbfaf7;
  color: var(--llamma-carbon);
  font-family: var(--llamma-font-display);
  font-size: 0.68rem;
  font-weight: 700;
}

.order-pill span {
  display: block;
  margin-top: 0.12rem;
  color: var(--llamma-muted);
  font-family: var(--llamma-font-body);
  font-size: 0.56rem;
  font-weight: 600;
