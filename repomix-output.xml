from functools import wraps

from flask import current_app, g, jsonify, request

from extensions import db
from models import SesionUsuario, Usuario, utcnow


def hash_token(token: str) -> str:
    return hashlib.sha256(token.encode("utf-8")).hexdigest()


def crear_sesion(usuario: Usuario, req=None) -> str:
    """Crea una sesión persistida y devuelve el token en claro (solo una vez)."""
    req = req or request
    token = secrets.token_urlsafe(40)
    ahora = utcnow()
    sesion = SesionUsuario(
        usuario_id=usuario.id,
        token_hash=hash_token(token),
        ip=_ip_cliente(req),
        user_agent=(req.headers.get("User-Agent") or "")[:255],
        creado_en=ahora,
        ultimo_uso=ahora,
        expira_en=ahora + timedelta(hours=current_app.config["TOKEN_TTL_HOURS"]),
    )
    usuario.ultimo_acceso = ahora
    db.session.add(sesion)
    db.session.commit()
    return token


def _ip_cliente(req) -> str:
    forwarded = req.headers.get("X-Forwarded-For", "")
    if forwarded:
        return forwarded.split(",")[0].strip()[:64]
    return (req.remote_addr or "")[:64]


def revocar_sesion(sesion: SesionUsuario) -> None:
    sesion.revocado = True
    db.session.commit()


def _leer_token() -> str | None:
    """Solo acepta el token por cabecera.

    Aceptarlo por `?token=` lo filtraba a logs, historial y cabecera Referer.
    """
    encabezado = request.headers.get("Authorization", "")
    if encabezado.lower().startswith("bearer "):
        return encabezado[7:].strip()
    return request.headers.get("X-Auth-Token") or None


def sesion_actual() -> SesionUsuario | None:
    token = _leer_token()
    if not token:
        return None

    sesion = SesionUsuario.query.filter_by(token_hash=hash_token(token), revocado=False).first()
    if not sesion:
        return None
    if sesion.expira_en <= utcnow() or not sesion.usuario or not sesion.usuario.activo:
        return None

    # Refresca la marca de uso sin escribir en cada petición.
    if (utcnow() - sesion.ultimo_uso).total_seconds() > 300:
        sesion.ultimo_uso = utcnow()
        db.session.commit()
    return sesion


def token_required(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        sesion = sesion_actual()
        if not sesion:
            return jsonify({"error": "Sesión no válida o expirada", "codigo": "no_autorizado"}), 401
        g.sesion = sesion
        g.usuario = sesion.usuario
        return func(*args, **kwargs)

    return wrapper


def role_required(*roles: str):
    """Restringe el endpoint a uno o varios roles, además de exigir token."""

    def decorador(func):
        @wraps(func)
        @token_required
        def wrapper(*args, **kwargs):
            if g.usuario.rol is None or g.usuario.rol.nombre not in roles:
                return (
                    jsonify(
                        {
                            "error": "Tu rol no tiene acceso a esta operación",
                            "codigo": "prohibido",
                            "rolesPermitidos": list(roles),
                        }
                    ),
                    403,
                )
            return func(*args, **kwargs)

        return wrapper

    return decorador


def permiso_required(clave: str):
    def decorador(func):
        @wraps(func)
        @token_required
        def wrapper(*args, **kwargs):
            if clave not in g.usuario.permisos:
                return (
                    jsonify(
                        {
                            "error": f"Falta el permiso '{clave}'",
                            "codigo": "prohibido",
                        }
                    ),
                    403,
                )
            return func(*args, **kwargs)

        return wrapper

    return decorador
</file>

<file path="src/app/llamma/aviso-privacidad/aviso-privacidad.component.html">
<!--
  Documento base alineado a la LFPDPPP. Antes de publicar, validar el texto y
  los datos del responsable con asesoría legal.
-->
<div class="module-page legal-page">
  <div class="llamma-container">
    <a class="legal-back" routerLink="/"> <i class="bi bi-arrow-left"></i> Volver al inicio </a>

    <article class="panel-card">
      <span class="panel-kicker">Información legal</span>
      <h1>Aviso de privacidad</h1>
      <p class="legal-updated">Última actualización: {{ actualizado }}</p>

      <p>
        En {{ site.nombre }} nos importa que sepas qué hacemos con tus datos. Este aviso explica qué
        información recabamos cuando solicitas una cotización, consultas el estatus de tu solicitud
        o te comunicas con nuestro equipo.
      </p>

      <h2>1. Responsable de los datos</h2>
      <p>
        {{ site.nombre }}, imprenta y estudio de producción, es responsable del tratamiento de los
        datos personales que nos proporcionas a través de este sitio. Para cualquier asunto
        relacionado con tu información puedes escribir a
        <a [href]="'mailto:' + site.correo">{{ site.correo }}</a>.
      </p>

      <h2>2. Datos que recabamos</h2>
      <ul>
        <li>Datos de contacto: nombre, empresa, correo electrónico y teléfono.</li>
        <li>Datos de tu proyecto: productos, cantidades, especificaciones y fecha deseada.</li>
        <li>Archivos que adjuntas como referencia (PDF, AI, PSD, imágenes o ZIP).</li>
        <li>Mensajes que intercambias con nuestro equipo en el seguimiento de la solicitud.</li>
      </ul>
      <p>
        No solicitamos datos personales sensibles. Los campos marcados como obligatorios son
        necesarios para atender tu solicitud; sin ellos no podríamos cotizar tu proyecto.
      </p>

      <h2>3. Para qué usamos tus datos</h2>
      <ul>
        <li>Elaborar y enviarte tu cotización.</li>
        <li>Contactarte para aclarar detalles del proyecto y dar seguimiento a tu solicitud.</li>
        <li>Producir y entregar los materiales solicitados.</li>
        <li>Llevar el control interno de pedidos, pagos y atención al cliente.</li>
      </ul>
      <p>
        No usamos tus datos para publicidad de terceros ni los vendemos. Solo los compartimos con
        proveedores tecnológicos que nos ayudan a operar el sitio y el correo, bajo obligaciones de
        confidencialidad, o cuando una autoridad competente lo requiera.
      </p>

      <h2>4. Almacenamiento en tu navegador</h2>
      <p>
        Este sitio usa almacenamiento local del navegador para mantener la sesión del equipo
        interno, recordar tus consultas guardadas y conservar la sesión si marcas «Recordarme». No
        utilizamos cookies publicitarias ni de seguimiento entre sitios.
      </p>

      <h2>5. Conservación y seguridad</h2>
      <p>
        Conservamos tu información mientras exista una relación comercial o mientras sea necesaria
        para atender tu solicitud, salvo que la ley exija otro plazo. El acceso al sistema interno
        está restringido por roles y las sesiones del equipo expiran automáticamente.
      </p>

      <h2>6. Tus derechos</h2>
      <p>
        Puedes solicitar el acceso, rectificación, cancelación u oposición al tratamiento de tus
        datos escribiendo a
        <a [href]="'mailto:' + site.correo">{{ site.correo }}</a>, indicando tu nombre, el correo
        con el que registraste la solicitud y el folio correspondiente. Responderemos en los plazos
        que marca la legislación aplicable.
      </p>

      <h2>7. Cambios a este aviso</h2>
      <p>
        Si modificamos este aviso, publicaremos la versión actualizada en esta misma página con su
        fecha de actualización.
      </p>

      <hr />

      <p class="legal-foot">
        <i class="bi bi-envelope"></i>
        ¿Dudas sobre tu información?
        <a [href]="'mailto:' + site.correo">Escríbenos a {{ site.correo }}</a
        >.
      </p>
      <p class="legal-foot legal-copy">
        © {{ anio }} {{ site.nombre }}. Todos los derechos reservados.
      </p>
    </article>
  </div>
</div>
</file>

