  background: rgba(var(--llamma-yellow-rgb), 0.08);
}

.material-chip-accent i {
  color: var(--llamma-yellow);
}

/* Proceso */
.process-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.process-step {
  position: relative;
  padding: 1.35rem;
  overflow: hidden;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius);
  background: #fff;
  box-shadow: var(--llamma-shadow-sm);
}

.process-step > i {
  display: block;
  margin-bottom: 0.9rem;
  color: var(--llamma-magenta);
  font-size: 1.35rem;
}

.process-step h3 {
  margin-bottom: 0.4rem;
  font-size: 0.95rem;
}

.process-step p {
  margin: 0;
  color: var(--llamma-muted);
  font-size: 0.75rem;
  line-height: 1.55;
}

.process-number {
  position: absolute;
  top: 0.7rem;
  right: 0.9rem;
  font-family: var(--llamma-font-display);
  font-size: 1.8rem;
  font-weight: 700;
  color: rgba(26, 26, 26, 0.07);
}

/* CTA final */
.cta-section {
  padding: 0 0 5.5rem;
}

.cta-panel {
  position: relative;
  padding: clamp(2rem, 5vw, 4rem);
  overflow: hidden;
  border-radius: 2rem;
  background:
    linear-gradient(120deg, rgba(var(--llamma-cyan-rgb), 0.17), transparent 45%),
    linear-gradient(300deg, rgba(var(--llamma-magenta-rgb), 0.16), transparent 45%),
    var(--llamma-carbon);
  color: #fff;
}

.cta-panel h2 {
  max-width: 44rem;
  margin-bottom: 0.75rem;
  font-size: clamp(2rem, 3.6vw, 3.2rem);
  line-height: 1.02;
}

.cta-panel p {
  max-width: 36rem;
  margin-bottom: 0;
  color: rgba(255, 255, 255, 0.6);
}

.cta-ink {
  position: absolute;
  right: -0.08em;
  bottom: -0.48em;
  font-family: var(--llamma-font-display);
  font-size: clamp(6rem, 15vw, 13rem);
  font-weight: 700;
  letter-spacing: -0.08em;
  line-height: 1;
  color: rgba(255, 255, 255, 0.045);
  pointer-events: none;
}

