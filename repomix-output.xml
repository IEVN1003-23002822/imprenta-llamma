<file path="src/app/llamma/consultas/consultas.component.html">
<div class="module-page consultas-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div>
        <span class="eyebrow">Analítica operativa</span>
        <h1>Consultas inteligentes.</h1>
        <p class="page-lead">
          Cruza fechas, clientes, líneas y estados para encontrar cualquier pedido o movimiento en
          segundos. Guarda tus búsquedas más frecuentes.
        </p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <button
          class="btn btn-outline-ink"
          type="button"
          (click)="ui.info('Las consultas guardadas estarán disponibles en la siguiente versión.')"
        >
          <i class="bi bi-bookmark-plus"></i> Guardar consulta
        </button>
        <button class="btn btn-brand" type="button" (click)="exportar()">
          <i class="bi bi-download"></i> Exportar resultados
        </button>
      </div>
    </header>

    <section class="panel-card mb-4">
      <div class="panel-head">
        <div>
          <span class="panel-kicker">Constructor de consultas</span>
          <h2>Filtros combinables</h2>
        </div>
        <span class="badge badge-soft-muted">
          <i class="bi bi-funnel"></i> {{ resultado()?.total ?? 0 }} resultados
        </span>
      </div>

      <form [formGroup]="form" (ngSubmit)="cargar(1)">
        <div class="row g-3">
          <div class="col-md-6 col-xl-3">
            <label class="form-label" for="consultaDesde">Desde</label>
            <input id="consultaDesde" type="date" class="form-control" formControlName="desde" />
          </div>
          <div class="col-md-6 col-xl-3">
            <label class="form-label" for="consultaHasta">Hasta</label>
            <input id="consultaHasta" type="date" class="form-control" formControlName="hasta" />
          </div>
          <div class="col-md-6 col-xl-3">
            <label class="form-label" for="consultaCliente">Cliente</label>
            <select id="consultaCliente" class="form-select" formControlName="clienteId">
              <option value="">Todos los clientes</option>
              @for (cliente of clientes(); track cliente.id) {
                <option [value]="cliente.id">{{ cliente.nombre }}</option>
              }
            </select>
          </div>
          <div class="col-md-6 col-xl-3">
            <label class="form-label" for="consultaLinea">Línea de negocio</label>
            <select id="consultaLinea" class="form-select" formControlName="linea">
              @for (linea of lineas; track linea.valor) {
                <option [value]="linea.valor">{{ linea.etiqueta }}</option>
              }
            </select>
          </div>
          <div class="col-md-6 col-xl-3">
            <label class="form-label" for="consultaEstado">Estado del pedido</label>
            <select id="consultaEstado" class="form-select" formControlName="estado">
              @for (estado of estados; track estado.valor) {
                <option [value]="estado.valor">{{ estado.etiqueta }}</option>
              }
            </select>
          </div>
          <div class="col-md-12 col-xl-4">
            <label class="form-label" for="consultaTexto">Búsqueda libre</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input
                id="consultaTexto"
                type="search"
                class="form-control"
                placeholder="Orden, cliente, empresa o producto…"
                formControlName="q"
              />
            </div>
          </div>
          <div class="col-md-12 col-xl-2 d-flex align-items-end gap-2">
            <button class="btn btn-ink flex-grow-1" type="submit" [disabled]="cargando()">
              <i class="bi" [class]="cargando() ? 'bi-arrow-repeat spin' : 'bi-funnel-fill'"></i>
              {{ cargando() ? 'Buscando…' : 'Filtrar' }}
            </button>
            <button
              class="btn btn-soft"
              type="button"
              aria-label="Limpiar filtros"
              (click)="limpiar()"
            >
              <i class="bi bi-arrow-counterclockwise"></i>
            </button>
          </div>
        </div>
      </form>

      <div class="quick-filters">
        <span>Rangos rápidos</span>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === 'mes'"
          type="button"
          (click)="rango('mes')"
        >
          Este mes
        </button>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === '7d'"
          type="button"
          (click)="rango('7d')"
        >
          Últimos 7 días
        </button>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === '30d'"
          type="button"
          (click)="rango('30d')"
        >
          Últimos 30 días
        </button>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === 'trimestre'"
          type="button"
          (click)="rango('trimestre')"
        >
          Este trimestre
        </button>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === 'anio'"
          type="button"
          (click)="rango('anio')"
        >
          Año en curso
        </button>
      </div>
    </section>

    @if (error()) {
      <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="flex-grow-1">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar(pagina())">
          Reintentar
        </button>
      </div>
    }

    <div class="row g-3 mb-4">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-sm-6 col-xl-3">
          <div class="query-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div><strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span></div>
          </div>
        </div>
      }
    </div>

    <div class="row g-4">
      <div class="col-xl-8">
        <section class="panel-card h-100">
          <div class="panel-head flex-wrap">
            <div>
              <span class="panel-kicker">Resultados</span>
              <h2>Pedidos del periodo</h2>
            </div>
            <div class="d-flex align-items-center gap-2">
              <span class="badge badge-soft-success">{{ resultado()?.total ?? 0 }} registros</span>
              @if (cargando()) {
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
              }
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-llamma align-middle">
              <thead>
                <tr>
                  <th>Orden</th>
                  <th>Cliente</th>
                  <th>Línea</th>
                  <th>Estado</th>
                  <th class="text-end">Total</th>
                </tr>
              </thead>
              <tbody>
                @for (pedido of resultado()?.items ?? []; track pedido.id) {
                  <tr>
                    <td>
                      <a class="order-id" [routerLink]="['/detalle']" [queryParams]="{ pedido: pedido.id }">
                        #{{ pedido.folio }}
                      </a>
                      <div class="cell-muted">{{ fechaCorta(pedido.fechaPedido) }}</div>
                    </td>
                    <td>
                      <div class="cell-main">{{ pedido.cliente || 'Mostrador' }}</div>
                      <div class="cell-muted">{{ pedido.partidas }} partidas</div>
                    </td>
                    <td>
                      <div class="d-flex flex-wrap gap-1">
                        @for (linea of pedido.lineas; track linea) {
                          <span class="badge" [class]="claseLinea(linea)">{{ etiquetaLinea(linea) }}</span>
                        } @empty {
                          <span class="cell-muted">Sin línea</span>
                        }
                      </div>
                    </td>
                    <td>
                      <span class="badge" [class]="claseEstado(pedido.estado)">
                        {{ etiquetaEstado(pedido.estado) }}
                      </span>
                    </td>
                    <td class="text-end cell-main">{{ moneda(pedido.total) }}</td>
                  </tr>
                } @empty {
                  <tr>
                    <td colspan="5" class="text-center text-muted py-5">
                      <i class="bi bi-search d-block fs-4 mb-2"></i>
                      No encontramos pedidos con esos filtros.
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            @if (resultado(); as data) {
              <span>{{ rangoTexto(data) }}</span>
              <nav aria-label="Paginación de consultas">
                <ul class="pagination pagination-sm mb-0">
                  <li class="page-item" [class.disabled]="data.pagina <= 1">
                    <button class="page-link" type="button" aria-label="Anterior" (click)="cargar(data.pagina - 1)">
                      <i class="bi bi-chevron-left"></i>
                    </button>
                  </li>
                  @for (numero of paginas(); track numero) {
                    <li class="page-item" [class.active]="numero === data.pagina">
                      <button class="page-link" type="button" (click)="cargar(numero)">{{ numero }}</button>
                    </li>
                  }
                  <li class="page-item" [class.disabled]="data.pagina >= data.paginas">
                    <button class="page-link" type="button" aria-label="Siguiente" (click)="cargar(data.pagina + 1)">
                      <i class="bi bi-chevron-right"></i>
                    </button>
                  </li>
                </ul>
              </nav>
            } @else {
              <span>Sin resultados</span>
            }
          </div>
        </section>
      </div>

      <div class="col-xl-4">
        <section class="panel-card mb-4">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Composición</span>
              <h2>Ventas por línea</h2>
            </div>
            <span class="badge badge-soft-muted">Periodo</span>
          </div>

          <div class="distribution">
            @for (fila of distribucion(); track fila.linea) {
              <div class="distribution-row">
                <div class="distribution-top">
                  <span>{{ fila.etiqueta }}</span><strong>{{ moneda(fila.total) }}</strong>
                </div>
                <div class="distribution-track">
                  <span [class]="fila.clase" [style.width]="fila.porcentaje + '%'"></span>
                </div>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">
                Sin partidas de producto en el periodo seleccionado.
              </p>
            }
          </div>
        </section>

        <section class="panel-card">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Ranking</span>
              <h2>Top clientes del periodo</h2>
            </div>
            <a class="panel-link mt-0" routerLink="/clientes">Ver todos <i class="bi bi-arrow-right"></i></a>
          </div>

          <div class="rank-list">
            @for (cliente of resultado()?.topClientes ?? []; track cliente.id; let i = $index) {
              <div class="rank-item">
                <span class="rank-number">{{ (i + 1).toString().padStart(2, '0') }}</span>
                <span class="avatar" [class]="'avatar ' + avatar(i)">{{ iniciales(cliente.nombre) }}</span>
                <div class="flex-grow-1 min-w-0">
                  <strong>{{ cliente.nombre }}</strong>
                  <small>{{ cliente.pedidos }} pedidos</small>
                </div>
                <strong class="rank-amount">{{ moneda(cliente.total) }}</strong>
              </div>
            } @empty {
              <p class="text-muted mb-0 small">Aún no hay clientes con pedidos en el periodo.</p>
            }
          </div>

          <div class="quote-note">
            <i class="bi bi-lightbulb"></i>
            <span>Filtra por rango de fechas y línea para analizar el desempeño comercial.</span>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>
</file>

<file path="src/app/llamma/consultas/consultas.component.ts">
import { ChangeDetectionStrategy, Component, OnInit, computed, inject, signal } from '@angular/core';
import { FormBuilder, ReactiveFormsModule } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { finalize } from 'rxjs';

import { ClienteApi, ConsultaPedidosApi, LineaProduccion } from '../llamma.models';
import { LlammaService } from '../llamma.service';
import { UiService } from '../ui.service';

const LINEAS: { valor: LineaProduccion | ''; etiqueta: string }[] = [
  { valor: '', etiqueta: 'Todas las líneas' },
  { valor: 'gran-formato', etiqueta: 'Gran formato' },
  { valor: 'textil', etiqueta: 'Textil' },
  { valor: 'promocionales', etiqueta: 'Promocionales' },
  { valor: 'papeleria', etiqueta: 'Papelería' },
];

const ESTADOS = [
  { valor: '', etiqueta: 'Todo estado' },
  { valor: 'confirmado', etiqueta: 'Confirmado' },
  { valor: 'en-produccion', etiqueta: 'En producción' },
  { valor: 'listo', etiqueta: 'Listo' },
  { valor: 'entregado', etiqueta: 'Entregado' },
  { valor: 'cancelado', etiqueta: 'Cancelado' },
];

const COLORES_LINEA: Record<string, string> = {
  'gran-formato': 'fill-cyan',
  textil: 'fill-magenta',
  promocionales: 'fill-yellow',
  papeleria: 'fill-ink',
};

const ETIQUETAS_LINEA: Record<string, string> = {
  'gran-formato': 'Gran formato',
  textil: 'Textil',
  promocionales: 'Promocionales',
  papeleria: 'Papelería',
};

@Component({
  selector: 'app-consultas',
  imports: [ReactiveFormsModule, RouterLink],
  templateUrl: './consultas.component.html',
  styleUrl: './consultas.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class ConsultasComponent implements OnInit {
  private readonly service = inject(LlammaService);
  readonly ui = inject(UiService);
  private readonly fb = inject(FormBuilder);

  readonly lineas = LINEAS;
  readonly estados = ESTADOS;
  readonly clientes = signal<ClienteApi[]>([]);
  readonly resultado = signal<ConsultaPedidosApi | null>(null);
  readonly cargando = signal(false);
  readonly error = signal<string | null>(null);
  readonly rangoActivo = signal('mes');
  readonly pagina = signal(1);

  readonly form = this.fb.nonNullable.group({
    desde: [this.primerDiaMes()],
    hasta: [this.hoy()],
    clienteId: [''],
    linea: [''],
    estado: [''],
    q: [''],
  });

  readonly estadisticas = computed(() => {
    const resumen = this.resultado()?.resumen;
    return [
      {
        icono: 'bi-receipt-cutoff',
        tono: 'icon-tile-cyan',
        valor: String(resumen?.pedidos ?? 0),
        etiqueta: 'Pedidos encontrados',
      },
      {
        icono: 'bi-cash-stack',
        tono: 'icon-tile-magenta',
        valor: this.moneda(resumen?.monto ?? 0),
        etiqueta: 'Monto consultado',
      },
      {
        icono: 'bi-bar-chart',
        tono: 'icon-tile-yellow',
        valor: this.moneda(resumen?.ticket ?? 0),
        etiqueta: 'Ticket promedio',
      },
      {
        icono: 'bi-check2-circle',
        tono: 'icon-tile-success',
        valor: String(resumen?.entregados ?? 0),
        etiqueta: 'Pedidos entregados',
      },
    ];
  });

  readonly distribucion = computed(() => {
    const filas = this.resultado()?.ventasPorLinea ?? [];
    const maximo = Math.max(1, ...filas.map((fila) => fila.total));
    return filas.map((fila) => ({
      ...fila,
      etiqueta: ETIQUETAS_LINEA[fila.linea] ?? fila.linea,
      clase: COLORES_LINEA[fila.linea] ?? 'fill-ink',
      porcentaje: Math.max(6, Math.round((fila.total / maximo) * 100)),
    }));
  });

  readonly paginas = computed(() => {
    const total = this.resultado()?.paginas ?? 0;
    const actual = this.resultado()?.pagina ?? 1;
    const desde = Math.max(1, actual - 2);
    const hasta = Math.min(total, desde + 4);
    return Array.from({ length: Math.max(0, hasta - desde + 1) }, (_, i) => desde + i);
  });

  ngOnInit(): void {
    this.cargarClientes();
    this.cargar(1);
  }

  private cargarClientes(): void {
    this.service.listarClientes({ page: 1, perPage: 100 }).subscribe({
      next: (respuesta) => this.clientes.set(respuesta.items),
      error: () => this.clientes.set([]),
    });
  }

  cargar(page = 1): void {
    this.cargando.set(true);
    this.error.set(null);
    const valores = this.form.getRawValue();
    this.service
      .consultarPedidos({
        q: valores.q.trim() || undefined,
        estado: valores.estado || undefined,
        linea: valores.linea || undefined,
        clienteId: valores.clienteId ? Number(valores.clienteId) : undefined,
        desde: valores.desde || undefined,
        hasta: valores.hasta || undefined,
        page,
        perPage: 10,
      })
      .pipe(finalize(() => this.cargando.set(false)))
      .subscribe({
        next: (respuesta) => {
          this.resultado.set(respuesta);
          this.pagina.set(respuesta.pagina);
        },
        error: (error) => {
          this.error.set(this.ui.mensajeDeError(error, 'No pudimos ejecutar la consulta.'));
        },
      });
  }

  limpiar(): void {
    this.form.reset({
      desde: this.primerDiaMes(),
      hasta: this.hoy(),
      clienteId: '',
      linea: '',
      estado: '',
      q: '',
    });
    this.rangoActivo.set('mes');
    this.cargar(1);
  }

  rango(clave: string): void {
    const hoy = new Date();
    const hasta = this.hoy();
    let desde = this.primerDiaMes();

    if (clave === '7d') {
      const fecha = new Date(hoy);
      fecha.setDate(fecha.getDate() - 7);
      desde = this.iso(fecha);
    } else if (clave === '30d') {
      const fecha = new Date(hoy);
      fecha.setDate(fecha.getDate() - 30);
      desde = this.iso(fecha);
    } else if (clave === 'trimestre') {
      const mes = Math.floor(hoy.getMonth() / 3) * 3;
      desde = this.iso(new Date(hoy.getFullYear(), mes, 1));
    } else if (clave === 'anio') {
      desde = this.iso(new Date(hoy.getFullYear(), 0, 1));
    }

    this.rangoActivo.set(clave);
    this.form.patchValue({ desde, hasta });
    this.cargar(1);
  }

  exportar(): void {
    const resultado = this.resultado();
    if (!resultado?.items.length) {
      this.ui.info('No hay resultados para exportar.');
      return;
    }

    const filas = [
      ['Folio', 'Fecha', 'Cliente', 'Líneas', 'Estado', 'Total'],
      ...resultado.items.map((pedido) => [
        pedido.folio,
        pedido.fechaPedido,
        pedido.cliente ?? '',
        pedido.lineas.map((linea) => ETIQUETAS_LINEA[linea] ?? linea).join(' / '),
        this.etiquetaEstado(pedido.estado),
        String(pedido.total),
      ]),
    ];
    const csv = filas.map((fila) => fila.map((celda) => `"${celda}"`).join(',')).join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    const enlace = document.createElement('a');
    enlace.href = url;
    enlace.download = `consultas-llamma-${this.hoy()}.csv`;
    enlace.click();
    URL.revokeObjectURL(url);
    this.ui.exito('Resultados exportados en CSV.');
  }

  claseEstado(estado: string): string {
    const mapa: Record<string, string> = {
      cotizacion: 'badge-soft-cyan',
      confirmado: 'badge-soft-warning',
      'en-produccion': 'badge-soft-cyan',
      listo: 'badge-soft-success',
      entregado: 'badge-soft-success',
      cancelado: 'badge-soft-danger',
    };
    return mapa[estado] ?? 'badge-soft-cyan';
  }

  etiquetaEstado(estado: string): string {
    return estado.replace(/-/g, ' ').replace(/^\w/, (letra) => letra.toUpperCase());
  }

  claseLinea(linea: string): string {
    const mapa: Record<string, string> = {
      'gran-formato': 'badge-soft-cyan',
      textil: 'badge-soft-magenta',
      promocionales: 'badge-soft-yellow',
      papeleria: 'badge-soft-muted',
    };
    return mapa[linea] ?? 'badge-soft-muted';
  }

  etiquetaLinea(linea: string): string {
    return ETIQUETAS_LINEA[linea] ?? linea;
  }

  iniciales(nombre: string): string {
    return nombre
      .split(' ')
      .filter(Boolean)
      .slice(0, 2)
      .map((parte) => parte[0])
      .join('')
      .toUpperCase();
  }

  avatar(indice: number): string {
    return ['avatar-cyan', 'avatar-magenta', 'avatar-yellow', 'avatar-ink'][indice % 4];
  }

  moneda(valor: number | null | undefined): string {
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0,
    }).format(Number(valor ?? 0));
  }

  rangoTexto(data: ConsultaPedidosApi): string {
    const inicio = data.total ? (data.pagina - 1) * data.porPagina + 1 : 0;
    const fin = Math.min(data.pagina * data.porPagina, data.total);
    return `Mostrando ${inicio}–${fin} de ${data.total} resultados`;
  }

  fechaCorta(valor: string | null | undefined): string {    if (!valor) return 'Sin fecha';
    const fecha = new Date(valor.length > 10 ? valor : `${valor}T00:00:00`);
    if (Number.isNaN(fecha.getTime())) return 'Sin fecha';
    return fecha.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  private hoy(): string {
    return this.iso(new Date());
  }

  private primerDiaMes(): string {
    const hoy = new Date();
    return this.iso(new Date(hoy.getFullYear(), hoy.getMonth(), 1));
  }

  private iso(fecha: Date): string {
    return fecha.toISOString().slice(0, 10);
  }
}
