          <div class="modal-body">
            <div class="grid grid-cols-12 gap-4">
              <div class="col-span-12 md:col-span-6">
                <label class="form-label" for="clienteNombre">Nombre o razón social *</label>
                <input id="clienteNombre" class="form-control" formControlName="nombre" />
                @if (formulario.controls.nombre.invalid && formulario.controls.nombre.touched) {
                  <small class="text-red-600">Indica al menos dos caracteres.</small>
                }
              </div>
              <div class="col-span-12 md:col-span-6">
                <label class="form-label" for="clienteEmpresa">Empresa</label>
                <input id="clienteEmpresa" class="form-control" formControlName="empresa" />
              </div>
              <div class="col-span-12 md:col-span-6">
                <label class="form-label" for="clienteCorreo">Correo *</label>
                <input
                  id="clienteCorreo"
                  type="email"
                  class="form-control"
                  formControlName="correo"
                />
                @if (formulario.controls.correo.invalid && formulario.controls.correo.touched) {
                  <small class="text-red-600">Captura un correo válido.</small>
                }
              </div>
              <div class="col-span-12 md:col-span-6">
                <label class="form-label" for="clienteTelefono">Teléfono</label>
                <input id="clienteTelefono" class="form-control" formControlName="telefono" />
              </div>
              <div class="col-span-12 md:col-span-6">
                <label class="form-label" for="clienteRfc">RFC</label>
                <input id="clienteRfc" class="form-control" formControlName="rfc" maxlength="20" />
              </div>
              <div class="col-span-12 md:col-span-6">
                <label class="form-label" for="clienteSegmento">Segmento</label>
                <select id="clienteSegmento" class="form-select" formControlName="segmento">
                  @for (segmento of segmentos; track segmento.valor) {
                    <option [value]="segmento.valor">{{ segmento.etiqueta }}</option>
                  }
                </select>
              </div>
              <div class="col-span-12">
                <label class="form-label" for="clienteDireccion">Dirección</label>
                <input id="clienteDireccion" class="form-control" formControlName="direccion" />
              </div>
              <div class="col-span-12">
                <label class="form-label" for="clienteNotas">Notas</label>
                <textarea
                  id="clienteNotas"
                  class="form-control"
                  rows="3"
                  formControlName="notas"
                ></textarea>
              </div>
              <div class="col-span-12">
                <div class="form-check form-switch">
                  <input
                    id="clienteActivo"
                    class="form-check-input"
                    type="checkbox"
                    formControlName="activo"
                  />
                  <label class="form-check-label" for="clienteActivo">Cliente activo</label>
                </div>
              </div>
            </div>
          </div>

          <div class="modal-footer">
            <button class="btn btn-outline-ink" type="button" (click)="cerrarFormulario()">
              Cancelar
            </button>
            <button class="btn btn-brand" type="submit" [disabled]="guardando()">
              <i class="bi" [class]="guardando() ? 'bi-arrow-repeat spin' : 'bi-check2'"></i>
              {{ guardando() ? 'Guardando…' : 'Guardar cliente' }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}
</file>

<file path="src/app/llamma/consultas/consultas.component.html">
<div class="module-page consultas-page">
  <div class="llamma-container">
    <header class="page-header flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Analítica operativa</span>
        <h1>Consultas inteligentes.</h1>
        <p class="page-lead">
          Cruza fechas, clientes, líneas y estados para encontrar cualquier pedido o movimiento en
          segundos. Guarda tus búsquedas más frecuentes.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button class="btn btn-outline-ink" type="button" (click)="guardarConsulta()">
          <i class="bi bi-bookmark-plus"></i> Guardar consulta
        </button>
        <div class="dropdown">
          <button
            class="btn btn-outline-ink dropdown-toggle"
            type="button"
            (click)="alternarGuardadas($event)"
            [attr.aria-expanded]="menuGuardadas()"
            [disabled]="!consultasGuardadas().length"
          >
            <i class="bi bi-bookmarks"></i> Guardadas
            @if (consultasGuardadas().length) {
              <span class="badge badge-soft-muted ms-1">{{ consultasGuardadas().length }}</span>
            }
          </button>
          <ul
            class="dropdown-menu dropdown-menu-end dropdown-menu-llamma"
            [class.show]="menuGuardadas()"
          >
            @for (consulta of consultasGuardadas(); track consulta.id) {
              <li class="flex items-center gap-1 pe-1">
                <button
                  class="dropdown-item truncate"
                  type="button"
                  [title]="consulta.nombre"
                  (click)="aplicarConsulta(consulta)"
                >
                  {{ consulta.nombre }}
                </button>
                <button
                  class="btn btn-icon btn-icon-xs"
                  type="button"
                  aria-label="Eliminar consulta"
                  title="Eliminar consulta"
                  (click)="eliminarConsulta(consulta, $event)"
                >
                  <i class="bi bi-x-lg"></i>
                </button>
              </li>
            }
          </ul>
        </div>
        <button class="btn btn-brand" type="button" (click)="exportar()">
          <i class="bi bi-download"></i> Exportar resultados
        </button>
      </div>
    </header>

    <section class="panel-card mb-6">
      <div class="panel-head">
        <div>
          <span class="panel-kicker">Constructor de consultas</span>
          <h2>Filtros combinables</h2>
        </div>
        <span class="badge badge-soft-muted">
          <i class="bi bi-funnel"></i> {{ resultado()?.total ?? 0 }} resultados
        </span>
      </div>

      <form [formGroup]="form" (ngSubmit)="cargar(1)">
        <div class="grid grid-cols-12 gap-4">
          <div class="col-span-12 md:col-span-6 xl:col-span-3">
            <label class="form-label" for="consultaDesde">Desde</label>
            <input id="consultaDesde" type="date" class="form-control" formControlName="desde" />
          </div>
          <div class="col-span-12 md:col-span-6 xl:col-span-3">
            <label class="form-label" for="consultaHasta">Hasta</label>
            <input id="consultaHasta" type="date" class="form-control" formControlName="hasta" />
          </div>
          <div class="col-span-12 md:col-span-6 xl:col-span-3">
            <label class="form-label" for="consultaCliente">Cliente</label>
            <select id="consultaCliente" class="form-select" formControlName="clienteId">
              <option value="">Todos los clientes</option>
              @for (cliente of clientes(); track cliente.id) {
                <option [value]="cliente.id">{{ cliente.nombre }}</option>
              }
            </select>
          </div>
          <div class="col-span-12 md:col-span-6 xl:col-span-3">
            <label class="form-label" for="consultaLinea">Línea de negocio</label>
            <select id="consultaLinea" class="form-select" formControlName="linea">
              @for (linea of lineas; track linea.valor) {
                <option [value]="linea.valor">{{ linea.etiqueta }}</option>
              }
            </select>
          </div>
          <div class="col-span-12 md:col-span-6 xl:col-span-3">
            <label class="form-label" for="consultaEstado">Estado del pedido</label>
            <select id="consultaEstado" class="form-select" formControlName="estado">
              @for (estado of estados; track estado.valor) {
                <option [value]="estado.valor">{{ estado.etiqueta }}</option>
              }
            </select>
          </div>
          <div class="col-span-12 md:col-span-12 xl:col-span-4">
            <label class="form-label" for="consultaTexto">Búsqueda libre</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input
                id="consultaTexto"
                type="search"
                class="form-control"
                placeholder="Orden, cliente, empresa o producto…"
                formControlName="q"
              />
            </div>
          </div>
          <div class="col-span-12 md:col-span-12 xl:col-span-2 flex items-end gap-2">
            <button class="btn btn-ink grow" type="submit" [disabled]="cargando()">
              <i class="bi" [class]="cargando() ? 'bi-arrow-repeat spin' : 'bi-funnel-fill'"></i>
              {{ cargando() ? 'Buscando…' : 'Filtrar' }}
            </button>
            <button
              class="btn btn-soft"
              type="button"
              aria-label="Limpiar filtros"
              (click)="limpiar()"
            >
              <i class="bi bi-arrow-counterclockwise"></i>
            </button>
          </div>
        </div>
      </form>

      <div class="quick-filters">
        <span>Rangos rápidos</span>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === 'mes'"
          type="button"
          (click)="rango('mes')"
        >
          Este mes
        </button>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === '7d'"
          type="button"
          (click)="rango('7d')"
        >
          Últimos 7 días
        </button>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === '30d'"
          type="button"
          (click)="rango('30d')"
        >
          Últimos 30 días
        </button>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === 'trimestre'"
          type="button"
          (click)="rango('trimestre')"
        >
          Este trimestre
        </button>
        <button
          class="filter-chip"
          [class.is-active]="rangoActivo() === 'anio'"
          type="button"
          (click)="rango('anio')"
        >
          Año en curso
        </button>
      </div>
    </section>

    @if (error()) {
      <div class="alert alert-danger flex items-center gap-2" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i>
        <span class="grow">{{ error() }}</span>
        <button class="btn btn-sm btn-outline-dark" type="button" (click)="cargar(pagina())">
          Reintentar
        </button>
      </div>
    }

    <div class="grid grid-cols-12 gap-4 mb-6">
      @for (stat of estadisticas(); track stat.etiqueta) {
        <div class="col-span-12 sm:col-span-6 xl:col-span-3">
          <div class="query-stat">
            <span class="icon-tile" [class]="'icon-tile ' + stat.tono">
              <i class="bi" [class]="'bi ' + stat.icono"></i>
            </span>
            <div>
              <strong>{{ stat.valor }}</strong><span>{{ stat.etiqueta }}</span>
            </div>
          </div>
        </div>
      }
    </div>

    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 xl:col-span-8">
        <section class="panel-card h-full">
          <div class="panel-head flex-wrap">
            <div>
              <span class="panel-kicker">Resultados</span>
              <h2>Pedidos del periodo</h2>
            </div>
            <div class="flex items-center gap-2">
              <span class="badge badge-soft-success">{{ resultado()?.total ?? 0 }} registros</span>
              @if (cargando()) {
                <span
                  class="spinner-border spinner-border-sm text-llamma-cyan-deep"
                  aria-hidden="true"
                ></span>
              }
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-llamma align-middle">
              <caption class="sr-only">
                Resultados de la consulta
              </caption>
              <thead>
                <tr>
                  <th scope="col">Orden</th>
                  <th scope="col">Cliente</th>
                  <th scope="col">Línea</th>
                  <th scope="col">Estado</th>
                  <th scope="col" class="text-right">Total</th>
                </tr>
              </thead>
              <tbody>
                @for (pedido of resultado()?.items ?? []; track pedido.id) {
                  <tr>
                    <td>
                      <a
                        class="order-id"
                        [routerLink]="['/detalle']"
                        [queryParams]="{ pedido: pedido.id }"
                      >
                        #{{ pedido.folio }}
                      </a>
                      <div class="cell-muted">{{ fechaCorta(pedido.fechaPedido) }}</div>
                    </td>
                    <td>
                      <div class="cell-main">{{ pedido.cliente || 'Mostrador' }}</div>
                      <div class="cell-muted">{{ pedido.partidas }} partidas</div>
                    </td>
                    <td>
                      <div class="flex flex-wrap gap-1">
                        @for (linea of pedido.lineas; track linea) {
                          <span class="badge" [class]="claseLinea(linea)">{{
                            etiquetaLinea(linea)
                          }}</span>
                        } @empty {
                          <span class="cell-muted">Sin línea</span>
                        }
                      </div>
                    </td>
                    <td>
                      <span class="badge" [class]="claseEstado(pedido.estado)">
                        {{ etiquetaEstado(pedido.estado) }}
                      </span>
                    </td>
                    <td class="text-right cell-main">{{ moneda(pedido.total) }}</td>
                  </tr>
                } @empty {
                  <tr>
                    <td colspan="5" class="text-center text-llamma-muted py-12">
                      <i class="bi bi-search block text-2xl mb-2"></i>
                      No encontramos pedidos con esos filtros.
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="table-footer">
            @if (resultado(); as data) {
              <span>{{ rangoTexto(data) }}</span>
              <nav aria-label="Paginación de consultas">
                <ul class="pagination pagination-sm mb-0">
                  <li class="page-item" [class.disabled]="data.pagina <= 1">
                    <button
                      class="page-link"
                      type="button"
                      aria-label="Anterior"
                      (click)="cargar(data.pagina - 1)"
                    >
                      <i class="bi bi-chevron-left"></i>
                    </button>
                  </li>
                  @for (numero of paginas(); track numero) {
                    <li class="page-item" [class.active]="numero === data.pagina">
                      <button class="page-link" type="button" (click)="cargar(numero)">
                        {{ numero }}
                      </button>
                    </li>
                  }
                  <li class="page-item" [class.disabled]="data.pagina >= data.paginas">
                    <button
                      class="page-link"
                      type="button"
                      aria-label="Siguiente"
                      (click)="cargar(data.pagina + 1)"
                    >
                      <i class="bi bi-chevron-right"></i>
                    </button>
                  </li>
                </ul>
              </nav>
            } @else {
              <span>Sin resultados</span>
            }
          </div>
        </section>
      </div>

      <div class="col-span-12 xl:col-span-4">
        <section class="panel-card mb-6">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Composición</span>
              <h2>Ventas por línea</h2>
            </div>
            <span class="badge badge-soft-muted">Periodo</span>
          </div>

          <div class="distribution">
            @for (fila of distribucion(); track fila.linea) {
              <div class="distribution-row">
                <div class="distribution-top">
                  <span>{{ fila.etiqueta }}</span><strong>{{ moneda(fila.total) }}</strong>
                </div>
                <div class="distribution-track">
                  <span [class]="fila.clase" [style.width]="fila.porcentaje + '%'"></span>
                </div>
              </div>
            } @empty {
              <p class="text-llamma-muted mb-0 small">
                Sin partidas de producto en el periodo seleccionado.
              </p>
            }
          </div>
        </section>

        <section class="panel-card">
          <div class="panel-head">
            <div>
              <span class="panel-kicker">Ranking</span>
              <h2>Top clientes del periodo</h2>
            </div>
            <a class="panel-link mt-0" routerLink="/clientes"
              >Ver todos <i class="bi bi-arrow-right"></i
            ></a>
          </div>

          <div class="rank-list">
            @for (cliente of resultado()?.topClientes ?? []; track cliente.id; let i = $index) {
              <div class="rank-item">
                <span class="rank-number">{{ (i + 1).toString().padStart(2, '0') }}</span>
                <span class="avatar" [class]="'avatar ' + avatar(i)">{{
                  iniciales(cliente.nombre)
                }}</span>
                <div class="grow min-w-0">
                  <strong>{{ cliente.nombre }}</strong>
                  <small>{{ cliente.pedidos }} pedidos</small>
                </div>
                <strong class="rank-amount">{{ moneda(cliente.total) }}</strong>
              </div>
            } @empty {
              <p class="text-llamma-muted mb-0 small">
                Aún no hay clientes con pedidos en el periodo.
              </p>
            }
          </div>

          <div class="quote-note">
            <i class="bi bi-lightbulb"></i>
            <span>Filtra por rango de fechas y línea para analizar el desempeño comercial.</span>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>
</file>

<file path="src/app/llamma/consultas/consultas.component.ts">
import {
  ChangeDetectionStrategy,
  Component,
  HostListener,
  OnInit,
  computed,
  inject,
  signal,
} from '@angular/core';
import { FormBuilder, ReactiveFormsModule } from '@angular/forms';
import { RouterLink } from '@angular/router';
import { finalize } from 'rxjs';

import { ESTADOS_PEDIDO, LINEAS_PRODUCCION, etiquetaDe } from '../estados';
import { ClienteApi, ConsultaPedidosApi, LineaProduccion } from '../llamma.models';
import { LlammaService } from '../llamma.service';
import { UiService } from '../ui.service';

const LINEAS: { valor: LineaProduccion | ''; etiqueta: string }[] = [
  { valor: '', etiqueta: 'Todas las líneas' },
  ...LINEAS_PRODUCCION,
];

const ESTADOS = [
  { valor: '', etiqueta: 'Todo estado' },
  ...ESTADOS_PEDIDO.filter((estado) => estado.valor !== 'cotizacion'),
];

const COLORES_LINEA: Record<string, string> = {
  'gran-formato': 'fill-cyan',
  textil: 'fill-magenta',
  promocionales: 'fill-yellow',
  papeleria: 'fill-ink',
};

const CONSULTAS_KEY = 'llamma.consultas.v1';
const MAX_CONSULTAS = 12;

interface FiltrosConsulta {
  desde: string;
  hasta: string;
  clienteId: string;
  linea: string;
  estado: string;
  q: string;
}

interface ConsultaGuardada {
  id: string;
  nombre: string;
  filtros: FiltrosConsulta;
}

@Component({
  selector: 'app-consultas',
  imports: [ReactiveFormsModule, RouterLink],
  templateUrl: './consultas.component.html',
  styleUrl: './consultas.component.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class ConsultasComponent implements OnInit {
  private readonly service = inject(LlammaService);
  readonly ui = inject(UiService);
  private readonly fb = inject(FormBuilder);

  readonly lineas = LINEAS;
  readonly estados = ESTADOS;
  readonly clientes = signal<ClienteApi[]>([]);
  readonly resultado = signal<ConsultaPedidosApi | null>(null);
  readonly cargando = signal(false);
  readonly error = signal<string | null>(null);
  readonly rangoActivo = signal('mes');
  readonly pagina = signal(1);
  readonly consultasGuardadas = signal<ConsultaGuardada[]>(this.leerConsultas());
  readonly menuGuardadas = signal(false);

  readonly form = this.fb.nonNullable.group({
    desde: [this.primerDiaMes()],
    hasta: [this.hoy()],
    clienteId: [''],
    linea: [''],
    estado: [''],
    q: [''],
  });

  readonly estadisticas = computed(() => {
    const resumen = this.resultado()?.resumen;
    return [
      {
        icono: 'bi-receipt-cutoff',
        tono: 'icon-tile-cyan',
        valor: String(resumen?.pedidos ?? 0),
        etiqueta: 'Pedidos encontrados',
      },
      {
        icono: 'bi-cash-stack',
        tono: 'icon-tile-magenta',
        valor: this.moneda(resumen?.monto ?? 0),
        etiqueta: 'Monto consultado',
      },
      {
        icono: 'bi-bar-chart',
        tono: 'icon-tile-yellow',
        valor: this.moneda(resumen?.ticket ?? 0),
        etiqueta: 'Ticket promedio',
      },
      {
        icono: 'bi-check2-circle',
        tono: 'icon-tile-success',
        valor: String(resumen?.entregados ?? 0),
        etiqueta: 'Pedidos entregados',
      },
    ];
  });

  readonly distribucion = computed(() => {
    const filas = this.resultado()?.ventasPorLinea ?? [];
    const maximo = Math.max(1, ...filas.map((fila) => fila.total));
    return filas.map((fila) => ({
      ...fila,
      etiqueta: etiquetaDe(LINEAS_PRODUCCION, fila.linea),
      clase: COLORES_LINEA[fila.linea] ?? 'fill-ink',
      porcentaje: Math.max(6, Math.round((fila.total / maximo) * 100)),
    }));
  });

  readonly paginas = computed(() => {
    const total = this.resultado()?.paginas ?? 0;
    const actual = this.resultado()?.pagina ?? 1;
    const desde = Math.max(1, actual - 2);
    const hasta = Math.min(total, desde + 4);
    return Array.from({ length: Math.max(0, hasta - desde + 1) }, (_, i) => desde + i);
  });

  ngOnInit(): void {
    this.cargarClientes();
    this.cargar(1);
  }

  private cargarClientes(): void {
    this.service.listarClientes({ page: 1, perPage: 100 }).subscribe({
      next: (respuesta) => this.clientes.set(respuesta.items),
      error: () => this.clientes.set([]),
    });
  }

  cargar(page = 1): void {
    this.cargando.set(true);
    this.error.set(null);
    const valores = this.form.getRawValue();
    this.service
      .consultarPedidos({
        q: valores.q.trim() || undefined,
        estado: valores.estado || undefined,
        linea: valores.linea || undefined,
        clienteId: valores.clienteId ? Number(valores.clienteId) : undefined,
        desde: valores.desde || undefined,
        hasta: valores.hasta || undefined,
        page,
        perPage: 10,
      })
      .pipe(finalize(() => this.cargando.set(false)))
      .subscribe({
        next: (respuesta) => {
          this.resultado.set(respuesta);
          this.pagina.set(respuesta.pagina);
        },
        error: (error) => {
          this.error.set(this.ui.mensajeDeError(error, 'No pudimos ejecutar la consulta.'));
        },
      });
  }

  limpiar(): void {
    this.form.reset({
      desde: this.primerDiaMes(),
      hasta: this.hoy(),
      clienteId: '',
      linea: '',
      estado: '',
      q: '',
    });
    this.rangoActivo.set('mes');
    this.cargar(1);
  }

  rango(clave: string): void {
    const hoy = new Date();
    const hasta = this.hoy();
    let desde = this.primerDiaMes();

    if (clave === '7d') {
      const fecha = new Date(hoy);
      fecha.setDate(fecha.getDate() - 7);
      desde = this.iso(fecha);
    } else if (clave === '30d') {
      const fecha = new Date(hoy);
      fecha.setDate(fecha.getDate() - 30);
      desde = this.iso(fecha);
    } else if (clave === 'trimestre') {
      const mes = Math.floor(hoy.getMonth() / 3) * 3;
      desde = this.iso(new Date(hoy.getFullYear(), mes, 1));
    } else if (clave === 'anio') {
      desde = this.iso(new Date(hoy.getFullYear(), 0, 1));
    }

    this.rangoActivo.set(clave);
    this.form.patchValue({ desde, hasta });
    this.cargar(1);
  }

  guardarConsulta(): void {
    const filtros: FiltrosConsulta = this.form.getRawValue();
    const actuales = this.consultasGuardadas();
    const yaExiste = actuales.some(
      (consulta) => JSON.stringify(consulta.filtros) === JSON.stringify(filtros),
    );
    if (yaExiste) {
      this.ui.info('Esa combinación de filtros ya está guardada.');
      return;
    }

    const consulta: ConsultaGuardada = {
      id: `${Date.now()}`,
      nombre: this.nombreConsulta(filtros),
      filtros,
    };
    this.escribirConsultas([consulta, ...actuales].slice(0, MAX_CONSULTAS));
    this.ui.exito(`Consulta guardada: ${consulta.nombre}.`);
  }

  aplicarConsulta(consulta: ConsultaGuardada): void {
    this.form.reset({ ...consulta.filtros });
    this.rangoActivo.set('personalizado');
    this.menuGuardadas.set(false);
    this.cargar(1);
    this.ui.exito(`Consulta aplicada: ${consulta.nombre}.`);
  }

  alternarGuardadas(evento: Event): void {
    evento.stopPropagation();
    this.menuGuardadas.update((abierto) => !abierto);
  }

  @HostListener('document:click', ['$event'])
  cerrarGuardadas(evento: Event): void {
    const objetivo = evento.target as Element | null;
    if (!objetivo?.closest('.dropdown')) this.menuGuardadas.set(false);
  }

  @HostListener('document:keydown.escape')
  cerrarConEscape(): void {
    this.menuGuardadas.set(false);
  }

  eliminarConsulta(consulta: ConsultaGuardada, evento: Event): void {
    evento.stopPropagation();
    this.escribirConsultas(this.consultasGuardadas().filter((fila) => fila.id !== consulta.id));
    this.ui.exito('Consulta eliminada.');
  }

  exportar(): void {
    const resultado = this.resultado();
    if (!resultado?.items.length) {
      this.ui.info('No hay resultados para exportar.');
      return;
    }

    const filas = [
      ['Folio', 'Fecha', 'Cliente', 'Líneas', 'Estado', 'Total'],
      ...resultado.items.map((pedido) => [
        pedido.folio,
        pedido.fechaPedido,
        pedido.cliente ?? '',
        pedido.lineas.map((linea) => etiquetaDe(LINEAS_PRODUCCION, linea)).join(' / '),
        this.etiquetaEstado(pedido.estado),
        String(pedido.total),
      ]),
    ];
    const csv = filas.map((fila) => fila.map((celda) => `"${celda}"`).join(',')).join('\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    const enlace = document.createElement('a');
    enlace.href = url;
    enlace.download = `consultas-llamma-${this.hoy()}.csv`;
    enlace.click();
    URL.revokeObjectURL(url);
    this.ui.exito('Resultados exportados en CSV.');
  }

  claseEstado(estado: string): string {
    const mapa: Record<string, string> = {
      cotizacion: 'badge-soft-cyan',
      confirmado: 'badge-soft-warning',
      'en-produccion': 'badge-soft-cyan',
      listo: 'badge-soft-success',
      entregado: 'badge-soft-success',
      cancelado: 'badge-soft-danger',
    };
    return mapa[estado] ?? 'badge-soft-cyan';
  }

  etiquetaEstado(estado: string): string {
    return estado.replace(/-/g, ' ').replace(/^\w/, (letra) => letra.toUpperCase());
  }

  claseLinea(linea: string): string {
    const mapa: Record<string, string> = {
      'gran-formato': 'badge-soft-cyan',
      textil: 'badge-soft-magenta',
      promocionales: 'badge-soft-yellow',
      papeleria: 'badge-soft-muted',
    };
    return mapa[linea] ?? 'badge-soft-muted';
  }

  etiquetaLinea(linea: string): string {
    return etiquetaDe(LINEAS_PRODUCCION, linea);
  }

  iniciales(nombre: string): string {
    return nombre
      .split(' ')
      .filter(Boolean)
      .slice(0, 2)
      .map((parte) => parte[0])
      .join('')
      .toUpperCase();
  }

  avatar(indice: number): string {
    return ['avatar-cyan', 'avatar-magenta', 'avatar-yellow', 'avatar-ink'][indice % 4];
  }

  moneda(valor: number | null | undefined): string {
    return new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      maximumFractionDigits: 0,
    }).format(Number(valor ?? 0));
  }

  rangoTexto(data: ConsultaPedidosApi): string {
    const inicio = data.total ? (data.pagina - 1) * data.porPagina + 1 : 0;
    const fin = Math.min(data.pagina * data.porPagina, data.total);
    return `Mostrando ${inicio}–${fin} de ${data.total} resultados`;
  }

  fechaCorta(valor: string | null | undefined): string {
    if (!valor) return 'Sin fecha';
    const fecha = new Date(valor.length > 10 ? valor : `${valor}T00:00:00`);
    if (Number.isNaN(fecha.getTime())) return 'Sin fecha';
    return fecha.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  private nombreConsulta(filtros: FiltrosConsulta): string {
    const partes: string[] = [];
    const termino = filtros.q.trim();
    if (termino) partes.push(`“${termino}”`);
    const linea = LINEAS.find((opcion) => opcion.valor === filtros.linea);
    if (linea?.valor) partes.push(linea.etiqueta);
    const estado = ESTADOS.find((opcion) => opcion.valor === filtros.estado);
    if (estado?.valor) partes.push(estado.etiqueta);
    if (filtros.clienteId) {
      const cliente = this.clientes().find((fila) => String(fila.id) === filtros.clienteId);
      if (cliente) partes.push(cliente.nombre);
    }
    if (filtros.desde || filtros.hasta) {
      partes.push(`${this.fechaCorta(filtros.desde)} – ${this.fechaCorta(filtros.hasta)}`);
    }
    return partes.join(' · ') || 'Todos los pedidos';
  }

  private leerConsultas(): ConsultaGuardada[] {
    try {
      const bruto = localStorage.getItem(CONSULTAS_KEY);
      if (!bruto) return [];
      const lista = JSON.parse(bruto) as unknown;
      if (!Array.isArray(lista)) return [];
      return lista.filter((fila): fila is ConsultaGuardada => {
        if (!fila || typeof fila !== 'object') return false;
        const consulta = fila as ConsultaGuardada;
        return (
          typeof consulta.id === 'string' &&
          typeof consulta.nombre === 'string' &&
          !!consulta.filtros &&
          typeof consulta.filtros === 'object'
        );
      });
    } catch {
      return [];
    }
  }

  private escribirConsultas(lista: ConsultaGuardada[]): void {
    this.consultasGuardadas.set(lista);
    try {
      localStorage.setItem(CONSULTAS_KEY, JSON.stringify(lista));
    } catch {
      /* almacenamiento no disponible */
    }
  }

  private hoy(): string {
    return this.iso(new Date());
  }

  private primerDiaMes(): string {
    const hoy = new Date();
    return this.iso(new Date(hoy.getFullYear(), hoy.getMonth(), 1));
  }

  private iso(fecha: Date): string {
    return fecha.toISOString().slice(0, 10);
  }
}
