  display: block;
  font-size: 0.74rem;
}

.conversion-locked span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.64rem;
  line-height: 1.4;
}

/* ------------------------------- Placeholder ------------------------------- */

.detail-placeholder {
  text-align: center;
}

.detail-placeholder h2 {
  margin: 0.7rem 0 0.4rem;
  font-size: 1.05rem;
}

.detail-placeholder p {
  max-width: 22rem;
  margin: 0 auto;
  color: var(--llamma-muted);
  font-size: 0.74rem;
  line-height: 1.6;
}

.placeholder-steps {
  display: grid;
  gap: 0.45rem;
  margin-top: 1.2rem;
  padding-top: 1rem;
  border-top: 1px dashed var(--llamma-line);
  text-align: left;
}

.placeholder-steps span {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--llamma-muted);
  font-size: 0.72rem;
}

.placeholder-steps i {
  color: var(--llamma-cyan-deep);
}

/* -------------------------------- Responsive ------------------------------- */

@media (max-width: 1199.98px) {
  /* Al apilar las columnas el detalle quedaría debajo de toda la lista, así que
     se presenta como una hoja inferior fija sobre la bandeja. */
  .detail-placeholder {
    display: none;
  }

  .detail-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1070;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: rgba(20, 20, 20, 0.48);
    backdrop-filter: blur(2px);
    cursor: pointer;
  }

  .detail-panel-open {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1080;
    width: 100%;
    max-width: 100%;
    max-height: min(88vh, 48rem);
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    border-radius: 1.25rem 1.25rem 0 0;
    box-shadow: 0 -20px 48px rgba(20, 20, 20, 0.24);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: detail-sheet-in 0.22s ease-out;
  }
}

@keyframes detail-sheet-in {
  from {
    opacity: 0;
    transform: translateY(1.5rem);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* En tablet la hoja se centra y limita su ancho para no parecer una página
   completa; en móvil ocupa todo el ancho disponible. */
@media (min-width: 768px) and (max-width: 1199.98px) {
  .detail-panel-open {
    right: auto;
    left: 50%;
    width: min(42rem, calc(100% - 2rem));
    max-height: min(84vh, 48rem);
    margin-bottom: 1.25rem;
    border-radius: 1.25rem;
    translate: -50% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .detail-panel-open {
    animation: none;
  }
}

@media (max-width: 575.98px) {
  .inbox-search {
    flex: 1 1 100%;
    max-width: none;
    flex-wrap: wrap;
  }

  .inbox-search .input-group {
    flex: 1 1 100%;
  }

  .inbox-search .btn {
    flex: 1 1 auto;
  }

  .inbox-tabs {
    width: 100%;
  }

  .inbox-pager span {
    display: none;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }
}
