<file path="cotizar.component.css">
/* Portal público de solicitudes de cotización. */

.min-w-0 {
  min-width: 0;
}

/* ------------------------------- Confirmación ------------------------------ */

.request-success {
  max-width: 62rem;
  margin: 0 auto;
  padding: 2.2rem;
  border-top: 6px solid var(--llamma-cyan);
}

.success-mark {
  display: inline-grid;
  place-items: center;
  width: 3.1rem;
  height: 3.1rem;
  margin-bottom: 0.9rem;
  border-radius: 50%;
  background: rgba(var(--llamma-cyan-rgb), 0.12);
  color: var(--llamma-cyan-deep);
  font-size: 1.5rem;
}

.request-success h2 {
  margin: 0.35rem 0 0.6rem;
  font-size: clamp(1.5rem, 2.6vw, 2.1rem);
}

.request-success-lead {
  max-width: 46rem;
  margin-bottom: 1.4rem;
  color: var(--llamma-muted);
  font-size: 0.86rem;
  line-height: 1.65;
}

.folio-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  padding: 1rem 1.2rem;
  margin-bottom: 1.4rem;
  border: 1px dashed #cfcdc5;
  border-radius: 0.85rem;
  background: #fbfaf7;
}

.folio-box span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.66rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.folio-box strong {
  display: block;
  font-family: var(--llamma-font-display);
  font-size: 1.3rem;
  letter-spacing: 0.02em;
}

.request-success-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.9rem;
  padding: 1rem 0 1.4rem;
}

.request-success-grid > div {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.request-success-grid strong {
  font-size: 0.85rem;
}

.success-lines {
  padding-bottom: 1.3rem;
}

.success-lines .cart-list {
  margin-top: 0.5rem;
}

.success-message {
  margin: 0.9rem 0 0;
  padding: 0.85rem 1rem;
  border-left: 3px solid var(--llamma-cyan);
  background: #fbfaf7;
  color: var(--llamma-muted);
  font-size: 0.76rem;
  line-height: 1.6;
}

/* --------------------------------- Formularios ----------------------------- */

.field-error {
  display: block;
  margin-top: 0.25rem;
  color: #b42318;
  font-size: 0.66rem;
  font-weight: 500;
}

.field-hint {
  margin-top: 0.3rem;
  color: var(--llamma-muted);
  font-size: 0.66rem;
}

.field-optional {
  color: var(--llamma-muted);
  font-size: 0.68rem;
  font-weight: 400;
}

.form-control.is-invalid,
.form-select.is-invalid {
  border-color: #d92d20;
}

/* ------------------------------ Constructor -------------------------------- */

.picked-product {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.85rem 1rem;
  margin-top: 1.1rem;
  border: 1px solid var(--llamma-line);
  border-radius: 0.85rem;
  background: #fbfaf7;
}

.picked-product strong {
  display: block;
  font-size: 0.82rem;
}

.picked-product small {
  display: block;
  margin-top: 0.15rem;
  color: var(--llamma-muted);
  font-size: 0.68rem;
  line-height: 1.45;
}

.picked-price {
  text-align: right;
  white-space: nowrap;
}

.picked-price strong {
  font-family: var(--llamma-font-display);
  font-size: 0.95rem;
}

.picked-price span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.62rem;
}

.line-estimate {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin: 0.55rem 0 0;
  color: var(--llamma-muted);
  font-size: 0.7rem;
}

.line-estimate strong {
  color: var(--llamma-carbon);
}

.cart-list {
  margin-top: 1.2rem;
  border-top: 1px solid var(--llamma-line);
}

.cart-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.7rem 0;
  border-bottom: 1px solid var(--llamma-line);
}

.cart-index {
  display: grid;
  place-items: center;
  width: 1.5rem;
  height: 1.5rem;
  flex: 0 0 auto;
  border-radius: 0.45rem;
  background: rgba(var(--llamma-cyan-rgb), 0.12);
  color: var(--llamma-cyan-deep);
  font-size: 0.62rem;
  font-weight: 700;
}

.cart-row strong {
  display: block;
  font-size: 0.78rem;
}

.cart-row small {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.66rem;
  line-height: 1.4;
}

.cart-amount {
  font-family: var(--llamma-font-display);
  font-size: 0.82rem;
  white-space: nowrap;
}

.cart-empty {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem;
  margin-top: 1.1rem;
  border: 1px dashed #cfcdc5;
  border-radius: 0.85rem;
  color: var(--llamma-muted);
}

.cart-empty i {
  font-size: 1.3rem;
  color: var(--llamma-cyan-deep);
}

.cart-empty p {
  margin: 0;
  font-size: 0.7rem;
  line-height: 1.5;
}

/* --------------------------------- Archivos -------------------------------- */

.upload-box {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  width: 100%;
  padding: 1rem;
  border: 1px dashed #cfcdc5;
  border-radius: 0.85rem;
  background: #fbfaf7;
  cursor: pointer;
}

.upload-box:hover {
  border-color: var(--llamma-cyan);
  background: rgba(var(--llamma-cyan-rgb), 0.035);
}

.upload-box > i {
  color: var(--llamma-cyan-deep);
  font-size: 1.4rem;
}

.upload-box strong {
  display: block;
  font-size: 0.78rem;
}

.upload-box span:not(.btn) {
  display: block;
  margin-top: 0.15rem;
  color: var(--llamma-muted);
  font-size: 0.66rem;
}

.upload-box-compact {
  padding: 0.7rem 0.9rem;
}

.upload-box-compact strong {
  font-size: 0.72rem;
}

.file-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  margin-top: 1rem;
}

.file-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  max-width: 100%;
  padding: 0.35rem 0.55rem;
  border: 1px solid var(--llamma-line);
  border-radius: 999px;
  background: #fff;
  font-size: 0.66rem;
}

.file-chip > i {
  color: var(--llamma-cyan-deep);
}

.file-chip-name {
  max-width: 13rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-chip small {
  color: var(--llamma-muted);
}

.file-chip button {
  display: grid;
  place-items: center;
  width: 1.15rem;
  height: 1.15rem;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(26, 26, 26, 0.06);
  color: var(--llamma-carbon);
  font-size: 0.6rem;
}

/* --------------------------------- Resumen --------------------------------- */

.request-summary .summary-empty {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.8rem;
  border-radius: 0.7rem;
  background: rgba(26, 26, 26, 0.03);
  color: var(--llamma-muted);
}

.request-summary .summary-empty i {
  font-size: 1.1rem;
  color: var(--llamma-cyan-deep);
}

.request-summary .summary-empty p {
  margin: 0;
  font-size: 0.68rem;
  line-height: 1.45;
}

.request-note {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin: 0.9rem 0 1rem;
  padding: 0.7rem 0.8rem;
  border-left: 3px solid var(--llamma-yellow);
  background: rgba(var(--llamma-yellow-rgb), 0.12);
  color: #4a4a4a;
  font-size: 0.66rem;
  line-height: 1.5;
}

.request-note i {
  margin-top: 0.1rem;
}

.request-error {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin-bottom: 0.9rem;
  padding: 0.65rem 0.75rem;
  border: 1px solid rgba(180, 35, 24, 0.26);
  border-radius: 0.7rem;
  background: #fdecec;
  color: #a01212;
  font-size: 0.7rem;
  line-height: 1.45;
}

.request-error i {
  margin-top: 0.1rem;
}

/* -------------------------------- Seguimiento ------------------------------ */

.tracking-card {
  margin-top: 2rem;
}

.tracking-result {
  margin-top: 1.2rem;
  padding-top: 1.2rem;
  border-top: 1px solid var(--llamma-line);
}

.tracking-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.tracking-head h3 {
  margin: 0.2rem 0 0;
  font-size: 1.05rem;
}

.tracking-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.75rem;
  margin-top: 1rem;
}

.tracking-grid > div {
  padding: 0.65rem 0.8rem;
  border-radius: 0.7rem;
  background: rgba(26, 26, 26, 0.03);
}

.tracking-grid span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.tracking-grid strong {
  display: block;
  margin-top: 0.2rem;
  font-size: 0.76rem;
}

.tracking-message {
  margin: 1rem 0 0;
  padding: 0.8rem 1rem;
  border-left: 3px solid var(--llamma-cyan);
  background: rgba(var(--llamma-cyan-rgb), 0.05);
  font-size: 0.76rem;
  line-height: 1.6;
}

.tracking-quote {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  margin-top: 1rem;
  padding: 0.8rem 1rem;
  border: 1px solid rgba(0, 174, 239, 0.25);
  border-radius: 0.75rem;
  background: rgba(var(--llamma-cyan-rgb), 0.07);
}

.tracking-quote > i {
  font-size: 1.3rem;
  color: var(--llamma-cyan-deep);
}

.tracking-quote strong {
  display: block;
  font-size: 0.8rem;
}

.tracking-quote span {
  display: block;
  color: var(--llamma-muted);
  font-size: 0.68rem;
}

/* --------------------------------- Responsive ------------------------------ */

@media (max-width: 991.98px) {
  .request-success-grid,
  .tracking-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 575.98px) {
  .request-success {
    padding: 1.4rem;
  }

  .request-success-grid,
  .tracking-grid {
    grid-template-columns: 1fr;
  }

  .upload-box {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .upload-box .btn {
    margin-left: 0 !important;
  }

  .picked-product {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .picked-price {
    text-align: left;
  }

  .cart-row {
    flex-wrap: wrap;
  }
}

/* --------------------------- Modal de Mockups ------------------------------ */

.mockup-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: rgba(16, 16, 16, 0.65);
  backdrop-filter: blur(2px);
}

.mockup-modal {
  width: 100%;
  max-width: 44rem;
  max-height: 92vh;
  overflow-y: auto;
  padding: 1.5rem;
  border-radius: var(--llamma-radius);
  background: var(--llamma-surface);
  box-shadow: var(--llamma-shadow);
}

.mockup-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding-bottom: 0.9rem;
  margin-bottom: 1rem;
  border-bottom: 1px solid var(--llamma-line);
}

.mockup-header h3 {
  margin: 0.15rem 0 0;
  font-family: var(--llamma-font-display);
  font-size: 1.2rem;
}

.mockup-upload,
.mockup-views {
  margin-bottom: 0.9rem;
}

.mockup-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.mockup-thumb {
  width: 8rem;
  padding: 0.4rem;
  border: 1.5px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fbfaf7;
  text-align: center;
  cursor: pointer;
  transition: border-color 0.15s ease;
}

.mockup-thumb:hover {
  border-color: var(--llamma-carbon);
}

.mockup-thumb.is-active {
  border: 2px solid var(--llamma-cyan);
  background: rgba(var(--llamma-cyan-rgb), 0.06);
}

.mockup-thumb img {
  width: 100%;
  height: 4rem;
  object-fit: cover;
  border-radius: 0.45rem;
  margin-bottom: 0.3rem;
  display: block;
}

.mockup-thumb span {
  display: block;
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--llamma-carbon);
}

.mockup-stage {
  position: relative;
  width: 100%;
  min-height: 20rem;
  padding: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: var(--llamma-paper);
}

/* Se ajusta exacto a la foto real (sin forzar 1:1) */
.mockup-canvas {
  position: relative;
  display: inline-block;
  line-height: 0;
  max-width: 100%;
}

.mockup-base {
  display: block;
  max-width: 100%;
  max-height: 21rem;
  width: auto;
  height: auto;
  user-select: none;
}

/* Ventana del área de impresión: recorta lo que sobra y aplica perspectiva */
.mockup-print-area {
  position: absolute;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transform-origin: center center;
}

.mockup-print-area.is-calibrating {
  border: 2px dashed var(--llamma-cyan);
  background: rgba(var(--llamma-cyan-rgb), 0.16);
}

.mockup-user-design {
  width: 100%;
  height: 100%;
  object-fit: contain;
  mix-blend-mode: multiply;
  transform-origin: center center;
}

.mockup-user-design.fit-cover {
  object-fit: cover;
}

.mockup-empty-hint {
  position: absolute;
  bottom: 0.75rem;
  padding: 0.4rem 0.9rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.94);
  color: var(--llamma-muted);
  font-size: 0.74rem;
  box-shadow: var(--llamma-shadow-sm);
}

.mockup-controls {
  margin-top: 0.9rem;
  padding: 0.85rem 1rem;
  border: 1px solid var(--llamma-line);
  border-radius: var(--llamma-radius-sm);
  background: #fbfaf7;
}

.mockup-controls-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.mockup-sliders {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.75rem;
}

.mockup-sliders-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.mockup-sliders label {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  font-size: 0.72rem;
  color: var(--llamma-muted);
}

.mockup-sliders input[type='range'] {
  width: 100%;
  accent-color: var(--llamma-cyan);
}

.mockup-calibrator {
  margin-top: 0.9rem;
  padding: 0.9rem 1rem;
  border: 1.5px dashed var(--llamma-cyan);
  border-radius: var(--llamma-radius-sm);
  background: rgba(var(--llamma-cyan-rgb), 0.05);
}

.mockup-calibrator-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  font-size: 0.8rem;
}

.mockup-code {
  margin: 0.75rem 0 0;
  padding: 0.6rem 0.75rem;
  border-radius: 0.5rem;
  background: var(--llamma-carbon);
  color: #f5f4f0;
  font-size: 0.72rem;
  white-space: pre-wrap;
}

.mockup-footer {
  margin-top: 1.1rem;
  display: flex;
  justify-content: flex-end;
}

@media (max-width: 640px) {
  .mockup-sliders,
  .mockup-sliders-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
