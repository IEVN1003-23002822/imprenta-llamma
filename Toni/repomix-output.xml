<file path="cotizar.component.html">
<div class="module-page cotizar-page">
  <div class="container">
    <header class="page-header d-flex flex-wrap align-items-end justify-content-between gap-3">
      <div class="page-brand">
        <img
          class="page-brand-logo"
          src="assets/images/logo-llamma.png"
          alt="Imprenta Llamma Logo"
          width="38"
          height="54"
        >
        <div>
          <span class="eyebrow">Portal de clientes</span>
          <h1>Solicita tu cotización.</h1>
          <p class="page-lead">
            Cuéntanos qué necesitas imprimir. Puedes elegir productos del catálogo, describir tu
            proyecto y adjuntar tu logotipo o referencias. Te respondemos con una propuesta a tu
            medida.
          </p>
        </div>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-ink" routerLink="/productos">
          <i class="bi bi-grid-3x3-gap"></i> Ver catálogo
        </a>
        <a class="btn btn-soft" routerLink="/login">
          <i class="bi bi-shield-lock"></i> Acceso equipo
        </a>
      </div>
    </header>

    @if (folio()) {
      <section class="panel-card request-success">
        <span class="success-mark"><i class="bi bi-check2-circle"></i></span>
        <span class="eyebrow">Solicitud recibida</span>
        <h2>¡Gracias, {{ solicitudCreada()?.nombreCliente }}!</h2>
        <p class="request-success-lead">
          Tu solicitud ya está en la bandeja del equipo de Llamma. Te contactaremos al
          {{ solicitudCreada()?.correo }} con una cotización formal.
        </p>

        <div class="folio-box">
          <div>
            <span>Tu folio de seguimiento</span>
            <strong>{{ folio() }}</strong>
          </div>
          <button class="btn btn-outline-ink btn-sm" type="button" (click)="copiarFolio()">
            <i class="bi" [class.bi-clipboard]="!copiado()" [class.bi-clipboard-check]="copiado()"></i>
            {{ copiado() ? 'Copiado' : 'Copiar folio' }}
          </button>
        </div>

        <div class="request-success-grid">
          <div>
            <span class="panel-kicker">Partidas</span>
            <strong>{{ totalPiezas() }} piezas / unidades</strong>
          </div>
          <div>
            <span class="panel-kicker">Estimado referencial</span>
            <strong>{{ moneda(totalConIva()) }} <small>IVA incluido</small></strong>
          </div>
          <div>
            <span class="panel-kicker">Fecha deseada</span>
            <strong>{{ fecha(solicitudCreada()?.fechaDeseada) }}</strong>
          </div>
          <div>
            <span class="panel-kicker">Estatus</span>
            <span class="badge badge-soft-cyan">Recibida</span>
          </div>
        </div>

        <div class="success-lines">
          <span class="panel-kicker">Detalle de tu solicitud</span>
          @if (partidasComprobante().length) {
            <div class="cart-list">
              @for (item of partidasComprobante(); track $index) {
                <div class="cart-row">
                  <span class="cart-index">{{ $index + 1 }}</span>
                  <div class="flex-grow-1 min-w-0">
                    <strong>{{ item.nombreProducto }}</strong>
                    <small>
                      {{ item.cantidad }} × {{ item.especificaciones || 'Especificaciones por confirmar' }}
                    </small>
                  </div>
                  @if (item.precioEstimado != null) {
                    <strong class="cart-amount">{{ moneda(item.precioEstimado) }}</strong>
                  }
                </div>
              }
            </div>
          } @else {
            <p class="success-message">
              Tu solicitud se registró con la descripción del proyecto. El equipo revisará los
